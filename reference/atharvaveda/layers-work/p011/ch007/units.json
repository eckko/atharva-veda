  "lines_deva": [
   "उच्छि॑ष्टे॒ नाम॑ रू॒पं चोच्छि॑ष्टे लो॒क आहि॑तः",
   "उच्छि॑ष्ट॒ इन्द्र॑श्चा॒ग्निश्च॒ विश्व॑म॒न्तः स॒माहि॑तम्"
  ],
  "lines_iast": [
   "ucchi̭ṣṭe̱ nāma̭ rū̱paṃ cocchi̭ṣṭe lo̱ka āhi̭taḥ",
   "ucchi̭ṣṭa̱ indra̭ścā̱gniśca̱ viśva̭ma̱ntaḥ sa̱māhi̭tam"
  ],
