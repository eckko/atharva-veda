  "lines_deva": [
   "अ॒ग्निं ब्रू॑मो॒ वन॒स्पती॒नोष॑धीरु॒त वी॒रुधः॑",
   "इन्द्रं॒ बृह॒स्पतिं॒ सूर्यं॒ ते नो॑ मुञ्च॒न्त्वंह॑सः"
  ],
  "lines_iast": [
   "a̱gniṃ brṷ̄mo̱ vana̱spatī̱noṣa̭dhīru̱ta vī̱rudha̭ḥ",
   "indra̱ṃ bṛha̱spati̱ṃ sūrya̱ṃ te no̭ muñca̱ntvaṃha̭saḥ"
  ],
