   "001.014.1a",
   "001.014.1b"
  ],
  "lines_deva": [
   "भग॑मस्या॒ वर्च॒ आदि॒ष्यधि॑ वृ॒क्षादि॑व॒ स्रज॑म्",
   "म॒हाबु॑ध्न इव॒ पर्व॑तो॒ ज्योक् पि॒तृष्वा॑स्ताम्"
  ],
  "lines_iast": [
   "bhaga̭masyā̱ varca̱ ādi̱ṣyadhi̭ vṛ̱kṣādi̭va̱ sraja̭m",
   "ma̱hābṷdhna iva̱ parva̭to̱ jyok pi̱tṛṣvā̭stām"
  ],
  "book_split": [
   "",
   ""
  ],
