  "type": "verse",
  "line_ids": [
   "001.014.4a",
   "001.014.4b"
  ],
  "lines_deva": [
   "असि॑तस्य ते॒ ब्रह्म॑णा क॒श्यप॑स्य॒ गय॑स्य च",
   "अ॒न्तः॒को॒शमि॑व जा॒मयोऽपि॑ नह्यामि ते॒ भग॑म्"
  ],
  "lines_iast": [
   "asi̭tasya te̱ brahma̭ṇā ka̱śyapa̭sya̱ gaya̭sya ca",
   "a̱nta̱ḥko̱śami̭va jā̱mayo'pi̭ nahyāmi te̱ bhaga̭m"
  ],
