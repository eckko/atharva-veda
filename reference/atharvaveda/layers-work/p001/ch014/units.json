 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.014.3a",
   "001.014.3b"
  ],
  "lines_deva": [
   "ए॒षा ते॑ कुल॒पा रा॑ज॒न् तामु॑ ते॒ परि॑ दद्मसि",
   "ज्योक् पि॒तृष्वा॑साता॒ आ शी॒र्ष्णः स॒मोप्या॑त्"
  ],
  "lines_iast": [
   "e̱ṣā tḙ kula̱pā rā̭ja̱n tāmṷ te̱ pari̭ dadmasi",
   "jyok pi̱tṛṣvā̭sātā̱ ā śī̱rṣṇaḥ sa̱mopyā̭t"
  ],
