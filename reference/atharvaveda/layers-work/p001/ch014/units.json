   "।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.014.2a",
   "001.014.2b"
  ],
  "lines_deva": [
   "ए॒षा ते॑ राजन् क॒न्या व॒धूर्नि धू॑यतां यम",
   "सा मा॒तुर्ब॑ध्यतां गृ॒हेऽथो॒ भ्रातु॒रथो॑ पि॒तुः"
  ],
  "lines_iast": [
   "e̱ṣā tḙ rājan ka̱nyā va̱dhūrni dhṷ̄yatāṃ yama",
   "sā mā̱turba̭dhyatāṃ gṛ̱he'tho̱ bhrātu̱ratho̭ pi̱tuḥ"
  ],
