[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.015.1a",
   "001.015.1b"
  ],
  "lines_deva": [
   "सं सं स्र॑वन्तु॒ सिन्ध॑वः॒ सं वाताः॒ सं प॑त॒त्रिणः॑",
   "इ॒मं य॒ज्ञं प्र॒दिवो॑ मे जुषन्तां संस्रा॒व्येण ह॒विषा॑ जुहोमि"
  ],
  "lines_iast": [
   "saṃ saṃ sra̭vantu̱ sindha̭va̱ḥ saṃ vātā̱ḥ saṃ pa̭ta̱triṇa̭ḥ",
   "i̱maṃ ya̱jñaṃ pra̱divo̭ me juṣantāṃ saṃsrā̱vyeṇa ha̱viṣā̭ juhomi"
  ],
