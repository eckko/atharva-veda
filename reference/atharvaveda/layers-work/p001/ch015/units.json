 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.015.3a",
   "001.015.3b"
  ],
  "lines_deva": [
   "ये न॒दीनां॑ सं॒स्रव॒न्त्युत्सा॑सः॒ सद॒मक्षि॑ताः",
   "तेभि॑र्मे॒ सर्वैः॑ संस्रा॒वैर्धनं॒ सं स्रा॑वयामसि"
  ],
  "lines_iast": [
   "ye na̱dīnā̭ṃ sa̱ṃsrava̱ntyutsā̭sa̱ḥ sada̱makṣi̭tāḥ",
   "tebhi̭rme̱ sarvai̭ḥ saṃsrā̱vairdhana̱ṃ saṃ srā̭vayāmasi"
  ],
