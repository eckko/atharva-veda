 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.015.4a",
   "001.015.4b"
  ],
  "lines_deva": [
   "ये स॒र्पिषः॑ सं॒स्रव॑न्ति क्षी॒रस्य॑ चोद॒कस्य॑ च",
   "तेभि॑र्मे॒ सर्वैः॑ संस्रा॒वैर्धनं॒ सं स्रा॑वयामसि"
  ],
  "lines_iast": [
   "ye sa̱rpiṣa̭ḥ sa̱ṃsrava̭nti kṣī̱rasya̭ coda̱kasya̭ ca",
   "tebhi̭rme̱ sarvai̭ḥ saṃsrā̱vairdhana̱ṃ saṃ srā̭vayāmasi"
  ],
