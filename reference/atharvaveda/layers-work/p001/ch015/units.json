 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.015.2a",
   "001.015.2b"
  ],
  "lines_deva": [
   "इ॒हैव हव॒मा या॑त म इ॒ह सं॑स्रावणा उ॒तेमं व॑र्धयता गिरः",
   "इ॒हैतु॒ सर्वो॒ यः प॒शुर॒स्मिन् ति॑ष्ठतु॒ या र॒यिः"
  ],
  "lines_iast": [
   "i̱haiva hava̱mā yā̭ta ma i̱ha sa̭ṃsrāvaṇā u̱temaṃ va̭rdhayatā giraḥ",
   "i̱haitu̱ sarvo̱ yaḥ pa̱śura̱smin ti̭ṣṭhatu̱ yā ra̱yiḥ"
  ],
