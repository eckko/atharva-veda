   "001.016.4b"
  ],
  "lines_deva": [
   "यदि॑ नो॒ गां हंसि॒ यद्यश्वं॒ यदि॒ पूरु॑षम्",
   "तं त्वा॒ सीसे॑न विध्यामो॒ यथा॒ नोऽसो॒ अवी॑रहा"
  ],
  "lines_iast": [
   "yadi̭ no̱ gāṃ haṃsi̱ yadyaśva̱ṃ yadi̱ pūrṷṣam",
   "taṃ tvā̱ sīsḙna vidhyāmo̱ yathā̱ no'so̱ avī̭rahā"
  ],
