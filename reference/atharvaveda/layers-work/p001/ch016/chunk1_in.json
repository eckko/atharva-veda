  ],
  "lines_deva": [
   "सीसा॒याध्या॑ह॒ वरु॑णः॒ सीसा॑या॒ग्निरुपा॑वति",
   "सीसं॑ म॒ इन्द्रः॒ प्राय॑च्छ॒त् तद॒ङ्ग या॑तु॒चात॑नम्"
  ],
  "lines_iast": [
   "sīsā̱yādhyā̭ha̱ varṷṇa̱ḥ sīsā̭yā̱gnirupā̭vati",
   "sīsa̭ṃ ma̱ indra̱ḥ prāya̭ccha̱t tada̱ṅga yā̭tu̱cāta̭nam"
  ],
