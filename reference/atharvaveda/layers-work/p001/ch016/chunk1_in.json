   "001.016.3a",
   "001.016.3b"
  ],
  "lines_deva": [
   "इ॒दं विष्क॑न्धं सहत इ॒दं बा॑धते अ॒त्त्रिणः॑",
   "अ॒नेन॒ विश्वा॑ ससहे॒ या जा॒तानि॑ पिशा॒च्याः"
  ],
  "lines_iast": [
   "i̱daṃ viṣka̭ndhaṃ sahata i̱daṃ bā̭dhate a̱ttriṇa̭ḥ",
   "a̱nena̱ viśvā̭ sasahe̱ yā jā̱tāni̭ piśā̱cyāḥ"
  ],
