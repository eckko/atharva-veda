 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.034.2a",
   "001.034.2b"
  ],
  "lines_deva": [
   "जि॒ह्वाया॒ अग्रे॒ मधु॑ मे जिह्वामू॒ले म॒धूल॑कम्",
   "ममेदह॒ क्रता॒वसो॒ मम॑ चि॒त्तमु॒पाय॑सि"
  ],
  "lines_iast": [
   "ji̱hvāyā̱ agre̱ madhṷ me jihvāmū̱le ma̱dhūla̭kam",
   "mamedaha̱ kratā̱vaso̱ mama̭ ci̱ttamu̱pāya̭si"
  ],
