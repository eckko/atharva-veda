  "lines_deva": [
   "परि॑ त्वा परित॒त्नुने॒क्षुणा॑गा॒मवि॑द्विषे",
   "यथा॒ मां का॒मिन्यसो॒ यथा॒ मन्नाप॑गा॒ असः॑"
  ],
  "lines_iast": [
   "pari̭ tvā parita̱tnune̱kṣuṇā̭gā̱mavi̭dviṣe",
   "yathā̱ māṃ kā̱minyaso̱ yathā̱ mannāpa̭gā̱ asa̭ḥ"
  ],
