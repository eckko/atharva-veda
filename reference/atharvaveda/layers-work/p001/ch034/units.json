   "001.034.1a",
   "001.034.1b"
  ],
  "lines_deva": [
   "इ॒यं वी॒रुन्मधु॑जाता॒ मधु॑ना त्वा खनामसि",
   "मधो॒रधि॒ प्रजा॑तासि॒ सा नो॒ मधु॑मतस्कृधि"
  ],
  "lines_iast": [
   "i̱yaṃ vī̱runmadhṷjātā̱ madhṷnā tvā khanāmasi",
   "madho̱radhi̱ prajā̭tāsi̱ sā no̱ madhṷmataskṛdhi"
  ],
