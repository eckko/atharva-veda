   "001.034.4b"
  ],
  "lines_deva": [
   "मधो॑रस्मि॒ मधु॑तरो म॒दुघा॒न्मधु॑मत्तरः",
   "मामित् किल॒ त्वं वनाः॒ शाखां॒ मधु॑मतीमिव"
  ],
  "lines_iast": [
   "madho̭rasmi̱ madhṷtaro ma̱dughā̱nmadhṷmattaraḥ",
   "māmit kila̱ tvaṃ vanā̱ḥ śākhā̱ṃ madhṷmatīmiva"
  ],
