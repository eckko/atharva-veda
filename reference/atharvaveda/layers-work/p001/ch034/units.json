   "001.034.3a",
   "001.034.3b"
  ],
  "lines_deva": [
   "मधु॑मन्मे नि॒क्रम॑णं॒ मधु॑मन्मे प॒राय॑णम्",
   "वा॒चा व॑दामि॒ मधु॑मद् भू॒यासं॒ मधु॑संदृशः"
  ],
  "lines_iast": [
   "madhṷmanme ni̱krama̭ṇa̱ṃ madhṷmanme pa̱rāya̭ṇam",
   "vā̱cā va̭dāmi̱ madhṷmad bhū̱yāsa̱ṃ madhṷsaṃdṛśaḥ"
  ],
