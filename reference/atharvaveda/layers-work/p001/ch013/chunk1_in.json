   "001.013.1a",
   "001.013.1b"
  ],
  "lines_deva": [
   "नम॑स्ते अस्तु वि॒द्युते॒ नम॑स्ते स्तनयि॒त्नवे",
   "नम॑स्ते अ॒स्त्वश्म॑ने॒ येना॑ दू॒डाशे॒ अस्य॑सि"
  ],
  "lines_iast": [
   "nama̭ste astu vi̱dyute̱ nama̭ste stanayi̱tnave",
   "nama̭ste a̱stvaśma̭ne̱ yenā̭ dū̱ḍāśe̱ asya̭si"
  ],
