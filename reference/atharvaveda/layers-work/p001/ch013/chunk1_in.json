 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.013.2a",
   "001.013.2b"
  ],
  "lines_deva": [
   "नम॑स्ते प्रवतो नपा॒द्यत॒स्तपः॑ स॒मूह॑सि",
   "मृ॒डया॑ नस्त॒नूभ्यो॒ मय॑स्तो॒केभ्य॑स्कृधि"
  ],
  "lines_iast": [
   "nama̭ste pravato napā̱dyata̱stapa̭ḥ sa̱mūha̭si",
   "mṛ̱ḍayā̭ nasta̱nūbhyo̱ maya̭sto̱kebhya̭skṛdhi"
  ],
