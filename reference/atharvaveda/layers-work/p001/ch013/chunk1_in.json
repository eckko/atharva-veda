 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.013.3a",
   "001.013.3b"
  ],
  "lines_deva": [
   "प्रव॑तो नपा॒न्नम॑ ए॒वास्तु॒ तुभ्यं॒ नम॑स्ते हे॒तये॒ तपु॑षे च कृण्मः",
   "वि॒द्म ते॒ धाम॑ पर॒मं गुहा॒ यत् स॑मु॒द्रे अ॒न्तर्नि॑हि॑तासि॒ नाभिः॑"
  ],
  "lines_iast": [
   "prava̭to napā̱nnama̭ e̱vāstu̱ tubhya̱ṃ nama̭ste he̱taye̱ tapṷṣe ca kṛṇmaḥ",
   "vi̱dma te̱ dhāma̭ para̱maṃ guhā̱ yat sa̭mu̱dre a̱ntarni̭hi̭tāsi̱ nābhi̭ḥ"
  ],
