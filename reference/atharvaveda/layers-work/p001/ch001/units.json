 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.001.3a",
   "001.001.3b"
  ],
  "lines_deva": [
   "इ॒हैवाभि॑ वि त॑नू॒भे आर्त्नी॑ इव॒ ज्य॑या",
   "वा॒चस्पति॒र्नि य॑च्छतु॒ मय्ये॒वा॑स्तु॒ मयि॑ श्रु॒तम्"
  ],
  "lines_iast": [
   "i̱haivābhi̭ vi ta̭nū̱bhe ārtnī̭ iva̱ jya̭yā",
   "vā̱caspati̱rni ya̭cchatu̱ mayye̱vā̭stu̱ mayi̭ śru̱tam"
  ],
