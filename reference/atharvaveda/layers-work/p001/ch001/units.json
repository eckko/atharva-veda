  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.001.2a",
   "001.001.2b"
  ],
  "lines_deva": [
   "पु॑नरे॑हि वचस्पते दे॒वेन॒ म॑नसा स॒ह",
   "वसो॑ष्पते॒ नि र॑मय॒ मय्ये॒वास्तु॒ मयि॑ श्रु॒तम्"
  ],
  "lines_iast": [
   "pṷnarḙhi vacaspate de̱vena̱ ma̭nasā sa̱ha",
   "vaso̭ṣpate̱ ni ra̭maya̱ mayye̱vāstu̱ mayi̭ śru̱tam"
  ],
  "book_split": [
