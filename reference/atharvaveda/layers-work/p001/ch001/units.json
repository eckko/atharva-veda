 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.001.4a",
   "001.001.4b"
  ],
  "lines_deva": [
   "उ॑पहूतो वा॒चस्पति॒रुपा॒स्मान् वा॒चस्प॑तिर्ह्वयताम्",
   "सं श्रु॒तेन॑ गमेमहि॒ मा श्रु॒तेन॒ वि रा॑धिषि"
  ],
  "lines_iast": [
   "ṷpahūto vā̱caspati̱rupā̱smān vā̱caspa̭tirhvayatām",
   "saṃ śru̱tena̭ gamemahi̱ mā śru̱tena̱ vi rā̭dhiṣi"
  ],
