  "type": "verse",
  "line_ids": [
   "001.001.1a",
   "001.001.1b"
  ],
  "lines_deva": [
   "ये॑ त्रिषप्ताः प॑रि॒य॑न्ति वि॑श्वा रू॒पाणि॒ बिभ्र॑तः",
   "वा॒चस्प॒तिर्बला॒ तेषां॑ तन्वो॒ अ॒द्य द॑धातु मे"
  ],
  "lines_iast": [
   "yḙ triṣaptāḥ pa̭ri̱ya̭nti vi̭śvā rū̱pāṇi̱ bibhra̭taḥ",
   "vā̱caspa̱tirbalā̱ teṣā̭ṃ tanvo̱ a̱dya da̭dhātu me"
  ],
  "book_split": [
