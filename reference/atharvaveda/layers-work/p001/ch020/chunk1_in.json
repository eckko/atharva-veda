  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.020.2a",
   "001.020.2b"
  ],
  "lines_deva": [
   "यो अ॒द्य सेन्यो॑ व॒धोऽघा॒यूना॑मु॒दीर॑ते",
   "यु॒वं तं मि॑त्रावरुणाव॒स्मद्या॑वयतं॒ परि॑"
  ],
  "lines_iast": [
   "yo a̱dya senyo̭ va̱dho'ghā̱yūnā̭mu̱dīra̭te",
   "yu̱vaṃ taṃ mi̭trāvaruṇāva̱smadyā̭vayata̱ṃ pari̭"
  ],
