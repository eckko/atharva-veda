   "001.020.4b"
  ],
  "lines_deva": [
   "शा॒स इ॒त्था म॒हाँ अ॑स्यमित्रसा॒हो अ॑स्तृ॒तः",
   "न यस्य॑ ह॒न्यते॒ सखा॒ न जी॒यते॑ क॒दा च॒न"
  ],
  "lines_iast": [
   "śā̱sa i̱tthā ma̱hā~ a̭syamitrasā̱ho a̭stṛ̱taḥ",
   "na yasya̭ ha̱nyate̱ sakhā̱ na jī̱yatḙ ka̱dā ca̱na"
  ],
