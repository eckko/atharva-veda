   "001.020.3a",
   "001.020.3b"
  ],
  "lines_deva": [
   "इ॒तश्च॒ यद॒मुत॑श्च॒ यद् व॒धं व॑रुण यावय",
   "वि म॒हच्छर्म॑ यच्छ॒ वरी॑यो यावया व॒धम्"
  ],
  "lines_iast": [
   "i̱taśca̱ yada̱muta̭śca̱ yad va̱dhaṃ va̭ruṇa yāvaya",
   "vi ma̱haccharma̭ yaccha̱ varī̭yo yāvayā va̱dham"
  ],
