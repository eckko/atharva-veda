   "001.027.4b"
  ],
  "lines_deva": [
   "प्रेतं॑ पादौ॒ प्र स्फु॑रतं॒ वह॑तं पृण॒तो गृ॒हान्",
   "इ॒न्द्रा॒ण्येऽतु प्रथ॒माजी॒तामु॑षिता पु॒रः"
  ],
  "lines_iast": [
   "preta̭ṃ pādau̱ pra sphṷrata̱ṃ vaha̭taṃ pṛṇa̱to gṛ̱hān",
   "i̱ndrā̱ṇye'tu pratha̱mājī̱tāmṷṣitā pu̱raḥ"
  ],
