   "001.027.2b"
  ],
  "lines_deva": [
   "विषू॑च्येतु कृन्त॒ती पिना॑कमिव॒ बिभ्र॑ती",
   "विष्व॑क् पुन॒र्भुवा॒ मनोऽस॑मृद्धा अघा॒यवः॑"
  ],
  "lines_iast": [
   "viṣṷ̄cyetu kṛnta̱tī pinā̭kamiva̱ bibhra̭tī",
   "viṣva̭k puna̱rbhuvā̱ mano'sa̭mṛddhā aghā̱yava̭ḥ"
  ],
