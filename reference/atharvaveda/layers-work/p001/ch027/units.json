 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.027.3a",
   "001.027.3b"
  ],
  "lines_deva": [
   "न ब॒हवः॒ सम॑शक॒न् नार्भ॒का अ॒भि दा॑धृषुः",
   "वे॒णोरद्गा॑ इवा॒भितोऽस॑मृद्धा अघा॒यवः॑"
  ],
  "lines_iast": [
   "na ba̱hava̱ḥ sama̭śaka̱n nārbha̱kā a̱bhi dā̭dhṛṣuḥ",
   "ve̱ṇoradgā̭ ivā̱bhito'sa̭mṛddhā aghā̱yava̭ḥ"
  ],
