   "001.027.1a",
   "001.027.1b"
  ],
  "lines_deva": [
   "अ॒मूः पा॒रे पृ॑दा॒क्व ऽ स्त्रिष॒प्ता निर्ज॑रायवः",
   "तासां॑ ज॒रायु॑भिर्व॒यम॒क्ष्या॒वपि॑ व्ययामस्यघा॒योः प॑रिप॒न्थिनः॑"
  ],
  "lines_iast": [
   "a̱mūḥ pā̱re pṛ̭dā̱kva ' striṣa̱ptā nirja̭rāyavaḥ",
   "tāsā̭ṃ ja̱rāyṷbhirva̱yama̱kṣyā̱vapi̭ vyayāmasyaghā̱yoḥ pa̭ripa̱nthina̭ḥ"
  ],
