   "001.029.1a",
   "001.029.1b"
  ],
  "lines_deva": [
   "अ॒भी॒व॒र्तेन॑ म॒णिना॒ येनेन्द्रो॑ अभिवावृ॒धे॑",
   "तेना॒स्मान् ब्र॑ह्मणस्पते॒ऽभि रा॒ष्ट्राय॑ वर्धय"
  ],
  "lines_iast": [
   "a̱bhī̱va̱rtena̭ ma̱ṇinā̱ yenendro̭ abhivāvṛ̱dhḙ",
   "tenā̱smān bra̭hmaṇaspate̱'bhi rā̱ṣṭrāya̭ vardhaya"
  ],
  "book_split": [
