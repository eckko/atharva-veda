   "001.029.3b"
  ],
  "lines_deva": [
   "अ॒भि त्वा॑ दे॒वः स॑वि॒ताभि सोमो॑ अवीवृधत्",
   "अ॒भि त्वा॒ विश्वा॑ भू॒तान्य॑भीव॒र्तो यथास॑सि"
  ],
  "lines_iast": [
   "a̱bhi tvā̭ de̱vaḥ sa̭vi̱tābhi somo̭ avīvṛdhat",
   "a̱bhi tvā̱ viśvā̭ bhū̱tānya̭bhīva̱rto yathāsa̭si"
  ],
