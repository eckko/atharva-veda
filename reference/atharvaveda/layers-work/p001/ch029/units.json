   "001.029.4b"
  ],
  "lines_deva": [
   "अ॒भी॒व॒र्तो अ॑भिभ॒वः स॑पत्न॒क्षय॑णो म॒णिः",
   "रा॒ष्ट्राय॒ मह्यं॑ बध्यतां स॒पत्ने॑भ्यः परा॒भुवे॑"
  ],
  "lines_iast": [
   "a̱bhī̱va̱rto a̭bhibha̱vaḥ sa̭patna̱kṣaya̭ṇo ma̱ṇiḥ",
   "rā̱ṣṭrāya̱ mahya̭ṃ badhyatāṃ sa̱patnḙbhyaḥ parā̱bhuvḙ"
  ],
