  "lines_deva": [
   "स॒प॒त्न॒क्षय॑णो॒ वृषा॒भिरा॑ष्ट्रो विषास॒हिः",
   "यथा॒हमे॒षां वी॒राणां॑ वि॒राजा॑नि॒ जन॑स्य च"
  ],
  "lines_iast": [
   "sa̱pa̱tna̱kṣaya̭ṇo̱ vṛṣā̱bhirā̭ṣṭro viṣāsa̱hiḥ",
   "yathā̱hame̱ṣāṃ vī̱rāṇā̭ṃ vi̱rājā̭ni̱ jana̭sya ca"
  ],
