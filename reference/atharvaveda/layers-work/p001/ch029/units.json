  "lines_deva": [
   "उद॒सौ सूर्यो॑ अगा॒दुदि॒दं मा॑म॒कं वचः॑",
   "यथा॒हं श॑त्रु॒होऽसा॑न्यसपत्नः सपत्नहा॑"
  ],
  "lines_iast": [
   "uda̱sau sūryo̭ agā̱dudi̱daṃ mā̭ma̱kaṃ vaca̭ḥ",
   "yathā̱haṃ śa̭tru̱ho'sā̭nyasapatnaḥ sapatnahā̭"
  ],
