  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.029.2a",
   "001.029.2b"
  ],
  "lines_deva": [
   "अ॒भि॒वृत्य॑ स॒पत्ना॑न॒भि या नो॒ अरा॑तयः",
   "अभि पृ॑त॒न्यन्तं॑ तिष्ठा॒भि यो नो॑ दुर॒स्यति॑"
  ],
  "lines_iast": [
   "a̱bhi̱vṛtya̭ sa̱patnā̭na̱bhi yā no̱ arā̭tayaḥ",
   "abhi pṛ̭ta̱nyanta̭ṃ tiṣṭhā̱bhi yo no̭ dura̱syati̭"
  ],
