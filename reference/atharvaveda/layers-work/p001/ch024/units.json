   "001.024.2b"
  ],
  "lines_deva": [
   "आ॒सु॒री च॑क्रे प्रथ॒मेदं कि॑लासभेष॒जमि॒दं कि॑लास॒नाश॑नम्",
   "अनी॑नशत् कि॒लासं॒ सरू॑पामकर॒त् त्वच॑म्"
  ],
  "lines_iast": [
   "ā̱su̱rī ca̭kre pratha̱medaṃ ki̭lāsabheṣa̱jami̱daṃ ki̭lāsa̱nāśa̭nam",
   "anī̭naśat ki̱lāsa̱ṃ sarṷ̄pāmakara̱t tvaca̭m"
  ],
