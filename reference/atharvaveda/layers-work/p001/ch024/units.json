   "001.024.1b"
  ],
  "lines_deva": [
   "सु॒प॒र्णो जा॒तः प्र॑थ॒मस्तस्य॒ त्वं पि॒त्तमा॑सिथ",
   "तदा॑सु॒री यु॒धा जि॒ता रू॒पं च॑क्रे॒ वन॒स्पती॑न्"
  ],
  "lines_iast": [
   "su̱pa̱rṇo jā̱taḥ pra̭tha̱mastasya̱ tvaṃ pi̱ttamā̭sitha",
   "tadā̭su̱rī yu̱dhā ji̱tā rū̱paṃ ca̭kre̱ vana̱spatī̭n"
  ],
