 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.024.3a",
   "001.024.3b"
  ],
  "lines_deva": [
   "सरू॑पा॒ नाम॑ ते मा॒ता सरू॑पो॒ नाम॑ ते पि॒ता",
   "स॒रू॒प॒कृत् त्वमो॑षधे॒ सा सरू॑पमि॒दं कृ॑धि"
  ],
  "lines_iast": [
   "sarṷ̄pā̱ nāma̭ te mā̱tā sarṷ̄po̱ nāma̭ te pi̱tā",
   "sa̱rū̱pa̱kṛt tvamo̭ṣadhe̱ sā sarṷ̄pami̱daṃ kṛ̭dhi"
  ],
