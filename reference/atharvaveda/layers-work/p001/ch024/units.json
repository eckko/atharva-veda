 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.024.4a",
   "001.024.4b"
  ],
  "lines_deva": [
   "श्या॒मा स॑रूपं॒कर॑णी पृथि॒व्या अध्युद्भृ॑ता",
   "इ॒दमू॒ षु प्र सा॑धय॒ पुना॑ रू॒पाणि॑ कल्पय"
  ],
  "lines_iast": [
   "śyā̱mā sa̭rūpa̱ṃkara̭ṇī pṛthi̱vyā adhyudbhṛ̭tā",
   "i̱damū̱ ṣu pra sā̭dhaya̱ punā̭ rū̱pāṇi̭ kalpaya"
  ],
