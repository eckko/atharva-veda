  "line_ids": [
   "001.023.1a",
   "001.023.1b"
  ],
  "lines_deva": [
   "न॒क्तं॒जा॒तास्यो॑षधे॒ रामे॒ कृष्णे॒ असि॑क्नि च",
   "इ॒दं र॑जनि रजय कि॒लासं॑ पलि॒तं च॒ यत्"
  ],
  "lines_iast": [
   "na̱kta̱ṃjā̱tāsyo̭ṣadhe̱ rāme̱ kṛṣṇe̱ asi̭kni ca",
   "i̱daṃ ra̭jani rajaya ki̱lāsa̭ṃ pali̱taṃ ca̱ yat"
  ],
  "book_split": [
   "",
   ""
  ],
