 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.023.3a",
   "001.023.3b"
  ],
  "lines_deva": [
   "असि॑तं ते प्र॒लय॑नमा॒स्थान॒मसि॑तं॒ तव॑",
   "असि॑क्न्यस्योषधे॒ निरि॒तो ना॑शया॒ पृष॑त्"
  ],
  "lines_iast": [
   "asi̭taṃ te pra̱laya̭namā̱sthāna̱masi̭ta̱ṃ tava̭",
   "asi̭knyasyoṣadhe̱ niri̱to nā̭śayā̱ pṛṣa̭t"
  ],
