 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.023.4a",
   "001.023.4b"
  ],
  "lines_deva": [
   "अ॒स्थि॒जस्य॑ कि॒लास॑स्य तनू॒जस्य॑ च॒ यत् त्व॒चि",
   "दूष्या॑ कृ॒तस्य॒ ब्रह्म॑णा॒ लक्ष्म॑ श्वे॒तम॑नीनशम्"
  ],
  "lines_iast": [
   "a̱sthi̱jasya̭ ki̱lāsa̭sya tanū̱jasya̭ ca̱ yat tva̱ci",
   "dūṣyā̭ kṛ̱tasya̱ brahma̭ṇā̱ lakṣma̭ śve̱tama̭nīnaśam"
  ],
