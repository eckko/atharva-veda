  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.023.2a",
   "001.023.2b"
  ],
  "lines_deva": [
   "कि॒लासं॑ च पलि॒तं च॒ निरि॒तो ना॑शया॒ पृष॑त्",
   "आ त्वा॒ स्वो वि॑शतां॒ वर्णः॒ परा॑ शु॒क्लानि॑ पातय"
  ],
  "lines_iast": [
   "ki̱lāsa̭ṃ ca pali̱taṃ ca̱ niri̱to nā̭śayā̱ pṛṣa̭t",
   "ā tvā̱ svo vi̭śatā̱ṃ varṇa̱ḥ parā̭ śu̱klāni̭ pātaya"
  ],
  "book_split": [
