   "001.008.1a",
   "001.008.1b"
  ],
  "lines_deva": [
   "इ॒दं ह॒विर्या॑तु॒धाना॑न् न॒दी फेन॑मि॒वा व॑हत्",
   "य इ॒दं स्त्री पुमा॒नक॑रि॒ह स स्तु॑वतां॒ जनः॑"
  ],
  "lines_iast": [
   "i̱daṃ ha̱viryā̭tu̱dhānā̭n na̱dī phena̭mi̱vā va̭hat",
   "ya i̱daṃ strī pumā̱naka̭ri̱ha sa stṷvatā̱ṃ jana̭ḥ"
  ],
