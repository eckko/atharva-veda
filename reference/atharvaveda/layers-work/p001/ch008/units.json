 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.008.2a",
   "001.008.2b"
  ],
  "lines_deva": [
   "अ॒यं स्तु॑वा॒न आग॑मदि॒मं स्म॒ प्रति॑ हर्यत",
   "बृह॑स्पते॒ वशे॑ ल॒ब्ध्वाग्नी॑षोमा॒ वि वि॑ध्यतम्"
  ],
  "lines_iast": [
   "a̱yaṃ stṷvā̱na āga̭madi̱maṃ sma̱ prati̭ haryata",
   "bṛha̭spate̱ vaśḙ la̱bdhvāgnī̭ṣomā̱ vi vi̭dhyatam"
  ],
