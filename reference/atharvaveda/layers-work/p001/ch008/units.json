 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.008.3a",
   "001.008.3b"
  ],
  "lines_deva": [
   "या॒तु॒धान॑स्य सोमप ज॒हि प्र॒जां नय॑स्व च",
   "नि स्तु॑वा॒नस्य॑ पातय॒ पर॒मक्ष्यु॒ताव॑रम्"
  ],
  "lines_iast": [
   "yā̱tu̱dhāna̭sya somapa ja̱hi pra̱jāṃ naya̭sva ca",
   "ni stṷvā̱nasya̭ pātaya̱ para̱makṣyu̱tāva̭ram"
  ],
