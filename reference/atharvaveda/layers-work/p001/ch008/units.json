 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.008.4a",
   "001.008.4b"
  ],
  "lines_deva": [
   "यत्रै॑षामग्ने॒ जनि॑मानि॒ वेत्थ॒ गुहा॑ स॒ताम॒त्त्रिणां॑ जातवेदः",
   "तांस्त्वं ब्रह्म॑णा वावृधा॒नो ज॒ह्येऽषां शत॒तर्ह॑मग्ने"
  ],
  "lines_iast": [
   "yatrai̭ṣāmagne̱ jani̭māni̱ vettha̱ guhā̭ sa̱tāma̱ttriṇā̭ṃ jātavedaḥ",
   "tāṃstvaṃ brahma̭ṇā vāvṛdhā̱no ja̱hye'ṣāṃ śata̱tarha̭magne"
  ],
