 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.002.4a",
   "001.002.4b"
  ],
  "lines_deva": [
   "यथा॒ द्यां च॑ पृथि॒वीं चा॒न्तस्तिष्ठ॑ति॒ तेज॑नम्",
   "ए॒वा रोगं॑ चास्रा॒वं चा॒न्तस्ति॑ष्ठतु॒ मुञ्ज॒ इत्"
  ],
  "lines_iast": [
   "yathā̱ dyāṃ ca̭ pṛthi̱vīṃ cā̱ntastiṣṭha̭ti̱ teja̭nam",
   "e̱vā roga̭ṃ cāsrā̱vaṃ cā̱ntasti̭ṣṭhatu̱ muñja̱ it"
  ],
