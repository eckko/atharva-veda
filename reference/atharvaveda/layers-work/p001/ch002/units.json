[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.002.1a",
   "001.002.1b"
  ],
  "lines_deva": [
   "वि॒द्मा श॒रस्य॑ पि॒तरं॑ प॒र्जन्यं॒ भू॑रिधायसम्",
   "वि॒द्मो ष्व॑स्य मा॒तरं॑ पृथि॒वीं भूरि॑वर्पसम्"
  ],
  "lines_iast": [
   "vi̱dmā śa̱rasya̭ pi̱tara̭ṃ pa̱rjanya̱ṃ bhṷ̄ridhāyasam",
   "vi̱dmo ṣva̭sya mā̱tara̭ṃ pṛthi̱vīṃ bhūri̭varpasam"
  ],
