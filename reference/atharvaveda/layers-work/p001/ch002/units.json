 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.002.2a",
   "001.002.2b"
  ],
  "lines_deva": [
   "ज्याऽके॒ परि॑ णो न॒माश्मा॑नं त॒न्वं कृधि",
   "वी॒डुर्वरी॒योऽरा॑ती॒रप॒ द्वेषां॒स्याऽकृ॑धि"
  ],
  "lines_iast": [
   "jyā'ke̱ pari̭ ṇo na̱māśmā̭naṃ ta̱nvaṃ kṛdhi",
   "vī̱ḍurvarī̱yo'rā̭tī̱rapa̱ dveṣā̱ṃsyā'kṛ̭dhi"
  ],
