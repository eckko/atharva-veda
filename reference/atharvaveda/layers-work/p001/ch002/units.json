 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.002.3a",
   "001.002.3b"
  ],
  "lines_deva": [
   "वृ॒क्षं यद्गावः॑ परिषस्वजा॒ना अ॑नुस्फु॒रं श॒रमर्च॑न्त्यृ॒भुम्",
   "शरु॑म॒स्मद्या॑वय दि॒द्युमि॑न्द्र"
  ],
  "lines_iast": [
   "vṛ̱kṣaṃ yadgāva̭ḥ pariṣasvajā̱nā a̭nusphu̱raṃ śa̱ramarca̭ntyṛ̱bhum",
   "śarṷma̱smadyā̭vaya di̱dyumi̭ndra"
  ],
