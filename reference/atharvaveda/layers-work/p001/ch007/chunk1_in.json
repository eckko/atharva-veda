 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.007.4a",
   "001.007.4b"
  ],
  "lines_deva": [
   "अ॒ग्नि पूर्व॒ आ र॑भतां॒ प्रेन्द्रो॑ नुदतु बाहु॒मा॑न्",
   "ब्रवी॑तु॒ सर्वो॑ यातु॒मान॒यम॒स्मीत्येत्य॑"
  ],
  "lines_iast": [
   "a̱gni pūrva̱ ā ra̭bhatā̱ṃ prendro̭ nudatu bāhu̱mā̭n",
   "bravī̭tu̱ sarvo̭ yātu̱māna̱yama̱smītyetya̭"
  ],
  "book_split": [
