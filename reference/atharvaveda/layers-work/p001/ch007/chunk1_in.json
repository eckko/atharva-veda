  ],
  "uncertain": [],
  "trailers": [
   "।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.007.2a",
   "001.007.2b"
  ],
  "lines_deva": [
   "आज्य॑स्य परमेष्ठिन् जात॑वेद॒स्तनू॑वशिन्",
   "अग्ने॑ तौ॒लस्य॒ प्राशा॑न यातु॒धाना॒न् वि ला॑पय"
  ],
  "lines_iast": [
   "ājya̭sya parameṣṭhin jāta̭veda̱stanṷ̄vaśin",
   "agnḙ tau̱lasya̱ prāśā̭na yātu̱dhānā̱n vi lā̭paya"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
