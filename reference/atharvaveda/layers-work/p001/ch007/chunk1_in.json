 },
 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "001.007.5a",
   "001.007.5b"
  ],
  "lines_deva": [
   "पश्या॑म ते वी॒र्यं॒ जातवेदः॒ प्र णो॑ ब्रूहि यातु॒धाना॑न् नृचक्षः",
   "त्वया॒ सर्वे॒ परि॑तप्ताः पु॒रस्तात्त आ य॑न्तु प्रब्रुवा॒णा उपे॒दम्"
  ],
  "lines_iast": [
   "paśyā̭ma te vī̱rya̱ṃ jātaveda̱ḥ pra ṇo̭ brūhi yātu̱dhānā̭n nṛcakṣaḥ",
   "tvayā̱ sarve̱ pari̭taptāḥ pu̱rastātta ā ya̭ntu prabruvā̱ṇā upe̱dam"
  ],
  "book_split": [
