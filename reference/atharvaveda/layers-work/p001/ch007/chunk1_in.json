   "001.007.7b"
  ],
  "lines_deva": [
   "त्व॑मग्ने यातु॒धाना॒नुप॑बद्धाँ इ॒हा व॑ह",
   "अथै॑षा॒मिन्द्रो॒ वज्रे॒णापि॑ शी॒र्षाणि॑ वृश्चतु"
  ],
  "lines_iast": [
   "tva̭magne yātu̱dhānā̱nupa̭baddhā~ i̱hā va̭ha",
   "athai̭ṣā̱mindro̱ vajre̱ṇāpi̭ śī̱rṣāṇi̭ vṛścatu"
  ],
