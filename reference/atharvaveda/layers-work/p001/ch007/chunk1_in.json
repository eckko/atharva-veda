  ]
 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.007.3a",
   "001.007.3b"
  ],
  "lines_deva": [
   "वि ल॑पन्तु यातु॒धाना॑ अ॒त्त्रिणो॒ ये कि॑मी॒दिनः॑",
   "अथे॒दम॑ग्ने नो ह॒विरिन्द्र॑श्च प्रति॑ हर्यतम्"
  ],
  "lines_iast": [
   "vi la̭pantu yātu̱dhānā̭ a̱ttriṇo̱ ye ki̭mī̱dina̭ḥ",
   "athe̱dama̭gne no ha̱virindra̭śca prati̭ haryatam"
  ],
