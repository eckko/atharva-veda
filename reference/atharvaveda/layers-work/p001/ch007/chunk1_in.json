 },
 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "001.007.6a",
   "001.007.6b"
  ],
  "lines_deva": [
   "आ र॑भस्व जातवेदो॒ऽस्माकार्था॑य जज्ञिषे",
   "दू॒तो नो॑ अग्ने भू॒त्वा या॑तु॒धाना॒न् वि ला॑पय"
  ],
  "lines_iast": [
   "ā ra̭bhasva jātavedo̱'smākārthā̭ya jajñiṣe",
   "dū̱to no̭ agne bhū̱tvā yā̭tu̱dhānā̱n vi lā̭paya"
  ],
