[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.007.1a",
   "001.007.1b"
  ],
  "lines_deva": [
   "स्तु॒वा॒नम॑ग्न॒ आ व॑ह यातु॒धानं॑ किमी॒दिन॑म्",
   "त्वं हि दे॑व वन्दि॒तो ह॒न्ता दस्यो॑र्ब॒भूवि॑थ"
  ],
  "lines_iast": [
   "stu̱vā̱nama̭gna̱ ā va̭ha yātu̱dhāna̭ṃ kimī̱dina̭m",
   "tvaṃ hi dḙva vandi̱to ha̱ntā dasyo̭rba̱bhūvi̭tha"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
