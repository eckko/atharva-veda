 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.031.4a",
   "001.031.4b"
  ],
  "lines_deva": [
   "स्व॒स्ति मा॒त्र उ॒त पि॒त्रे नो॑ अस्तु स्व॒स्ति गोभ्यो॒ जग॑ते॒ पुरु॑षेभ्यः",
   "विश्वं॑ सुभू॒तं सु॑वि॒दत्रं॑ नो अस्तु॒ ज्योगे॒व दृ॑शेम॒ सूर्य॑म्"
  ],
  "lines_iast": [
   "sva̱sti mā̱tra u̱ta pi̱tre no̭ astu sva̱sti gobhyo̱ jaga̭te̱ purṷṣebhyaḥ",
   "viśva̭ṃ subhū̱taṃ sṷvi̱datra̭ṃ no astu̱ jyoge̱va dṛ̭śema̱ sūrya̭m"
  ],
