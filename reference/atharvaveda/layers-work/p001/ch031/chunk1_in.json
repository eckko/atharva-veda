   "001.031.1a",
   "001.031.1b"
  ],
  "lines_deva": [
   "आशा॑नामाशापा॒लेभ्य॑श्च॒तुर्भ्यो॑ अ॒मृते॑भ्यः",
   "इ॒दं भू॒तस्याध्य॑क्षेभ्यो वि॒धेम॑ ह॒विषा॑ व॒यम्"
  ],
  "lines_iast": [
   "āśā̭nāmāśāpā̱lebhya̭śca̱turbhyo̭ a̱mṛtḙbhyaḥ",
   "i̱daṃ bhū̱tasyādhya̭kṣebhyo vi̱dhema̭ ha̱viṣā̭ va̱yam"
  ],
