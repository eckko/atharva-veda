 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.031.3a",
   "001.031.3b"
  ],
  "lines_deva": [
   "अस्रा॑मस्त्वा ह॒विषा॑ यजा॒म्यश्लो॑णस्त्वा घृ॒तेन॑ जुहोमि",
   "य आशा॑नामाशापा॒लस्तु॒रीयो॑ दे॒वः स नः॑ सुभू॒तमेह व॑क्षत्"
  ],
  "lines_iast": [
   "asrā̭mastvā ha̱viṣā̭ yajā̱myaślo̭ṇastvā ghṛ̱tena̭ juhomi",
   "ya āśā̭nāmāśāpā̱lastu̱rīyo̭ de̱vaḥ sa na̭ḥ subhū̱tameha va̭kṣat"
  ],
