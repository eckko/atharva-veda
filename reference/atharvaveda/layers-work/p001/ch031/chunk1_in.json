 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.031.2a",
   "001.031.2b"
  ],
  "lines_deva": [
   "य आशा॑नामाशापा॒लाश्च॒त्वार॒ स्थन॑ देवाः",
   "ते नो॒ निरृ॑त्याः॒ पाशे॑भ्यो मु॒ञ्चतांह॑सो अंहसः"
  ],
  "lines_iast": [
   "ya āśā̭nāmāśāpā̱lāśca̱tvāra̱ sthana̭ devāḥ",
   "te no̱ nirṛ̭tyā̱ḥ pāśḙbhyo mu̱ñcatāṃha̭so aṃhasaḥ"
  ],
