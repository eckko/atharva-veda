   "001.032.4b"
  ],
  "lines_deva": [
   "विश्व॑म॒न्याम॑भी॒वार॒ तद॒न्यस्या॒मधि॑श्रि॒तम्",
   "दि॒वे च॑ वि॒श्ववे॑दसे पृथि॒व्यै चा॑करं॒ नमः॑"
  ],
  "lines_iast": [
   "viśva̭ma̱nyāma̭bhī̱vāra̱ tada̱nyasyā̱madhi̭śri̱tam",
   "di̱ve ca̭ vi̱śvavḙdase pṛthi̱vyai cā̭kara̱ṃ nama̭ḥ"
  ],
