 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.032.2a",
   "001.032.2b"
  ],
  "lines_deva": [
   "अ॒न्तरि॑क्ष आसां॒ स्थाम॑ श्रान्त॒सदा॑मिव",
   "आ॒स्थान॑म॒स्य भू॒तस्य॑ वि॒दुष्टद् वे॒धसो॒ न वा॑"
  ],
  "lines_iast": [
   "a̱ntari̭kṣa āsā̱ṃ sthāma̭ śrānta̱sadā̭miva",
   "ā̱sthāna̭ma̱sya bhū̱tasya̭ vi̱duṣṭad ve̱dhaso̱ na vā̭"
  ],
