  "line_ids": [
   "001.032.1a",
   "001.032.1b"
  ],
  "lines_deva": [
   "इ॒दं ज॑नासो वि॒दथ॑ म॒हद् ब्रह्म॑ वदिष्यति",
   "न तत् पृ॑थिव्यां नो दि॒वि येन॑ प्रा॒णन्ति॑ वी॒रुधः॑"
  ],
  "lines_iast": [
   "i̱daṃ ja̭nāso vi̱datha̭ ma̱had brahma̭ vadiṣyati",
   "na tat pṛ̭thivyāṃ no di̱vi yena̭ prā̱ṇanti̭ vī̱rudha̭ḥ"
  ],
