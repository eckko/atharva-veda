 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.032.3a",
   "001.032.3b"
  ],
  "lines_deva": [
   "यद् रोद॑सी॒ रेज॑माने॒ भूमि॑श्च नि॒रत॑क्षतम्",
   "आ॒र्द्रं तद॒द्य स॑र्व॒दा स॑मु॒द्रस्ये॑व स्रो॒त्याः"
  ],
  "lines_iast": [
   "yad roda̭sī̱ reja̭māne̱ bhūmi̭śca ni̱rata̭kṣatam",
   "ā̱rdraṃ tada̱dya sa̭rva̱dā sa̭mu̱drasyḙva sro̱tyāḥ"
  ],
