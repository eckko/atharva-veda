 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "001.021.3a",
   "001.021.3b"
  ],
  "lines_deva": [
   "वि रक्षो॒ वि मृधो॑ जहि वि वृ॒त्रस्य॒ हनू॑ रुज",
   "वि म॒न्युमि॑न्द्र वृत्रहन्न॒मित्र॑स्याभि॒दास॑तः"
  ],
  "lines_iast": [
   "vi rakṣo̱ vi mṛdho̭ jahi vi vṛ̱trasya̱ hanṷ̄ ruja",
   "vi ma̱nyumi̭ndra vṛtrahanna̱mitra̭syābhi̱dāsa̭taḥ"
  ],
