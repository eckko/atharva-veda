   ""
  ],
  "book_english": [
   "",
   ""
  ],
  "uncertain": [],
  "trailers": [
   "।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.021.2a",
   "001.021.2b"
  ],
  "lines_deva": [
   "वि न॑ इन्द्र॒ मृधो॑ जहि नीचा॒ य॑च्छ पृतन्य॒तः",
   "अ॒ध॒मं ग॑मया॒ तमो॒ यो अ॒स्माँ अ॑भि॒दास॑ति"
  ],
  "lines_iast": [
   "vi na̭ indra̱ mṛdho̭ jahi nīcā̱ ya̭ccha pṛtanya̱taḥ",
   "a̱dha̱maṃ ga̭mayā̱ tamo̱ yo a̱smā~ a̭bhi̱dāsa̭ti"
  ],
  "book_split": [
   "",
   ""
  ],
