 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "001.021.4a",
   "001.021.4b"
  ],
  "lines_deva": [
   "अपे॑न्द्र द्विष॒तो मनोऽप॒ जिज्या॑सतो व॒धम्",
   "वि महच्छर्म॑ यच्छ॒ वरी॑यो यावया व॒धम्"
  ],
  "lines_iast": [
   "apḙndra dviṣa̱to mano'pa̱ jijyā̭sato va̱dham",
   "vi mahaccharma̭ yaccha̱ varī̭yo yāvayā va̱dham"
  ],
