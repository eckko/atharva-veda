[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "001.021.1a",
   "001.021.1b"
  ],
  "lines_deva": [
   "स्वस्ति॒दा वि॒शां पति॑र्वृत्र॒हा वि॑मृ॒धो॑ व॒शी",
   "वृषेन्द्रः॑ पु॒र ए॑तु नः सोम॒पा अ॑भयंक॒रः"
  ],
  "lines_iast": [
   "svasti̱dā vi̱śāṃ pati̭rvṛtra̱hā vi̭mṛ̱dho̭ va̱śī",
   "vṛṣendra̭ḥ pu̱ra ḙtu naḥ soma̱pā a̭bhayaṃka̱raḥ"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
