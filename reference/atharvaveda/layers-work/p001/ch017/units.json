   "001.017.3b"
  ],
  "lines_deva": [
   "श॒तस्य॑ ध॒मनी॑नां स॒हस्र॑स्य हि॒राणा॑म्",
   "अस्थु॒रिन्म॑ध्य॒मा इ॒माः सा॒कमन्ता॑ अरंसत"
  ],
  "lines_iast": [
   "śa̱tasya̭ dha̱manī̭nāṃ sa̱hasra̭sya hi̱rāṇā̭m",
   "asthu̱rinma̭dhya̱mā i̱māḥ sā̱kamantā̭ araṃsata"
  ],
