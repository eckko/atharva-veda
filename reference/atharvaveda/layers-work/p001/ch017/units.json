 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "001.017.2a",
   "001.017.2b"
  ],
  "lines_deva": [
   "तिष्ठा॑वरे॒ तिष्ठ॑ पर उ॒त त्वं ति॑ष्ठ मध्यमे",
   "क॒नि॒ष्ठि॒का च॒ तिष्ठ॑ति॒ तिष्ठा॒दिद्ध॒मनि॑र्म॒ही"
  ],
  "lines_iast": [
   "tiṣṭhā̭vare̱ tiṣṭha̭ para u̱ta tvaṃ ti̭ṣṭha madhyame",
   "ka̱ni̱ṣṭhi̱kā ca̱ tiṣṭha̭ti̱ tiṣṭhā̱diddha̱mani̭rma̱hī"
  ],
