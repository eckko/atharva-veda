   "001.017.1a",
   "001.017.1b"
  ],
  "lines_deva": [
   "अ॒मूर्या यन्ति॑ यो॒षितो॑ हि॒रा लोहि॑तवाससः",
   "अ॒भ्रात॑र इव जा॒मय॒स्तिष्ठ॑न्तु ह॒तव॑र्चसः"
  ],
  "lines_iast": [
   "a̱mūryā yanti̭ yo̱ṣito̭ hi̱rā lohi̭tavāsasaḥ",
   "a̱bhrāta̭ra iva jā̱maya̱stiṣṭha̭ntu ha̱tava̭rcasaḥ"
  ],
