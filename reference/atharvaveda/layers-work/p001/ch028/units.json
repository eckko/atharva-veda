   "001.028.4b"
  ],
  "lines_deva": [
   "पु॒त्रम॑त्तु यातुधा॒नीः स्वसा॑रमु॒त न॒प्त्यऽम्",
   "अधा॑ मि॒थो वि॑के॒श्यो॒३वि घ्न॑तां यातुधा॒न्यो॒३वि तृ॑ह्यन्तामरा॒य्यः"
  ],
  "lines_iast": [
   "pu̱trama̭ttu yātudhā̱nīḥ svasā̭ramu̱ta na̱ptya'm",
   "adhā̭ mi̱tho vi̭ke̱śyo̱3vi ghna̭tāṃ yātudhā̱nyo̱3vi tṛ̭hyantāmarā̱yyaḥ"
  ],
