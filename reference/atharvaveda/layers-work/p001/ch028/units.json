  "lines_deva": [
   "उप॒ प्रागा॑द् दे॒वो अ॒ग्नी र॑क्षो॒हामी॑व॒चात॑नः",
   "दह॒न्नप॑ द्वया॒विनो॑ यातु॒धाना॑न् किमी॒दिनः॑"
  ],
  "lines_iast": [
   "upa̱ prāgā̭d de̱vo a̱gnī ra̭kṣo̱hāmī̭va̱cāta̭naḥ",
   "daha̱nnapa̭ dvayā̱vino̭ yātu̱dhānā̭n kimī̱dina̭ḥ"
  ],
