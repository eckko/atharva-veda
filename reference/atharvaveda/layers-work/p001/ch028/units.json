   "001.028.2b"
  ],
  "lines_deva": [
   "प्रति॑ दह यातु॒धाना॒न् प्रति॑ देव किमी॒दिनः॑",
   "प्र॒तीचीः॑ कृष्णवर्तने॒ सं द॑ह यातुधा॒न्यः"
  ],
  "lines_iast": [
   "prati̭ daha yātu̱dhānā̱n prati̭ deva kimī̱dina̭ḥ",
   "pra̱tīcī̭ḥ kṛṣṇavartane̱ saṃ da̭ha yātudhā̱nyaḥ"
  ],
