   "001.022.1b"
  ],
  "lines_deva": [
   "अनु॒ सूर्य॒मुद॑यतां हृद्दयो॒तो ह॑रि॒मा च॑ ते",
   "गो रोहि॑तस्य॒ वर्णे॑न॒ तेन॑ त्वा॒ परि॑ दध्मसि"
  ],
  "lines_iast": [
   "anu̱ sūrya̱muda̭yatāṃ hṛddayo̱to ha̭ri̱mā ca̭ te",
   "go rohi̭tasya̱ varṇḙna̱ tena̭ tvā̱ pari̭ dadhmasi"
  ],
