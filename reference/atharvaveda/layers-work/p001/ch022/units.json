   "001.022.3b"
  ],
  "lines_deva": [
   "या रोहि॑णीर्देव॒त्या॒३ गावो॒ या उ॒त रोहि॑णीः",
   "रू॒पंरू॑पं वयो॑वय॒स्ताभि॑ष्ट्वा॒ परि॑ दध्मसि"
  ],
  "lines_iast": [
   "yā rohi̭ṇīrdeva̱tyā̱3 gāvo̱ yā u̱ta rohi̭ṇīḥ",
   "rū̱paṃrṷ̄paṃ vayo̭vaya̱stābhi̭ṣṭvā̱ pari̭ dadhmasi"
  ],
