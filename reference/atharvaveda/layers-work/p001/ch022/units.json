   "001.022.2a",
   "001.022.2b"
  ],
  "lines_deva": [
   "परि॑ त्वा॒ रोहि॑तै॒र्वर्णै॑र्दीर्घायु॒त्वाय॑ दध्मसि",
   "यथा॒यम॑र॒पा अस॒दथो॒ अह॑रितो॒ भुव॑त्"
  ],
  "lines_iast": [
   "pari̭ tvā̱ rohi̭tai̱rvarṇai̭rdīrghāyu̱tvāya̭ dadhmasi",
   "yathā̱yama̭ra̱pā asa̱datho̱ aha̭rito̱ bhuva̭t"
  ],
