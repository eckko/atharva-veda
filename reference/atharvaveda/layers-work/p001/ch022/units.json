   "001.022.4a",
   "001.022.4b"
  ],
  "lines_deva": [
   "शुके॑षु ते हरि॒माणं॑ रोप॒णाका॑सु दध्मसि",
   "अथो॒ हारि॑द्रवेषु ते हरि॒माणं॒ नि द॑ध्मसि"
  ],
  "lines_iast": [
   "śukḙṣu te hari̱māṇa̭ṃ ropa̱ṇākā̭su dadhmasi",
   "atho̱ hāri̭draveṣu te hari̱māṇa̱ṃ ni da̭dhmasi"
  ],
