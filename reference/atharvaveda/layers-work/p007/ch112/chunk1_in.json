  "lines_deva": [
   "शुम्भ॑नी॒ द्यावा॑पृथि॒वी अन्ति॑सुम्ने॒ महि॑व्रते",
   "आपः॑ स॒प्त सु॑स्रुवुर्दे॒वीस्ता नो॑ मुञ्च॒न्त्वंह॑सः"
  ],
  "lines_iast": [
   "śumbha̭nī̱ dyāvā̭pṛthi̱vī anti̭sumne̱ mahi̭vrate",
   "āpa̭ḥ sa̱pta sṷsruvurde̱vīstā no̭ muñca̱ntvaṃha̭saḥ"
  ],
