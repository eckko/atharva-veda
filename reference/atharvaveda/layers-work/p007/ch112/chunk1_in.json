   "007.112.2b"
  ],
  "lines_deva": [
   "मु॒ञ्चन्तु॑ मा शप॒थ्या॒३दथो॑ वरु॒ण्याऽदु॒त",
   "अथो॑ य॒मस्य॒ पड्वी॑शा॒द् विश्व॑स्माद् देवकिल्बि॒षात्"
  ],
  "lines_iast": [
   "mu̱ñcantṷ mā śapa̱thyā̱3datho̭ varu̱ṇyā'du̱ta",
   "atho̭ ya̱masya̱ paḍvī̭śā̱d viśva̭smād devakilbi̱ṣāt"
  ],
