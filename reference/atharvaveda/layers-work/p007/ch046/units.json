  ],
  "lines_deva": [
   "सिनी॑वालि॒ पृथु॑ष्टुके॒ या दे॒वाना॒मसि॒ स्वसा॑",
   "जु॒षस्व॑ ह॒व्यमाहु॑तं प्र॒जां दे॑वि दिदिड्ढि नः"
  ],
  "lines_iast": [
   "sinī̭vāli̱ pṛthṷṣṭuke̱ yā de̱vānā̱masi̱ svasā̭",
   "ju̱ṣasva̭ ha̱vyamāhṷtaṃ pra̱jāṃ dḙvi didiḍḍhi naḥ"
  ],
