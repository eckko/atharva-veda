 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.046.2a",
   "007.046.2b"
  ],
  "lines_deva": [
   "या सु॑बा॒हुः स्व॑ङ्गु॒रिः सु॒षूमा॑ बहु॒सूव॑री",
   "तस्यै॑ वि॒श्पत्न्यै॑ ह॒विः सि॑नीवा॒ल्यै जु॑होतन"
  ],
  "lines_iast": [
   "yā sṷbā̱huḥ sva̭ṅgu̱riḥ su̱ṣūmā̭ bahu̱sūva̭rī",
   "tasyai̭ vi̱śpatnyai̭ ha̱viḥ si̭nīvā̱lyai jṷhotana"
  ],
