 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.046.3a",
   "007.046.3b"
  ],
  "lines_deva": [
   "या वि॒श्पत्नीन्द्र॒मसि॑ प्र॒तीची॑ स॒हस्र॑स्तुकाभि॒यन्ती॑ दे॒वी",
   "विष्णोः॑ पत्नि॒ तुभ्यं॑ रा॒ता ह॒वींषि॒ पतिं॑ देवि॒ राध॑से चोदयस्व"
  ],
  "lines_iast": [
   "yā vi̱śpatnīndra̱masi̭ pra̱tīcī̭ sa̱hasra̭stukābhi̱yantī̭ de̱vī",
   "viṣṇo̭ḥ patni̱ tubhya̭ṃ rā̱tā ha̱vīṃṣi̱ pati̭ṃ devi̱ rādha̭se codayasva"
  ],
