  "lines_deva": [
   "अ॒दन्ति॑ त्वा पि॒पीलि॑का॒ वि वृ॑श्चन्ति मयू॒र्यः",
   "सर्वे॑ भल ब्रवाथ॒ शार्को॑टमर॒सं वि॒षम्"
  ],
  "lines_iast": [
   "a̱danti̭ tvā pi̱pīli̭kā̱ vi vṛ̭ścanti mayū̱ryaḥ",
   "sarvḙ bhala bravātha̱ śārko̭ṭamara̱saṃ vi̱ṣam"
  ],
