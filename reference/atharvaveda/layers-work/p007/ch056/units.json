   "007.056.2b"
  ],
  "lines_deva": [
   "इ॒यं वी॒रुन्मधु॑जाता मधु॒श्चुन्म॑धु॒ला म॒धूः",
   "सा विह्रु॑तस्य भेष॒ज्यथो॑ मशक॒जम्भ॑नी"
  ],
  "lines_iast": [
   "i̱yaṃ vī̱runmadhṷjātā madhu̱ścunma̭dhu̱lā ma̱dhūḥ",
   "sā vihrṷtasya bheṣa̱jyatho̭ maśaka̱jambha̭nī"
  ],
