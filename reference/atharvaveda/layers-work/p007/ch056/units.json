  ],
  "lines_deva": [
   "तिर॑श्चिराजेरसि॒तात् पृदा॑कोः॒ परि॒ संभृ॑तम्",
   "तत् क॒ङ्कप॑र्वणो वि॒षमि॒यं वी॒रुद॑नीनशत्"
  ],
  "lines_iast": [
   "tira̭ścirājerasi̱tāt pṛdā̭ko̱ḥ pari̱ saṃbhṛ̭tam",
   "tat ka̱ṅkapa̭rvaṇo vi̱ṣami̱yaṃ vī̱ruda̭nīnaśat"
  ],
