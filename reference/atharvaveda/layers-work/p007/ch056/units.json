   "007.056.3b"
  ],
  "lines_deva": [
   "यतो॑ द॒ष्टं यतो॑ धी॒तं तत॑स्ते॒ निर्ह्व॑यामसि",
   "अ॒र्भस्य॑ तृप्रदं॒शिनो॑ म॒शक॑स्यार॒सं वि॒षम्"
  ],
  "lines_iast": [
   "yato̭ da̱ṣṭaṃ yato̭ dhī̱taṃ tata̭ste̱ nirhva̭yāmasi",
   "a̱rbhasya̭ tṛprada̱ṃśino̭ ma̱śaka̭syāra̱saṃ vi̱ṣam"
  ],
