   "007.056.6b"
  ],
  "lines_deva": [
   "न ते॑ बा॒ह्वोर्बल॑मस्ति॒ न शी॒र्षे नोत म॑ध्य॒तः",
   "अथ॒ किं पा॒पया॑मु॒या पुच्छे॑ बिभर्ष्यर्भ॒कम्"
  ],
  "lines_iast": [
   "na tḙ bā̱hvorbala̭masti̱ na śī̱rṣe nota ma̭dhya̱taḥ",
   "atha̱ kiṃ pā̱payā̭mu̱yā pucchḙ bibharṣyarbha̱kam"
  ],
