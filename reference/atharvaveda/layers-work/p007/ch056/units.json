   "007.056.4b"
  ],
  "lines_deva": [
   "अ॒यं यो व॒क्रो विप॑रु॒र्व्यऽङ्गो॒ मुखा॑नि व॒क्रा वृ॑जि॒ना कृ॒णोषि॑",
   "तानि॒ त्वं ब्र॑ह्मणस्पत इ॒षीका॑मिव॒ सं न॑मः"
  ],
  "lines_iast": [
   "a̱yaṃ yo va̱kro vipa̭ru̱rvya'ṅgo̱ mukhā̭ni va̱krā vṛ̭ji̱nā kṛ̱ṇoṣi̭",
   "tāni̱ tvaṃ bra̭hmaṇaspata i̱ṣīkā̭miva̱ saṃ na̭maḥ"
  ],
