 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.110.3a",
   "007.110.3b"
  ],
  "lines_deva": [
   "उप॑ त्वा दे॒वो अ॑ग्रमीच्चम॒सेन॒ बृह॒स्पतिः॑",
   "इन्द्र॑ गी॒र्भिर्न॒ आ वि॑श॒ यज॑मानाय सुन्व॒ते"
  ],
  "lines_iast": [
   "upa̭ tvā de̱vo a̭gramīccama̱sena̱ bṛha̱spati̭ḥ",
   "indra̭ gī̱rbhirna̱ ā vi̭śa̱ yaja̭mānāya sunva̱te"
  ],
