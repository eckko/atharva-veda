   "007.110.1b"
  ],
  "lines_deva": [
   "अग्न॒ इन्द्र॑श्च दा॒शुषे॑ ह॒तो वृ॒त्राण्य॑प्र॒ति",
   "उ॒भा हि वृ॑त्र॒हन्त॑मा"
  ],
  "lines_iast": [
   "agna̱ indra̭śca dā̱śuṣḙ ha̱to vṛ̱trāṇya̭pra̱ti",
   "u̱bhā hi vṛ̭tra̱hanta̭mā"
  ],
