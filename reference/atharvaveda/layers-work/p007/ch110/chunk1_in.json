 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.110.2a",
   "007.110.2b"
  ],
  "lines_deva": [
   "याभ्या॒मज॑य॒न्त्स्व॑१रग्र॑ ए॒व यावा॑त॒स्थतु॒र्भुव॑नानि॒ विश्वा॑",
   "प्रच॑र्षणी॒ वृष॑णा॒ वज्र॑बाहू अ॒ग्निमिन्द्रं॑ वृत्र॒हणा॑ हुवे॒ऽहम्"
  ],
  "lines_iast": [
   "yābhyā̱maja̭ya̱ntsva̭1ragra̭ e̱va yāvā̭ta̱sthatu̱rbhuva̭nāni̱ viśvā̭",
   "praca̭rṣaṇī̱ vṛṣa̭ṇā̱ vajra̭bāhū a̱gnimindra̭ṃ vṛtra̱haṇā̭ huve̱'ham"
  ],
