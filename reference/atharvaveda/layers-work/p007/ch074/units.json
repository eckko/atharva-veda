   "007.074.1b"
  ],
  "lines_deva": [
   "अ॒प॒चितां॒ लोहि॑नीनां कृ॒ष्णा मा॒तेति॑ शुश्रुम",
   "मुने॑र्दे॒वस्य॒ मूले॑न॒ सर्वा॑ विध्यामि॒ ता अ॒हम्"
  ],
  "lines_iast": [
   "a̱pa̱citā̱ṃ lohi̭nīnāṃ kṛ̱ṣṇā mā̱teti̭ śuśruma",
   "munḙrde̱vasya̱ mūlḙna̱ sarvā̭ vidhyāmi̱ tā a̱ham"
  ],
