 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.074.2a",
   "007.074.2b"
  ],
  "lines_deva": [
   "विध्या॑म्यासां प्रथ॒मां विध्या॑म्यु॒त म॑ध्य॒माम्",
   "इ॒दं ज॑घ॒न्याऽमासा॒मा च्छि॑नद्मि॒ स्तुका॑मिव"
  ],
  "lines_iast": [
   "vidhyā̭myāsāṃ pratha̱māṃ vidhyā̭myu̱ta ma̭dhya̱mām",
   "i̱daṃ ja̭gha̱nyā'māsā̱mā cchi̭nadmi̱ stukā̭miva"
  ],
