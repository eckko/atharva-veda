 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.074.4a",
   "007.074.4b"
  ],
  "lines_deva": [
   "व्र॒तेन॒ त्वं व्र॑तपते॒ सम॑क्तो वि॒श्वाहा॑ सु॒मना॑ दीदिही॒ह",
   "तं त्वा॑ व॒यं जा॑तवेदः॒ समि॑द्धं प्र॒जाव॑न्त॒ उप॑ सदेम॒ सर्वे॑"
  ],
  "lines_iast": [
   "vra̱tena̱ tvaṃ vra̭tapate̱ sama̭kto vi̱śvāhā̭ su̱manā̭ dīdihī̱ha",
   "taṃ tvā̭ va̱yaṃ jā̭taveda̱ḥ sami̭ddhaṃ pra̱jāva̭nta̱ upa̭ sadema̱ sarvḙ"
  ],
