 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.074.3a",
   "007.074.3b"
  ],
  "lines_deva": [
   "त्वा॒ष्ट्रेणा॒हं वच॑सा॒ वि त॑ ई॒र्ष्याम॑मीमदम्",
   "अथो॒ यो म॒न्युष्टे॑ पते॒ तमु॑ ते शमयामसि"
  ],
  "lines_iast": [
   "tvā̱ṣṭreṇā̱haṃ vaca̭sā̱ vi ta̭ ī̱rṣyāma̭mīmadam",
   "atho̱ yo ma̱nyuṣṭḙ pate̱ tamṷ te śamayāmasi"
  ],
