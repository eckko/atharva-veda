   "007.060.4b"
  ],
  "lines_deva": [
   "उप॑हूता॒ भूरि॑धनाः॒ सखा॑यः स्वा॒दुसं॑मुदः",
   "अ॒क्षु॒ध्या अ॑तृ॒ष्या स्त॒ गृहा॒ मास्मद् बि॑भीतन"
  ],
  "lines_iast": [
   "upa̭hūtā̱ bhūri̭dhanā̱ḥ sakhā̭yaḥ svā̱dusa̭ṃmudaḥ",
   "a̱kṣu̱dhyā a̭tṛ̱ṣyā sta̱ gṛhā̱ māsmad bi̭bhītana"
  ],
  "book_split": [
