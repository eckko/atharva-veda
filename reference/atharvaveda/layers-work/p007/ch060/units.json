   "007.060.3b"
  ],
  "lines_deva": [
   "येषा॑म॒ध्येति॑ प्र॒वस॒न् येषु॑ सौमन॒सो ब॒हुः",
   "गृ॒हानुप॑ ह्वयामहे॒ ते नो॑ जानन्त्वाय॒तः"
  ],
  "lines_iast": [
   "yeṣā̭ma̱dhyeti̭ pra̱vasa̱n yeṣṷ saumana̱so ba̱huḥ",
   "gṛ̱hānupa̭ hvayāmahe̱ te no̭ jānantvāya̱taḥ"
  ],
