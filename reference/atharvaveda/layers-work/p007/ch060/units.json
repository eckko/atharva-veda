 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.060.2a",
   "007.060.2b"
  ],
  "lines_deva": [
   "इ॒मे गृ॒हा म॑यो॒भुव॒ ऊर्ज॑स्वन्तः॒ पय॑स्वन्तः",
   "पू॒र्णा वा॒मेन॒ तिष्ठ॑न्त॒स्ते नो॑ जानन्त्वाय॒तः"
  ],
  "lines_iast": [
   "i̱me gṛ̱hā ma̭yo̱bhuva̱ ūrja̭svanta̱ḥ paya̭svantaḥ",
   "pū̱rṇā vā̱mena̱ tiṣṭha̭nta̱ste no̭ jānantvāya̱taḥ"
  ],
  "book_split": [
