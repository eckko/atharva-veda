   "007.060.6b"
  ],
  "lines_deva": [
   "सू॒नृता॑वन्तः सु॒भगा॒ इरा॑वन्तो हसामु॒दाः",
   "अ॒तृ॒ष्या अ॑क्षु॒ध्या स्त॒ गृहा॒ मास्मद् बि॑भीतन"
  ],
  "lines_iast": [
   "sū̱nṛtā̭vantaḥ su̱bhagā̱ irā̭vanto hasāmu̱dāḥ",
   "a̱tṛ̱ṣyā a̭kṣu̱dhyā sta̱ gṛhā̱ māsmad bi̭bhītana"
  ],
