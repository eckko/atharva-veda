   "007.060.5b"
  ],
  "lines_deva": [
   "उप॑हूता इ॒ह गाव॒ उप॑हूता अजा॒वयः॑",
   "अथो॒ अन्न॑स्य की॒लाल॒ उप॑हूतो गृ॒हेषु॑ नः"
  ],
  "lines_iast": [
   "upa̭hūtā i̱ha gāva̱ upa̭hūtā ajā̱vaya̭ḥ",
   "atho̱ anna̭sya kī̱lāla̱ upa̭hūto gṛ̱heṣṷ naḥ"
  ],
