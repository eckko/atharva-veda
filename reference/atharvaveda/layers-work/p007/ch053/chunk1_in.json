   "007.053.5b"
  ],
  "lines_deva": [
   "प्र वि॑शतं प्राणापानावन॒ड्वाहा॑विव व्र॒जम्",
   "अ॒यं ज॑रि॒म्णः शे॑व॒धिररि॑ष्ट इ॒ह व॑र्धताम्"
  ],
  "lines_iast": [
   "pra vi̭śataṃ prāṇāpānāvana̱ḍvāhā̭viva vra̱jam",
   "a̱yaṃ ja̭ri̱mṇaḥ śḙva̱dhirari̭ṣṭa i̱ha va̭rdhatām"
  ],
