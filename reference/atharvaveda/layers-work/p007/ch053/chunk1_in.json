  "lines_deva": [
   "उद् व॒यं तम॑स॒स्परि॒ रोह॑न्तो॒ नाक॑मुत्त॒मम्",
   "दे॒वं दे॑व॒त्रा सूर्य॒मग॑न्म॒ ज्योति॑रुत्त॒मम्"
  ],
  "lines_iast": [
   "ud va̱yaṃ tama̭sa̱spari̱ roha̭nto̱ nāka̭mutta̱mam",
   "de̱vaṃ dḙva̱trā sūrya̱maga̭nma̱ jyoti̭rutta̱mam"
  ],
