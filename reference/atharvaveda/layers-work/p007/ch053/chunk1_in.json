 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.053.2a",
   "007.053.2b"
  ],
  "lines_deva": [
   "सं क्रा॑मतं॒ मा ज॑हीतं॒ शरी॑रं प्राणापा॒नौ ते॑ स॒युजा॑वि॒ह स्ता॑म्",
   "श॒तं जी॑व श॒रदो॒ वर्ध॑मानो॒ऽग्निष्टे॑ गो॒पा अ॑धि॒पा वसि॑ष्ठः"
  ],
  "lines_iast": [
   "saṃ krā̭mata̱ṃ mā ja̭hīta̱ṃ śarī̭raṃ prāṇāpā̱nau tḙ sa̱yujā̭vi̱ha stā̭m",
   "śa̱taṃ jī̭va śa̱rado̱ vardha̭māno̱'gniṣṭḙ go̱pā a̭dhi̱pā vasi̭ṣṭhaḥ"
  ],
