 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.053.3a",
   "007.053.3b"
  ],
  "lines_deva": [
   "आयु॒र्यत् ते॒ अति॑हितं परा॒चैर॑पा॒नः प्रा॒णः पुन॒रा तावि॑ताम्",
   "अ॒ग्निष्टदाहा॒र्निरृ॑तेरु॒पस्था॒त् तदा॒त्मनि॒ पुन॒रा वे॑शयामि ते"
  ],
  "lines_iast": [
   "āyu̱ryat te̱ ati̭hitaṃ parā̱caira̭pā̱naḥ prā̱ṇaḥ puna̱rā tāvi̭tām",
   "a̱gniṣṭadāhā̱rnirṛ̭teru̱pasthā̱t tadā̱tmani̱ puna̱rā vḙśayāmi te"
  ],
  "book_split": [
