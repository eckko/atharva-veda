 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.053.4a",
   "007.053.4b"
  ],
  "lines_deva": [
   "मेमं प्रा॒णो हा॑सी॒न्मो अ॑पा॒नोऽव॒हाय॒ परा॑ गात्",
   "स॒प्त॒र्षिभ्य॑ एनं॒ परि॑ ददामि॒ त ए॑नं स्व॒स्ति ज॒रसे॑ वहन्तु"
  ],
  "lines_iast": [
   "memaṃ prā̱ṇo hā̭sī̱nmo a̭pā̱no'va̱hāya̱ parā̭ gāt",
   "sa̱pta̱rṣibhya̭ ena̱ṃ pari̭ dadāmi̱ ta ḙnaṃ sva̱sti ja̱rasḙ vahantu"
  ],
