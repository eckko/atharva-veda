   "007.053.1a",
   "007.053.1b"
  ],
  "lines_deva": [
   "अ॒मु॒त्र॒भूया॒दधि॒ यद् य॒मस्य॒ बृह॑स्पतेर॒भिश॑स्तेर॑मुञ्चः",
   "प्रत्यौ॑हताम॒श्विना॑ मृ॒त्युम॒स्मद् दे॒वाना॑मग्ने भि॒षजा॒ शची॑भिः"
  ],
  "lines_iast": [
   "a̱mu̱tra̱bhūyā̱dadhi̱ yad ya̱masya̱ bṛha̭spatera̱bhiśa̭stera̭muñcaḥ",
   "pratyaṷhatāma̱śvinā̭ mṛ̱tyuma̱smad de̱vānā̭magne bhi̱ṣajā̱ śacī̭bhiḥ"
  ],
