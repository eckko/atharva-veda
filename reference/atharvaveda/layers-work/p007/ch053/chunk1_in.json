   "007.053.6b"
  ],
  "lines_deva": [
   "आ ते॑ प्रा॒णं सु॑वामसि॒ परा॒ यक्ष्मं॑ सुवामि ते",
   "आयु॑र्नो वि॒श्वतो॑ दधद॒यम॒ग्निर्वरे॑ण्यः"
  ],
  "lines_iast": [
   "ā tḙ prā̱ṇaṃ sṷvāmasi̱ parā̱ yakṣma̭ṃ suvāmi te",
   "āyṷrno vi̱śvato̭ dadhada̱yama̱gnirvarḙṇyaḥ"
  ],
