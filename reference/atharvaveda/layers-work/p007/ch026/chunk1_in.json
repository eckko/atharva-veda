   "007.026.5b"
  ],
  "lines_deva": [
   "त्रीणि॑ प॒दा वि च॑क्रमे॒ विष्णु॑र्गो॒पा अदा॑भ्यः",
   "इ॒तो धर्मा॑णि धा॒रय॑न्"
  ],
  "lines_iast": [
   "trīṇi̭ pa̱dā vi ca̭krame̱ viṣṇṷrgo̱pā adā̭bhyaḥ",
   "i̱to dharmā̭ṇi dhā̱raya̭n"
  ],
