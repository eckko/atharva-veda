[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "007.026.1a",
   "007.026.1b"
  ],
  "lines_deva": [
   "विष्णो॒र्नु कं॒ प्रा वो॑चं वी॒र्याऽणि॒ यः पार्थि॑वानि विम॒मे रजां॑सि",
   "यो अस्क॑भाय॒दुत्त॑रं स॒धस्थं॑ विचक्रमा॒णस्त्रे॒धोरु॑गा॒यः"
  ],
  "lines_iast": [
   "viṣṇo̱rnu ka̱ṃ prā vo̭caṃ vī̱ryā'ṇi̱ yaḥ pārthi̭vāni vima̱me rajā̭ṃsi",
   "yo aska̭bhāya̱dutta̭raṃ sa̱dhastha̭ṃ vicakramā̱ṇastre̱dhorṷgā̱yaḥ"
  ],
  "book_split": [
