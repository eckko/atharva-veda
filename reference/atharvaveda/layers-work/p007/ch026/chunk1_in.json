 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.026.3a",
   "007.026.3b",
   "007.026.3c"
  ],
  "lines_deva": [
   "यस्यो॒रुषु॑ त्रि॒षु वि॒क्रम॑नेष्वधिक्षि॒यन्ति॒ भुव॑नानि॒ विश्वा॑",
   "उ॒रु वि॑ष्णो॒ वि क्र॑मस्वो॒रु क्षया॑य नस्कृधि",
   "घृ॒तं घृ॑तयोने पिब॒ प्रप्र॑ य॒ज्ञप॑तिं तिर"
  ],
  "lines_iast": [
   "yasyo̱ruṣṷ tri̱ṣu vi̱krama̭neṣvadhikṣi̱yanti̱ bhuva̭nāni̱ viśvā̭",
   "u̱ru vi̭ṣṇo̱ vi kra̭masvo̱ru kṣayā̭ya naskṛdhi",
   "ghṛ̱taṃ ghṛ̭tayone piba̱ prapra̭ ya̱jñapa̭tiṃ tira"
  ],
  "book_split": [
