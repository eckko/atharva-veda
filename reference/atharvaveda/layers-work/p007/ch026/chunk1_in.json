 {
  "n": "8",
  "type": "verse",
  "line_ids": [
   "007.026.8a",
   "007.026.8b"
  ],
  "lines_deva": [
   "दि॒वो वि॑ष्ण उ॒त वा॑ पृथि॒व्या म॒हो वि॑ष्ण उ॒रोर॒न्तरि॑क्षात्",
   "हस्तौ॑ पृणस्व ब॒हुभि॑र्व॒सव्यै॑रा॒प्रय॑च्छ॒ दक्षि॑णा॒दोत स॒व्यात्"
  ],
  "lines_iast": [
   "di̱vo vi̭ṣṇa u̱ta vā̭ pṛthi̱vyā ma̱ho vi̭ṣṇa u̱rora̱ntari̭kṣāt",
   "hastaṷ pṛṇasva ba̱hubhi̭rva̱savyai̭rā̱praya̭ccha̱ dakṣi̭ṇā̱dota sa̱vyāt"
  ],
