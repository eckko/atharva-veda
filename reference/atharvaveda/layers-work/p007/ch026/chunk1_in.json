  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.026.2a",
   "007.026.2b"
  ],
  "lines_deva": [
   "प्र तद् विष्णु॑ स्तवते वी॒र्याऽणि मृ॒गो न भी॒मः कु॑च॒रो गि॑रि॒ष्ठाः",
   "प॒रा॒वत॒ आ ज॑गम्या॒त् पर॑स्याः"
  ],
  "lines_iast": [
   "pra tad viṣṇṷ stavate vī̱ryā'ṇi mṛ̱go na bhī̱maḥ kṷca̱ro gi̭ri̱ṣṭhāḥ",
   "pa̱rā̱vata̱ ā ja̭gamyā̱t para̭syāḥ"
  ],
  "book_split": [
