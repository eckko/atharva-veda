 {
  "n": "7",
  "type": "verse",
  "line_ids": [
   "007.026.7a",
   "007.026.7b"
  ],
  "lines_deva": [
   "तद् विष्णोः॑ पर॒मं प॒दं सदा॑ पश्यन्ति सू॒रयः॑",
   "दि॒वीऽव॒ चक्षु॒रात॑तम्"
  ],
  "lines_iast": [
   "tad viṣṇo̭ḥ para̱maṃ pa̱daṃ sadā̭ paśyanti sū̱raya̭ḥ",
   "di̱vī'va̱ cakṣu̱rāta̭tam"
  ],
