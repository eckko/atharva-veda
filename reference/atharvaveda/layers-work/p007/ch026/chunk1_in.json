 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.026.4a",
   "007.026.4b"
  ],
  "lines_deva": [
   "इ॒दं विष्णु॒र्वि च॑क्रमे त्रे॒धा नि द॑धे प॒दा",
   "समू॑ढमस्य पांसु॒रे"
  ],
  "lines_iast": [
   "i̱daṃ viṣṇu̱rvi ca̭krame tre̱dhā ni da̭dhe pa̱dā",
   "samṷ̄ḍhamasya pāṃsu̱re"
  ],
  "book_split": [
