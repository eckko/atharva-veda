   "007.026.6b"
  ],
  "lines_deva": [
   "विष्णोः॒ कर्मा॑णि पश्यत॒ यतो॑ व्र॒तानि॑ पस्प॒शे",
   "इन्द्र॑स्य॒ युज्यः॒ सखा॑"
  ],
  "lines_iast": [
   "viṣṇo̱ḥ karmā̭ṇi paśyata̱ yato̭ vra̱tāni̭ paspa̱śe",
   "indra̭sya̱ yujya̱ḥ sakhā̭"
  ],
