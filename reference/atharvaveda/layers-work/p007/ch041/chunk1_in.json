 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.041.2a",
   "007.041.2b"
  ],
  "lines_deva": [
   "श्ये॒नो नृ॒चक्षा॑ दि॒व्यः सु॑प॒र्णः स॒हस्र॑पाच्छ॒तयो॑निर्वयो॒धाः",
   "स नो॒ नि य॑च्छाद् वसु॒ यत् परा॑भृतम॒स्माक॑मस्तु पि॒तृषु॑ स्व॒धाव॑त्"
  ],
  "lines_iast": [
   "śye̱no nṛ̱cakṣā̭ di̱vyaḥ sṷpa̱rṇaḥ sa̱hasra̭pāccha̱tayo̭nirvayo̱dhāḥ",
   "sa no̱ ni ya̭cchād vasu̱ yat parā̭bhṛtama̱smāka̭mastu pi̱tṛṣṷ sva̱dhāva̭t"
  ],
