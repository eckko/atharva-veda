   "007.041.1b"
  ],
  "lines_deva": [
   "अति॒ धन्वा॒न्यत्य॒पस्त॑तर्द श्ये॒नो नृ॒चक्षा॑ अवसानद॒र्शः",
   "तर॒न् विश्वा॒न्यव॑रा॒ रजां॒सीन्द्रे॑ण॒ सख्या॑ शि॒व आ ज॑गम्यात्"
  ],
  "lines_iast": [
   "ati̱ dhanvā̱nyatya̱pasta̭tarda śye̱no nṛ̱cakṣā̭ avasānada̱rśaḥ",
   "tara̱n viśvā̱nyava̭rā̱ rajā̱ṃsīndrḙṇa̱ sakhyā̭ śi̱va ā ja̭gamyāt"
  ],
