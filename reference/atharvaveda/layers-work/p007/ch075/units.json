   "007.075.2a",
   "007.075.2b",
   "007.075.2c"
  ],
  "lines_deva": [
   "प॒द॒ज्ञा स्थ॒ रम॑तयः॒ संहि॑ता वि॒श्वना॑म्नीः",
   "उप॑ मा देवीर्दे॒वेभि॒रेत॑",
   "इ॒मं गो॒ष्ठमि॒दं सदो॑ घृ॒तेना॒स्मान्त्समु॑क्षत"
  ],
  "lines_iast": [
   "pa̱da̱jñā stha̱ rama̭taya̱ḥ saṃhi̭tā vi̱śvanā̭mnīḥ",
   "upa̭ mā devīrde̱vebhi̱reta̭",
   "i̱maṃ go̱ṣṭhami̱daṃ sado̭ ghṛ̱tenā̱smāntsamṷkṣata"
  ],
