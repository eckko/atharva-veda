   "007.075.1b"
  ],
  "lines_deva": [
   "प्र॒जाव॑तीः सू॒यव॑से रु॒शन्तीः॑ शु॒द्धा अ॒पः सु॑प्रपा॒णे पिब॑न्तीः",
   "मा व॑ स्ते॒न ई॑शत॒ माघशं॑सः॒ परि॑ वो रु॒द्रस्य॑ हे॒तिर्वृ॑णक्तु"
  ],
  "lines_iast": [
   "pra̱jāva̭tīḥ sū̱yava̭se ru̱śantī̭ḥ śu̱ddhā a̱paḥ sṷprapā̱ṇe piba̭ntīḥ",
   "mā va̭ ste̱na ī̭śata̱ māghaśa̭ṃsa̱ḥ pari̭ vo ru̱drasya̭ he̱tirvṛ̭ṇaktu"
  ],
