   "007.095.3b"
  ],
  "lines_deva": [
   "आ॒तो॒दिनौ॑ नितो॒दिना॒वथो॑ संतो॒दिना॑वु॒त",
   "अपि॑ नह्याम्यस्य॒ मेढ्रं॒ य इ॒तः स्त्री पुमा॑न् ज॒भार॑"
  ],
  "lines_iast": [
   "ā̱to̱dinaṷ nito̱dinā̱vatho̭ saṃto̱dinā̭vu̱ta",
   "api̭ nahyāmyasya̱ meḍhra̱ṃ ya i̱taḥ strī pumā̭n ja̱bhāra̭"
  ],
