   "007.095.2b"
  ],
  "lines_deva": [
   "अ॒हमे॑ना॒वुद॑तिष्ठिपं॑ गावौ॑ श्रान्त॒सदा॑विव",
   "कु॒र्कु॒रावि॑व॒ कूज॑न्तावु॒दव॑न्तौ॒ वृका॑विव"
  ],
  "lines_iast": [
   "a̱hamḙnā̱vuda̭tiṣṭhipa̭ṃ gāvaṷ śrānta̱sadā̭viva",
   "ku̱rku̱rāvi̭va̱ kūja̭ntāvu̱dava̭ntau̱ vṛkā̭viva"
  ],
