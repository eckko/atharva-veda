   "007.095.1b"
  ],
  "lines_deva": [
   "उद॑स्य श्या॒वौ वि॑थु॒रौ गृध्रौ॒ द्यामि॑व पेततुः",
   "उ॒च्छो॒च॒न॒प्र॒शो॒च॒नाव॒स्योच्छोच॑नौ हृ॒दः"
  ],
  "lines_iast": [
   "uda̭sya śyā̱vau vi̭thu̱rau gṛdhrau̱ dyāmi̭va petatuḥ",
   "u̱ccho̱ca̱na̱pra̱śo̱ca̱nāva̱syocchoca̭nau hṛ̱daḥ"
  ],
