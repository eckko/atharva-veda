 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.017.4a",
   "007.017.4b"
  ],
  "lines_deva": [
   "धा॒ता रा॒तिः स॑वि॒तेदं जु॑षन्तां प्र॒जाप॑तिर्नि॒धिप॑तिर्नो अ॒ग्निः",
   "त्वष्टा॒ विष्णुः॑ प्र॒जया॑ संररा॒णो यज॑मानाय॒ द्रवि॑णं दधातु"
  ],
  "lines_iast": [
   "dhā̱tā rā̱tiḥ sa̭vi̱tedaṃ jṷṣantāṃ pra̱jāpa̭tirni̱dhipa̭tirno a̱gniḥ",
   "tvaṣṭā̱ viṣṇṷḥ pra̱jayā̭ saṃrarā̱ṇo yaja̭mānāya̱ dravi̭ṇaṃ dadhātu"
  ],
