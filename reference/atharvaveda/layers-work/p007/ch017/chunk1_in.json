   "007.017.2b"
  ],
  "lines_deva": [
   "धा॒ता द॑धातु दा॒शुषे॒ प्राचीं॑ जी॒वातु॒क्षि॑ताम्",
   "व॒यं दे॒वस्य॑ धीमहि सुम॒तिं वि॒श्वरा॑धसः"
  ],
  "lines_iast": [
   "dhā̱tā da̭dhātu dā̱śuṣe̱ prācī̭ṃ jī̱vātu̱kṣi̭tām",
   "va̱yaṃ de̱vasya̭ dhīmahi suma̱tiṃ vi̱śvarā̭dhasaḥ"
  ],
