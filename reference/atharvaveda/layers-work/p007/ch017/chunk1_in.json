 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.017.3a",
   "007.017.3b"
  ],
  "lines_deva": [
   "धा॒ता विश्वा॒ वार्या॑ दधातु प्र॒जाका॑माय दा॒शुषे॑ दुरो॒णे",
   "तस्मै॑ दे॒वाअ॒मृतं॒ सं व्य॑यन्तु॒ विश्वे॑ दे॒वा अदि॑तिः स॒जोषाः॑"
  ],
  "lines_iast": [
   "dhā̱tā viśvā̱ vāryā̭ dadhātu pra̱jākā̭māya dā̱śuṣḙ duro̱ṇe",
   "tasmai̭ de̱vāa̱mṛta̱ṃ saṃ vya̭yantu̱ viśvḙ de̱vā adi̭tiḥ sa̱joṣā̭ḥ"
  ],
