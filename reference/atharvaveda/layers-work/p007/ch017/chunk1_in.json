   "007.017.1a",
   "007.017.1b"
  ],
  "lines_deva": [
   "धा॒ता द॑धातु नो र॒यिमीशा॑नो॒ जग॑त॒स्पतिः॑",
   "स नः॑ पू॒र्णेन॑ यच्छतु"
  ],
  "lines_iast": [
   "dhā̱tā da̭dhātu no ra̱yimīśā̭no̱ jaga̭ta̱spati̭ḥ",
   "sa na̭ḥ pū̱rṇena̭ yacchatu"
  ],
