 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.090.3a",
   "007.090.3b",
   "007.090.3c"
  ],
  "lines_deva": [
   "यथा॒ शेपो॑ अ॒पाया॑तै स्त्री॒षु चास॒दना॑वयाः",
   "अ॒व॒स्थस्य॑ क्न॒दीव॑तः शाङ्-कु॒रस्य॑ नितो॒दिनः॑",
   "यदात॑त॒मव॒ तत् त॑नु॒ यदुत्त॑तं॒ नि तत् त॑नु"
  ],
  "lines_iast": [
   "yathā̱ śepo̭ a̱pāyā̭tai strī̱ṣu cāsa̱danā̭vayāḥ",
   "a̱va̱sthasya̭ kna̱dīva̭taḥ śāṅ-ku̱rasya̭ nito̱dina̭ḥ",
   "yadāta̭ta̱mava̱ tat ta̭nu̱ yadutta̭ta̱ṃ ni tat ta̭nu"
  ],
