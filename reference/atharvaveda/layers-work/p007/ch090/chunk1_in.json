  "lines_deva": [
   "अपि॑ वृश्च पुराण॒वद् व्र॒तते॑रिव गुष्पि॒तम्",
   "ओजो॑ दा॒स्यस्य॑ दम्भय"
  ],
  "lines_iast": [
   "api̭ vṛśca purāṇa̱vad vra̱tatḙriva guṣpi̱tam",
   "ojo̭ dā̱syasya̭ dambhaya"
  ],
