 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.090.2a",
   "007.090.2b"
  ],
  "lines_deva": [
   "व॒यं तद॑स्य॒ सम्भृ॑तं॒ वस्विन्द्रे॑ण॒ वि भ॑जामहै",
   "म्ला॒पया॑मि भ्र॒जः शि॒भ्रं वरु॑णस्य व्र॒तेन॑ ते"
  ],
  "lines_iast": [
   "va̱yaṃ tada̭sya̱ sambhṛ̭ta̱ṃ vasvindrḙṇa̱ vi bha̭jāmahai",
   "mlā̱payā̭mi bhra̱jaḥ śi̱bhraṃ varṷṇasya vra̱tena̭ te"
  ],
