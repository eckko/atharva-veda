  "lines_deva": [
   "प्र॒ती॒चीन॑फलो॒ हि त्वमपा॑मार्ग रु॒रोहि॑थ",
   "सर्वा॒न् मच्छ॒पथाँ अधि॒ वरी॑यो यावया इ॒तः"
  ],
  "lines_iast": [
   "pra̱tī̱cīna̭phalo̱ hi tvamapā̭mārga ru̱rohi̭tha",
   "sarvā̱n maccha̱pathā~ adhi̱ varī̭yo yāvayā i̱taḥ"
  ],
