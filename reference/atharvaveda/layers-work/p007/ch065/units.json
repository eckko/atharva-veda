 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.065.3a",
   "007.065.3b"
  ],
  "lines_deva": [
   "श्या॒वद॑ता कुन॒खिना॑ ब॒ण्डेन॒ यत् स॒हासि॒म",
   "अपा॑मार्ग॒ त्वया॑ व॒यं सर्वं॒ तदप॑ मृज्महे"
  ],
  "lines_iast": [
   "śyā̱vada̭tā kuna̱khinā̭ ba̱ṇḍena̱ yat sa̱hāsi̱ma",
   "apā̭mārga̱ tvayā̭ va̱yaṃ sarva̱ṃ tadapa̭ mṛjmahe"
  ],
