   "007.065.2b"
  ],
  "lines_deva": [
   "यद् दु॑ष्कृ॒तं यच्छम॑लं॒ यद् वा चेरि॒म पा॒पया॑",
   "त्वया॒ तद् वि॑श्वतोमु॒खापा॑मा॒र्गाप॑ मृज्महे"
  ],
  "lines_iast": [
   "yad dṷṣkṛ̱taṃ yacchama̭la̱ṃ yad vā ceri̱ma pā̱payā̭",
   "tvayā̱ tad vi̭śvatomu̱khāpā̭mā̱rgāpa̭ mṛjmahe"
  ],
