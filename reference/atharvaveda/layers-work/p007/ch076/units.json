 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.076.4a",
   "007.076.4b"
  ],
  "lines_deva": [
   "प॒क्षी जा॒यान्यः॑ पतति॒ स आ वि॑शति॒ पूरु॑षम्",
   "तदक्षि॑तस्य भेष॒जमु॒भयोः॒ सुक्ष॑तस्य च"
  ],
  "lines_iast": [
   "pa̱kṣī jā̱yānya̭ḥ patati̱ sa ā vi̭śati̱ pūrṷṣam",
   "tadakṣi̭tasya bheṣa̱jamu̱bhayo̱ḥ sukṣa̭tasya ca"
  ],
