   "007.076.2b"
  ],
  "lines_deva": [
   "या ग्रैव्या॑ अप॒चितोऽथो॒ या उ॑पप॒क्ष्याः",
   "वि॒जाम्नि॒ या अ॑प॒चितः॑ स्वयं॒स्रसः॑"
  ],
  "lines_iast": [
   "yā graivyā̭ apa̱cito'tho̱ yā ṷpapa̱kṣyāḥ",
   "vi̱jāmni̱ yā a̭pa̱cita̭ḥ svaya̱ṃsrasa̭ḥ"
  ],
