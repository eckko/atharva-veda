   "007.076.6a",
   "007.076.6b"
  ],
  "lines_deva": [
   "धृ॒षत् पि॑ब क॒लशे॒ सोम॑मिन्द्र वृत्र॒हा शू॑र सम॒रे वसू॑नाम्",
   "माध्य॑न्दिने॒ सव॑न॒ आ वृ॑षस्व रयि॒ष्ठानो॑ र॒यिम॒स्मासु॑ धेहि"
  ],
  "lines_iast": [
   "dhṛ̱ṣat pi̭ba ka̱laśe̱ soma̭mindra vṛtra̱hā śṷ̄ra sama̱re vasṷ̄nām",
   "mādhya̭ndine̱ sava̭na̱ ā vṛ̭ṣasva rayi̱ṣṭhāno̭ ra̱yima̱smāsṷ dhehi"
  ],
