   "007.076.1b"
  ],
  "lines_deva": [
   "आ सु॒स्रसः॑ सु॒स्रसो॒ अस॑तीभ्यो॒ अस॑त्तराः",
   "से हो॑रर॒सत॑रा लव॒णाद् विक्ले॑दीयसीः"
  ],
  "lines_iast": [
   "ā su̱srasa̭ḥ su̱sraso̱ asa̭tībhyo̱ asa̭ttarāḥ",
   "se ho̭rara̱sata̭rā lava̱ṇād viklḙdīyasīḥ"
  ],
