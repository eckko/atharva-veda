 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "007.076.5a",
   "007.076.5b"
  ],
  "lines_deva": [
   "वि॒द्म वै ते॑ जायान्य॒ जानं॒ यतो॑ जायान्य॒ जाय॑से",
   "क॒थं ह॒ तत्र॒ त्वं ह॑नो॒ यस्य॑ कृ॒ण्मो ह॒विर्गृ॒हे"
  ],
  "lines_iast": [
   "vi̱dma vai tḙ jāyānya̱ jāna̱ṃ yato̭ jāyānya̱ jāya̭se",
   "ka̱thaṃ ha̱ tatra̱ tvaṃ ha̭no̱ yasya̭ kṛ̱ṇmo ha̱virgṛ̱he"
  ],
