 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.076.3a",
   "007.076.3b"
  ],
  "lines_deva": [
   "यः कीक॑साः प्रशृ॒णाति॑ तली॒द्यऽमव॒तिष्ठ॑ति",
   "निर्हा॒स्तं सर्वं॑ जा॒यान्यं॒ यः कश्च॑ क॒कुदि॑ श्रि॒तः"
  ],
  "lines_iast": [
   "yaḥ kīka̭sāḥ praśṛ̱ṇāti̭ talī̱dya'mava̱tiṣṭha̭ti",
   "nirhā̱staṃ sarva̭ṃ jā̱yānya̱ṃ yaḥ kaśca̭ ka̱kudi̭ śri̱taḥ"
  ],
  "book_split": [
