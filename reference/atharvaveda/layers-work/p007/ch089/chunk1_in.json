   "007.089.3a",
   "007.089.3b"
  ],
  "lines_deva": [
   "इ॒दमा॑पः॒ प्र व॑हताव॒द्यं च॒ मलं॑ च॒ यत्",
   "यच्चा॑भिदु॒द्रोहानृ॑तं॒ यच्च॑ शे॒पे अ॒भीरु॑णम्"
  ],
  "lines_iast": [
   "i̱damā̭pa̱ḥ pra va̭hatāva̱dyaṃ ca̱ mala̭ṃ ca̱ yat",
   "yaccā̭bhidu̱drohānṛ̭ta̱ṃ yacca̭ śe̱pe a̱bhīrṷṇam"
  ],
