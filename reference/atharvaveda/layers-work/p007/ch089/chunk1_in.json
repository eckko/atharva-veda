  "lines_deva": [
   "एधो॑ऽस्येधिषी॒य स॒मिद॑सि॒ समे॑धिषीय",
   "तेजो॑ऽसि॒ तेजो॒ मयि॑ धेहि"
  ],
  "lines_iast": [
   "edho̭'syedhiṣī̱ya sa̱mida̭si̱ samḙdhiṣīya",
   "tejo̭'si̱ tejo̱ mayi̭ dhehi"
  ],
