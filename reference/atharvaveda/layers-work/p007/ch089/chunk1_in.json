   "007.089.1a",
   "007.089.1b"
  ],
  "lines_deva": [
   "अ॒पो दि॒व्या अ॑चायिषं॒ रसे॑न॒ सम॑पृक्ष्महि",
   "पय॑स्वानग्न॒ आग॑मं॒ तं मा॒ सं सृ॑ज॒ वर्च॑सा"
  ],
  "lines_iast": [
   "a̱po di̱vyā a̭cāyiṣa̱ṃ rasḙna̱ sama̭pṛkṣmahi",
   "paya̭svānagna̱ āga̭ma̱ṃ taṃ mā̱ saṃ sṛ̭ja̱ varca̭sā"
  ],
  "book_split": [
