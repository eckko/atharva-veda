  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.089.2a",
   "007.089.2b"
  ],
  "lines_deva": [
   "सं मा॑ग्ने॒ वर्च॑सा सृज॒ सं प्र॒जया॒ समायु॑षा",
   "वि॒द्युर्मे॑ अ॒स्य दे॒वा इन्द्रो॑ विद्यात् सह ऋषि॑भिः"
  ],
  "lines_iast": [
   "saṃ mā̭gne̱ varca̭sā sṛja̱ saṃ pra̱jayā̱ samāyṷṣā",
   "vi̱dyurmḙ a̱sya de̱vā indro̭ vidyāt saha ṛṣi̭bhiḥ"
  ],
