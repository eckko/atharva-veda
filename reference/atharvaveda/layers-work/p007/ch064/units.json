 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.064.2a",
   "007.064.2b"
  ],
  "lines_deva": [
   "इ॒दं यत् कृ॒ष्णः श॒कुनि॑र॒वामृ॑क्षन्निरृते ते॒ मुखे॑न",
   "अ॒ग्निर्मा॒ तस्मा॒देन॑सो॒ गार्ह॑पत्यः॒ प्र मु॑ञ्चतु"
  ],
  "lines_iast": [
   "i̱daṃ yat kṛ̱ṣṇaḥ śa̱kuni̭ra̱vāmṛ̭kṣannirṛte te̱ mukhḙna",
   "a̱gnirmā̱ tasmā̱dena̭so̱ gārha̭patya̱ḥ pra mṷñcatu"
  ],
