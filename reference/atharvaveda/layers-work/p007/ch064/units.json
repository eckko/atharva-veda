  "lines_deva": [
   "इ॒दं यत् कृ॒ष्णः श॒कुनि॑रभिनि॒ष्पत॒न्नपी॑पतत्",
   "आपो॑ मा॒ तस्मा॒त् सर्व॑स्माद् दुरि॒तात् पा॒न्त्वंह॑सः"
  ],
  "lines_iast": [
   "i̱daṃ yat kṛ̱ṣṇaḥ śa̱kuni̭rabhini̱ṣpata̱nnapī̭patat",
   "āpo̭ mā̱ tasmā̱t sarva̭smād duri̱tāt pā̱ntvaṃha̭saḥ"
  ],
