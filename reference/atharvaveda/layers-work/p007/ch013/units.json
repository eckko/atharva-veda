  "lines_deva": [
   "यथा॒ सूर्यो॒ नक्ष॑त्राणामु॒द्यंस्तेजां॑स्याद॒दे",
   "ए॒वा स्त्री॒णां च॑ पुं॒सां च॑ द्विष॒तां वर्च॒ आ द॑दे"
  ],
  "lines_iast": [
   "yathā̱ sūryo̱ nakṣa̭trāṇāmu̱dyaṃstejā̭ṃsyāda̱de",
   "e̱vā strī̱ṇāṃ ca̭ pu̱ṃsāṃ ca̭ dviṣa̱tāṃ varca̱ ā da̭de"
  ],
