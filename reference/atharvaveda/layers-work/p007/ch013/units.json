   "007.013.2b"
  ],
  "lines_deva": [
   "याव॑न्तो मा स॒पत्ना॑नामा॒यन्तं॑ प्रति॒पश्य॑थ",
   "उ॒द्यन्त्सूर्य॑ इव सु॒प्तानां॑ द्विष॒तां वर्च॒ आ द॑दे"
  ],
  "lines_iast": [
   "yāva̭nto mā sa̱patnā̭nāmā̱yanta̭ṃ prati̱paśya̭tha",
   "u̱dyantsūrya̭ iva su̱ptānā̭ṃ dviṣa̱tāṃ varca̱ ā da̭de"
  ],
