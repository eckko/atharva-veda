   "007.014.1a",
   "007.014.1b"
  ],
  "lines_deva": [
   "अ॒भि त्यं दे॒वं स॑वि॒तार॑मो॒ण्योः क॒विक्र॑तुम्",
   "अर्चा॑मि स॒त्यस॑वं रत्न॒धाम॒भि प्रि॒यं म॒तिम्"
  ],
  "lines_iast": [
   "a̱bhi tyaṃ de̱vaṃ sa̭vi̱tāra̭mo̱ṇyoḥ ka̱vikra̭tum",
   "arcā̭mi sa̱tyasa̭vaṃ ratna̱dhāma̱bhi pri̱yaṃ ma̱tim"
  ],
