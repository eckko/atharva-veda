 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.014.2a",
   "007.014.2b"
  ],
  "lines_deva": [
   "उ॒र्ध्वा यस्या॒मति॒र्भा अदि॑द्युत॒त् सवी॑मनि",
   "हिर॑ण्यपाणिरमिमीत सु॒क्रतुः॑ कृ॒पात् स्वः"
  ],
  "lines_iast": [
   "u̱rdhvā yasyā̱mati̱rbhā adi̭dyuta̱t savī̭mani",
   "hira̭ṇyapāṇiramimīta su̱kratṷḥ kṛ̱pāt svaḥ"
  ],
