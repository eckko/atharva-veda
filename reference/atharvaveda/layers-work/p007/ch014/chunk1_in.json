 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.014.4a",
   "007.014.4b"
  ],
  "lines_deva": [
   "दमू॑ना दे॒वः स॑वि॒ता वरे॑ण्यो॒ दध॒द् रत्नं॒ दक्षं पि॒तृभ्य॒ आयूं॑षि",
   "पिबा॒त् सोमं॑ म॒मद॑देनमि॒ष्टे परि॑ज्मा चित् क्रमते अस्य॒ धर्म॑णि"
  ],
  "lines_iast": [
   "damṷ̄nā de̱vaḥ sa̭vi̱tā varḙṇyo̱ dadha̱d ratna̱ṃ dakṣaṃ pi̱tṛbhya̱ āyṷ̄ṃṣi",
   "pibā̱t soma̭ṃ ma̱mada̭denami̱ṣṭe pari̭jmā cit kramate asya̱ dharma̭ṇi"
  ],
