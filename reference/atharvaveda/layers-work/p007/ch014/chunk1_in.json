 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.014.3a",
   "007.014.3b"
  ],
  "lines_deva": [
   "सावी॒र्हि दे॑व प्रथ॒माय॑ पि॒त्रे व॒र्ष्माण॑मस्मै वरि॒माण॑मस्मै",
   "अथा॒स्मभ्यं॑ सवित॒र्वार्या॑णि दि॒वोदि॑व॒ आ सु॑वा॒ भूरि॑ प॒श्वः"
  ],
  "lines_iast": [
   "sāvī̱rhi dḙva pratha̱māya̭ pi̱tre va̱rṣmāṇa̭masmai vari̱māṇa̭masmai",
   "athā̱smabhya̭ṃ savita̱rvāryā̭ṇi di̱vodi̭va̱ ā sṷvā̱ bhūri̭ pa̱śvaḥ"
  ],
