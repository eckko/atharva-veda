 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "007.038.3a",
   "007.038.3b"
  ],
  "lines_deva": [
   "प्र॒तीची॒ सोम॑मसि प्र॒तीच्यु॒त सूर्य॑म्",
   "प्र॒तीची॒ विश्वा॑न् दे॒वान् तां त्वा॒च्छाव॑दामसि"
  ],
  "lines_iast": [
   "pra̱tīcī̱ soma̭masi pra̱tīcyu̱ta sūrya̭m",
   "pra̱tīcī̱ viśvā̭n de̱vān tāṃ tvā̱cchāva̭dāmasi"
  ],
  "book_split": [
