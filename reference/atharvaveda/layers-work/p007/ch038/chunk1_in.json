  "line_ids": [
   "007.038.1a",
   "007.038.1b"
  ],
  "lines_deva": [
   "इ॒दं ख॑नामि भेष॒जं मां॑प॒श्यम॑भिरोरु॒दम्",
   "प॒रा॒य॒तो नि॒वर्त॑नमाय॒तः प्र॑ति॒नन्द॑नम्"
  ],
  "lines_iast": [
   "i̱daṃ kha̭nāmi bheṣa̱jaṃ mā̭ṃpa̱śyama̭bhiroru̱dam",
   "pa̱rā̱ya̱to ni̱varta̭namāya̱taḥ pra̭ti̱nanda̭nam"
  ],
  "book_split": [
