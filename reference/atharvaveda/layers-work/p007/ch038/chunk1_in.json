   "007.038.5b"
  ],
  "lines_deva": [
   "यदि॒ वासि॑ तिरोज॒नं यदि॑ वा न॒द्यऽस्ति॒रः",
   "इ॒यं ह॒ मह्यं॒ त्वामोष॑धिर्ब॒द्ध्वेव॒ न्यान॑यत्"
  ],
  "lines_iast": [
   "yadi̱ vāsi̭ tiroja̱naṃ yadi̭ vā na̱dya'sti̱raḥ",
   "i̱yaṃ ha̱ mahya̱ṃ tvāmoṣa̭dhirba̱ddhveva̱ nyāna̭yat"
  ],
