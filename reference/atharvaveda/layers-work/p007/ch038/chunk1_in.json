  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.038.2a",
   "007.038.2b"
  ],
  "lines_deva": [
   "येना॑ निच॒क्र आ॑सु॒रीन्द्रं॑ दे॒वेभ्य॒स्परि॑",
   "तेना॒ नि कु॑र्वे॒ त्वाम॒हं यथा॒ तेऽसा॑नि॒ सुप्रि॑या"
  ],
  "lines_iast": [
   "yenā̭ nica̱kra ā̭su̱rīndra̭ṃ de̱vebhya̱spari̭",
   "tenā̱ ni kṷrve̱ tvāma̱haṃ yathā̱ te'sā̭ni̱ supri̭yā"
  ],
  "book_split": [
