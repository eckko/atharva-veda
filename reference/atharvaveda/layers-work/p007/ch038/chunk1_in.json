 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "007.038.4a",
   "007.038.4b"
  ],
  "lines_deva": [
   "अ॒हं व॑दामि॒ नेत् त्वं स॒भाया॒मह॒ त्वं वद॑",
   "ममेदस॒स्त्वं केव॑लो॒ नान्यासां॑ की॒र्तया॑श्च॒न"
  ],
  "lines_iast": [
   "a̱haṃ va̭dāmi̱ net tvaṃ sa̱bhāyā̱maha̱ tvaṃ vada̭",
   "mamedasa̱stvaṃ keva̭lo̱ nānyāsā̭ṃ kī̱rtayā̭śca̱na"
  ],
