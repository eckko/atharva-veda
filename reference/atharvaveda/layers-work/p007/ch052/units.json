  "lines_deva": [
   "सं॒ज्ञानं॑ नः॒ स्वेभिः॑ सं॒ज्ञान॒मर॑णेभिः",
   "सं॒ज्ञान॑मश्विना यु॒वमि॒हास्मासु॒ नि य॑च्छतम्"
  ],
  "lines_iast": [
   "sa̱ṃjñāna̭ṃ na̱ḥ svebhi̭ḥ sa̱ṃjñāna̱mara̭ṇebhiḥ",
   "sa̱ṃjñāna̭maśvinā yu̱vami̱hāsmāsu̱ ni ya̭cchatam"
  ],
