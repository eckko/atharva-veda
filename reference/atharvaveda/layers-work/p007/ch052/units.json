 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "007.052.2a",
   "007.052.2b"
  ],
  "lines_deva": [
   "सं जा॑नामहै॒ मन॑सा॒ सं चि॑कि॒त्वा मा यु॑ष्महि॒ मन॑सा॒ दैव्ये॑न",
   "मा घोषा॒ उत् स्थु॑र्बहु॒ले वि॒निर्ह॑ते॒ मेषुः॑ पप्त॒दिन्द्र॒स्याह॒न्याग॑ते"
  ],
  "lines_iast": [
   "saṃ jā̭nāmahai̱ mana̭sā̱ saṃ ci̭ki̱tvā mā yṷṣmahi̱ mana̭sā̱ daivyḙna",
   "mā ghoṣā̱ ut sthṷrbahu̱le vi̱nirha̭te̱ meṣṷḥ papta̱dindra̱syāha̱nyāga̭te"
  ],
