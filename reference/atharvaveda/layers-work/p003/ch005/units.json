  "lines_deva": [
   "ये राजा॑नो राज॒कृतः॑ सू॒ता ग्रा॑म॒ण्यऽश्च॒ ये",
   "उ॒प॒स्तीन् प॑र्ण॒ मह्यं॒ त्वं सर्वा॑न् कृण्व॒भितो॒ जनान्"
  ],
  "lines_iast": [
   "ye rājā̭no rāja̱kṛta̭ḥ sū̱tā grā̭ma̱ṇya'śca̱ ye",
   "u̱pa̱stīn pa̭rṇa̱ mahya̱ṃ tvaṃ sarvā̭n kṛṇva̱bhito̱ janān"
  ],
