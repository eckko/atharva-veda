   "003.005.2a",
   "003.005.2b"
  ],
  "lines_deva": [
   "मयि॑ क्ष॒त्रं प॑र्णमणे॒ मयि॑ धारयताद् र॒यिम्",
   "अ॒हं रा॒ष्ट्रस्या॑भीव॒र्गे नि॒जो भू॑यासमुत्त॒मः"
  ],
  "lines_iast": [
   "mayi̭ kṣa̱traṃ pa̭rṇamaṇe̱ mayi̭ dhārayatād ra̱yim",
   "a̱haṃ rā̱ṣṭrasyā̭bhīva̱rge ni̱jo bhṷ̄yāsamutta̱maḥ"
  ],
  "book_split": [
