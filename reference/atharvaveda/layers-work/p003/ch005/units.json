  "lines_deva": [
   "प॒र्णोऽसि तनू॒पानः॒ सयो॑निर्वी॒रो वी॒रेण॒ मया॑",
   "सं॒व॒त्स॒रस्य॒ तेज॑सा॒ तेन॒ बध्नामि त्वा मणे"
  ],
  "lines_iast": [
   "pa̱rṇo'si tanū̱pāna̱ḥ sayo̭nirvī̱ro vī̱reṇa̱ mayā̭",
   "sa̱ṃva̱tsa̱rasya̱ teja̭sā̱ tena̱ badhnāmi tvā maṇe"
  ],
