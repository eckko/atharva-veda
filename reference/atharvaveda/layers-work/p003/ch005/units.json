   "003.005.1a",
   "003.005.1b"
  ],
  "lines_deva": [
   "आयम॑गन् पर्णम॒णिर्ब॒ली बले॑न प्रमृ॒णन्त्स॒पत्ना॑न्",
   "ओजो॑ दे॒वानां॒ पय॒ ओष॑धीनां॒ वर्च॑सा मा जिन्व॒त्वप्र॑यावन्"
  ],
  "lines_iast": [
   "āyama̭gan parṇama̱ṇirba̱lī balḙna pramṛ̱ṇantsa̱patnā̭n",
   "ojo̭ de̱vānā̱ṃ paya̱ oṣa̭dhīnā̱ṃ varca̭sā mā jinva̱tvapra̭yāvan"
  ],
