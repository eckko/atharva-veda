   "003.005.6b"
  ],
  "lines_deva": [
   "ये धीवा॑नो रथका॒राः क॒र्मारा॒ ये म॑नी॒षिणः॑",
   "उ॒प॒स्तीन् प॑र्ण॒ मह्यं॒ त्वं सर्वा॑न् कृण्व॒भितो॒ जना॑न्"
  ],
  "lines_iast": [
   "ye dhīvā̭no rathakā̱rāḥ ka̱rmārā̱ ye ma̭nī̱ṣiṇa̭ḥ",
   "u̱pa̱stīn pa̭rṇa̱ mahya̱ṃ tvaṃ sarvā̭n kṛṇva̱bhito̱ janā̭n"
  ],
