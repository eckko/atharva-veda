 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.005.4a",
   "003.005.4b"
  ],
  "lines_deva": [
   "सोम॑स्य प॒र्णः सह॑ उ॒ग्रमाग॒न्निन्द्रे॑ण द॒त्तो वरु॑णेन शि॒ष्टः",
   "तं प्रि॑यासं ब॒हु रोच॑मानो दीर्घायु॒त्वाय॑ श॒तशा॑रदाय"
  ],
  "lines_iast": [
   "soma̭sya pa̱rṇaḥ saha̭ u̱gramāga̱nnindrḙṇa da̱tto varṷṇena śi̱ṣṭaḥ",
   "taṃ pri̭yāsaṃ ba̱hu roca̭māno dīrghāyu̱tvāya̭ śa̱taśā̭radāya"
  ],
