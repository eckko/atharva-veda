   "003.005.3b"
  ],
  "lines_deva": [
   "यं नि॑द॒धुर्वन॒स्पतौ॒ गुह्यं॑ दे॒वाः प्रि॒यं म॒णिम्",
   "तम॒स्मभ्यं॑ स॒हायु॑षा दे॒वा द॑दतु॒ भर्त॑वे"
  ],
  "lines_iast": [
   "yaṃ ni̭da̱dhurvana̱spatau̱ guhya̭ṃ de̱vāḥ pri̱yaṃ ma̱ṇim",
   "tama̱smabhya̭ṃ sa̱hāyṷṣā de̱vā da̭datu̱ bharta̭ve"
  ],
  "book_split": [
