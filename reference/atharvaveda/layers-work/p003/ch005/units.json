  "lines_deva": [
   "आ मा॑रुक्षत् पर्णम॒णिर्म॒ह्या अ॑रि॒ष्टता॑तये",
   "यथा॒हमु॑त्त॒रोऽसा॑न्यर्य॒म्ण उ॒त सं॒विदः॑"
  ],
  "lines_iast": [
   "ā mā̭rukṣat parṇama̱ṇirma̱hyā a̭ri̱ṣṭatā̭taye",
   "yathā̱hamṷtta̱ro'sā̭nyarya̱mṇa u̱ta sa̱ṃvida̭ḥ"
  ],
