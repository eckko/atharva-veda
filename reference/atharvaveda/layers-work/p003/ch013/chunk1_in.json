   "003.013.4b"
  ],
  "lines_deva": [
   "एको॑ वो दे॒वोऽप्य॑तिष्ठ॒त् स्यन्द॑माना यथाव॒शम्",
   "उदा॑निषुर्म॒हीरिति॒ तस्मा॑दुद॒कमु॑च्यते"
  ],
  "lines_iast": [
   "eko̭ vo de̱vo'pya̭tiṣṭha̱t syanda̭mānā yathāva̱śam",
   "udā̭niṣurma̱hīriti̱ tasmā̭duda̱kamṷcyate"
  ],
