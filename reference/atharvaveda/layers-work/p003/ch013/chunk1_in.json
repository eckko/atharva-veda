  "lines_deva": [
   "आदित् प॑श्याम्यु॒त वा॑ शृणो॒म्या मा॒ घोषो॑ गच्छति॒ वाङ् मा॑साम्",
   "मन्ये॑ भेजा॒नो अ॒मृत॑स्य तर्हि॒ हिर॑ण्यवर्णा॒ अतृ॑पं य॒दा वः॑"
  ],
  "lines_iast": [
   "ādit pa̭śyāmyu̱ta vā̭ śṛṇo̱myā mā̱ ghoṣo̭ gacchati̱ vāṅ mā̭sām",
   "manyḙ bhejā̱no a̱mṛta̭sya tarhi̱ hira̭ṇyavarṇā̱ atṛ̭paṃ ya̱dā va̭ḥ"
  ],
