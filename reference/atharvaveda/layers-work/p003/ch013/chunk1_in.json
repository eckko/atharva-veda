  "lines_deva": [
   "यद॒दः सं॑प्रय॒तीरहा॒वन॑दता हते॑",
   "तस्मा॒दा न॒द्यो॒३ नाम॑ स्थ॒ ता वो॒ नामा॑नि सिन्धवः"
  ],
  "lines_iast": [
   "yada̱daḥ sa̭ṃpraya̱tīrahā̱vana̭datā hatḙ",
   "tasmā̱dā na̱dyo̱3 nāma̭ stha̱ tā vo̱ nāmā̭ni sindhavaḥ"
  ],
