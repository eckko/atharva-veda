   "003.013.5b"
  ],
  "lines_deva": [
   "आपो॑ भ॒द्रा घृ॒तमिदाप॑ आसन्न॒ग्नीषोमौ॑ बिभ्र॒त्याप॒ इत् ताः",
   "ती॒व्रो रसो॑ मधुपृचा॑मरंग॒म आ मा॑ प्रा॒णेन॑ स॒ह वर्च॑सा गमेत्"
  ],
  "lines_iast": [
   "āpo̭ bha̱drā ghṛ̱tamidāpa̭ āsanna̱gnīṣomaṷ bibhra̱tyāpa̱ it tāḥ",
   "tī̱vro raso̭ madhupṛcā̭maraṃga̱ma ā mā̭ prā̱ṇena̭ sa̱ha varca̭sā gamet"
  ],
