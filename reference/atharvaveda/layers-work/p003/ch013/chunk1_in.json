  "lines_deva": [
   "यत् प्रेषि॑ता॒ वरु॑णे॒नाच्छीभं॑ स॒मव॑ल्गत",
   "तदा॑प्नो॒दिन्द्रो॑ वो य॒तीस्तस्मा॑दापो॒ अनु॑ ष्ठन"
  ],
  "lines_iast": [
   "yat preṣi̭tā̱ varṷṇe̱nācchībha̭ṃ sa̱mava̭lgata",
   "tadā̭pno̱dindro̭ vo ya̱tīstasmā̭dāpo̱ anṷ ṣṭhana"
  ],
