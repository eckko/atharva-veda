  "lines_deva": [
   "अ॒प॒का॒मं स्यन्द॑माना॒ अवी॑वरत वो॒ हि क॑म्",
   "इन्द्रो॑ वः॒ शक्ति॑भिर्देवी॒स्तस्मा॒द् वार्नाम॑ वो हि॒तम्"
  ],
  "lines_iast": [
   "a̱pa̱kā̱maṃ syanda̭mānā̱ avī̭varata vo̱ hi ka̭m",
   "indro̭ va̱ḥ śakti̭bhirdevī̱stasmā̱d vārnāma̭ vo hi̱tam"
  ],
