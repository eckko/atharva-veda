  "lines_deva": [
   "प्रेता॒ जय॑ता नर उ॒ग्रा वः॑ सन्तु बा॒हवः॑",
   "ती॒क्ष्णेष॑वोऽब॒लध॑न्वनो हतो॒ग्रायु॑धा अब॒लानु॒ग्रबा॑हवः"
  ],
  "lines_iast": [
   "pretā̱ jaya̭tā nara u̱grā va̭ḥ santu bā̱hava̭ḥ",
   "tī̱kṣṇeṣa̭vo'ba̱ladha̭nvano hato̱grāyṷdhā aba̱lānu̱grabā̭havaḥ"
  ],
