   "003.019.3b"
  ],
  "lines_deva": [
   "नी॒चैः प॑द्यन्ता॒मध॑रे भवन्तु॒ ये नः॑ सू॒रिं म॒घवा॑नं पृत॒न्यान्",
   "क्षि॒णामि॒ ब्रह्म॑णा॒मित्रा॒नुन्न॑यामि॒ स्वान॒हम्"
  ],
  "lines_iast": [
   "nī̱caiḥ pa̭dyantā̱madha̭re bhavantu̱ ye na̭ḥ sū̱riṃ ma̱ghavā̭naṃ pṛta̱nyān",
   "kṣi̱ṇāmi̱ brahma̭ṇā̱mitrā̱nunna̭yāmi̱ svāna̱ham"
  ],
