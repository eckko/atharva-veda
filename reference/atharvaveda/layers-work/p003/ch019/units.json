  "lines_deva": [
   "तीक्ष्णी॑यांसः पर॒शोर॒ग्नेस्तीक्ष्ण॑तरा उत॑",
   "इन्द्र॑स्य॒ वज्रा॒त् तीक्ष्णी॑यांसो॒ येषा॒मस्मि॑ पु॒रोहि॑तः"
  ],
  "lines_iast": [
   "tīkṣṇī̭yāṃsaḥ para̱śora̱gnestīkṣṇa̭tarā uta̭",
   "indra̭sya̱ vajrā̱t tīkṣṇī̭yāṃso̱ yeṣā̱masmi̭ pu̱rohi̭taḥ"
  ],
