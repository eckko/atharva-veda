  "lines_deva": [
   "सम॒हमे॒षां रा॒ष्ट्रं स्या॑मि॒ समोजो॑ वी॒र्य॑१ बल॑म्",
   "वृ॒श्चामि॒ शत्रू॑णां बा॒हून॒नेन॑ ह॒विषा॒हम्"
  ],
  "lines_iast": [
   "sama̱hame̱ṣāṃ rā̱ṣṭraṃ syā̭mi̱ samojo̭ vī̱rya̭1 bala̭m",
   "vṛ̱ścāmi̱ śatrṷ̄ṇāṃ bā̱hūna̱nena̭ ha̱viṣā̱ham"
  ],
