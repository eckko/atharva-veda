  "lines_deva": [
   "अव॑सृष्टा॒ परा॑ पत॒ शर॑व्ये॒ ब्रह्म॑संशिते",
   "जया॒मित्रा॒न् प्र प॑द्यस्व ज॒ह्येऽषां॒ वरं॑वरं॒ मामीषां॑ मोचि॒ कश्च॒न"
  ],
  "lines_iast": [
   "ava̭sṛṣṭā̱ parā̭ pata̱ śara̭vye̱ brahma̭saṃśite",
   "jayā̱mitrā̱n pra pa̭dyasva ja̱hye'ṣā̱ṃ vara̭ṃvara̱ṃ māmīṣā̭ṃ moci̱ kaśca̱na"
  ],
