  "lines_deva": [
   "संशि॑तं म इ॒दं ब्रह्म॒ संशि॑तं वी॒र्य॑१ बल॑म्",
   "संशि॑तं क्ष॒त्रम॒जर॑मस्तु जि॒ष्णुर्येषा॒मस्मि॑ पु॒रोहि॑तः"
  ],
  "lines_iast": [
   "saṃśi̭taṃ ma i̱daṃ brahma̱ saṃśi̭taṃ vī̱rya̭1 bala̭m",
   "saṃśi̭taṃ kṣa̱trama̱jara̭mastu ji̱ṣṇuryeṣā̱masmi̭ pu̱rohi̭taḥ"
  ],
