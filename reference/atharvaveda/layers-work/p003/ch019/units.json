  "lines_deva": [
   "ए॒षाम॒हमायु॑धा॒ सं स्या॑म्ये॒षां रा॒ष्ट्रं सुवी॑रं वर्धयामि",
   "ए॒षां क्ष॒त्रम॒जर॑मस्तु जि॒ष्ण्वे॒३षां चि॒त्तं विश्वे॑ऽवन्तु दे॒वाः"
  ],
  "lines_iast": [
   "e̱ṣāma̱hamāyṷdhā̱ saṃ syā̭mye̱ṣāṃ rā̱ṣṭraṃ suvī̭raṃ vardhayāmi",
   "e̱ṣāṃ kṣa̱trama̱jara̭mastu ji̱ṣṇve̱3ṣāṃ ci̱ttaṃ viśvḙ'vantu de̱vāḥ"
