   "003.029.3b"
  ],
  "lines_deva": [
   "यो ददा॑ति शिति॒पाद॒मविं॑ लो॒केन॒ संमि॑तम्",
   "स नाक॑म॒भ्यारो॑हति॒ यत्र॑ शु॒ल्को न क्रि॒यते॑ अब॒लेन॒ बली॑यसे"
  ],
  "lines_iast": [
   "yo dadā̭ti śiti̱pāda̱mavi̭ṃ lo̱kena̱ saṃmi̭tam",
   "sa nāka̭ma̱bhyāro̭hati̱ yatra̭ śu̱lko na kri̱yatḙ aba̱lena̱ balī̭yase"
  ],
