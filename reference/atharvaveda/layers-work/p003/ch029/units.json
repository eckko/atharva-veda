 {
  "n": "7",
  "type": "verse",
  "line_ids": [
   "003.029.7a",
   "003.029.7b",
   "003.029.7c"
  ],
  "lines_deva": [
   "क इ॒दं कस्मा॑ अदा॒त् कामः॒ कामा॑यादात्",
   "कामो॑ दा॒ता कामः॑ प्रतिग्रही॒ता कामः॑ समु॒द्रमा वि॑वेश",
   "कामे॑न त्वा॒ प्रति॑ गृह्णामि॒ कामै॒तत् ते॑"
  ],
  "lines_iast": [
   "ka i̱daṃ kasmā̭ adā̱t kāma̱ḥ kāmā̭yādāt",
   "kāmo̭ dā̱tā kāma̭ḥ pratigrahī̱tā kāma̭ḥ samu̱dramā vi̭veśa",
   "kāmḙna tvā̱ prati̭ gṛhṇāmi̱ kāmai̱tat tḙ"
  ],
