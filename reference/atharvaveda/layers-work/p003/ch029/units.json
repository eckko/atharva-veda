   "003.029.8b"
  ],
  "lines_deva": [
   "भूमि॑ष्ट्वा॒ प्रति॑ गृह्णात्व॒न्तरि॑क्षमि॒दं म॒हत्",
   "माहं प्रा॒णेन॒ मात्मना॒ मा प्र॒जया॑ प्रति॒गृह्य॒ वि रा॑धिषि"
  ],
  "lines_iast": [
   "bhūmi̭ṣṭvā̱ prati̭ gṛhṇātva̱ntari̭kṣami̱daṃ ma̱hat",
   "māhaṃ prā̱ṇena̱ mātmanā̱ mā pra̱jayā̭ prati̱gṛhya̱ vi rā̭dhiṣi"
  ],
