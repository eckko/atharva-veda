  "line_ids": [
   "003.029.1a",
   "003.029.1b"
  ],
  "lines_deva": [
   "यद् राजा॑नो वि॒भज॑न्त इष्टापू॒र्तस्य॑ षोड॒शं य॒मस्या॒मी स॑भा॒सदः॑",
   "अवि॒स्तस्मा॒त् प्र मु॑ञ्चति द॒त्तः शि॑ति॒पात् स्व॒धा"
  ],
  "lines_iast": [
   "yad rājā̭no vi̱bhaja̭nta iṣṭāpū̱rtasya̭ ṣoḍa̱śaṃ ya̱masyā̱mī sa̭bhā̱sada̭ḥ",
   "avi̱stasmā̱t pra mṷñcati da̱ttaḥ śi̭ti̱pāt sva̱dhā"
  ],
