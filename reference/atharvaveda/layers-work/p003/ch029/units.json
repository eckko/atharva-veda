   "003.029.2b"
  ],
  "lines_deva": [
   "सर्वा॒न् कामा॑न् पूरयत्या॒भव॑न् प्र॒भव॒न् भव॑न्",
   "आ॒कू॒ति॒प्रोऽवि॑र्द॒त्तः शि॑ति॒पान्नोप॑ दस्यति"
  ],
  "lines_iast": [
   "sarvā̱n kāmā̭n pūrayatyā̱bhava̭n pra̱bhava̱n bhava̭n",
   "ā̱kū̱ti̱pro'vi̭rda̱ttaḥ śi̭ti̱pānnopa̭ dasyati"
  ],
