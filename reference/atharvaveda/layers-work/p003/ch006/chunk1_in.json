   "003.006.6b"
  ],
  "lines_deva": [
   "यथा॑श्वत्थ वानस्प॒त्याना॒रोह॑न् कृणु॒षेऽध॑रान्",
   "ए॒वा मे॒ शत्रो॑र्मू॒र्धानं॒ विष्व॑ग् भिन्द्धि॒ सह॑स्व च"
  ],
  "lines_iast": [
   "yathā̭śvattha vānaspa̱tyānā̱roha̭n kṛṇu̱ṣe'dha̭rān",
   "e̱vā me̱ śatro̭rmū̱rdhāna̱ṃ viṣva̭g bhinddhi̱ saha̭sva ca"
  ],
