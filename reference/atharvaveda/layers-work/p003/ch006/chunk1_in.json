 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.006.2a",
   "003.006.2b"
  ],
  "lines_deva": [
   "तान॑श्वत्थ॒ निः शृ॑णीहि॒ शत्रू॑न् वैबाध॒दोध॑तः",
   "इन्द्रे॑ण वृत्र॒घ्ना मे॒दी मि॒त्रेण॒ वरु॑णेन च"
  ],
  "lines_iast": [
   "tāna̭śvattha̱ niḥ śṛ̭ṇīhi̱ śatrṷ̄n vaibādha̱dodha̭taḥ",
   "indrḙṇa vṛtra̱ghnā me̱dī mi̱treṇa̱ varṷṇena ca"
  ],
