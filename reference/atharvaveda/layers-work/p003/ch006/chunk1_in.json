   "003.006.5b"
  ],
  "lines_deva": [
   "सि॒नात्वे॑ना॒न् निरृ॑तिर्मृ॒त्योः पाशै॑रमो॒क्यैः",
   "अश्व॑त्थ॒ शत्रू॑न् माम॒कान् यान॒हं द्वेष्मि॒ ये च॒ माम्"
  ],
  "lines_iast": [
   "si̱nātvḙnā̱n nirṛ̭tirmṛ̱tyoḥ pāśai̭ramo̱kyaiḥ",
   "aśva̭ttha̱ śatrṷ̄n māma̱kān yāna̱haṃ dveṣmi̱ ye ca̱ mām"
  ],
