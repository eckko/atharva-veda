   "003.006.7b"
  ],
  "lines_deva": [
   "तेऽध॒राञ्चः॒ प्र प्ल॑वन्तां छि॒न्ना नौरि॑व॒ बन्ध॑नात्",
   "न वै॑बा॒धप्र॑णुत्तानां॒ पुन॑रस्ति नि॒वर्त॑नम्"
  ],
  "lines_iast": [
   "te'dha̱rāñca̱ḥ pra pla̭vantāṃ chi̱nnā nauri̭va̱ bandha̭nāt",
   "na vai̭bā̱dhapra̭ṇuttānā̱ṃ puna̭rasti ni̱varta̭nam"
  ],
