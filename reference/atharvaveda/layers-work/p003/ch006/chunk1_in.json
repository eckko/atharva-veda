 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.006.3a",
   "003.006.3b"
  ],
  "lines_deva": [
   "यथा॑श्वत्थ नि॒रभ॑नो॒ऽन्तर्म॑ह॒त्यऽर्ण॒वे",
   "ए॒वा तान्त्सर्वा॒न् निर्भ॑ङ्ग्धि॒ यान॒हं द्वेष्मि॒ ये च॒ माम्"
  ],
  "lines_iast": [
   "yathā̭śvattha ni̱rabha̭no̱'ntarma̭ha̱tya'rṇa̱ve",
   "e̱vā tāntsarvā̱n nirbha̭ṅgdhi̱ yāna̱haṃ dveṣmi̱ ye ca̱ mām"
  ],
  "book_split": [
