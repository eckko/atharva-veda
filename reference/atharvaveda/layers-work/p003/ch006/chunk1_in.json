[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "003.006.1a",
   "003.006.1b"
  ],
  "lines_deva": [
   "पुमा॑न् पुंसः परि॑जातोऽश्व॒त्थः ख॑दि॒रादधि॑",
   "स ह॑न्तु॒ शत्रू॑न् माम॒कान् यान॒हं द्वेष्मि॒ ये च॒ माम्"
  ],
  "lines_iast": [
   "pumā̭n puṃsaḥ pari̭jāto'śva̱tthaḥ kha̭di̱rādadhi̭",
   "sa ha̭ntu̱ śatrṷ̄n māma̱kān yāna̱haṃ dveṣmi̱ ye ca̱ mām"
  ],
  "book_split": [
