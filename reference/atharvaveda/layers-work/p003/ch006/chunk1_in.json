 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.006.4a",
   "003.006.4b"
  ],
  "lines_deva": [
   "यः सह॑मान॒श्चर॑सि सासहा॒न इव ऋष॒भः",
   "तेना॑श्वत्थ॒ त्वया॑ व॒यं स॒पत्ना॑न्त्सहिषीमहि"
  ],
  "lines_iast": [
   "yaḥ saha̭māna̱ścara̭si sāsahā̱na iva ṛṣa̱bhaḥ",
   "tenā̭śvattha̱ tvayā̭ va̱yaṃ sa̱patnā̭ntsahiṣīmahi"
  ],
  "book_split": [
