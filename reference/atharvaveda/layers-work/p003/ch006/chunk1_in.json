   "003.006.8b"
  ],
  "lines_deva": [
   "प्रैणा॑न् नुदे॒ मन॑सा॒ प्र चि॒त्ते॑नो॒त ब्रह्म॑णा",
   "प्रैणा॑न् वृ॒क्षस्य॒ शाख॑याश्व॒त्थस्य॑ नुदामहे"
  ],
  "lines_iast": [
   "praiṇā̭n nude̱ mana̭sā̱ pra ci̱ttḙno̱ta brahma̭ṇā",
   "praiṇā̭n vṛ̱kṣasya̱ śākha̭yāśva̱tthasya̭ nudāmahe"
  ],
