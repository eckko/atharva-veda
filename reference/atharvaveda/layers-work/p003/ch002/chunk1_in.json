[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "003.002.1a",
   "003.002.1b"
  ],
  "lines_deva": [
   "अ॒ग्निर्नो॑ दू॒तः प्र॒त्येतु॑ वि॒द्वान् प्र॑ति॒दह॑न्न॒भिश॑स्ति॒मरा॑तिम्",
   "स चि॒त्तानि॑ मोहयतु॒ परे॑षां॒ निर्ह॑स्तांश्च कृणवज्जा॒तवे॑दाः"
  ],
  "lines_iast": [
   "a̱gnirno̭ dū̱taḥ pra̱tyetṷ vi̱dvān pra̭ti̱daha̭nna̱bhiśa̭sti̱marā̭tim",
   "sa ci̱ttāni̭ mohayatu̱ parḙṣā̱ṃ nirha̭stāṃśca kṛṇavajjā̱tavḙdāḥ"
  ],
  "book_split": [
