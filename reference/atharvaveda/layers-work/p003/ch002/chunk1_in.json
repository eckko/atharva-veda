 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.002.3a",
   "003.002.3b"
  ],
  "lines_deva": [
   "इन्द्र॑ चि॒त्तानि॑ मो॒हय॑न्न॒र्वाङाकू॑त्या चर",
   "अ॒ग्नेर्वात॑स्य॒ ध्राज्या॒ तान् विषू॑चो॒ वि ना॑शय"
  ],
  "lines_iast": [
   "indra̭ ci̱ttāni̭ mo̱haya̭nna̱rvāṅākṷ̄tyā cara",
   "a̱gnervāta̭sya̱ dhrājyā̱ tān viṣṷ̄co̱ vi nā̭śaya"
  ],
  "book_split": [
