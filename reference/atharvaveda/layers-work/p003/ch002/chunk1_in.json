 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "003.002.5a",
   "003.002.5b"
  ],
  "lines_deva": [
   "अ॒मीषां॑ चि॒त्तानि॑ प्रतिमो॒हय॑न्ती गृहा॒णाङ्गा॑न्यप्वे॒ परे॑हि",
   "अ॒भि प्रेहि॒ निर्द॑ह हृ॒त्सु शोकै॒र्ग्राह्या॒मित्रां॒स्तम॑सा विध्य॒ शत्रू॑न्"
  ],
  "lines_iast": [
   "a̱mīṣā̭ṃ ci̱ttāni̭ pratimo̱haya̭ntī gṛhā̱ṇāṅgā̭nyapve̱ parḙhi",
   "a̱bhi prehi̱ nirda̭ha hṛ̱tsu śokai̱rgrāhyā̱mitrā̱ṃstama̭sā vidhya̱ śatrṷ̄n"
  ],
