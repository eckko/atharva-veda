 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "003.002.6a",
   "003.002.6b"
  ],
  "lines_deva": [
   "अ॒सौ या सेना॑ मरुतः॒ परे॑षाम॒स्मा॑नैत्य॒भ्योज॑सा॒ स्पर्ध॑माना",
   "तां वि॑ध्यत॒ तम॒साप॑व्रतेन॒ यथै॑षाम॒न्यो अ॒न्यं न जा॒नात्"
  ],
  "lines_iast": [
   "a̱sau yā senā̭ maruta̱ḥ parḙṣāma̱smā̭naitya̱bhyoja̭sā̱ spardha̭mānā",
   "tāṃ vi̭dhyata̱ tama̱sāpa̭vratena̱ yathai̭ṣāma̱nyo a̱nyaṃ na jā̱nāt"
  ],
