 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.002.4a",
   "003.002.4b"
  ],
  "lines_deva": [
   "व्याऽकूतय एषामि॒ताथो॑ चि॒त्तानि॑ मुह्यत",
   "अथो॒ यद॒द्यैषां॑ हृदि तदे॑षां॒ परि॒ निर्ज॑हि"
  ],
  "lines_iast": [
   "vyā'kūtaya eṣāmi̱tātho̭ ci̱ttāni̭ muhyata",
   "atho̱ yada̱dyaiṣā̭ṃ hṛdi tadḙṣā̱ṃ pari̱ nirja̭hi"
  ],
