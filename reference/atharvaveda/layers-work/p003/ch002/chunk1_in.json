  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.002.2a",
   "003.002.2b"
  ],
  "lines_deva": [
   "अ॒यम॒ग्निर॑मूमुह॒द् यानि॑ चि॒त्तानि॑ वो हृ॒दि",
   "वि वो॑ धम॒त्वोक॑सः॒ प्र वो॑ धमतु स॒र्वतः॑"
  ],
  "lines_iast": [
   "a̱yama̱gnira̭mūmuha̱d yāni̭ ci̱ttāni̭ vo hṛ̱di",
   "vi vo̭ dhama̱tvoka̭sa̱ḥ pra vo̭ dhamatu sa̱rvata̭ḥ"
  ],
