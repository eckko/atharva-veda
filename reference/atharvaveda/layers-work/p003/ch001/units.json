 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.001.2a",
   "003.001.2b"
  ],
  "lines_deva": [
   "यू॒यमु॒ग्रा म॑रुत ई॒दृशे॑ स्था॒भि प्रेत॑ मृ॒णत॒ सह॑ध्वम्",
   "अमी॑मृण॒न् वस॑वो नाथि॒ता इ॒मे अ॒ग्निर्ह्येऽषां दू॒तः प्र॒त्येतु॑ वि॒द्वान्"
  ],
  "lines_iast": [
   "yū̱yamu̱grā ma̭ruta ī̱dṛśḙ sthā̱bhi preta̭ mṛ̱ṇata̱ saha̭dhvam",
   "amī̭mṛṇa̱n vasa̭vo nāthi̱tā i̱me a̱gnirhye'ṣāṃ dū̱taḥ pra̱tyetṷ vi̱dvān"
  ],
