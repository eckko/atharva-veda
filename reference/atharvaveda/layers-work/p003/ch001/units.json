 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.001.4a",
   "003.001.4b"
  ],
  "lines_deva": [
   "प्रसू॑त इन्द्र प्र॒वता॒ हरि॑भ्यां॒ प्र ते॒ वज्रः॑ प्रमृ॒णन्ने॑तु॒ शत्रू॑न्",
   "ज॒हि प्र॒तीचो॑ अ॒नूचः॒ परा॑चो॒ विष्व॑क् स॒त्यं कृ॑णुहि चि॒त्तमे॑षाम्"
  ],
  "lines_iast": [
   "prasṷ̄ta indra pra̱vatā̱ hari̭bhyā̱ṃ pra te̱ vajra̭ḥ pramṛ̱ṇannḙtu̱ śatrṷ̄n",
   "ja̱hi pra̱tīco̭ a̱nūca̱ḥ parā̭co̱ viṣva̭k sa̱tyaṃ kṛ̭ṇuhi ci̱ttamḙṣām"
  ],
