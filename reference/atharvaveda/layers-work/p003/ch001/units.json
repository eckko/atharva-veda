   "003.001.5a",
   "003.001.5b"
  ],
  "lines_deva": [
   "इन्द्र॒ सेनां॑ मोहया॒मित्रा॑णाम्",
   "अ॒ग्नेर्वात॑स्य॒ ध्राज्या॒ तान् विषू॑चो॒ वि ना॑शय"
  ],
  "lines_iast": [
   "indra̱ senā̭ṃ mohayā̱mitrā̭ṇām",
   "a̱gnervāta̭sya̱ dhrājyā̱ tān viṣṷ̄co̱ vi nā̭śaya"
  ],
