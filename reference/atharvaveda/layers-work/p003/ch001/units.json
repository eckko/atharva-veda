[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "003.001.1a",
   "003.001.1b"
  ],
  "lines_deva": [
   "अ॒ग्निर्नः॒ शत्रू॒न् प्रत्ये॑तु वि॒द्वान् प्र॑ति॒दह॑न्न॒भिश॑स्ति॒मरा॑तिम्",
   "स सेनां॑ मोहयतु॒ परे॑षां॒ निर्ह॑स्तांश्च कृणवज्जा॒तवे॑दाः"
  ],
  "lines_iast": [
   "a̱gnirna̱ḥ śatrū̱n pratyḙtu vi̱dvān pra̭ti̱daha̭nna̱bhiśa̭sti̱marā̭tim",
   "sa senā̭ṃ mohayatu̱ parḙṣā̱ṃ nirha̭stāṃśca kṛṇavajjā̱tavḙdāḥ"
  ],
  "book_split": [
