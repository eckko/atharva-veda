 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.001.3a",
   "003.001.3b"
  ],
  "lines_deva": [
   "अ॒मि॒त्र॒से॒नां॑ मघवन्न॒स्मान् छ॑त्रूय॒तीम॒भि",
   "यु॒वं तानि॑न्द्र वृत्रहन्न॒ग्निश्च॑ दहतं॒ प्रति॑"
  ],
  "lines_iast": [
   "a̱mi̱tra̱se̱nā̭ṃ maghavanna̱smān cha̭trūya̱tīma̱bhi",
   "yu̱vaṃ tāni̭ndra vṛtrahanna̱gniśca̭ dahata̱ṃ prati̭"
  ],
