  "lines_deva": [
   "इन्द्रः॒ सेनां॑ मोहयतु म॒रुतो॑ घ्न॒न्त्वोज॑सा",
   "चक्षूं॑स्य॒ग्निरा द॑त्तां॒ पुन॑रेतु॒ परा॑जिता"
  ],
  "lines_iast": [
   "indra̱ḥ senā̭ṃ mohayatu ma̱ruto̭ ghna̱ntvoja̭sā",
   "cakṣṷ̄ṃsya̱gnirā da̭ttā̱ṃ puna̭retu̱ parā̭jitā"
  ],
