   "003.009.4b"
  ],
  "lines_deva": [
   "येना॑ श्रवस्यव॒श्चर॑थ दे॒वा इ॑वासुरमा॒यया॑",
   "शुनां॑ क॒पिरि॑व॒ दूष॑णो॒ बन्धु॑रा काब॒वस्य॑ च"
  ],
  "lines_iast": [
   "yenā̭ śravasyava̱ścara̭tha de̱vā i̭vāsuramā̱yayā̭",
   "śunā̭ṃ ka̱piri̭va̱ dūṣa̭ṇo̱ bandhṷrā kāba̱vasya̭ ca"
  ],
