   "003.009.6b"
  ],
  "lines_deva": [
   "एक॑शतं॒ विष्क॑न्धानि॒ विष्ठि॑ता पृथि॒वीमनु॑",
   "तेषां॒ त्वामग्रे॒ उज्ज॑हरुर्म॒णिं वि॑ष्कन्ध॒दूष॑णम्"
  ],
  "lines_iast": [
   "eka̭śata̱ṃ viṣka̭ndhāni̱ viṣṭhi̭tā pṛthi̱vīmanṷ",
   "teṣā̱ṃ tvāmagre̱ ujja̭harurma̱ṇiṃ vi̭ṣkandha̱dūṣa̭ṇam"
  ],
