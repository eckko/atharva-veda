   "003.009.5b"
  ],
  "lines_deva": [
   "दुष्ट्यै॒ हि त्वा॑ भ॒त्स्यामि॑ दूषयि॒ष्यामि॑ काब॒वम्",
   "उदा॒शवो॒ रथा॑ इव श॒पथे॑भिः सरिष्यथ"
  ],
  "lines_iast": [
   "duṣṭyai̱ hi tvā̭ bha̱tsyāmi̭ dūṣayi̱ṣyāmi̭ kāba̱vam",
   "udā̱śavo̱ rathā̭ iva śa̱pathḙbhiḥ sariṣyatha"
  ],
