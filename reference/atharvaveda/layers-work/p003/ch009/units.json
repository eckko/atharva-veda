  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.009.2a",
   "003.009.2b"
  ],
  "lines_deva": [
   "अ॒श्रे॒ष्माणो॑ अधारय॒न् तथा॒ तन्मनु॑ना कृ॒तम्",
   "कृणोमि॒ वध्रि॒ विष्क॑न्धं मुष्काब॒र्हो गवा॑मिव"
  ],
  "lines_iast": [
   "a̱śre̱ṣmāṇo̭ adhāraya̱n tathā̱ tanmanṷnā kṛ̱tam",
   "kṛṇomi̱ vadhri̱ viṣka̭ndhaṃ muṣkāba̱rho gavā̭miva"
  ],
