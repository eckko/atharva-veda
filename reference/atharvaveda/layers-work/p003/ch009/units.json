   "003.009.1a",
   "003.009.1b"
  ],
  "lines_deva": [
   "क॒र्शफ॑स्य विश॒फस्य॒ द्यौः पि॒ता पृ॑थि॒वी मा॒ता",
   "यथा॑भिच॒क्र दे॑वा॒स्तथाप॑ कृणुता॒ पुनः॑"
  ],
  "lines_iast": [
   "ka̱rśapha̭sya viśa̱phasya̱ dyauḥ pi̱tā pṛ̭thi̱vī mā̱tā",
   "yathā̭bhica̱kra dḙvā̱stathāpa̭ kṛṇutā̱ puna̭ḥ"
  ],
  "book_split": [
