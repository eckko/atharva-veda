 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.009.3a",
   "003.009.3b"
  ],
  "lines_deva": [
   "पि॒शङ्गे॒ सूत्रे॒ खृग॑लं॒ तदा ब॑ध्नन्ति वे॒धसः॑",
   "श्र॒व॒स्युं शुष्मं॑ काब॒वं वध्रिं॑ कृण्वन्तु ब॒न्धुरः॑"
  ],
  "lines_iast": [
   "pi̱śaṅge̱ sūtre̱ khṛga̭la̱ṃ tadā ba̭dhnanti ve̱dhasa̭ḥ",
   "śra̱va̱syuṃ śuṣma̭ṃ kāba̱vaṃ vadhri̭ṃ kṛṇvantu ba̱ndhura̭ḥ"
  ],
