  "lines_deva": [
   "उदुत्सं॑ श॒तधा॑रं स॒हस्र॑धार॒मक्षि॑तम्",
   "ए॒वास्माके॒दं धा॒न्यं ऽ स॒हस्र॑धार॒मक्षि॑तम्"
  ],
  "lines_iast": [
   "udutsa̭ṃ śa̱tadhā̭raṃ sa̱hasra̭dhāra̱makṣi̭tam",
   "e̱vāsmāke̱daṃ dhā̱nyaṃ ' sa̱hasra̭dhāra̱makṣi̭tam"
  ],
