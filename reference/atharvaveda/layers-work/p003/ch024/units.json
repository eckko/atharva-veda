 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.024.2a",
   "003.024.2b"
  ],
  "lines_deva": [
   "वेदा॒हं पय॑स्वन्तं च॒का॑र धा॒न्यं ऽ ब॒हु",
   "सं॒भृत्वा॒ नाम॒ यो दे॒वस्तं व॒यं ह॑वामहे॒ योयो॒ अय॑ज्वनो गृ॒हे"
  ],
  "lines_iast": [
   "vedā̱haṃ paya̭svantaṃ ca̱kā̭ra dhā̱nyaṃ ' ba̱hu",
   "sa̱ṃbhṛtvā̱ nāma̱ yo de̱vastaṃ va̱yaṃ ha̭vāmahe̱ yoyo̱ aya̭jvano gṛ̱he"
  ],
  "book_split": [
