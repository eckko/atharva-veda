   "003.024.5b"
  ],
  "lines_deva": [
   "शत॑हस्त स॒माह॑र॒ सह॑स्रहस्त॒ सं कि॑र",
   "कृ॒तस्य॑ का॒र्यऽस्य चे॒ह स्फा॒तिं स॒माव॑ह"
  ],
  "lines_iast": [
   "śata̭hasta sa̱māha̭ra̱ saha̭srahasta̱ saṃ ki̭ra",
   "kṛ̱tasya̭ kā̱rya'sya ce̱ha sphā̱tiṃ sa̱māva̭ha"
  ],
