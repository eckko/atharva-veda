   "003.024.1a",
   "003.024.1b"
  ],
  "lines_deva": [
   "पय॑स्वती॒रोष॑धयः॒ पय॑स्वन्माम॒कं वचः॑",
   "अथो॒ पय॑स्वतीना॒मा भ॑रे॒ऽहं स॑हस्र॒शः"
  ],
  "lines_iast": [
   "paya̭svatī̱roṣa̭dhaya̱ḥ paya̭svanmāma̱kaṃ vaca̭ḥ",
   "atho̱ paya̭svatīnā̱mā bha̭re̱'haṃ sa̭hasra̱śaḥ"
  ],
  "book_split": [
