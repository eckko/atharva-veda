  "lines_deva": [
   "उ॒पो॒हश्च॑ समू॒हश्च॑ क्ष॒त्तारौ॑ ते प्रजापते",
   "तावि॒हा व॑हतां स्फा॒तिं ब॒हुं भू॒मान॒मक्षि॑तम्"
  ],
  "lines_iast": [
   "u̱po̱haśca̭ samū̱haśca̭ kṣa̱ttāraṷ te prajāpate",
   "tāvi̱hā va̭hatāṃ sphā̱tiṃ ba̱huṃ bhū̱māna̱makṣi̭tam"
  ],
