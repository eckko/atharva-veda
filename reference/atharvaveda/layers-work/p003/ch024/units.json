 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.024.3a",
   "003.024.3b"
  ],
  "lines_deva": [
   "इ॒मा याः पञ्च॑ प्र॒दिशो॑ मान॒वीः पञ्च॑ कृ॒ष्टयः॑",
   "वृ॒ष्टे शापं॑ न॒दीरि॑वे॒ह स्फा॒तिं समा॑वहान्"
  ],
  "lines_iast": [
   "i̱mā yāḥ pañca̭ pra̱diśo̭ māna̱vīḥ pañca̭ kṛ̱ṣṭaya̭ḥ",
   "vṛ̱ṣṭe śāpa̭ṃ na̱dīri̭ve̱ha sphā̱tiṃ samā̭vahān"
  ],
