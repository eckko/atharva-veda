   "003.024.6b"
  ],
  "lines_deva": [
   "ति॒स्रो मात्रा॑ गन्ध॒र्वाणां॒ चत॑स्रो गृ॒हप॑त्न्याः",
   "तासां॒ या स्फा॑ति॒मत्त॑मा॒ तया॑ त्वा॒भि मृ॑शामसि"
  ],
  "lines_iast": [
   "ti̱sro mātrā̭ gandha̱rvāṇā̱ṃ cata̭sro gṛ̱hapa̭tnyāḥ",
   "tāsā̱ṃ yā sphā̭ti̱matta̭mā̱ tayā̭ tvā̱bhi mṛ̭śāmasi"
  ],
