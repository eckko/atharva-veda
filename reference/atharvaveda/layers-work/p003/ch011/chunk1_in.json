 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.011.4a",
   "003.011.4b"
  ],
  "lines_deva": [
   "श॒तं जी॑व श॒रदो॒ वर्ध॑मानः श॒तं हे॑म॒न्तान् छ॒तमु॑ वस॒न्तान्",
   "श॒तं त॒ इन्द्रो॑ अ॒ग्निः स॑वि॒ता बृह॒स्पतिः॑ श॒तायु॑षा ह॒विषाहा॑र्षमेनम्"
  ],
  "lines_iast": [
   "śa̱taṃ jī̭va śa̱rado̱ vardha̭mānaḥ śa̱taṃ hḙma̱ntān cha̱tamṷ vasa̱ntān",
   "śa̱taṃ ta̱ indro̭ a̱gniḥ sa̭vi̱tā bṛha̱spati̭ḥ śa̱tāyṷṣā ha̱viṣāhā̭rṣamenam"
  ],
