 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.011.3a",
   "003.011.3b"
  ],
  "lines_deva": [
   "स॒ह॒स्रा॒क्षेण॑ श॒तवी॑र्येण श॒तायु॑षा ह॒विषाहा॑र्षमेनम्",
   "इन्द्रो॒ यथै॑नं श॒रदो॒ नया॒त्यति॒ विश्व॑स्य दुरि॒तस्य॑ पा॒रम्"
  ],
  "lines_iast": [
   "sa̱ha̱srā̱kṣeṇa̭ śa̱tavī̭ryeṇa śa̱tāyṷṣā ha̱viṣāhā̭rṣamenam",
   "indro̱ yathai̭naṃ śa̱rado̱ nayā̱tyati̱ viśva̭sya duri̱tasya̭ pā̱ram"
  ],
  "book_split": [
