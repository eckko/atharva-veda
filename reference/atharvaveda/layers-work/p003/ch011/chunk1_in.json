   "003.011.7b"
  ],
  "lines_deva": [
   "ज॒रायै॑ त्वा॒ परि॑ ददामि ज॒रायै॒ नि धु॑वामि त्वा",
   "ज॒रा त्वा॑ भ॒द्रा ने॑ष्ट॒ व्य॑१न्ये य॑न्तु मृ॒त्यवो॒ याना॒हुरित॑रान् छ॒तम्"
  ],
  "lines_iast": [
   "ja̱rāyai̭ tvā̱ pari̭ dadāmi ja̱rāyai̱ ni dhṷvāmi tvā",
   "ja̱rā tvā̭ bha̱drā nḙṣṭa̱ vya̭1nye ya̭ntu mṛ̱tyavo̱ yānā̱hurita̭rān cha̱tam"
  ],
