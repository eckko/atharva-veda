   "003.011.8c"
  ],
  "lines_deva": [
   "अ॒भि त्वा॑ जरि॒माहि॑त॒ गामु॒क्षण॑मिव॒ रज्ज्वा",
   "यस्त्वा॑ मृ॒त्युर॒भ्यध॑त्त॒ जाय॑मानं सुपा॒शया॑",
   "तं ते॑ स॒त्यस्य॒ हस्ता॑भ्या॒मुद॑मुञ्च॒द् बृह॒स्पतिः॑"
  ],
  "lines_iast": [
   "a̱bhi tvā̭ jari̱māhi̭ta̱ gāmu̱kṣaṇa̭miva̱ rajjvā",
   "yastvā̭ mṛ̱tyura̱bhyadha̭tta̱ jāya̭mānaṃ supā̱śayā̭",
   "taṃ tḙ sa̱tyasya̱ hastā̭bhyā̱muda̭muñca̱d bṛha̱spati̭ḥ"
  ],
