   "003.011.2b"
  ],
  "lines_deva": [
   "यदि॑ क्षि॒तायु॒र्यदि॑ वा॒ परे॑तो॒ यदि॑ मृ॒त्योर॑न्ति॒कं नी॑त ए॒व",
   "तमा ह॑रामि॒ निरृ॑तेरु॒पस्था॒दस्पा॑र्शमेनं श॒तशा॑रदाय"
  ],
  "lines_iast": [
   "yadi̭ kṣi̱tāyu̱ryadi̭ vā̱ parḙto̱ yadi̭ mṛ̱tyora̭nti̱kaṃ nī̭ta e̱va",
   "tamā ha̭rāmi̱ nirṛ̭teru̱pasthā̱daspā̭rśamenaṃ śa̱taśā̭radāya"
  ],
