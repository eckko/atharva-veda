  "lines_deva": [
   "प्र वि॑शतं प्राणापानावन॒ड्वाहा॑विव व्र॒जम्",
   "व्य॑१न्ये य॑न्तु मृ॒त्यवो॒ याना॒हुरित॑रान् छ॒तम्"
  ],
  "lines_iast": [
   "pra vi̭śataṃ prāṇāpānāvana̱ḍvāhā̭viva vra̱jam",
   "vya̭1nye ya̭ntu mṛ̱tyavo̱ yānā̱hurita̭rān cha̱tam"
  ],
