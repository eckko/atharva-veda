   "003.011.1a",
   "003.011.1b"
  ],
  "lines_deva": [
   "मु॒ञ्चामि॑ त्वा ह॒विषा॒ जीव॑नाय॒ कम॑ज्ञातय॒क्ष्मादु॒त रा॑जय॒क्ष्मात्",
   "ग्राहि॑र्ज॒ग्राह॒ यद्ये॒तदे॑नं॒ तस्या॑ इन्द्राग्नी॒ प्र मु॑मुक्तमेनम्"
  ],
  "lines_iast": [
   "mu̱ñcāmi̭ tvā ha̱viṣā̱ jīva̭nāya̱ kama̭jñātaya̱kṣmādu̱ta rā̭jaya̱kṣmāt",
   "grāhi̭rja̱grāha̱ yadye̱tadḙna̱ṃ tasyā̭ indrāgnī̱ pra mṷmuktamenam"
  ],
