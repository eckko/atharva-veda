   "003.025.1a",
   "003.025.1b"
  ],
  "lines_deva": [
   "उ॒त्तु॒दस्त्वोत् तु॑दतु॒ मा धृ॑थाः॒ शय॑ने॒ स्वे",
   "इषुः॒ काम॑स्य॒ या भी॒मा तया॑ विध्यामि त्वा हृ॒दि"
  ],
  "lines_iast": [
   "u̱ttu̱dastvot tṷdatu̱ mā dhṛ̭thā̱ḥ śaya̭ne̱ sve",
   "iṣu̱ḥ kāma̭sya̱ yā bhī̱mā tayā̭ vidhyāmi tvā hṛ̱di"
  ],
