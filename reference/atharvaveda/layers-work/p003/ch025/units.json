   "003.025.4b"
  ],
  "lines_deva": [
   "शु॒चा वि॒द्धा व्योऽषया॒ शुष्का॑स्या॒भि स॑र्प मा",
   "मृ॒दुर्निम॑न्युः॒ केव॑ली प्रियवा॒दिन्यनु॑व्रता"
  ],
  "lines_iast": [
   "śu̱cā vi̱ddhā vyo'ṣayā̱ śuṣkā̭syā̱bhi sa̭rpa mā",
   "mṛ̱durnima̭nyu̱ḥ keva̭lī priyavā̱dinyanṷvratā"
  ],
