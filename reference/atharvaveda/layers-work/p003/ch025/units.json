   "003.025.3b"
  ],
  "lines_deva": [
   "या प्ली॒हानं॑ शो॒षय॑ति॒ काम॒स्येषुः॒ सुसं॑नता",
   "प्रा॒चीन॑पक्षा॒ व्योऽषा॒ तया॑ विध्यामि त्वा हृ॒दि"
  ],
  "lines_iast": [
   "yā plī̱hāna̭ṃ śo̱ṣaya̭ti̱ kāma̱syeṣu̱ḥ susa̭ṃnatā",
   "prā̱cīna̭pakṣā̱ vyo'ṣā̱ tayā̭ vidhyāmi tvā hṛ̱di"
  ],
