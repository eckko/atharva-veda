   "003.025.2b"
  ],
  "lines_deva": [
   "आ॒धीप॑र्णां॒ काम॑शल्या॒मिषुं॑ संक॒ल्पकु॑ल्मलाम्",
   "तां सुसं॑नतां कृ॒त्वा कामो॑ विध्यतु त्वा हृ॒दि"
  ],
  "lines_iast": [
   "ā̱dhīpa̭rṇā̱ṃ kāma̭śalyā̱miṣṷṃ saṃka̱lpakṷlmalām",
   "tāṃ susa̭ṃnatāṃ kṛ̱tvā kāmo̭ vidhyatu tvā hṛ̱di"
  ],
