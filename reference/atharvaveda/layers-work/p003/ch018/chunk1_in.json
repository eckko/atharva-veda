  "trailers": [
   "।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.018.2a",
   "003.018.2b"
  ],
  "lines_deva": [
   "उत्ता॑नपर्णे॒ सुभ॑गे॒ देव॑जूते॒ सह॑स्वति",
   "स॒पत्नीं॑ मे॒ परा॑ णुद॒ पतिं॑ मे॒ केव॑लं कृधि"
  ],
  "lines_iast": [
   "uttā̭naparṇe̱ subha̭ge̱ deva̭jūte̱ saha̭svati",
   "sa̱patnī̭ṃ me̱ parā̭ ṇuda̱ pati̭ṃ me̱ keva̭laṃ kṛdhi"
  ],
  "book_split": [
   "",
