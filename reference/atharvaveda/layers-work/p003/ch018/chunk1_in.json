 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.018.4a",
   "003.018.4b"
  ],
  "lines_deva": [
   "उत्त॑रा॒हमु॑त्तर॒ उत्त॒रेदुत्त॑राभ्यः",
   "अ॒धः स॒पत्नी॒ या ममाध॑रा॒ साध॑राभ्यः"
  ],
  "lines_iast": [
   "utta̭rā̱hamṷttara̱ utta̱redutta̭rābhyaḥ",
   "a̱dhaḥ sa̱patnī̱ yā mamādha̭rā̱ sādha̭rābhyaḥ"
  ],
  "book_split": [
