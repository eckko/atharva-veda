 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.018.3a",
   "003.018.3b"
  ],
  "lines_deva": [
   "न॒हि ते॒ नाम॑ ज॒ग्राह॒ नो अ॒स्मिन् र॑मसे॒ पतौ॑",
   "परा॑मे॒व प॑रा॒वतं॑ स॒पत्नीं॑ गमयामसि"
  ],
  "lines_iast": [
   "na̱hi te̱ nāma̭ ja̱grāha̱ no a̱smin ra̭mase̱ pataṷ",
   "parā̭me̱va pa̭rā̱vata̭ṃ sa̱patnī̭ṃ gamayāmasi"
  ],
  "book_split": [
   "",
