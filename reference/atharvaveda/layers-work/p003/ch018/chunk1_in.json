 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "003.018.5a",
   "003.018.5b"
  ],
  "lines_deva": [
   "अ॒हम॑स्मि॒ सह॑मा॒नाथो॒ त्वम॑सि सास॒हिः",
   "उ॒भे सह॑स्वती भू॒त्वा स॒पत्नीं॑ मे सहावहै"
  ],
  "lines_iast": [
   "a̱hama̭smi̱ saha̭mā̱nātho̱ tvama̭si sāsa̱hiḥ",
   "u̱bhe saha̭svatī bhū̱tvā sa̱patnī̭ṃ me sahāvahai"
  ],
