   "003.018.6b"
  ],
  "lines_deva": [
   "अ॒भि ते॑ऽधां॒ सह॑माना॒मुप॑ तेऽधां॒ सही॑यसीम्",
   "मामनु॒ प्र ते॒ मनो॑ व॒त्सं गौरि॑व धावतु प॒था वारि॑व धावतु"
  ],
  "lines_iast": [
   "a̱bhi tḙ'dhā̱ṃ saha̭mānā̱mupa̭ te'dhā̱ṃ sahī̭yasīm",
   "māmanu̱ pra te̱ mano̭ va̱tsaṃ gauri̭va dhāvatu pa̱thā vāri̭va dhāvatu"
  ],
