[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "003.018.1a",
   "003.018.1b"
  ],
  "lines_deva": [
   "इ॒मां ख॑ना॒म्योष॑धिं वी॒रुधां॒ बल॑वत्तमाम्",
   "यया॑ स॒पत्नीं॒ बाध॑ते॒ यया॑ संवि॒न्दते॒ पति॑म्"
  ],
  "lines_iast": [
   "i̱māṃ kha̭nā̱myoṣa̭dhiṃ vī̱rudhā̱ṃ bala̭vattamām",
   "yayā̭ sa̱patnī̱ṃ bādha̭te̱ yayā̭ saṃvi̱ndate̱ pati̭m"
  ],
  "book_split": [
   "",
   ""
  ],
