[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "003.007.1a",
   "003.007.1b"
  ],
  "lines_deva": [
   "ह॒रि॒णस्य॑ रघु॒ष्यदोऽधि॑ शी॒र्षणि॑ भेष॒जम्",
   "स क्षे॑त्रि॒यं वि॒षाण॑या विषू॒चीन॑मनीनशत्"
  ],
  "lines_iast": [
   "ha̱ri̱ṇasya̭ raghu̱ṣyado'dhi̭ śī̱rṣaṇi̭ bheṣa̱jam",
   "sa kṣḙtri̱yaṃ vi̱ṣāṇa̭yā viṣū̱cīna̭manīnaśat"
  ],
  "book_split": [
   "",
   ""
  ],
