   "।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "003.007.2a",
   "003.007.2b"
  ],
  "lines_deva": [
   "अनु॑ त्वा हरि॒णो वृषा॑ प॒द्भिश्च॒तुर्भि॑रक्रमीत्",
   "विषा॑णे॒ वि ष्य॑ गुष्पि॒तं यद॑स्य क्षेत्रि॒यं हृ॒दि"
  ],
  "lines_iast": [
   "anṷ tvā hari̱ṇo vṛṣā̭ pa̱dbhiśca̱turbhi̭rakramīt",
   "viṣā̭ṇe̱ vi ṣya̭ guṣpi̱taṃ yada̭sya kṣetri̱yaṃ hṛ̱di"
  ],
  "book_split": [
