   "003.007.5b"
  ],
  "lines_deva": [
   "आप॒ इद् वा उ॑ भेष॒जीरापो॑ अमीव॒चात॑नीः",
   "आपो॒ विश्व॑स्य भेष॒जीस्तास्त्वा॑ मुञ्चन्तु क्षेत्रि॒यात्"
  ],
  "lines_iast": [
   "āpa̱ id vā ṷ bheṣa̱jīrāpo̭ amīva̱cāta̭nīḥ",
   "āpo̱ viśva̭sya bheṣa̱jīstāstvā̭ muñcantu kṣetri̱yāt"
  ],
