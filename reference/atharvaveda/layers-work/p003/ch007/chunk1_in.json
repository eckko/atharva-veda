   "003.007.6a",
   "003.007.6b"
  ],
  "lines_deva": [
   "यदा॑सु॒तेः क्रि॒यमा॑णायाः क्षेत्रि॒यं त्वा॑ व्यान॒शे",
   "वेदा॒हं तस्य॑ भेष॒जं क्षे॑त्रि॒यं ना॑शयामि॒ त्वत्"
  ],
  "lines_iast": [
   "yadā̭su̱teḥ kri̱yamā̭ṇāyāḥ kṣetri̱yaṃ tvā̭ vyāna̱śe",
   "vedā̱haṃ tasya̭ bheṣa̱jaṃ kṣḙtri̱yaṃ nā̭śayāmi̱ tvat"
  ],
