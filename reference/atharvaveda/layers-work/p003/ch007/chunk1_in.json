 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "003.007.3a",
   "003.007.3b"
  ],
  "lines_deva": [
   "अ॒दो यद॑व॒रोच॑ते॒ चतु॑ष्पक्षमिव च्छ॒दिः",
   "तेना॑ ते॒ सर्वं॑ क्षेत्रि॒यमङ्गे॑भ्यो नाशयामसि"
  ],
  "lines_iast": [
   "a̱do yada̭va̱roca̭te̱ catṷṣpakṣamiva ccha̱diḥ",
   "tenā̭ te̱ sarva̭ṃ kṣetri̱yamaṅgḙbhyo nāśayāmasi"
  ],
  "book_split": [
