  "lines_deva": [
   "अ॒प॒वा॒से नक्ष॑त्राणामपवा॒स उ॒षसा॑मु॒त",
   "अपा॒स्मत् सर्वं॑ दुर्भू॒तमप॑ क्षेत्रि॒यमु॑च्छतु"
  ],
  "lines_iast": [
   "a̱pa̱vā̱se nakṣa̭trāṇāmapavā̱sa u̱ṣasā̭mu̱ta",
   "apā̱smat sarva̭ṃ durbhū̱tamapa̭ kṣetri̱yamṷcchatu"
  ],
