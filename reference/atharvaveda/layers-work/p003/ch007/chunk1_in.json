 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "003.007.4a",
   "003.007.4b"
  ],
  "lines_deva": [
   "अ॒मू ये दि॒वि सु॒भगे॑ वि॒चृतौ॒ नाम॒ तार॑के",
   "वि क्षे॑त्रि॒यस्य॑ मुञ्चतामध॒मं पाश॑मुत्त॒मम्"
  ],
  "lines_iast": [
   "a̱mū ye di̱vi su̱bhagḙ vi̱cṛtau̱ nāma̱ tāra̭ke",
   "vi kṣḙtri̱yasya̭ muñcatāmadha̱maṃ pāśa̭mutta̱mam"
  ],
  "book_split": [
