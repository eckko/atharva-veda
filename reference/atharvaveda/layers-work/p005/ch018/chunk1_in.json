   "005.018.6b"
  ],
  "lines_deva": [
   "न ब्रा॑ह्म॒णो हिं॑सित॒व्यो॒३ऽग्निः प्रि॒यत॑नोरिव",
   "सोमो॒ ह्यऽस्य दाया॒द इन्द्रो॑ अस्याभिशस्ति॒पाः"
  ],
  "lines_iast": [
   "na brā̭hma̱ṇo hi̭ṃsita̱vyo̱3'gniḥ pri̱yata̭noriva",
   "somo̱ hya'sya dāyā̱da indro̭ asyābhiśasti̱pāḥ"
  ],
