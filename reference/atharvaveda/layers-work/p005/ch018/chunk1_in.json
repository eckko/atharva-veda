  "lines_deva": [
   "ये स॒हस्र॒मरा॑ज॒न्नासन् दशश॒ता उ॒त",
   "ते ब्रा॑ह्म॒णस्य॒ गां ज॒ग्ध्वा वै॑तह॒व्याः परा॑भवन्"
  ],
  "lines_iast": [
   "ye sa̱hasra̱marā̭ja̱nnāsan daśaśa̱tā u̱ta",
   "te brā̭hma̱ṇasya̱ gāṃ ja̱gdhvā vai̭taha̱vyāḥ parā̭bhavan"
  ],
