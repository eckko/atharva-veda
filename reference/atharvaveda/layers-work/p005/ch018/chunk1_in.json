   "005.018.9b"
  ],
  "lines_deva": [
   "ती॒क्ष्णेष॑वो ब्राह्म॒णा हे॑ति॒मन्तो॒ यामस्य॑न्ति शर॒व्यां॒३ न सा मृषा॑",
   "अ॒नु॒हाय॒ तप॑सा म॒न्युना॑ चो॒त दू॒रादव॑ भिन्दन्त्येनम्"
  ],
  "lines_iast": [
   "tī̱kṣṇeṣa̭vo brāhma̱ṇā hḙti̱manto̱ yāmasya̭nti śara̱vyā̱ṃ3 na sā mṛṣā̭",
   "a̱nu̱hāya̱ tapa̭sā ma̱nyunā̭ co̱ta dū̱rādava̭ bhindantyenam"
  ],
