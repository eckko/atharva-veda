  "lines_deva": [
   "दे॒व॒पी॒युश्च॑रति॒ मर्त्ये॑षु गरगी॒र्णो भ॑व॒त्यस्थि॑भूयान्",
   "यो ब्रा॑ह्म॒णं दे॒वब॑न्धुं हि॒नस्ति॒ न स पि॑तृ॒याण॒मप्ये॑ति लो॒कम्"
  ],
  "lines_iast": [
   "de̱va̱pī̱yuśca̭rati̱ martyḙṣu garagī̱rṇo bha̭va̱tyasthi̭bhūyān",
   "yo brā̭hma̱ṇaṃ de̱vaba̭ndhuṃ hi̱nasti̱ na sa pi̭tṛ̱yāṇa̱mapyḙti lo̱kam"
  ],
