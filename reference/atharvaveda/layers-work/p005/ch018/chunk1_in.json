   "005.018.2a",
   "005.018.2b"
  ],
  "lines_deva": [
   "अ॒क्षद्रु॑ग्धो राज॒न्यः पा॒प आ॑त्मपराजि॒तः",
   "स ब्रा॑ह्म॒णस्य॒ गाम॑द्याद॒द्य जी॑वानि॒ माश्वः"
  ],
  "lines_iast": [
   "a̱kṣadrṷgdho rāja̱nyaḥ pā̱pa ā̭tmaparāji̱taḥ",
   "sa brā̭hma̱ṇasya̱ gāma̭dyāda̱dya jī̭vāni̱ māśvaḥ"
  ],
