  "lines_deva": [
   "अ॒ग्निर्वै नः॑ पदवा॒यः सोमो॑ दाया॒द उ॑च्यते",
   "ह॒न्ताभिश॒स्तेन्द्र॒स्तथा॒ तद् वे॒धसो॑ विदुः"
  ],
  "lines_iast": [
   "a̱gnirvai na̭ḥ padavā̱yaḥ somo̭ dāyā̱da ṷcyate",
   "ha̱ntābhiśa̱stendra̱stathā̱ tad ve̱dhaso̭ viduḥ"
  ],
