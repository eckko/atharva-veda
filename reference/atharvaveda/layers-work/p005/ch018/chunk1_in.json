 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.018.1a",
   "005.018.1b"
  ],
  "lines_deva": [
   "नैतां ते॑ दे॒वा अ॑ददु॒स्तुभ्यं॑ नृपते॒ अत्त॑वे",
   "मा ब्रा॑ह्म॒णस्य॑ राजन्य॒ गां जि॑घत्सो अना॒द्याम्"
  ],
  "lines_iast": [
   "naitāṃ tḙ de̱vā a̭dadu̱stubhya̭ṃ nṛpate̱ atta̭ve",
   "mā brā̭hma̱ṇasya̭ rājanya̱ gāṃ ji̭ghatso anā̱dyām"
  ],
  "book_split": [
