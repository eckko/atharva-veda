 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.018.4a",
   "005.018.4b"
  ],
  "lines_deva": [
   "निर्वै क्ष॒त्रं नय॑ति॒ हन्ति॒ वर्चो॒ऽग्निरि॒वार॑ब्धो॒ वि दु॑नोति॒ सर्व॑म्",
   "यो ब्रा॑ह्म॒णं मन्य॑ते॒ अन्न॑मे॒व स वि॒षस्य॑ पिबति तैमा॒तस्य॑"
  ],
  "lines_iast": [
   "nirvai kṣa̱traṃ naya̭ti̱ hanti̱ varco̱'gniri̱vāra̭bdho̱ vi dṷnoti̱ sarva̭m",
   "yo brā̭hma̱ṇaṃ manya̭te̱ anna̭me̱va sa vi̱ṣasya̭ pibati taimā̱tasya̭"
  ],
  "book_split": [
