  "lines_deva": [
   "श॒तापा॑ष्ठां॒ नि गि॑रति॒ तां न श॑क्नोति निः॒खिद॑म्",
   "अन्नं॒ यो ब्र॒ह्मणां॑ म॒ल्वः स्वा॒द्व॑१द्मीति॒ मन्य॑ते"
  ],
  "lines_iast": [
   "śa̱tāpā̭ṣṭhā̱ṃ ni gi̭rati̱ tāṃ na śa̭knoti ni̱ḥkhida̭m",
   "anna̱ṃ yo bra̱hmaṇā̭ṃ ma̱lvaḥ svā̱dva̭1dmīti̱ manya̭te"
  ],
