 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.018.3a",
   "005.018.3b"
  ],
  "lines_deva": [
   "आवि॑ष्टिता॒घवि॑षा पृदा॒कूरि॑व॒ चर्म॑णा",
   "सा ब्रा॑ह्म॒णस्य॑ राजन्य तृ॒ष्टैषा गौर॑ना॒द्या"
  ],
  "lines_iast": [
   "āvi̭ṣṭitā̱ghavi̭ṣā pṛdā̱kūri̭va̱ carma̭ṇā",
   "sā brā̭hma̱ṇasya̭ rājanya tṛ̱ṣṭaiṣā gaura̭nā̱dyā"
  ],
