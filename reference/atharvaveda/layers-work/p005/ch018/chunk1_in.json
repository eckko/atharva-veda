   "005.018.8b"
  ],
  "lines_deva": [
   "जिह्वा॒ ज्या भव॑ति॒ कुल्म॑लं॒ वाङ्ना॑डी॒का दन्ता॒स्तप॑सा॒भिदि॑ग्धाः",
   "ते भि॑र्ब्रह्मा वि॑ध्यति देवपी॒यून् हृ॑द्ब॒लैर्धनु॑र्भिर्दे॒वजू॑तैः"
  ],
  "lines_iast": [
   "jihvā̱ jyā bhava̭ti̱ kulma̭la̱ṃ vāṅnā̭ḍī̱kā dantā̱stapa̭sā̱bhidi̭gdhāḥ",
   "te bhi̭rbrahmā vi̭dhyati devapī̱yūn hṛ̭dba̱lairdhanṷrbhirde̱vajṷ̄taiḥ"
  ],
