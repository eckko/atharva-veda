  "lines_deva": [
   "हिर॑ण्यवर्णा सु॒भगा॒ हिर॑ण्यकशिपुर्म॒ही",
   "तस्यै॒ हिर॑ण्यद्राप॒येऽरा॑त्या अकरं॒ नमः॑"
  ],
  "lines_iast": [
   "hira̭ṇyavarṇā su̱bhagā̱ hira̭ṇyakaśipurma̱hī",
   "tasyai̱ hira̭ṇyadrāpa̱ye'rā̭tyā akara̱ṃ nama̭ḥ"
  ],
