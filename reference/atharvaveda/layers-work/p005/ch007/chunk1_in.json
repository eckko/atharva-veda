   "005.007.7b"
  ],
  "lines_deva": [
   "प॒रोऽपे॑ह्यसमृद्धे॒ वि ते॑ हे॒तिं न॑यामसि",
   "वेद॑ त्वा॒हं नि॒मीव॑न्तीं नितु॒दन्ती॑मराते"
  ],
  "lines_iast": [
   "pa̱ro'pḙhyasamṛddhe̱ vi tḙ he̱tiṃ na̭yāmasi",
   "veda̭ tvā̱haṃ ni̱mīva̭ntīṃ nitu̱dantī̭marāte"
  ],
