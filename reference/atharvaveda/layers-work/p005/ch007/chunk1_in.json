   "005.007.8b"
  ],
  "lines_deva": [
   "उ॒त न॒ग्ना बोभु॑वती स्वप्न॒या स॑चसे॒ जन॑म्",
   "अरा॑ते चि॒त्तं वीर्त्स॒न्त्याकू॑तिं॒ पुरु॑षस्य च"
  ],
  "lines_iast": [
   "u̱ta na̱gnā bobhṷvatī svapna̱yā sa̭case̱ jana̭m",
   "arā̭te ci̱ttaṃ vīrtsa̱ntyākṷ̄ti̱ṃ purṷṣasya ca"
  ],
