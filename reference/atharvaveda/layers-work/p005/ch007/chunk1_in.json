   "005.007.9b"
  ],
  "lines_deva": [
   "या म॑ह॒ती म॒होन्मा॑ना॒ विश्वा॒ आशा॑ व्यान॒शे",
   "तस्यै॑ हिरण्यके॒श्यै निरृ॑त्या अकरं॒ नमः॑"
  ],
  "lines_iast": [
   "yā ma̭ha̱tī ma̱honmā̭nā̱ viśvā̱ āśā̭ vyāna̱śe",
   "tasyai̭ hiraṇyake̱śyai nirṛ̭tyā akara̱ṃ nama̭ḥ"
  ],
