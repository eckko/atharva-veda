   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.007.2a",
   "005.007.2b"
  ],
  "lines_deva": [
   "यम॑राते पुरोध॒त्से पुरु॑षं परिरा॒पिण॑म्",
   "नम॑स्ते॒ तस्मै॑ कृण्मो॒ मा व॒निं व्य॑थयी॒र्मम॑"
  ],
  "lines_iast": [
   "yama̭rāte purodha̱tse purṷṣaṃ parirā̱piṇa̭m",
   "nama̭ste̱ tasmai̭ kṛṇmo̱ mā va̱niṃ vya̭thayī̱rmama̭"
  ],
  "book_split": [
