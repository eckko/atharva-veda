 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.007.4a",
   "005.007.4b"
  ],
  "lines_deva": [
   "सर॑स्वती॒मनु॑मतिं॒ भगं॒ यन्तो॑ हवामहे",
   "वाचं॑ जु॒ष्टां मधु॑मतीमवादिषं दे॒वानां॑ दे॒वहू॑तिषु"
  ],
  "lines_iast": [
   "sara̭svatī̱manṷmati̱ṃ bhaga̱ṃ yanto̭ havāmahe",
   "vāca̭ṃ ju̱ṣṭāṃ madhṷmatīmavādiṣaṃ de̱vānā̭ṃ de̱vahṷ̄tiṣu"
  ],
  "book_split": [
