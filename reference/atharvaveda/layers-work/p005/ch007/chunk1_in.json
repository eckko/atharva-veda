 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.007.3a",
   "005.007.3b"
  ],
  "lines_deva": [
   "प्र णो॑ व॒निर्दे॒वकृ॑ता॒ दिवा॒ नक्तं॑ च कल्पताम्",
   "अरा॑तिमनु॒प्रेमो॑ व॒यं नमो॑ अ॒स्त्वरा॑तये"
  ],
  "lines_iast": [
   "pra ṇo̭ va̱nirde̱vakṛ̭tā̱ divā̱ nakta̭ṃ ca kalpatām",
   "arā̭timanu̱premo̭ va̱yaṃ namo̭ a̱stvarā̭taye"
  ],
