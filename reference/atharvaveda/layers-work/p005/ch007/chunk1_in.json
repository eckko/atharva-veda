[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.007.1a",
   "005.007.1b"
  ],
  "lines_deva": [
   "आ नो॑ भर॒ मा परि॑ ष्ठा अराते॒ मा नो॑ रक्षी॒र्दक्षि॑णां नी॒यमा॑नाम्",
   "नमो॑ वी॒र्त्साया॒ अस॑मृद्धये॒ नमो॑ अ॒स्त्वरा॑तये"
  ],
  "lines_iast": [
   "ā no̭ bhara̱ mā pari̭ ṣṭhā arāte̱ mā no̭ rakṣī̱rdakṣi̭ṇāṃ nī̱yamā̭nām",
   "namo̭ vī̱rtsāyā̱ asa̭mṛddhaye̱ namo̭ a̱stvarā̭taye"
  ],
  "book_split": [
   "",
   ""
