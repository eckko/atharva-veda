 },
 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "005.007.5a",
   "005.007.5b"
  ],
  "lines_deva": [
   "यं याचा॑म्य॒हं वा॒चा सर॑स्वत्या मनो॒युजा॑",
   "श्र॒द्धा तम॒द्य वि॑न्दतु द॒त्ता सोमे॑न ब॒भ्रुणा॑"
  ],
  "lines_iast": [
   "yaṃ yācā̭mya̱haṃ vā̱cā sara̭svatyā mano̱yujā̭",
   "śra̱ddhā tama̱dya vi̭ndatu da̱ttā somḙna ba̱bhruṇā̭"
  ],
  "book_split": [
