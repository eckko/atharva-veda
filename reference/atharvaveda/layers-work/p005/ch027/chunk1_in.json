  "lines_deva": [
   "ऊ॒र्ध्वा अ॑स्य स॒मिधो॑ भवन्त्यू॒र्ध्वा शु॒क्रा शो॒चीष्य॒ग्नेः",
   "द्यु॒मत्त॑मा सु॒प्रती॑कः॒ ससू॑नु॒स्तनू॒नपा॒दसु॑रो॒ भूरि॑पाणिः"
  ],
  "lines_iast": [
   "ū̱rdhvā a̭sya sa̱midho̭ bhavantyū̱rdhvā śu̱krā śo̱cīṣya̱gneḥ",
   "dyu̱matta̭mā su̱pratī̭ka̱ḥ sasṷ̄nu̱stanū̱napā̱dasṷro̱ bhūri̭pāṇiḥ"
  ],
