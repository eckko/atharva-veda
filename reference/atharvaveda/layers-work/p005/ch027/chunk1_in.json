  ],
  "lines_iast": [
   "madhvā̭ ya̱jñaṃ na̭kṣati praiṇā̱no narā̱śaṃso̭ a̱gniḥ su̱kṛd de̱vaḥ sa̭vi̱tā vi̱śvavā̭raḥ"
  ],
