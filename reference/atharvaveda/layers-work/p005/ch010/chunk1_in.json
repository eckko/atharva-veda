   "005.010.8a",
   "005.010.8b",
   "005.010.8c"
  ],
  "lines_deva": [
   "बृ॒ह॒ता मन॒ उप॑ ह्वये मात॒रिश्व॑ना प्राणापा॒नौ",
   "सूर्या॒च्चक्षु॑र॒न्तरि॑क्षा॒च्छ्रोत्रं॑ पृथि॒व्याः शरी॑रम्",
   "सर॑स्वत्या॒ वाच॒मुप॑ ह्वयामहे मनो॒युजा॑"
  ],
  "lines_iast": [
   "bṛ̱ha̱tā mana̱ upa̭ hvaye māta̱riśva̭nā prāṇāpā̱nau",
   "sūryā̱ccakṣṷra̱ntari̭kṣā̱cchrotra̭ṃ pṛthi̱vyāḥ śarī̭ram",
   "sara̭svatyā̱ vāca̱mupa̭ hvayāmahe mano̱yujā̭"
  ],
