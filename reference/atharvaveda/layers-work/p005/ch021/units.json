   "005.021.8b"
  ],
  "lines_deva": [
   "यैरिन्द्रः॑ प्र॒क्रीड॑ते पद्घो॒षैश्छा॒यया॑ स॒ह",
   "तैर॒मित्रा॑स्त्रसन्तु नो॒ऽमी ये यन्त्य॑नीक॒शः"
  ],
  "lines_iast": [
   "yairindra̭ḥ pra̱krīḍa̭te padgho̱ṣaiśchā̱yayā̭ sa̱ha",
   "taira̱mitrā̭strasantu no̱'mī ye yantya̭nīka̱śaḥ"
  ],
