   "005.021.11b"
  ],
  "lines_deva": [
   "यू॒यमु॒ग्रा म॑रुतः पृश्निमातर॒ इन्द्रे॑ण यु॒जा प्र मृ॑णीत॒ शत्रू॑न्",
   "सोमो॒ राजा॒ वरु॑णो॒ राजा॑ महादे॒व उ॒त मृ॒त्युरिन्द्रः॑"
  ],
  "lines_iast": [
   "yū̱yamu̱grā ma̭rutaḥ pṛśnimātara̱ indrḙṇa yu̱jā pra mṛ̭ṇīta̱ śatrṷ̄n",
   "somo̱ rājā̱ varṷṇo̱ rājā̭ mahāde̱va u̱ta mṛ̱tyurindra̭ḥ"
  ],
