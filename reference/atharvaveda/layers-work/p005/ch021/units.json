[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.021.1a",
   "005.021.1b"
  ],
  "lines_deva": [
   "विहृ॑दयं वैमन॒स्यं वदा॒मित्रे॑षु दुन्दुभे",
   "वि॒द्वे॒षं कश्म॑शं भ॒यम॒मित्रे॑षु॒ नि द॑ध्म॒स्यवैनान् दुन्दुभे जहि"
  ],
  "lines_iast": [
   "vihṛ̭dayaṃ vaimana̱syaṃ vadā̱mitrḙṣu dundubhe",
   "vi̱dve̱ṣaṃ kaśma̭śaṃ bha̱yama̱mitrḙṣu̱ ni da̭dhma̱syavainān dundubhe jahi"
  ],
  "book_split": [
