 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.021.2a",
   "005.021.2b"
  ],
  "lines_deva": [
   "उ॒द्वेप॑माना॒ मन॑सा॒ चक्षु॑षा॒ हृद॑येन च",
   "धाव॑न्तु॒ बिभ्य॑तो॒ऽमित्राः॑ प्रत्रा॒सेनाज्ये॑ हु॒ते"
  ],
  "lines_iast": [
   "u̱dvepa̭mānā̱ mana̭sā̱ cakṣṷṣā̱ hṛda̭yena ca",
   "dhāva̭ntu̱ bibhya̭to̱'mitrā̭ḥ pratrā̱senājyḙ hu̱te"
  ],
