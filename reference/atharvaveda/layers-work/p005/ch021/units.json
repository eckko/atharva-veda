   "005.021.7a",
   "005.021.7b"
  ],
  "lines_deva": [
   "परा॒मित्रा॑न् दुन्दु॒भिना॑ हरि॒णस्या॒जिने॑न च",
   "सर्वे॑ दे॒वा अ॑तित्रस॒न् ये सं॑ग्रा॒मस्येशते"
  ],
  "lines_iast": [
   "parā̱mitrā̭n dundu̱bhinā̭ hari̱ṇasyā̱jinḙna ca",
   "sarvḙ de̱vā a̭titrasa̱n ye sa̭ṃgrā̱masyeśate"
  ],
