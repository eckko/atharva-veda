   "005.021.9b"
  ],
  "lines_deva": [
   "ज्या॒घो॒षा दु॑न्दु॒भयो॒ भि क्रो॑शन्तु॒ या दिशः॑",
   "सेनाः॒ परा॑जिता य॒तीर॒मित्रा॑णामनीक॒शः"
  ],
  "lines_iast": [
   "jyā̱gho̱ṣā dṷndu̱bhayo̱ bhi kro̭śantu̱ yā diśa̭ḥ",
   "senā̱ḥ parā̭jitā ya̱tīra̱mitrā̭ṇāmanīka̱śaḥ"
  ],
