   "005.021.10b"
  ],
  "lines_deva": [
   "आदि॑त्य॒ चक्षु॒रा द॑त्स्व॒ मरी॑च॒योऽनु॑ धावत",
   "प॒त्स॒ङ्गिनी॒रा स॑जन्तु॒ विग॑ते बाहुवी॒र्येऽ"
  ],
  "lines_iast": [
   "ādi̭tya̱ cakṣu̱rā da̭tsva̱ marī̭ca̱yo'nṷ dhāvata",
   "pa̱tsa̱ṅginī̱rā sa̭jantu̱ viga̭te bāhuvī̱rye'"
  ],
