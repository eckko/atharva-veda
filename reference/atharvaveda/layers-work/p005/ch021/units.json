   "005.021.4b"
  ],
  "lines_deva": [
   "यथा॑ मृ॒गाः सं॑वि॒जन्त॑ आर॒ण्याः पुरु॑षा॒दधि॑",
   "ए॒वा त्वं दु॑न्दुभे॒ऽमित्रा॑न॒भि क्र॑न्द॒ प्र त्रा॑स॒याथो॑ चि॒त्तानि॑ मोहय"
  ],
  "lines_iast": [
   "yathā̭ mṛ̱gāḥ sa̭ṃvi̱janta̭ āra̱ṇyāḥ purṷṣā̱dadhi̭",
   "e̱vā tvaṃ dṷndubhe̱'mitrā̭na̱bhi kra̭nda̱ pra trā̭sa̱yātho̭ ci̱ttāni̭ mohaya"
  ],
