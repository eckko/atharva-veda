 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.021.3a",
   "005.021.3b"
  ],
  "lines_deva": [
   "वा॒न॒स्प॒त्यः संभृ॑त उ॒स्रिया॑भिर्वि॒श्वगो॑त्र्यः",
   "प्र॒त्रा॒सम॒मित्रे॑भ्यो व॒दाज्ये॑ना॒भिघा॑रितः"
  ],
  "lines_iast": [
   "vā̱na̱spa̱tyaḥ saṃbhṛ̭ta u̱sriyā̭bhirvi̱śvago̭tryaḥ",
   "pra̱trā̱sama̱mitrḙbhyo va̱dājyḙnā̱bhighā̭ritaḥ"
  ],
