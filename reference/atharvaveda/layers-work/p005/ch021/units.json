   "005.021.6b"
  ],
  "lines_deva": [
   "यथा॑ श्ये॒नात् प॑त॒त्रिणः॑ संवि॒जन्ते॒ अह॑र्दिवि सिं॒हस्य॑ स्त॒नथो॒र्यथा॑",
   "ए॒वा त्वं दु॑न्दुभे॒ऽमित्रा॑न॒भि क्र॑न्द॒ प्र त्रा॑स॒याथो॑ चि॒त्तानि॑ मोहय"
  ],
  "lines_iast": [
   "yathā̭ śye̱nāt pa̭ta̱triṇa̭ḥ saṃvi̱jante̱ aha̭rdivi si̱ṃhasya̭ sta̱natho̱ryathā̭",
   "e̱vā tvaṃ dṷndubhe̱'mitrā̭na̱bhi kra̭nda̱ pra trā̭sa̱yātho̭ ci̱ttāni̭ mohaya"
  ],
