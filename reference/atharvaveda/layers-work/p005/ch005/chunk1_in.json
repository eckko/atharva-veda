   "005.005.8b"
  ],
  "lines_deva": [
   "सि॒ला॒ची नाम॑ कानी॒नोऽज॑बभ्रु पि॒ता तव॑",
   "अश्वो॑ य॒मस्य॒ यः श्या॒वस्तस्य॑ हा॒स्नास्यु॑क्षि॒ता"
  ],
  "lines_iast": [
   "si̱lā̱cī nāma̭ kānī̱no'ja̭babhru pi̱tā tava̭",
   "aśvo̭ ya̱masya̱ yaḥ śyā̱vastasya̭ hā̱snāsyṷkṣi̱tā"
  ],
