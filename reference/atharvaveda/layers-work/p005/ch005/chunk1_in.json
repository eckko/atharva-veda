  "lines_deva": [
   "भ॒द्रात् प्ल॒क्षान्निस्ति॑ष्ठस्यश्व॒त्थात् ख॑दि॒राद्ध॒वात्",
   "भ॒द्रान्न्य॒ग्रोधा॑त् प॒र्णात् सा न॒ एह्य॑रुन्धति"
  ],
  "lines_iast": [
   "bha̱drāt pla̱kṣānnisti̭ṣṭhasyaśva̱tthāt kha̭di̱rāddha̱vāt",
   "bha̱drānnya̱grodhā̭t pa̱rṇāt sā na̱ ehya̭rundhati"
  ],
