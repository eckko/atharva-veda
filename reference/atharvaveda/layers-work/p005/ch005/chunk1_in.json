  "lines_deva": [
   "अश्व॑स्या॒स्नः संप॑तिता॒ सा वृ॒क्षां अ॒भि सि॑ष्यदे",
   "स॒रा प॑त॒त्रिणी॑ भू॒त्वा सा न॒ एह्य॑रुन्धति"
  ],
  "lines_iast": [
   "aśva̭syā̱snaḥ saṃpa̭titā̱ sā vṛ̱kṣāṃ a̱bhi si̭ṣyade",
   "sa̱rā pa̭ta̱triṇī̭ bhū̱tvā sā na̱ ehya̭rundhati"
  ],
