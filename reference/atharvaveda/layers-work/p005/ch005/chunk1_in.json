   "005.005.2b"
  ],
  "lines_deva": [
   "यस्त्वा॒ पिब॑ति॒ जीव॑ति॒ त्राय॑से॒ पुरु॑षं॒ त्वम्",
   "भ॒र्त्री हि शश्व॑ता॒मसि॒ जना॑नां च॒ न्यञ्च॑नी"
  ],
  "lines_iast": [
   "yastvā̱ piba̭ti̱ jīva̭ti̱ trāya̭se̱ purṷṣa̱ṃ tvam",
   "bha̱rtrī hi śaśva̭tā̱masi̱ janā̭nāṃ ca̱ nyañca̭nī"
  ],
