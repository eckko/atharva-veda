 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.005.3a",
   "005.005.3b"
  ],
  "lines_deva": [
   "वृ॒क्षंवृ॑क्ष॒मा रो॑हसि वृष॒ण्यन्ती॑व क॒न्यला॑",
   "जय॑न्ती प्रत्या॒तिष्ठ॑न्ती॒ स्पर॑णी॒ नाम॒ वा अ॑सि"
  ],
  "lines_iast": [
   "vṛ̱kṣaṃvṛ̭kṣa̱mā ro̭hasi vṛṣa̱ṇyantī̭va ka̱nyalā̭",
   "jaya̭ntī pratyā̱tiṣṭha̭ntī̱ spara̭ṇī̱ nāma̱ vā a̭si"
  ],
  "book_split": [
