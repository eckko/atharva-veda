  "lines_deva": [
   "यद् द॒ण्डेन॒ यदिष्वा॒ यद् वारु॒र्हर॑सा कृ॒तम्",
   "तस्य॒ त्वम॑सि॒ निष्कृ॑तिः॒ सेमं निष्कृ॑धि॒ पूरु॑षम्"
  ],
  "lines_iast": [
   "yad da̱ṇḍena̱ yadiṣvā̱ yad vāru̱rhara̭sā kṛ̱tam",
   "tasya̱ tvama̭si̱ niṣkṛ̭ti̱ḥ semaṃ niṣkṛ̭dhi̱ pūrṷṣam"
  ],
