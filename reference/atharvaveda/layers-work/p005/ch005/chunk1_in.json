  "lines_deva": [
   "हिर॑ण्यवर्णे॒ सुभ॑गे॒ शुष्मे॒ लोम॑शवक्षने",
   "अ॒पाम॑सि॒ स्वसा॒ लाक्षे॒ वातो॑ हा॒त्मा ब॑भूव ते"
  ],
  "lines_iast": [
   "hira̭ṇyavarṇe̱ subha̭ge̱ śuṣme̱ loma̭śavakṣane",
   "a̱pāma̭si̱ svasā̱ lākṣe̱ vāto̭ hā̱tmā ba̭bhūva te"
  ],
