  "lines_deva": [
   "हिर॑ण्यवर्णे॒ सुभ॑गे॒ सूर्य॑वर्णे॒ वपु॑ष्टमे",
   "रु॒तं ग॑छासि निष्कृते॒ निष्कृ॑ति॒र्नाम॒ वा अ॑सि"
  ],
  "lines_iast": [
   "hira̭ṇyavarṇe̱ subha̭ge̱ sūrya̭varṇe̱ vapṷṣṭame",
   "ru̱taṃ ga̭chāsi niṣkṛte̱ niṣkṛ̭ti̱rnāma̱ vā a̭si"
  ],
