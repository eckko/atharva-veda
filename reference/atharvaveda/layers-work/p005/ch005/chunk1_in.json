   "005.005.1a",
   "005.005.1b"
  ],
  "lines_deva": [
   "रात्री॑ मा॒ता नभः॑ पि॒तार्य॒मा ते॑ पिताम॒हः",
   "सि॒ला॒ची नाम॒ वा अ॑सि॒ सा दे॒वाना॑मसि॒ स्वसा॑"
  ],
  "lines_iast": [
   "rātrī̭ mā̱tā nabha̭ḥ pi̱tārya̱mā tḙ pitāma̱haḥ",
   "si̱lā̱cī nāma̱ vā a̭si̱ sā de̱vānā̭masi̱ svasā̭"
  ],
  "book_split": [
