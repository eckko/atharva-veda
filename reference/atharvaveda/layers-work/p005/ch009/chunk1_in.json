 {
  "n": "8",
  "type": "verse",
  "line_ids": [
   "005.009.8a",
   "005.009.8b",
   "005.009.8c"
  ],
  "lines_deva": [
   "उदायु॒रुद् बल॒मुत् कृ॒तमुत् कृ॒त्यामुन्म॑नी॒षामुदि॑न्द्रि॒यम्",
   "आयु॑ष्कृ॒दायु॑ष्पत्नी॒ स्वधा॑वन्तौ गो॒पा मे॑ स्तं गोपा॒यतं॑ मा",
   "आ॒त्म॒सदौ॑ मे स्तं॒ मा॑ हिंसिष्टम्"
  ],
  "lines_iast": [
   "udāyu̱rud bala̱mut kṛ̱tamut kṛ̱tyāmunma̭nī̱ṣāmudi̭ndri̱yam",
   "āyṷṣkṛ̱dāyṷṣpatnī̱ svadhā̭vantau go̱pā mḙ staṃ gopā̱yata̭ṃ mā",
   "ā̱tma̱sadaṷ me sta̱ṃ mā̭ hiṃsiṣṭam"
  ],
