  "lines_deva": [
   "इन्द्रा या॑हि मे॒ हव॑मि॒दं क॑रिष्यामि॒ तच्छृ॑णु",
   "इ॒म ऐ॒न्द्रा अ॑तिस॒रा आकू॑तिं॒ सं न॑मन्तु मे",
   "तेभिः॑ शकेम वी॒र्यं१ जात॑वेद॒स्तनू॑वशिन्"
  ],
  "lines_iast": [
   "indrā yā̭hi me̱ hava̭mi̱daṃ ka̭riṣyāmi̱ tacchṛ̭ṇu",
   "i̱ma ai̱ndrā a̭tisa̱rā ākṷ̄ti̱ṃ saṃ na̭mantu me",
   "tebhi̭ḥ śakema vī̱ryaṃ1 jāta̭veda̱stanṷ̄vaśin"
  ],
