  "lines_deva": [
   "अति॑ धावतातिसरा॒ इन्द्र॑स्य॒ वच॑सा हत",
   "अविं॒ वृक॑ इव मथ्नीत॒ स वो॒ जीव॒न्मा मो॑चि प्रा॒णम॒स्यापि॑ नह्यत"
  ],
  "lines_iast": [
   "ati̭ dhāvatātisarā̱ indra̭sya̱ vaca̭sā hata",
   "avi̱ṃ vṛka̭ iva mathnīta̱ sa vo̱ jīva̱nmā mo̭ci prā̱ṇama̱syāpi̭ nahyata"
  ],
