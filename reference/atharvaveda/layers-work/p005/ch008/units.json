   "मा तस्या॒ग्निर्ह॒व्यं वा॑क्षी॒द्धवं॑ दे॒वा अ॑स्य॒ मोप॑ गु॒र्ममै॒व हव॒मेत॑न"
  ],
  "lines_iast": [
   "yada̱sāva̱muto̭ devā ade̱vaḥ saṃścikī̭rṣati",
   "mā tasyā̱gnirha̱vyaṃ vā̭kṣī̱ddhava̭ṃ de̱vā a̭sya̱ mopa̭ gu̱rmamai̱va hava̱meta̭na"
  ],
