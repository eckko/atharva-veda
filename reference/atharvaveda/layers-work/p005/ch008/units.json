  "lines_deva": [
   "वै॒क॒ङ्क॒तेने॒ध्मेन॑ दे॒वेभ्य॒ आज्यं॑ वह",
   "अग्ने॒ ताँ इ॒ह मा॑दय॒ सर्व॑ आ य॑न्तु मे॒ हव॑म्"
  ],
  "lines_iast": [
   "vai̱ka̱ṅka̱tene̱dhmena̭ de̱vebhya̱ ājya̭ṃ vaha",
   "agne̱ tā~ i̱ha mā̭daya̱ sarva̭ ā ya̭ntu me̱ hava̭m"
  ],
