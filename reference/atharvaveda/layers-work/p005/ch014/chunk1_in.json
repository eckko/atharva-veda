 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.014.2a",
   "005.014.2b"
  ],
  "lines_deva": [
   "अव॑ जहि यातु॒धाना॒नव॑ कृत्या॒कृतं॑ जहि",
   "अथो॒ योअ॒स्मान् दिप्स॑ति॒ तमु॒ त्वं ज॑ह्योषधे"
  ],
  "lines_iast": [
   "ava̭ jahi yātu̱dhānā̱nava̭ kṛtyā̱kṛta̭ṃ jahi",
   "atho̱ yoa̱smān dipsa̭ti̱ tamu̱ tvaṃ ja̭hyoṣadhe"
  ],
