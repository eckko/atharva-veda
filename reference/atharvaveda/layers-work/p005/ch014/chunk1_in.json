 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "005.014.4a",
   "005.014.4b"
  ],
  "lines_deva": [
   "पुनः॑ कृ॒त्यां कृ॑त्या॒कृते॑ हस्त॒गृह्य॒ परा॑ णय",
   "स॒म॒क्षम॑स्मा॒ आ धे॑हि॒ यथा॑ कृत्या॒कृतं॒ हन॑त्"
  ],
  "lines_iast": [
   "puna̭ḥ kṛ̱tyāṃ kṛ̭tyā̱kṛtḙ hasta̱gṛhya̱ parā̭ ṇaya",
   "sa̱ma̱kṣama̭smā̱ ā dhḙhi̱ yathā̭ kṛtyā̱kṛta̱ṃ hana̭t"
  ],
  "book_split": [
