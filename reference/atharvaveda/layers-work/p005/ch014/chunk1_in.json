  "type": "verse",
  "line_ids": [
   "005.014.3a",
   "005.014.3b"
  ],
  "lines_deva": [
   "रिश्य॑स्येव परीशा॒सं प॑रि॒कृत्य॒ परि॑ त्व॒चः",
   "कृ॒त्यां कृ॑त्या॒कृते॑ देवा नि॒ष्कमि॑व॒ प्रति॑ मुञ्चत"
  ],
  "lines_iast": [
   "riśya̭syeva parīśā̱saṃ pa̭ri̱kṛtya̱ pari̭ tva̱caḥ",
   "kṛ̱tyāṃ kṛ̭tyā̱kṛtḙ devā ni̱ṣkami̭va̱ prati̭ muñcata"
  ],
  "book_split": [
