  "type": "verse",
  "line_ids": [
   "005.014.5a",
   "005.014.5b"
  ],
  "lines_deva": [
   "कृ॒त्याः स॑न्तु कृत्या॒कृते॑ श॒पथः॑ शपथीय॒ते",
   "सु॒खो रथ॑ इव वर्ततां कृ॒त्या कृ॑त्या॒कृतं॒ पुनः॑"
  ],
  "lines_iast": [
   "kṛ̱tyāḥ sa̭ntu kṛtyā̱kṛtḙ śa̱patha̭ḥ śapathīya̱te",
   "su̱kho ratha̭ iva vartatāṃ kṛ̱tyā kṛ̭tyā̱kṛta̱ṃ puna̭ḥ"
  ],
