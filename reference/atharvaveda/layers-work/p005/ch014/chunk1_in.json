  "lines_deva": [
   "कृत॑व्यधनि॒ विध्य॒ तं यश्च॒कार॒ तमिज्ज॑हि",
   "न त्वामच॑क्रुषे व॒यं व॒धाय॒ सं शि॑शीमहि"
  ],
  "lines_iast": [
   "kṛta̭vyadhani̱ vidhya̱ taṃ yaśca̱kāra̱ tamijja̭hi",
   "na tvāmaca̭kruṣe va̱yaṃ va̱dhāya̱ saṃ śi̭śīmahi"
  ],
