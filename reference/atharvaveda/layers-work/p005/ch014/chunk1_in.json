   "005.014.1a",
   "005.014.1b"
  ],
  "lines_deva": [
   "सु॒प॒र्णस्त्वान्व॑विन्दत् सूक॒रस्त्वा॑खन्न॒सा",
   "दिप्सौ॑षधे॒ त्वं दिप्स॑न्त॒मव॑ कृत्या॒कृतं॑ जहि"
  ],
  "lines_iast": [
   "su̱pa̱rṇastvānva̭vindat sūka̱rastvā̭khanna̱sā",
   "dipsaṷṣadhe̱ tvaṃ dipsa̭nta̱mava̭ kṛtyā̱kṛta̭ṃ jahi"
  ],
  "book_split": [
