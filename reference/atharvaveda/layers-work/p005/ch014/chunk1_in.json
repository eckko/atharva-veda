  "lines_deva": [
   "यदि॒ स्त्री यदि॑ वा॒ पुमा॑न् कृ॒त्यां च॒कार॑ पा॒प्मने॑",
   "तामु॒ तस्मै॑ नयाम॒स्यश्व॑मिवाश्वाभि॒धान्या॑"
  ],
  "lines_iast": [
   "yadi̱ strī yadi̭ vā̱ pumā̭n kṛ̱tyāṃ ca̱kāra̭ pā̱pmanḙ",
   "tāmu̱ tasmai̭ nayāma̱syaśva̭mivāśvābhi̱dhānyā̭"
  ],
