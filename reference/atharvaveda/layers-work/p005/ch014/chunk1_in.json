  "lines_deva": [
   "यदि॒ वासि॑ दे॒वकृ॑ता॒ यदि॑ वा॒ पुरु॑षैः कृ॒ता",
   "तां त्वा॒ पुन॑र्णयाम॒सीन्द्रे॑ण स॒युजा॑ व॒यम्"
  ],
  "lines_iast": [
   "yadi̱ vāsi̭ de̱vakṛ̭tā̱ yadi̭ vā̱ purṷṣaiḥ kṛ̱tā",
   "tāṃ tvā̱ puna̭rṇayāma̱sīndrḙṇa sa̱yujā̭ va̱yam"
  ],
