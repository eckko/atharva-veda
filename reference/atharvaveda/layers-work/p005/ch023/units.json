[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.023.1a",
   "005.023.1b"
  ],
  "lines_deva": [
   "ओते॑ मे॒ द्यावा॑पृथि॒वी ओता॑ दे॒वी सर॑स्वती",
   "ओतौ॑ म॒ इन्द्र॑श्चा॒ग्निश्च॒ क्रिमिं॑ जम्भयता॒मिति॑"
  ],
  "lines_iast": [
   "otḙ me̱ dyāvā̭pṛthi̱vī otā̭ de̱vī sara̭svatī",
   "otaṷ ma̱ indra̭ścā̱gniśca̱ krimi̭ṃ jambhayatā̱miti̭"
  ],
  "book_split": [
