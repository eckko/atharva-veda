   "005.023.9b"
  ],
  "lines_deva": [
   "त्रि॒शी॒र्षाणं॑ त्रिक॒कुदं॒ क्रिमिं॑ सा॒रङ्ग॒मर्जु॑नम्",
   "शृ॒णाम्य॑स्य पृ॒ष्टीरपि॑ वृश्चामि॒ यच्छिरः॑"
  ],
  "lines_iast": [
   "tri̱śī̱rṣāṇa̭ṃ trika̱kuda̱ṃ krimi̭ṃ sā̱raṅga̱marjṷnam",
   "śṛ̱ṇāmya̭sya pṛ̱ṣṭīrapi̭ vṛścāmi̱ yacchira̭ḥ"
  ],
