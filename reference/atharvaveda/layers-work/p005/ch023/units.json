 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.023.2a",
   "005.023.2b"
  ],
  "lines_deva": [
   "अ॒स्येन्द्र॑ कुमा॒रस्य॒ क्रिमी॑न् धनपते जहि",
   "ह॒ता विश्वा॒ अरा॑तय उ॒ग्रेण॒ वच॑सा॒ मम॑"
  ],
  "lines_iast": [
   "a̱syendra̭ kumā̱rasya̱ krimī̭n dhanapate jahi",
   "ha̱tā viśvā̱ arā̭taya u̱greṇa̱ vaca̭sā̱ mama̭"
  ],
