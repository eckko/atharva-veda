   "005.023.7b"
  ],
  "lines_deva": [
   "येवा॑षासः॒ कष्क॑षास एज॒त्काः शि॑पवित्नु॒काः",
   "दृ॒ष्टांश्च॑ ह॒न्यतां॑ क्रिमि॑रु॒तादृष्ट॑श्च हन्यताम्"
  ],
  "lines_iast": [
   "yevā̭ṣāsa̱ḥ kaṣka̭ṣāsa eja̱tkāḥ śi̭pavitnu̱kāḥ",
   "dṛ̱ṣṭāṃśca̭ ha̱nyatā̭ṃ krimi̭ru̱tādṛṣṭa̭śca hanyatām"
  ],
