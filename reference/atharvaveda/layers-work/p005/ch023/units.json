  "type": "verse",
  "line_ids": [
   "005.023.4a",
   "005.023.4b"
  ],
  "lines_deva": [
   "सरू॑पौ॒ द्वौ विरू॑पौ॒ द्वौ कृ॒ष्णौ द्वौ रोहि॑तौ॒ द्वौ",
   "ब॒भ्रुश्च॑ ब॒भ्रुक॑र्णश्च॒ गृध्रः॒ कोक॑श्च॒ ते ह॒ताः"
  ],
  "lines_iast": [
   "sarṷ̄pau̱ dvau virṷ̄pau̱ dvau kṛ̱ṣṇau dvau rohi̭tau̱ dvau",
   "ba̱bhruśca̭ ba̱bhruka̭rṇaśca̱ gṛdhra̱ḥ koka̭śca̱ te ha̱tāḥ"
  ],
  "book_split": [
