   "005.023.13b"
  ],
  "lines_deva": [
   "सर्वे॑षां च॒ क्रिमी॑णां॒ सर्वा॑सां च क्रि॒मीना॑म्",
   "भि॒नद्म्यश्म॑ना॒ शिरो॒ दहा॑म्य॒ग्निना॒ मुख॑म्"
  ],
  "lines_iast": [
   "sarvḙṣāṃ ca̱ krimī̭ṇā̱ṃ sarvā̭sāṃ ca kri̱mīnā̭m",
   "bhi̱nadmyaśma̭nā̱ śiro̱ dahā̭mya̱gninā̱ mukha̭m"
  ],
