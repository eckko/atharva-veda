   "005.023.6b"
  ],
  "lines_deva": [
   "उत् पु॒रस्ता॒त् सूर्य॑ एति वि॒श्वदृ॑ष्टो अदृष्ट॒हा",
   "दृ॒ष्टांश्च॒ घ्नन्न॒दॄष्टां॑श्च॒ सर्वां॑श्च प्रमृ॒णन् क्रिमी॑न्"
  ],
  "lines_iast": [
   "ut pu̱rastā̱t sūrya̭ eti vi̱śvadṛ̭ṣṭo adṛṣṭa̱hā",
   "dṛ̱ṣṭāṃśca̱ ghnanna̱dṝṣṭā̭ṃśca̱ sarvā̭ṃśca pramṛ̱ṇan krimī̭n"
  ],
