 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "005.023.3a",
   "005.023.3b"
  ],
  "lines_deva": [
   "यो अ॒क्ष्यौऽपरि॒सर्प॑ति॒ यो नासे॑ परि॒सर्प॑ति",
   "द॒तां यो मध्यं॒ गच्छ॑ति॒ तं क्रिमिं॑ जम्भयामसि"
  ],
  "lines_iast": [
   "yo a̱kṣyau'pari̱sarpa̭ti̱ yo nāsḙ pari̱sarpa̭ti",
   "da̱tāṃ yo madhya̱ṃ gaccha̭ti̱ taṃ krimi̭ṃ jambhayāmasi"
  ],
