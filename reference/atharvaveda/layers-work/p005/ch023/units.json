 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "005.023.5a",
   "005.023.5b"
  ],
  "lines_deva": [
   "ये क्रिम॑यः शिति॒कक्षा॒ ये कृ॒ष्णाः शि॑ति॒बाह॑वः",
   "ये के च॑ वि॒श्वरू॑पा॒स्तान् क्रिमी॑न् जम्भयामसि"
  ],
  "lines_iast": [
   "ye krima̭yaḥ śiti̱kakṣā̱ ye kṛ̱ṣṇāḥ śi̭ti̱bāha̭vaḥ",
   "ye ke ca̭ vi̱śvarṷ̄pā̱stān krimī̭n jambhayāmasi"
  ],
