   "005.023.10b"
  ],
  "lines_deva": [
   "अ॒त्रि॒वद् वः॑ क्रिमयो हन्मि कण्व॒वज्ज॑मदग्नि॒वत्",
   "अ॒गस्त्य॑स्य॒ ब्रह्म॑णा॒ सं पि॑नष्म्य॒हं क्रिमी॑न्"
  ],
  "lines_iast": [
   "a̱tri̱vad va̭ḥ krimayo hanmi kaṇva̱vajja̭madagni̱vat",
   "a̱gastya̭sya̱ brahma̭ṇā̱ saṃ pi̭naṣmya̱haṃ krimī̭n"
  ],
