   "005.023.8b"
  ],
  "lines_deva": [
   "ह॒तो येवा॑षः॒ क्रिमी॑णां ह॒तो न॑दनि॒मोत",
   "सर्वा॒न् नि म॑ष्म॒षाक॑रं दृ॒षदा॒ खल्वाँ॑ इव"
  ],
  "lines_iast": [
   "ha̱to yevā̭ṣa̱ḥ krimī̭ṇāṃ ha̱to na̭dani̱mota",
   "sarvā̱n ni ma̭ṣma̱ṣāka̭raṃ dṛ̱ṣadā̱ khalvā̭~ iva"
  ],
