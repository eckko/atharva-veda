  "lines_deva": [
   "उ॒त्त॒मो नाम॑ कुष्ठस्युत्त॒मो नाम॑ ते पि॒ता",
   "यक्ष्मं॑ च॒ सर्वं॑ ना॒शय॑ त॒क्मानं॑ चार॒सं कृ॑धि"
  ],
  "lines_iast": [
   "u̱tta̱mo nāma̭ kuṣṭhasyutta̱mo nāma̭ te pi̱tā",
   "yakṣma̭ṃ ca̱ sarva̭ṃ nā̱śaya̭ ta̱kmāna̭ṃ cāra̱saṃ kṛ̭dhi"
  ],
