  "lines_deva": [
   "इ॒मं मे॑ कुष्ठ॒ पूरु॑षं॒ तमा व॑ह॒ तं निष्कु॑रु",
   "तमु॑ मे अग॒दं कृ॑धि"
  ],
  "lines_iast": [
   "i̱maṃ mḙ kuṣṭha̱ pūrṷṣa̱ṃ tamā va̭ha̱ taṃ niṣkṷru",
   "tamṷ me aga̱daṃ kṛ̭dhi"
  ],
