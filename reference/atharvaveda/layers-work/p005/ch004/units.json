   "005.004.5b"
  ],
  "lines_deva": [
   "हि॒र॒ण्ययाः॒ पन्था॑न आस॒न्नरि॑त्राणि हिर॒ण्यया॑",
   "नावो॑ हिर॒ण्ययी॑रास॒न् याभिः॒ कुष्ठं॑ नि॒राव॑हन्"
  ],
  "lines_iast": [
   "hi̱ra̱ṇyayā̱ḥ panthā̭na āsa̱nnari̭trāṇi hira̱ṇyayā̭",
   "nāvo̭ hira̱ṇyayī̭rāsa̱n yābhi̱ḥ kuṣṭha̭ṃ ni̱rāva̭han"
  ],
