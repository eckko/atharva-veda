   "005.004.2b"
  ],
  "lines_deva": [
   "सु॒प॒र्ण॒सुव॑ने गि॒रौ जा॒तं हि॒मव॑त॒स्परि॑",
   "धनै॑र॒भि श्रु॒त्वा य॑न्ति वि॒दुर्हि त॑क्म॒नाश॑नम्"
  ],
  "lines_iast": [
   "su̱pa̱rṇa̱suva̭ne gi̱rau jā̱taṃ hi̱mava̭ta̱spari̭",
   "dhanai̭ra̱bhi śru̱tvā ya̭nti vi̱durhi ta̭kma̱nāśa̭nam"
  ],
