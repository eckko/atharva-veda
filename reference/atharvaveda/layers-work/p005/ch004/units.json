   "005.004.7a",
   "005.004.7b"
  ],
  "lines_deva": [
   "दे॒वेभ्यो॒ अधि॑ जा॒तोऽसि॒ सोम॑स्यासि॒ सखा॑ हि॒तः",
   "स प्रा॒णाय॑ व्या॒नाय॒ च॑क्षुषे मे अ॒स्मै मृ॑ड"
  ],
  "lines_iast": [
   "de̱vebhyo̱ adhi̭ jā̱to'si̱ soma̭syāsi̱ sakhā̭ hi̱taḥ",
   "sa prā̱ṇāya̭ vyā̱nāya̱ ca̭kṣuṣe me a̱smai mṛ̭ḍa"
  ],
