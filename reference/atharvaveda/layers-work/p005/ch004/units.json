  "lines_deva": [
   "उद॑ङ् जा॒तो हि॒मव॑तः॒ स प्रा॒च्यां नी॑यसे॒ जन॑म्",
   "तत्र॑ कुष्ठ॑स्य॒ नामा॑न्युत्त॒मानि॒ वि भे॑जिरे"
  ],
  "lines_iast": [
   "uda̭ṅ jā̱to hi̱mava̭ta̱ḥ sa prā̱cyāṃ nī̭yase̱ jana̭m",
   "tatra̭ kuṣṭha̭sya̱ nāmā̭nyutta̱māni̱ vi bhḙjire"
  ],
