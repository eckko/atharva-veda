   "005.004.4b"
  ],
  "lines_deva": [
   "हि॒र॒ण्ययी॒ नौर॑चर॒द्धिर॑ण्यबन्धना दि॒वि",
   "तत्रा॒मृत॑स्य॒ पुष्पं॑ दे॒वाः कुष्ठ॑मवन्वत"
  ],
  "lines_iast": [
   "hi̱ra̱ṇyayī̱ naura̭cara̱ddhira̭ṇyabandhanā di̱vi",
   "tatrā̱mṛta̭sya̱ puṣpa̭ṃ de̱vāḥ kuṣṭha̭mavanvata"
  ],
