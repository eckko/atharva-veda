   "005.004.1a",
   "005.004.1b"
  ],
  "lines_deva": [
   "यो गि॒रिष्वजा॑यथा वी॒रुधां॒ बल॑वत्तमः",
   "कुष्ठेहि॑ तक्मनाशन त॒क्मानं॑ ना॒शय॑न्नि॒तः"
  ],
  "lines_iast": [
   "yo gi̱riṣvajā̭yathā vī̱rudhā̱ṃ bala̭vattamaḥ",
   "kuṣṭhehi̭ takmanāśana ta̱kmāna̭ṃ nā̱śaya̭nni̱taḥ"
  ],
