  "lines_deva": [
   "दे॒वा वा ए॒तस्या॑मवदन्त॒ पूर्वे॑ सप्तऋ॒षय॒स्तप॑सा॒ ये नि॑षे॒दुः",
   "भी॒मा जा॒या ब्रा॑ह्म॒णस्याप॑नीता दु॒र्धां द॑धाति पर॒मेव्योऽमन्"
  ],
  "lines_iast": [
   "de̱vā vā e̱tasyā̭mavadanta̱ pūrvḙ saptaṛ̱ṣaya̱stapa̭sā̱ ye ni̭ṣe̱duḥ",
   "bhī̱mā jā̱yā brā̭hma̱ṇasyāpa̭nītā du̱rdhāṃ da̭dhāti para̱mevyo'man"
  ],
