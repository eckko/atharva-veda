  "lines_deva": [
   "ये गर्भा॑ अव॒पद्य॑न्ते॒ जग॒द् यच्चा॑पलु॒प्यते॑",
   "वी॒रा ये तृ॒ह्यन्ते॑ मि॒थो ब्र॑ह्मजा॒या हि॑नस्ति॒ तान्"
  ],
  "lines_iast": [
   "ye garbhā̭ ava̱padya̭nte̱ jaga̱d yaccā̭palu̱pyatḙ",
   "vī̱rā ye tṛ̱hyantḙ mi̱tho bra̭hmajā̱yā hi̭nasti̱ tān"
  ],
