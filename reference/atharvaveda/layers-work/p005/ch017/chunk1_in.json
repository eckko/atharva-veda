 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "005.017.2a",
   "005.017.2b"
  ],
  "lines_deva": [
   "सोमो॒ राजा॑ प्रथ॒मो ब्र॑ह्मजा॒यां पुनः॒ प्राय॑च्छ॒दहृ॑णीयमानः",
   "अ॒न्व॒र्ति॒ता वरु॑णो मि॒त्र आ॑सीद॒ग्निर्होता॑ हस्त॒गृह्या नि॑नाय"
  ],
  "lines_iast": [
   "somo̱ rājā̭ pratha̱mo bra̭hmajā̱yāṃ puna̱ḥ prāya̭ccha̱dahṛ̭ṇīyamānaḥ",
   "a̱nva̱rti̱tā varṷṇo mi̱tra ā̭sīda̱gnirhotā̭ hasta̱gṛhyā ni̭nāya"
  ],
