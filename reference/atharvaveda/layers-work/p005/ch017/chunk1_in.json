[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "005.017.1a",
   "005.017.1b"
  ],
  "lines_deva": [
   "तेऽवदन् प्रथ॒मा ब्र॑ह्मकिल्बि॒षेऽकू॑पारः सलि॒लो मा॑त॒रिश्वा॑",
   "वी॒डुह॑रा॒स्तप॑ उ॒ग्रं म॑यो॒भूरापो॑ दे॒वीः प्र॑थम॒जा ऋ॒तस्य॑"
  ],
  "lines_iast": [
   "te'vadan pratha̱mā bra̭hmakilbi̱ṣe'kṷ̄pāraḥ sali̱lo mā̭ta̱riśvā̭",
   "vī̱ḍuha̭rā̱stapa̭ u̱graṃ ma̭yo̱bhūrāpo̭ de̱vīḥ pra̭thama̱jā ṛ̱tasya̭"
  ],
