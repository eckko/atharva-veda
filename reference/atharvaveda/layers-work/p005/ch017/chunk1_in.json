  "lines_deva": [
   "ब्र॒ह्म॒चा॒री च॑रति॒ वेवि॑ष॒द् विषः॒ स दे॒वानां॑ भव॒त्येक॒मङ्ग॑म्",
   "तेन॑ जा॒या मन्व॑विन्द॒द् बृह॒स्पतिः॒ सोमे॑न नी॒तां जु॒ह्वं१ न दे॑वाः"
  ],
  "lines_iast": [
   "bra̱hma̱cā̱rī ca̭rati̱ vevi̭ṣa̱d viṣa̱ḥ sa de̱vānā̭ṃ bhava̱tyeka̱maṅga̭m",
   "tena̭ jā̱yā manva̭vinda̱d bṛha̱spati̱ḥ somḙna nī̱tāṃ ju̱hvaṃ1 na dḙvāḥ"
  ],
