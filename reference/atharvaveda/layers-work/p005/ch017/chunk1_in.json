   "005.017.4b"
  ],
  "lines_deva": [
   "यामा॒हुस्तार॑कै॒षा वि॑के॒शीति॑ दु॒च्छुनां॒ ग्राम॑मव॒पद्य॑मानाम्",
   "सा ब्र॑ह्मजा॒या वि दु॑नोति रा॒ष्ट्रं यत्र॒ प्रापा॑दि श॒श उ॑ल्कु॒षीमा॑न्"
  ],
  "lines_iast": [
   "yāmā̱hustāra̭kai̱ṣā vi̭ke̱śīti̭ du̱cchunā̱ṃ grāma̭mava̱padya̭mānām",
   "sā bra̭hmajā̱yā vi dṷnoti rā̱ṣṭraṃ yatra̱ prāpā̭di śa̱śa ṷlku̱ṣīmā̭n"
  ],
