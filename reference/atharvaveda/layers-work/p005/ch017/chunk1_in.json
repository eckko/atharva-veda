   "005.017.3b"
  ],
  "lines_deva": [
   "हस्ते॑नै॒व ग्रा॒ह्यऽआ॒धिर॑स्या ब्रह्मजा॒येति॒ चेदवो॑चत्",
   "न दू॒ताय॑ प्र॒हेया॑ तस्थ ए॒षा तथा॑ रा॒ष्ट्रं गु॑पि॒तं क्ष॒त्रिय॑स्य"
  ],
  "lines_iast": [
   "hastḙnai̱va grā̱hya'ā̱dhira̭syā brahmajā̱yeti̱ cedavo̭cat",
   "na dū̱tāya̭ pra̱heyā̭ tastha e̱ṣā tathā̭ rā̱ṣṭraṃ gṷpi̱taṃ kṣa̱triya̭sya"
  ],
