  "lines_deva": [
   "अप॑ नः॒ शोशु॑चद॒घमग्ने॑ शुशु॒ग्ध्या र॒यिम्",
   "अप॑ नः॒ शोशु॑चद॒घम्"
  ],
  "lines_iast": [
   "apa̭ na̱ḥ śośṷcada̱ghamagnḙ śuśu̱gdhyā ra̱yim",
   "apa̭ na̱ḥ śośṷcada̱gham"
  ],
