  "lines_deva": [
   "दि॒वि जा॒तः स॑मुद्र॒जः सि॑न्धु॒तस्पर्याभृ॑तः",
   "स नो॑ हिरण्य॒जाः श॒ङ्ख आ॑युष्प्र॒तर॑णो म॒णिः"
  ],
  "lines_iast": [
   "di̱vi jā̱taḥ sa̭mudra̱jaḥ si̭ndhu̱tasparyābhṛ̭taḥ",
   "sa no̭ hiraṇya̱jāḥ śa̱ṅkha ā̭yuṣpra̱tara̭ṇo ma̱ṇiḥ"
  ],
