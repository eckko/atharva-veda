  "lines_deva": [
   "स॒मु॒द्राज्जा॒तो म॒णिर्वृ॒त्राज्जा॒तो दि॑वाक॒रः",
   "सो अ॒स्मान्त्स॒र्वतः॑ पातु हे॒त्या दे॑वासु॒रेभ्यः॑"
  ],
  "lines_iast": [
   "sa̱mu̱drājjā̱to ma̱ṇirvṛ̱trājjā̱to di̭vāka̱raḥ",
   "so a̱smāntsa̱rvata̭ḥ pātu he̱tyā dḙvāsu̱rebhya̭ḥ"
  ],
