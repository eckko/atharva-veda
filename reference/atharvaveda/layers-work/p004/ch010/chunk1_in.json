   "004.010.6a",
   "004.010.6b"
  ],
  "lines_deva": [
   "हिर॑ण्याना॒मेको॑ऽसि॒ सोमा॒त् त्वमधि॑ जज्ञिषे",
   "रथे॒ त्वम॑सि दर्श॒त॑ इ॑षु॒धौ रो॑च॒नस्त्वं प्र ण॒ आयूं॑षि तारिषत्"
  ],
  "lines_iast": [
   "hira̭ṇyānā̱meko̭'si̱ somā̱t tvamadhi̭ jajñiṣe",
   "rathe̱ tvama̭si darśa̱ta̭ i̭ṣu̱dhau ro̭ca̱nastvaṃ pra ṇa̱ āyṷ̄ṃṣi tāriṣat"
  ],
