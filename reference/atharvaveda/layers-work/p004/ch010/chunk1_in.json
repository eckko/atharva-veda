   "004.010.1b"
  ],
  "lines_deva": [
   "वाता॑ज्जा॒तो अ॒न्तरि॑क्षाद् वि॒द्युतो॒ ज्योति॑ष॒स्परि",
   "स नो॑ हिरण्य॒जाः श॒ङ्खः कृश॑नः पा॒त्वंह॑सः"
  ],
  "lines_iast": [
   "vātā̭jjā̱to a̱ntari̭kṣād vi̱dyuto̱ jyoti̭ṣa̱spari",
   "sa no̭ hiraṇya̱jāḥ śa̱ṅkhaḥ kṛśa̭naḥ pā̱tvaṃha̭saḥ"
  ],
