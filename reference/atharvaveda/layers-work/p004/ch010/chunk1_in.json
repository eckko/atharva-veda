   "004.010.7b"
  ],
  "lines_deva": [
   "दे॒वाना॒मस्थि॒ कृश॑नं बभूव॒ तदा॑त्म॒न्वच्च॑रत्य॒प्स्व॑१न्तः",
   "तत् ते॑ बध्ना॒म्यायु॑षे॒ वर्च॑से॒ बला॑य दीर्घायु॒त्वाय॑ श॒तशा॑रदाय कार्श॒नस्त्वा॒भि र॑क्षतु"
  ],
  "lines_iast": [
   "de̱vānā̱masthi̱ kṛśa̭naṃ babhūva̱ tadā̭tma̱nvacca̭ratya̱psva̭1ntaḥ",
   "tat tḙ badhnā̱myāyṷṣe̱ varca̭se̱ balā̭ya dīrghāyu̱tvāya̭ śa̱taśā̭radāya kārśa̱nastvā̱bhi ra̭kṣatu"
  ],
