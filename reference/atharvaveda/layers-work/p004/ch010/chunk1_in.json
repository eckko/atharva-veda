 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "004.010.2a",
   "004.010.2b"
  ],
  "lines_deva": [
   "यो अ॑ग्र॒तो रो॑च॒नानां॑ समु॒द्रादधि॑ जज्ञि॒षे",
   "श॒ङ्खेन॑ ह॒त्वा रक्षां॑स्य॒त्त्रिणो॒ वि ष॑हामहे"
  ],
  "lines_iast": [
   "yo a̭gra̱to ro̭ca̱nānā̭ṃ samu̱drādadhi̭ jajñi̱ṣe",
   "śa̱ṅkhena̭ ha̱tvā rakṣā̭ṃsya̱ttriṇo̱ vi ṣa̭hāmahe"
  ],
