   "004.010.3b"
  ],
  "lines_deva": [
   "श॒ङ्खेनामी॑वा॒मम॑तिं श॒ङ्खेनो॒त सदान्वाः॑",
   "श॒ङ्खो नो॑ वि॒श्वभे॑षजः॒ कृश॑नः पा॒त्वंह॑सः"
  ],
  "lines_iast": [
   "śa̱ṅkhenāmī̭vā̱mama̭tiṃ śa̱ṅkheno̱ta sadānvā̭ḥ",
   "śa̱ṅkho no̭ vi̱śvabhḙṣaja̱ḥ kṛśa̭naḥ pā̱tvaṃha̭saḥ"
  ],
