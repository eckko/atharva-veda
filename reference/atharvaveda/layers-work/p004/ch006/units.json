 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "004.006.1a",
   "004.006.1b"
  ],
  "lines_deva": [
   "ब्रा॒ह्म॒णो ज॑ज्ञे प्रथ॒मो दश॑शीर्षो॒ दशा॑स्यः",
   "स सोमं॑ प्रथ॒मः प॑पौ॒ स चकारार॒सं वि॒षम्"
  ],
  "lines_iast": [
   "brā̱hma̱ṇo ja̭jñe pratha̱mo daśa̭śīrṣo̱ daśā̭syaḥ",
   "sa soma̭ṃ pratha̱maḥ pa̭pau̱ sa cakārāra̱saṃ vi̱ṣam"
  ],
