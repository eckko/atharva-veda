  "type": "verse",
  "line_ids": [
   "004.006.5a",
   "004.006.5b"
  ],
  "lines_deva": [
   "श॒ल्याद्वि॒षं निर॑वोचं प्राञ्ज॑नादु॒त प॒र्ण॒धेः",
   "अ॒पा॒ष्ठाच्छृङ्गा॒त्कुल्म॑ला॒न्निर॑वोचमहं वि॒ष॑म्"
  ],
  "lines_iast": [
   "śa̱lyādvi̱ṣaṃ nira̭vocaṃ prāñja̭nādu̱ta pa̱rṇa̱dheḥ",
   "a̱pā̱ṣṭhācchṛṅgā̱tkulma̭lā̱nnira̭vocamahaṃ vi̱ṣa̭m"
  ],
