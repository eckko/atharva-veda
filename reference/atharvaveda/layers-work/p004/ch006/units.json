   "004.006.4b"
  ],
  "lines_deva": [
   "यस्त॒ आस्य॒त् पञ्चा॑ङ्गुरिर्व॒क्राच्चि॒दधि॒ धन्व॑नः",
   "अ॒प॒स्क॒म्भस्य॑ श॒ल्यान्निर॑वोचम॒हं वि॒षम्"
  ],
  "lines_iast": [
   "yasta̱ āsya̱t pañcā̭ṅgurirva̱krācci̱dadhi̱ dhanva̭naḥ",
   "a̱pa̱ska̱mbhasya̭ śa̱lyānnira̭vocama̱haṃ vi̱ṣam"
  ],
  "book_split": [
