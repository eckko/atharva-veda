   "004.006.6b"
  ],
  "lines_deva": [
   "अ॒र॒सस्त॑ इषो श॒ल्योऽथो॑ ते अ॒र॒सं वि॒षम्",
   "उ॒तार॒सस्य॑ वृ॒क्षस्य॒ धनु॑ष्टे अरसार॒सम्"
  ],
  "lines_iast": [
   "a̱ra̱sasta̭ iṣo śa̱lyo'tho̭ te a̱ra̱saṃ vi̱ṣam",
   "u̱tāra̱sasya̭ vṛ̱kṣasya̱ dhanṷṣṭe arasāra̱sam"
  ],
