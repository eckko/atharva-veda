   "004.006.7a",
   "004.006.7b"
  ],
  "lines_deva": [
   "ये अपी॑ष॒न् ये अदि॑ह॒न् य आस्य॒न् ये अ॒वासृ॑जन्",
   "सर्वे॒ ते वध्र॑यः कृ॒ता वध्रि॑र्विषगि॒रिः कृतः"
  ],
  "lines_iast": [
   "ye apī̭ṣa̱n ye adi̭ha̱n ya āsya̱n ye a̱vāsṛ̭jan",
   "sarve̱ te vadhra̭yaḥ kṛ̱tā vadhri̭rviṣagi̱riḥ kṛtaḥ"
  ],
