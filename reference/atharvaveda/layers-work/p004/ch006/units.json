 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "004.006.2a",
   "004.006.2b"
  ],
  "lines_deva": [
   "याव॑ती॒ द्यावा॑पृथि॒वी व॑रि॒म्णा यावत् स॒प्त सिन्ध॑वो वितष्ठि॒रे",
   "वाचं॑ वि॒षस्य॒ दूष॑णीं॒ तामि॒तो निर॑वादिषम्"
  ],
  "lines_iast": [
   "yāva̭tī̱ dyāvā̭pṛthi̱vī va̭ri̱mṇā yāvat sa̱pta sindha̭vo vitaṣṭhi̱re",
   "vāca̭ṃ vi̱ṣasya̱ dūṣa̭ṇī̱ṃ tāmi̱to nira̭vādiṣam"
  ],
