   "004.006.8b"
  ],
  "lines_deva": [
   "वध्र॑यस्ते खनि॒तारो॒ वध्रि॒स्त्वम॑स्योषधे",
   "वध्रिः॒ स पर्व॑तो गि॒रिर्यतो॑ जा॒तमि॒दं वि॒षम्"
  ],
  "lines_iast": [
   "vadhra̭yaste khani̱tāro̱ vadhri̱stvama̭syoṣadhe",
   "vadhri̱ḥ sa parva̭to gi̱riryato̭ jā̱tami̱daṃ vi̱ṣam"
  ],
