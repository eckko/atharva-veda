 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.006.3a",
   "004.006.3b"
  ],
  "lines_deva": [
   "सु॒प॒र्णस्त्वा॑ ग॒रुत्मा॒न्विष॑ प्रथ॒ममा॑वयत्",
   "नामी॑मदो॒ नारू॑रुप उ॒तास्मा॑ अभवः पि॒तुः"
  ],
  "lines_iast": [
   "su̱pa̱rṇastvā̭ ga̱rutmā̱nviṣa̭ pratha̱mamā̭vayat",
   "nāmī̭mado̱ nārṷ̄rupa u̱tāsmā̭ abhavaḥ pi̱tuḥ"
  ],
