 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.018.3a",
   "004.018.3b"
  ],
  "lines_deva": [
   "अ॒मा कृ॒त्वा पा॒प्मानं॒ यस्तेना॒न्यं जिघां॑सति",
   "अश्मा॑न॒स्तस्यां॑ द॒ग्धायां॑ बहु॒लाः फट् क॑रिक्रति"
  ],
  "lines_iast": [
   "a̱mā kṛ̱tvā pā̱pmāna̱ṃ yastenā̱nyaṃ jighā̭ṃsati",
   "aśmā̭na̱stasyā̭ṃ da̱gdhāyā̭ṃ bahu̱lāḥ phaṭ ka̭rikrati"
  ],
  "book_split": [
