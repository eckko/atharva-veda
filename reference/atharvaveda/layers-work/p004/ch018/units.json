   "004.018.6b"
  ],
  "lines_deva": [
   "यश्च॒कार॒ न श॒शाक॒ कर्तुं॑ श॒श्रे पाद॑म॒ङ्गुरि॑म्",
   "च॒कार॑ भ॒द्रम॒स्मभ्य॑मा॒त्मने॒ तप॑नं॒ तु सः"
  ],
  "lines_iast": [
   "yaśca̱kāra̱ na śa̱śāka̱ kartṷṃ śa̱śre pāda̭ma̱ṅguri̭m",
   "ca̱kāra̭ bha̱drama̱smabhya̭mā̱tmane̱ tapa̭na̱ṃ tu saḥ"
  ],
