[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "004.018.1a",
   "004.018.1b"
  ],
  "lines_deva": [
   "स॒मं ज्योतिः॒ सूर्ये॒णाह्ना॒ रात्री॑ स॒मावती॑",
   "कृ॒णोमि॑ स॒त्यमू॒तये॑ऽर॒साः स॑न्तु॒ कृत्व॑रीः"
  ],
  "lines_iast": [
   "sa̱maṃ jyoti̱ḥ sūrye̱ṇāhnā̱ rātrī̭ sa̱māvatī̭",
   "kṛ̱ṇomi̭ sa̱tyamū̱tayḙ'ra̱sāḥ sa̭ntu̱ kṛtva̭rīḥ"
  ],
