 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "004.018.2a",
   "004.018.2b"
  ],
  "lines_deva": [
   "यो दे॑वाः कृ॒त्यां कृ॒त्वा हरा॒दवि॑दुषो गृ॒हम्",
   "व॒त्सो धा॒रुरि॑व मा॒तरं॒ तं प्र॒त्यगुप॑ पद्यताम्"
  ],
  "lines_iast": [
   "yo dḙvāḥ kṛ̱tyāṃ kṛ̱tvā harā̱davi̭duṣo gṛ̱ham",
   "va̱tso dhā̱ruri̭va mā̱tara̱ṃ taṃ pra̱tyagupa̭ padyatām"
  ],
  "book_split": [
