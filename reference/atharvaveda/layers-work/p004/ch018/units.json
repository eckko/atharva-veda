 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "004.018.4a",
   "004.018.4b"
  ],
  "lines_deva": [
   "सह॑स्रधाम॒न् विशि॑खा॒न् विग्री॑वां छायया॒ त्वम्",
   "प्रति॑ स्म च॒क्रुषे॑ कृ॒त्यां प्रि॒यां प्रि॒याव॑ते हर"
  ],
  "lines_iast": [
   "saha̭sradhāma̱n viśi̭khā̱n vigrī̭vāṃ chāyayā̱ tvam",
   "prati̭ sma ca̱kruṣḙ kṛ̱tyāṃ pri̱yāṃ pri̱yāva̭te hara"
  ],
