  "lines_deva": [
   "अ॒प॒मृज्य॑ यातु॒धाना॒नप॒ सर्वा॑ अरा॒य्यः",
   "अपा॑मार्ग॒ त्वया॑ व॒यं सर्वं॒ तदप॒ मृज्महे"
  ],
  "lines_iast": [
   "a̱pa̱mṛjya̭ yātu̱dhānā̱napa̱ sarvā̭ arā̱yyaḥ",
   "apā̭mārga̱ tvayā̭ va̱yaṃ sarva̱ṃ tadapa̱ mṛjmahe"
  ],
