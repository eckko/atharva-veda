  "lines_deva": [
   "अ॒पा॒मा॒र्गोऽप॑ मार्ष्टु क्षेत्रि॒यं श॒पथ॑श्च॒ यः",
   "अपाह॑ यातुधा॒नीरप॒ सर्वा॒ अरा॒य्यः"
  ],
  "lines_iast": [
   "a̱pā̱mā̱rgo'pa̭ mārṣṭu kṣetri̱yaṃ śa̱patha̭śca̱ yaḥ",
   "apāha̭ yātudhā̱nīrapa̱ sarvā̱ arā̱yyaḥ"
  ],
