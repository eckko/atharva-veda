   "004.018.5b"
  ],
  "lines_deva": [
   "अ॒नया॒हमोष॑ध्या सर्वाः॑ कृ॒त्या अ॑दूदुषम्",
   "यां क्षेत्रे॑ च॒क्रुर्यां गोषु॒ यां वा॑ ते॒ पुरु॑षेषु"
  ],
  "lines_iast": [
   "a̱nayā̱hamoṣa̭dhyā sarvā̭ḥ kṛ̱tyā a̭dūduṣam",
   "yāṃ kṣetrḙ ca̱kruryāṃ goṣu̱ yāṃ vā̭ te̱ purṷṣeṣu"
  ],
