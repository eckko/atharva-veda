  "type": "verse",
  "line_ids": [
   "004.017.3a",
   "004.017.3b"
  ],
  "lines_deva": [
   "या श॒शाप॒ शप॑नेन॒ याघं मूर॑माद॒धे",
   "या रस॑स्य॒ हर॑णाय जा॒तमा॑रे॒भे तो॒कम॑त्तु॒ सा"
  ],
  "lines_iast": [
   "yā śa̱śāpa̱ śapa̭nena̱ yāghaṃ mūra̭māda̱dhe",
   "yā rasa̭sya̱ hara̭ṇāya jā̱tamā̭re̱bhe to̱kama̭ttu̱ sā"
  ],
