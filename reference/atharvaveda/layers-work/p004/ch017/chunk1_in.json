   "004.017.2b"
  ],
  "lines_deva": [
   "स॒त्य॒जितं॑ शपथ॒याव॑नीं॒ सह॑मानां पुनःस॒राम्",
   "सर्वाः॒ सम॒ह्व्योष॑धीरि॒तो नः॑ पारया॒दिति॑"
  ],
  "lines_iast": [
   "sa̱tya̱jita̭ṃ śapatha̱yāva̭nī̱ṃ saha̭mānāṃ punaḥsa̱rām",
   "sarvā̱ḥ sama̱hvyoṣa̭dhīri̱to na̭ḥ pārayā̱diti̭"
  ],
