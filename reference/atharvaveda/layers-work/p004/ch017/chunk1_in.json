   "004.017.1a",
   "004.017.1b"
  ],
  "lines_deva": [
   "ईशा॑णां त्वा भेष॒जाना॒मुज्जे॑ष॒ आ र॑भामहे",
   "च॒क्रे स॒हस्र॑वीर्यं॒ सर्व॑स्मा ओषधे त्वा"
  ],
  "lines_iast": [
   "īśā̭ṇāṃ tvā bheṣa̱jānā̱mujjḙṣa̱ ā ra̭bhāmahe",
   "ca̱kre sa̱hasra̭vīrya̱ṃ sarva̭smā oṣadhe tvā"
  ],
