  "lines_deva": [
   "दौष्व॑प्न्यं॒ दौर्जी॑वित्यं॒ रक्षो॑ अ॒भ्वऽमरा॒य्यः",
   "दु॒र्णाम्नीः॒ सर्वा॑ दु॒र्वाच॒स्ता अ॒स्मन्ना॑शयामसि"
  ],
  "lines_iast": [
   "dauṣva̭pnya̱ṃ daurjī̭vitya̱ṃ rakṣo̭ a̱bhva'marā̱yyaḥ",
   "du̱rṇāmnī̱ḥ sarvā̭ du̱rvāca̱stā a̱smannā̭śayāmasi"
  ],
