 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "004.017.4a",
   "004.017.4b"
  ],
  "lines_deva": [
   "यां ते॑ च॒क्रुरा॒मे पात्रे॒ यां च॒क्रुर्नी॑ललोहि॒ते",
   "आ॒मे मां॒से कृ॒त्यां यां च॒क्रुस्तया॑ कृत्या॒कृतो॑ जहि"
  ],
  "lines_iast": [
   "yāṃ tḙ ca̱krurā̱me pātre̱ yāṃ ca̱krurnī̭lalohi̱te",
   "ā̱me mā̱ṃse kṛ̱tyāṃ yāṃ ca̱krustayā̭ kṛtyā̱kṛto̭ jahi"
  ],
