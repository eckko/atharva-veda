  "lines_deva": [
   "क्षु॒धा॒मा॒रं तृ॑ष्णामा॒रम॒गोता॑मनप॒त्यता॑म्",
   "अपा॑मार्ग॒ त्वया॑ व॒यं सर्वं॒ तदप॑ मृज्महे"
  ],
  "lines_iast": [
   "kṣu̱dhā̱mā̱raṃ tṛ̭ṣṇāmā̱rama̱gotā̭manapa̱tyatā̭m",
   "apā̭mārga̱ tvayā̭ va̱yaṃ sarva̱ṃ tadapa̭ mṛjmahe"
  ],
