  "lines_deva": [
   "तृ॒ष्णा॒मा॒रं क्षु॑धामा॒रमथो॑ अक्षपराज॒यम्",
   "अपा॑मार्ग॒ त्वया॑ व॒यं सर्वं॒ तदप॒ मृज्महे"
  ],
  "lines_iast": [
   "tṛ̱ṣṇā̱mā̱raṃ kṣṷdhāmā̱ramatho̭ akṣaparāja̱yam",
   "apā̭mārga̱ tvayā̭ va̱yaṃ sarva̱ṃ tadapa̱ mṛjmahe"
  ],
