  "lines_deva": [
   "अ॒पा॒मा॒र्ग ओष॑धीनां॒ सर्वा॑सा॒मेक॒ इद् व॒शी",
   "तेन॑ ते मृज्म॒ आस्थि॑त॒मथ॒ त्वम॑ग॒दश्च॑र"
  ],
  "lines_iast": [
   "a̱pā̱mā̱rga oṣa̭dhīnā̱ṃ sarvā̭sā̱meka̱ id va̱śī",
   "tena̭ te mṛjma̱ āsthi̭ta̱matha̱ tvama̭ga̱daśca̭ra"
  ],
