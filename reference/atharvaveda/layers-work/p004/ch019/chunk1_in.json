   "004.019.6b"
  ],
  "lines_deva": [
   "अस॒द् भूम्याः॒ सम॑भव॒त् तद् यामे॑ति म॒हद् व्यचः॑",
   "तद् वै ततो॑ विधू॒पाय॑त् प्र॒त्यक् क॒र्तार॑मृच्छतु"
  ],
  "lines_iast": [
   "asa̱d bhūmyā̱ḥ sama̭bhava̱t tad yāmḙti ma̱had vyaca̭ḥ",
   "tad vai tato̭ vidhū̱pāya̭t pra̱tyak ka̱rtāra̭mṛcchatu"
  ],
