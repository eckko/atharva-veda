  "lines_deva": [
   "अग्र॑मे॒ष्योष॑धीनां॒ ज्योति॑षेवाभिदी॒पय॑न्",
   "उ॒त त्रा॒तासि॒ पाक॒स्याथो॑ ह॒न्तासि॑ र॒क्षसः॑"
  ],
  "lines_iast": [
   "agra̭me̱ṣyoṣa̭dhīnā̱ṃ jyoti̭ṣevābhidī̱paya̭n",
   "u̱ta trā̱tāsi̱ pāka̱syātho̭ ha̱ntāsi̭ ra̱kṣasa̭ḥ"
  ],
