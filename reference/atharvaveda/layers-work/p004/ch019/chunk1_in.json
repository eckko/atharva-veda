  "lines_deva": [
   "श॒तेन॑ मा॒ परि॑ पाहि स॒हस्रे॑णा॒भि र॑क्ष मा",
   "इन्द्र॑स्ते वीरुधां पत उ॒ग्र ओ॒ज्मान॒मा द॑धत्"
  ],
  "lines_iast": [
   "śa̱tena̭ mā̱ pari̭ pāhi sa̱hasrḙṇā̱bhi ra̭kṣa mā",
   "indra̭ste vīrudhāṃ pata u̱gra o̱jmāna̱mā da̭dhat"
  ],
