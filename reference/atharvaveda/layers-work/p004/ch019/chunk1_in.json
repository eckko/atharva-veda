  "lines_deva": [
   "यद॒दो दे॒वा असु॑रां॒स्त्वयाग्रे॑ नि॒रकु॑र्वत",
   "तत॒स्त्वमध्यो॑षधेऽपामा॒र्गो अ॑जायथाः"
  ],
  "lines_iast": [
   "yada̱do de̱vā asṷrā̱ṃstvayāgrḙ ni̱rakṷrvata",
   "tata̱stvamadhyo̭ṣadhe'pāmā̱rgo a̭jāyathāḥ"
  ],
