 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "004.019.2a",
   "004.019.2b"
  ],
  "lines_deva": [
   "ब्रा॒ह्म॒णेन॒ पर्यु॑क्तासि॒ कण्वे॑न नार्ष॒देन॑",
   "सेने॑वैषि॒ त्विषी॑मती॒ न तत्र॑ भ॒यमस्ति॒ यत्र॑ प्रा॒प्नोष्यो॑षधे"
  ],
  "lines_iast": [
   "brā̱hma̱ṇena̱ paryṷktāsi̱ kaṇvḙna nārṣa̱dena̭",
   "senḙvaiṣi̱ tviṣī̭matī̱ na tatra̭ bha̱yamasti̱ yatra̭ prā̱pnoṣyo̭ṣadhe"
  ],
