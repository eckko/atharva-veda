   "004.019.7b"
  ],
  "lines_deva": [
   "प्र॒त्यङ् हि सं॑ब॒भूवि॑थ प्रती॒चीन॑फल॒स्त्वम्",
   "सर्वा॒न् मच्छ॒पथाँ॒ अधि॒ वरी॑यो यावया व॒धम्"
  ],
  "lines_iast": [
   "pra̱tyaṅ hi sa̭ṃba̱bhūvi̭tha pratī̱cīna̭phala̱stvam",
   "sarvā̱n maccha̱pathā̱~ adhi̱ varī̭yo yāvayā va̱dham"
  ],
