 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "004.019.1a",
   "004.019.1b"
  ],
  "lines_deva": [
   "उ॒तो अ॒स्यब॑न्धुकृदु॒तो अ॑सि॒ नु जा॑मि॒कृत्",
   "उ॒तो कृ॑त्या॒कृतः॑ प्र॒जां न॒डमि॒वा छि॑न्धि॒ वार्षि॑कम्"
  ],
  "lines_iast": [
   "u̱to a̱syaba̭ndhukṛdu̱to a̭si̱ nu jā̭mi̱kṛt",
   "u̱to kṛ̭tyā̱kṛta̭ḥ pra̱jāṃ na̱ḍami̱vā chi̭ndhi̱ vārṣi̭kam"
  ],
