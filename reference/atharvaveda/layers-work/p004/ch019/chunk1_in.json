   "004.019.5b"
  ],
  "lines_deva": [
   "वि॒भि॒न्द॒ती श॒तशा॑खा विभि॒न्दन् नाम॑ ते पि॒ता",
   "प्र॒त्यग् वि भि॑न्धि॒ त्वं तं यो अ॒स्माँ अ॑भि॒दास॑ति"
  ],
  "lines_iast": [
   "vi̱bhi̱nda̱tī śa̱taśā̭khā vibhi̱ndan nāma̭ te pi̱tā",
   "pra̱tyag vi bhi̭ndhi̱ tvaṃ taṃ yo a̱smā~ a̭bhi̱dāsa̭ti"
  ],
