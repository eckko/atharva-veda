   "004.005.4b"
  ],
  "lines_deva": [
   "एज॑देजदजग्रभं॒ चक्षुः॑ प्रा॒णम॑जग्रभम्",
   "अङ्गा॑न्यजग्रभं॒ सर्वा॑ रात्री॑णामतिशर्व॒रे"
  ],
  "lines_iast": [
   "eja̭dejadajagrabha̱ṃ cakṣṷḥ prā̱ṇama̭jagrabham",
   "aṅgā̭nyajagrabha̱ṃ sarvā̭ rātrī̭ṇāmatiśarva̱re"
  ],
