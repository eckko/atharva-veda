  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "004.005.2a",
   "004.005.2b"
  ],
  "lines_deva": [
   "न भूमिं॒ वातो॒ अति॑ वाति॒ नाति॑ पश्यति॒ कश्च॒न",
   "स्त्रिय॑श्च॒ सर्वाः॑ स्वा॒पय॒ शुन॒श्चेन्द्र॑सखा॒ चर॑न्"
  ],
  "lines_iast": [
   "na bhūmi̱ṃ vāto̱ ati̭ vāti̱ nāti̭ paśyati̱ kaśca̱na",
   "striya̭śca̱ sarvā̭ḥ svā̱paya̱ śuna̱ścendra̭sakhā̱ cara̭n"
  ],
  "book_split": [
