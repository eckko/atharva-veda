   "004.005.5b"
  ],
  "lines_deva": [
   "य आस्ते॒ यश्चर॑ति॒ यश्च॒ तिष्ठ॑न्वि॒पश्य॑ति",
   "तेषां॒ सं द॑ध्मो॒ अक्षी॑णि॒ यथे॒दं ह॒र्म्यं तथा॑"
  ],
  "lines_iast": [
   "ya āste̱ yaścara̭ti̱ yaśca̱ tiṣṭha̭nvi̱paśya̭ti",
   "teṣā̱ṃ saṃ da̭dhmo̱ akṣī̭ṇi̱ yathe̱daṃ ha̱rmyaṃ tathā̭"
  ],
