[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "004.005.1a",
   "004.005.1b"
  ],
  "lines_deva": [
   "स॒हस्र॑शृङ्गो वृष॒भो यः स॑मु॒द्रादु॒दाच॑रत्",
   "तेना॑ सह॒स्येऽना व॒यं नि जना॑न्त्स्वापयामसि"
  ],
  "lines_iast": [
   "sa̱hasra̭śṛṅgo vṛṣa̱bho yaḥ sa̭mu̱drādu̱dāca̭rat",
   "tenā̭ saha̱sye'nā va̱yaṃ ni janā̭ntsvāpayāmasi"
  ],
  "book_split": [
