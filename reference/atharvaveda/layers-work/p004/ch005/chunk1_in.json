 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.005.3a",
   "004.005.3b"
  ],
  "lines_deva": [
   "प्रो॒ष्ठे॒श॒यास्त॑ल्पेश॒या नारी॒र्या व॑ह्य॒शीव॑रीः",
   "स्त्रियो॒ याः पुण्य॑गन्धय॒स्ताः सर्वाः॑ स्वापयामसि"
  ],
  "lines_iast": [
   "pro̱ṣṭhe̱śa̱yāsta̭lpeśa̱yā nārī̱ryā va̭hya̱śīva̭rīḥ",
   "striyo̱ yāḥ puṇya̭gandhaya̱stāḥ sarvā̭ḥ svāpayāmasi"
  ],
