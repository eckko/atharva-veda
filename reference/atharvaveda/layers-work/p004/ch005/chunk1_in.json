   "004.005.6b"
  ],
  "lines_deva": [
   "स्वप्तु॑ मा॒ता स्वप्तु॑ पि॒ता स्वप्तु॒ श्वा स्वप्तु॑ वि॒श्पतिः॑",
   "स्वप॑न्त्वस्यै ज्ञा॒तयः॒ स्वप्त्व॒यम॒भितो॒ जनः॑"
  ],
  "lines_iast": [
   "svaptṷ mā̱tā svaptṷ pi̱tā svaptu̱ śvā svaptṷ vi̱śpati̭ḥ",
   "svapa̭ntvasyai jñā̱taya̱ḥ svaptva̱yama̱bhito̱ jana̭ḥ"
  ],
