   "004.005.7b"
  ],
  "lines_deva": [
   "स्वप्न॑ स्वप्नाभि॒कर॑णेन॒ सर्वं॒ नि स्वापया॒ जन॑म्",
   "ओ॒त्सू॒र्यम॒न्यान्त्स्वा॒पया॑व्यु॒षं जा॑गृताद॒हमिन्द्र॑ इ॒वारि॑ष्टो॒ अक्षि॑तः"
  ],
  "lines_iast": [
   "svapna̭ svapnābhi̱kara̭ṇena̱ sarva̱ṃ ni svāpayā̱ jana̭m",
   "o̱tsū̱ryama̱nyāntsvā̱payā̭vyu̱ṣaṃ jā̭gṛtāda̱hamindra̭ i̱vāri̭ṣṭo̱ akṣi̭taḥ"
  ],
