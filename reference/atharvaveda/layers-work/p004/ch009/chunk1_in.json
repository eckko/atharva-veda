   "004.009.8b"
  ],
  "lines_deva": [
   "त्रयो॑ दा॒सा आञ्ज॑नस्य त॒क्मा ब॒लास॒ आदहिः॑",
   "वर्षि॑ष्ठः॒ पर्व॑तानां त्रिक॒कुन्नाम॑ ते पि॒ता"
  ],
  "lines_iast": [
   "trayo̭ dā̱sā āñja̭nasya ta̱kmā ba̱lāsa̱ ādahi̭ḥ",
   "varṣi̭ṣṭha̱ḥ parva̭tānāṃ trika̱kunnāma̭ te pi̱tā"
  ],
