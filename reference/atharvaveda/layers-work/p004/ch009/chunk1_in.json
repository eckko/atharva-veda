  "lines_deva": [
   "यदि॒ वासि॑ त्रैककु॒दं यदि॑ यामु॒नमु॒च्यसे॑",
   "उ॒भे ते॑ भ॒द्रे॑ नाम्नी॒ ताभ्यां॒ नः पाह्याञ्जन"
  ],
  "lines_iast": [
   "yadi̱ vāsi̭ traikaku̱daṃ yadi̭ yāmu̱namu̱cyasḙ",
   "u̱bhe tḙ bha̱drḙ nāmnī̱ tābhyā̱ṃ naḥ pāhyāñjana"
  ],
