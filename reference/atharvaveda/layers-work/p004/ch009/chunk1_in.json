 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "004.009.5a",
   "004.009.5b"
  ],
  "lines_deva": [
   "नैनं॒ प्राप्नो॑ति श॒पथो॒ न कृ॒त्या नाभि॒शोच॑नम्",
   "नैनं॒ विष्क॑न्धमश्नुते॒ यस्त्वा॒ बिभ॑र्त्याञ्जन"
  ],
  "lines_iast": [
   "naina̱ṃ prāpno̭ti śa̱patho̱ na kṛ̱tyā nābhi̱śoca̭nam",
   "naina̱ṃ viṣka̭ndhamaśnute̱ yastvā̱ bibha̭rtyāñjana"
  ],
