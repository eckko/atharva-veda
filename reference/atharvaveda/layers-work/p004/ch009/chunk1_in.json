 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "004.009.4a",
   "004.009.4b"
  ],
  "lines_deva": [
   "यस्या॑ञ्जन प्र॒सर्प॒स्यङ्ग॑मङ्गं॒ परु॑ष्परुः",
   "ततो॒ यक्ष्मं॒ वि बा॑धस उ॒ग्रो मध्यम॒शीरि॑व"
  ],
  "lines_iast": [
   "yasyā̭ñjana pra̱sarpa̱syaṅga̭maṅga̱ṃ parṷṣparuḥ",
   "tato̱ yakṣma̱ṃ vi bā̭dhasa u̱gro madhyama̱śīri̭va"
  ],
