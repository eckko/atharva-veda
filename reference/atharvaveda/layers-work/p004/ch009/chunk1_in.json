  "lines_deva": [
   "यदाञ्ज॑नं त्रैककु॒दं जा॒तं हि॒मव॑त॒स्परि॑",
   "या॒तूंश्च॒ सर्वा॑ञ्ज॒म्भय॒त् सर्वा॑श्च यातुधा॒न्यः"
  ],
  "lines_iast": [
   "yadāñja̭naṃ traikaku̱daṃ jā̱taṃ hi̱mava̭ta̱spari̭",
   "yā̱tūṃśca̱ sarvā̭ñja̱mbhaya̱t sarvā̭śca yātudhā̱nyaḥ"
  ],
