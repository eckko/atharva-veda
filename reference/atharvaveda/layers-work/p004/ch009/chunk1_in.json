   "004.009.7b"
  ],
  "lines_deva": [
   "इ॒दं वि॒द्वाना॑ञ्जन स॒त्यं व॑क्ष्यामि॒ नानृ॑तम्",
   "स॒नेय॒मश्वं॒ गाम॒हमा॒त्मानं॒ तव॒ पूरुष"
  ],
  "lines_iast": [
   "i̱daṃ vi̱dvānā̭ñjana sa̱tyaṃ va̭kṣyāmi̱ nānṛ̭tam",
   "sa̱neya̱maśva̱ṃ gāma̱hamā̱tmāna̱ṃ tava̱ pūruṣa"
  ],
