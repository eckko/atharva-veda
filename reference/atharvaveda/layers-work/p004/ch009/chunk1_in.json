   "004.009.1a",
   "004.009.1b"
  ],
  "lines_deva": [
   "एहि॑ जी॒वं त्राय॑माणं॒ पर्व॑तस्या॒स्यक्ष्य॑म्",
   "विश्वे॑भिर्दे॒वैर्द॒त्तं प॑रि॒धिर्जीव॑नाय॒ कम्"
  ],
  "lines_iast": [
   "ehi̭ jī̱vaṃ trāya̭māṇa̱ṃ parva̭tasyā̱syakṣya̭m",
   "viśvḙbhirde̱vairda̱ttaṃ pa̭ri̱dhirjīva̭nāya̱ kam"
  ],
