 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.009.3a",
   "004.009.3b"
  ],
  "lines_deva": [
   "उ॒तासि॑ परि॒पाणं॑ यातु॒जम्भ॑नमाञ्जन",
   "उ॒तामृत॑स्य॒ त्वं वे॒त्थाथो॑ असि जीव॒भोज॑न॒मथो॑ हरितभेष॒जम्"
  ],
  "lines_iast": [
   "u̱tāsi̭ pari̱pāṇa̭ṃ yātu̱jambha̭namāñjana",
   "u̱tāmṛta̭sya̱ tvaṃ ve̱tthātho̭ asi jīva̱bhoja̭na̱matho̭ haritabheṣa̱jam"
  ],
