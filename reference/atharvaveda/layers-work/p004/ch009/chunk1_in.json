   "004.009.6b"
  ],
  "lines_deva": [
   "अ॒स॒न्म॒न्त्रा॑द् दु॒ष्वप्न्याद् दुष्कृ॒ताच्छम॑लादु॒त",
   "दु॒र्हार्द॒श्चक्षु॑षो घो॒रात् तस्मा॑न्नः पाह्याञ्जन"
  ],
  "lines_iast": [
   "a̱sa̱nma̱ntrā̭d du̱ṣvapnyād duṣkṛ̱tācchama̭lādu̱ta",
   "du̱rhārda̱ścakṣṷṣo gho̱rāt tasmā̭nnaḥ pāhyāñjana"
  ],
