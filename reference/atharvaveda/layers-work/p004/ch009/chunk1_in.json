   "004.009.2a",
   "004.009.2b"
  ],
  "lines_deva": [
   "प॒रि॒पाणं॒ पुरु॑षाणां परि॒पाणं॒ गवा॑मसि",
   "अश्वा॑ना॒मर्व॑तां परि॒पाणा॑य तस्थिषे"
  ],
  "lines_iast": [
   "pa̱ri̱pāṇa̱ṃ purṷṣāṇāṃ pari̱pāṇa̱ṃ gavā̭masi",
   "aśvā̭nā̱marva̭tāṃ pari̱pāṇā̭ya tasthiṣe"
  ],
