  "lines_deva": [
   "उच्छुष्मौष॑धीनां॒ सार॑ ऋष॒भाणा॑म्",
   "सं पुं॒सामि॑न्द्र॒ वृष्ण्य॑म॒स्मिन्धे॑हि तनूवशिन्"
  ],
  "lines_iast": [
   "ucchuṣmauṣa̭dhīnā̱ṃ sāra̭ ṛṣa̱bhāṇā̭m",
   "saṃ pu̱ṃsāmi̭ndra̱ vṛṣṇya̭ma̱smindhḙhi tanūvaśin"
  ],
