   "004.004.2b"
  ],
  "lines_deva": [
   "उदु॒षा उदु॒ सूर्य॒ उदि॒दं मा॑म॒कं वचः॑",
   "उदे॑जतु प्र॒जाप॑ति॒र्वृषा॒ शुष्मे॑ण वा॒जिना॑"
  ],
  "lines_iast": [
   "udu̱ṣā udu̱ sūrya̱ udi̱daṃ mā̭ma̱kaṃ vaca̭ḥ",
   "udḙjatu pra̱jāpa̭ti̱rvṛṣā̱ śuṣmḙṇa vā̱jinā̭"
  ],
