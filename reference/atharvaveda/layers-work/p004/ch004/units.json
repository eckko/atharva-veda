  "lines_deva": [
   "अ॒पां रसः॑ प्रथम॒जोऽथो॒ वन॒स्पती॑नाम्",
   "उ॒त सोम॑स्य॒ भ्राता॑स्यु॒तार्शम॑सि॒ वृष्ण्य॑म्"
  ],
  "lines_iast": [
   "a̱pāṃ rasa̭ḥ prathama̱jo'tho̱ vana̱spatī̭nām",
   "u̱ta soma̭sya̱ bhrātā̭syu̱tārśama̭si̱ vṛṣṇya̭m"
  ],
