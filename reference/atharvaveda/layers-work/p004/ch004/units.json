  "type": "verse",
  "line_ids": [
   "004.004.1a",
   "004.004.1b"
  ],
  "lines_deva": [
   "यां त्वा॑ गन्ध॒र्वो अख॑न॒द् वरु॑णाय मृ॒तभ्र॑जे",
   "तां त्वा॑ व॒यं ख॑नाम॒स्योष॑धिं शेप॒हर्ष॑णीम्"
  ],
  "lines_iast": [
   "yāṃ tvā̭ gandha̱rvo akha̭na̱d varṷṇāya mṛ̱tabhra̭je",
   "tāṃ tvā̭ va̱yaṃ kha̭nāma̱syoṣa̭dhiṃ śepa̱harṣa̭ṇīm"
  ],
