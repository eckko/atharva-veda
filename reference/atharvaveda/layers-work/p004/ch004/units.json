  "lines_deva": [
   "यथा॑ स्म ते वि॒रोह॑तो॒ऽभित॑प्तमि॒वान॑ति",
   "तत॑स्ते॒ शुष्म॑वत्तरमि॒यं कृ॑णो॒त्वोष॑धिः"
  ],
  "lines_iast": [
   "yathā̭ sma te vi̱roha̭to̱'bhita̭ptami̱vāna̭ti",
   "tata̭ste̱ śuṣma̭vattarami̱yaṃ kṛ̭ṇo̱tvoṣa̭dhiḥ"
  ],
