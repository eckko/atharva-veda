   "004.004.6b"
  ],
  "lines_deva": [
   "अ॒द्याग्ने॑ अ॒द्य स॑वितर॒द्य दे॑वि सरस्वति",
   "अ॑द्यास्य ब्र॑ह्मणस्पते॒ धनु॑रि॒वा ता॑नया॒ पसः॑"
  ],
  "lines_iast": [
   "a̱dyāgnḙ a̱dya sa̭vitara̱dya dḙvi sarasvati",
   "a̭dyāsya bra̭hmaṇaspate̱ dhanṷri̱vā tā̭nayā̱ pasa̭ḥ"
  ],
