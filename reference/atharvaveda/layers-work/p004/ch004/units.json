  "lines_deva": [
   "आहं त॑नोमि ते॒ पसो॒ अधि॒ ज्यामि॑व॒ धन्व॑नि",
   "क्रम॒स्वर्श॑ इव रो॒हित॒मन॑वग्लायता॒ सदा॑"
  ],
  "lines_iast": [
   "āhaṃ ta̭nomi te̱ paso̱ adhi̱ jyāmi̭va̱ dhanva̭ni",
   "krama̱svarśa̭ iva ro̱hita̱mana̭vaglāyatā̱ sadā̭"
  ],
