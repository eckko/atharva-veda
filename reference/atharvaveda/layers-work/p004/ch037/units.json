  "lines_deva": [
   "त्वया॒ पूर्व॒मथ॑र्वाणो ज॒घ्नू रक्षां॑स्योषधे",
   "त्वया॑ जघान क॒श्यप॒स्त्वया॒ कण्वो॑ अ॒गस्त्यः॑"
  ],
  "lines_iast": [
   "tvayā̱ pūrva̱matha̭rvāṇo ja̱ghnū rakṣā̭ṃsyoṣadhe",
   "tvayā̭ jaghāna ka̱śyapa̱stvayā̱ kaṇvo̭ a̱gastya̭ḥ"
  ],
