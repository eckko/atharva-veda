   "004.037.3a",
   "004.037.3b",
   "004.037.3c"
  ],
  "lines_deva": [
   "न॒दीं य॑न्त्वप्स॒रसो॒ऽपां ता॒रम॑वश्व॒सम्",
   "गु॒ल्गु॒लूः पीला॑ नल॒द्यौ॒३क्षग॑न्धिः प्रमन्द॒नी",
   "तत् परे॑ताप्सरसः॒ प्रति॑बुद्धा अभूतन"
  ],
  "lines_iast": [
   "na̱dīṃ ya̭ntvapsa̱raso̱'pāṃ tā̱rama̭vaśva̱sam",
   "gu̱lgu̱lūḥ pīlā̭ nala̱dyau̱3kṣaga̭ndhiḥ pramanda̱nī",
   "tat parḙtāpsarasa̱ḥ prati̭buddhā abhūtana"
  ],
