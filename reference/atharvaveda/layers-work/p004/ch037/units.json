  "lines_deva": [
   "यत्रा॑श्व॒त्था न्य॒ग्रोधा॑ महावृ॒क्षाः शि॑ख॒ण्डिनः॑",
   "तत् परे॑ताप्सरसः॒ प्रति॑बुद्धा अभूतन"
  ],
  "lines_iast": [
   "yatrā̭śva̱tthā nya̱grodhā̭ mahāvṛ̱kṣāḥ śi̭kha̱ṇḍina̭ḥ",
   "tat parḙtāpsarasa̱ḥ prati̭buddhā abhūtana"
  ],
