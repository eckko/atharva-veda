  "lines_deva": [
   "त्वया॑ व॒यम॑प्स॒रसो॑ गन्ध॒र्वांस्चा॑तयामहे",
   "अज॑शृ॒ङ्ग्यज॒ रक्षः॒ सर्वा॑न् ग॒न्धेन॑ नाशय"
  ],
  "lines_iast": [
   "tvayā̭ va̱yama̭psa̱raso̭ gandha̱rvāṃscā̭tayāmahe",
   "aja̭śṛ̱ṅgyaja̱ rakṣa̱ḥ sarvā̭n ga̱ndhena̭ nāśaya"
  ],
