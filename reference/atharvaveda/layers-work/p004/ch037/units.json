  "lines_deva": [
   "स्वेवैकः॑ क॒पिरि॒वैकः॑ कुमा॒रः स॑र्वकेश॒कः",
   "प्रियो दृश इ॑व भू॒त्वा ग॑न्ध॒र्वः स॑चते॒ स्त्रिय॑स्त॑मि॒तो ना॑शयामसि॒ ब्रह्म॑णा वी॒र्याऽवता"
  ],
  "lines_iast": [
   "svevaika̭ḥ ka̱piri̱vaika̭ḥ kumā̱raḥ sa̭rvakeśa̱kaḥ",
   "priyo dṛśa i̭va bhū̱tvā ga̭ndha̱rvaḥ sa̭cate̱ striya̭sta̭mi̱to nā̭śayāmasi̱ brahma̭ṇā vī̱ryā'vatā"
  ],
