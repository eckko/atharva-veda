   "004.037.5b"
  ],
  "lines_deva": [
   "यत्र॑ वः प्रे॒ङ्खा हरि॑ता॒ अर्जु॑ना उ॒त यत्रा॑घा॒ताः क॑र्क॒र्यः सं॒वद॑न्ति",
   "तत् परे॑ताप्सरसः॒ प्रति॑बुद्धा अभूतन"
  ],
  "lines_iast": [
   "yatra̭ vaḥ pre̱ṅkhā hari̭tā̱ arjṷnā u̱ta yatrā̭ghā̱tāḥ ka̭rka̱ryaḥ sa̱ṃvada̭nti",
   "tat parḙtāpsarasa̱ḥ prati̭buddhā abhūtana"
  ],
