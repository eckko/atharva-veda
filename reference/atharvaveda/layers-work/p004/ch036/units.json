  "lines_deva": [
   "अ॒भि तं निरृ॑तिर्धत्ता॒मश्व॑मिवाश्वाभि॒धान्या॑",
   "म॒ल्वो यो मह्यं॒ क्रुध्य॑ति॒ स उ॒ पाशा॒न्नमु॑च्यते"
  ],
  "lines_iast": [
   "a̱bhi taṃ nirṛ̭tirdhattā̱maśva̭mivāśvābhi̱dhānyā̭",
   "ma̱lvo yo mahya̱ṃ krudhya̭ti̱ sa u̱ pāśā̱nnamṷcyate"
  ],
