   "004.036.7b"
  ],
  "lines_deva": [
   "न पि॑शा॒चैः सं श॑क्नोमि॒ न स्ते॒नैर्न व॑न॒र्गुभिः॑",
   "पि॒शा॒चास्तस्मा॑न्नश्यन्ति॒ यम॒हं ग्राम॑मावि॒शे"
  ],
  "lines_iast": [
   "na pi̭śā̱caiḥ saṃ śa̭knomi̱ na ste̱nairna va̭na̱rgubhi̭ḥ",
   "pi̱śā̱cāstasmā̭nnaśyanti̱ yama̱haṃ grāma̭māvi̱śe"
  ],
