 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "004.036.6a",
   "004.036.6b"
  ],
  "lines_deva": [
   "तप॑नो अस्मि पिशा॒चानां॑ व्या॒घ्रो गोम॑तामिव",
   "श्वानः॑ सिं॒हमि॑व दृ॒ष्ट्वा ते न वि॑न्दन्ते॒ न्यञ्च॑नम्"
  ],
  "lines_iast": [
   "tapa̭no asmi piśā̱cānā̭ṃ vyā̱ghro goma̭tāmiva",
   "śvāna̭ḥ si̱ṃhami̭va dṛ̱ṣṭvā te na vi̭ndante̱ nyañca̭nam"
  ],
