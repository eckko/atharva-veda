  "lines_deva": [
   "यं ग्राम॑मावि॒शत॑ इ॒दमु॒ग्रं सहो॒ मम॑",
   "पि॒शा॒चास्तस्मा॑न्नश्यन्ति॒ न पा॒पमुप॑ जानते"
  ],
  "lines_iast": [
   "yaṃ grāma̭māvi̱śata̭ i̱damu̱graṃ saho̱ mama̭",
   "pi̱śā̱cāstasmā̭nnaśyanti̱ na pā̱pamupa̭ jānate"
  ],
