 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "004.036.2a",
   "004.036.2b"
  ],
  "lines_deva": [
   "यो नो॒ दिप्स॒ददि॑प्सतो॒ दिप्स॑तो॒ यश्च॒ दिप्स॑ति",
   "वै॒श्वा॒न॒रस्य॒ दंष्ट्र॑योर॒ग्नेरपि॑ दधामि॒ तम्"
  ],
  "lines_iast": [
   "yo no̱ dipsa̱dadi̭psato̱ dipsa̭to̱ yaśca̱ dipsa̭ti",
   "vai̱śvā̱na̱rasya̱ daṃṣṭra̭yora̱gnerapi̭ dadhāmi̱ tam"
  ],
