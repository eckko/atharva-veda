 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.036.3a",
   "004.036.3b"
  ],
  "lines_deva": [
   "य आ॑ग॒रे मृ॒गय॑न्ते प्रतिक्रो॒शेऽमावा॒स्ये",
   "क्र॒व्यादो॑ अ॒न्यान् दिप्स॑तः॒ सर्वां॒स्तान्त्सह॑सा सहे"
  ],
  "lines_iast": [
   "ya ā̭ga̱re mṛ̱gaya̭nte pratikro̱śe'māvā̱sye",
   "kra̱vyādo̭ a̱nyān dipsa̭ta̱ḥ sarvā̱ṃstāntsaha̭sā sahe"
  ],
