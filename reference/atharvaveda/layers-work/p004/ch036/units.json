[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "004.036.1a",
   "004.036.1b"
  ],
  "lines_deva": [
   "तान्त्स॒त्यौजाः॒ प्र द॑हत्व॒ग्निर्वै॑श्वान॒रोवृषा॑",
   "यो नो॑ दुर॒स्याद् दिप्सा॒च्चाथो॒ यो नो॑ अराति॒यात्"
  ],
  "lines_iast": [
   "tāntsa̱tyaujā̱ḥ pra da̭hatva̱gnirvai̭śvāna̱rovṛṣā̭",
   "yo no̭ dura̱syād dipsā̱ccātho̱ yo no̭ arāti̱yāt"
  ],
  "book_split": [
