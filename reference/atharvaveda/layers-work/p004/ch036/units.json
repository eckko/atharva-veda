 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "004.036.4a",
   "004.036.4b"
  ],
  "lines_deva": [
   "सहे॑ पिशा॒चान्त्सह॑सैषां॒ द्रवि॑णं ददे",
   "सर्वा॑न् दुरस्य॒तो ह॑न्मि॒ सं म॒ आकू॑तिरृद्यताम्"
  ],
  "lines_iast": [
   "sahḙ piśā̱cāntsaha̭saiṣā̱ṃ dravi̭ṇaṃ dade",
   "sarvā̭n durasya̱to ha̭nmi̱ saṃ ma̱ ākṷ̄tirṛdyatām"
  ],
