   "004.036.5b"
  ],
  "lines_deva": [
   "ये दे॒वास्तेन॒ हास॑न्ते॒ सूर्ये॑ण मिमते ज॒वम्",
   "न॒दीषु॒ पर्व॑तेषु॒ ये सं तैः प॒शुभि॑र्विदे"
  ],
  "lines_iast": [
   "ye de̱vāstena̱ hāsa̭nte̱ sūryḙṇa mimate ja̱vam",
   "na̱dīṣu̱ parva̭teṣu̱ ye saṃ taiḥ pa̱śubhi̭rvide"
  ],
