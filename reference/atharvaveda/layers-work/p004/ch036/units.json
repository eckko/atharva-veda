  "lines_deva": [
   "ये मा॑ क्रो॒धय॑न्ति लपि॒ता ह॒स्तिनं॑ म॒शका॑ इव",
   "तान॒हं म॑न्ये॒ दुर्हि॑ता॒न् जने॒ अल्प॑शयूनिव"
  ],
  "lines_iast": [
   "ye mā̭ kro̱dhaya̭nti lapi̱tā ha̱stina̭ṃ ma̱śakā̭ iva",
   "tāna̱haṃ ma̭nye̱ durhi̭tā̱n jane̱ alpa̭śayūniva"
  ],
