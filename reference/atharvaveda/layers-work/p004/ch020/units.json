 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.020.3a",
   "004.020.3b"
  ],
  "lines_deva": [
   "दि॒व्यस्य॑ सुप॒र्णस्य॒ तस्य॑ हासि क॒नीनि॑का",
   "सा भूमि॒मा रु॑रोहिथ व॒ह्यं श्रा॒न्ता व॒धूरि॑व"
  ],
  "lines_iast": [
   "di̱vyasya̭ supa̱rṇasya̱ tasya̭ hāsi ka̱nīni̭kā",
   "sā bhūmi̱mā rṷrohitha va̱hyaṃ śrā̱ntā va̱dhūri̭va"
  ],
