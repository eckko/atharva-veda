  "lines_deva": [
   "आ॒विष्कृ॑णुष्व रू॒पाणि॒ मात्मान॒मप॑ गूहथाः",
   "अथो॑ सहस्रचक्षो॒ त्वं प्रति॑ पश्याः किमी॒दिनः॑"
  ],
  "lines_iast": [
   "ā̱viṣkṛ̭ṇuṣva rū̱pāṇi̱ mātmāna̱mapa̭ gūhathāḥ",
   "atho̭ sahasracakṣo̱ tvaṃ prati̭ paśyāḥ kimī̱dina̭ḥ"
  ],
