   "004.020.1b"
  ],
  "lines_deva": [
   "आ प॑श्यति॒ प्रति॑ पश्यति॒ परा॑ पश्यति॒ पश्य॑ति",
   "दिव॑म॒न्तरि॑क्ष॒माद् भूमिं॒ सर्वं॒ तद् दे॑वि पश्यति"
  ],
  "lines_iast": [
   "ā pa̭śyati̱ prati̭ paśyati̱ parā̭ paśyati̱ paśya̭ti",
   "diva̭ma̱ntari̭kṣa̱mād bhūmi̱ṃ sarva̱ṃ tad dḙvi paśyati"
  ],
