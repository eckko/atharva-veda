 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "004.020.4a",
   "004.020.4b"
  ],
  "lines_deva": [
   "तां मे॑ सहस्रा॒क्षो दे॒वो दक्षि॑णे॒ हस्त॒ आ द॑धत्",
   "तया॒हं सर्वं॑ पश्यामि॒ यश्च॑ शू॒द्र उ॒तार्यः॑"
  ],
  "lines_iast": [
   "tāṃ mḙ sahasrā̱kṣo de̱vo dakṣi̭ṇe̱ hasta̱ ā da̭dhat",
   "tayā̱haṃ sarva̭ṃ paśyāmi̱ yaśca̭ śū̱dra u̱tārya̭ḥ"
  ],
