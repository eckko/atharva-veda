   "004.020.6b"
  ],
  "lines_deva": [
   "द॒र्शय॑ मा यातु॒धाना॑न् द॒र्शय॑ यातुधा॒न्यः",
   "पि॒शा॒चान्त्सर्वा॑न् दर्श॒येति॒ त्वा र॑भ ओषधे"
  ],
  "lines_iast": [
   "da̱rśaya̭ mā yātu̱dhānā̭n da̱rśaya̭ yātudhā̱nyaḥ",
   "pi̱śā̱cāntsarvā̭n darśa̱yeti̱ tvā ra̭bha oṣadhe"
  ],
