  "lines_deva": [
   "क॒श्यप॑स्य॒ चक्षु॑रसि शु॒न्याश्च॑ चतुर॒क्ष्याः",
   "वी॒ध्रे सूर्य॑मिव॒ सर्प॑न्तं॒ मा पि॑शा॒चं ति॒र॒स्क॑रः"
  ],
  "lines_iast": [
   "ka̱śyapa̭sya̱ cakṣṷrasi śu̱nyāśca̭ catura̱kṣyāḥ",
   "vī̱dhre sūrya̭miva̱ sarpa̭nta̱ṃ mā pi̭śā̱caṃ ti̱ra̱ska̭raḥ"
  ],
