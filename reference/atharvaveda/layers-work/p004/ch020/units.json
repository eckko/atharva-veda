  "lines_deva": [
   "यो अ॒न्तरि॑क्षेण॒ पत॑ति॒ दिवं॒ यश्चा॑ति॒सर्प॑ति",
   "भूमिं॒ यो मन्य॑ते ना॒थं तं पि॑शा॒चं॑ प्र द॑र्शय"
  ],
  "lines_iast": [
   "yo a̱ntari̭kṣeṇa̱ pata̭ti̱ diva̱ṃ yaścā̭ti̱sarpa̭ti",
   "bhūmi̱ṃ yo manya̭te nā̱thaṃ taṃ pi̭śā̱ca̭ṃ pra da̭rśaya"
  ],
