   "004.020.2a",
   "004.020.2b"
  ],
  "lines_deva": [
   "ति॒स्रो दिव॑स्ति॒स्रः पृ॑थि॒वीः षट् चे॒माः प्र॒दिशः॒ पृथ॑क्",
   "त्वया॒हं सर्वा॑ भू॒तानि॒ पश्या॑नि देव्योषधे"
  ],
  "lines_iast": [
   "ti̱sro diva̭sti̱sraḥ pṛ̭thi̱vīḥ ṣaṭ ce̱māḥ pra̱diśa̱ḥ pṛtha̭k",
   "tvayā̱haṃ sarvā̭ bhū̱tāni̱ paśyā̭ni devyoṣadhe"
  ],
