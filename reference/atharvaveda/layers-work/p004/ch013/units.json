  "lines_deva": [
   "हस्ता॑भ्यां॒ दश॑शाखाभ्यां जि॒ह्वा वा॒चः पु॑रोग॒वी",
   "अ॒ना॒म॒यि॒त्नुभ्यां॒ हस्ता॑भ्यां॒ ताभ्यां॑ त्वा॒भि मृ॑शामसि"
  ],
  "lines_iast": [
   "hastā̭bhyā̱ṃ daśa̭śākhābhyāṃ ji̱hvā vā̱caḥ pṷroga̱vī",
   "a̱nā̱ma̱yi̱tnubhyā̱ṃ hastā̭bhyā̱ṃ tābhyā̭ṃ tvā̱bhi mṛ̭śāmasi"
  ],
