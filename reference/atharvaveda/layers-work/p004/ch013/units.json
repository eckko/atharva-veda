   "004.013.1b"
  ],
  "lines_deva": [
   "उ॒त दे॑वा॒ अव॑हितं॒ देवा॒ उन्न॑यथा॒ पुनः॑",
   "उ॒ताग॑श्च॒क्रुषं॑ देवा॒ देवा॑ जी॒वय॑था॒ पुनः॑"
  ],
  "lines_iast": [
   "u̱ta dḙvā̱ ava̭hita̱ṃ devā̱ unna̭yathā̱ puna̭ḥ",
   "u̱tāga̭śca̱kruṣa̭ṃ devā̱ devā̭ jī̱vaya̭thā̱ puna̭ḥ"
  ],
