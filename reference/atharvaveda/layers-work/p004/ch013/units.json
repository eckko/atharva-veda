   "004.013.5b"
  ],
  "lines_deva": [
   "आ त्वा॑गमं॒ शंता॑तिभि॒रथो॑ अरि॒ष्टता॑तिभिः",
   "दक्षं॑ त उ॒ग्रमाभा॑रिषं॒ परा॒ यक्ष्मं॑ सुवामि ते"
  ],
  "lines_iast": [
   "ā tvā̭gama̱ṃ śaṃtā̭tibhi̱ratho̭ ari̱ṣṭatā̭tibhiḥ",
   "dakṣa̭ṃ ta u̱gramābhā̭riṣa̱ṃ parā̱ yakṣma̭ṃ suvāmi te"
  ],
