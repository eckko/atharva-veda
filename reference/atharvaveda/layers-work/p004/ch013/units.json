   "004.013.3b"
  ],
  "lines_deva": [
   "आ वा॑त वाहि भेष॒जं वि वा॑त वाहि॒ यद्रपः॑",
   "त्वं हि वि॑श्वभेषज दे॒वानां॑ दू॒त ईय॑से"
  ],
  "lines_iast": [
   "ā vā̭ta vāhi bheṣa̱jaṃ vi vā̭ta vāhi̱ yadrapa̭ḥ",
   "tvaṃ hi vi̭śvabheṣaja de̱vānā̭ṃ dū̱ta īya̭se"
  ],
