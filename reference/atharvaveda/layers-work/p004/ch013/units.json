  "lines_deva": [
   "त्राय॑न्तामि॒मं दे॒वास्त्राय॑न्तां म॒रुतां॑ ग॒णाः",
   "त्राय॑न्तां॒ विश्वा॑ भू॒तानि॒ यथा॒यम॑र॒पा अस॑त्"
  ],
  "lines_iast": [
   "trāya̭ntāmi̱maṃ de̱vāstrāya̭ntāṃ ma̱rutā̭ṃ ga̱ṇāḥ",
   "trāya̭ntā̱ṃ viśvā̭ bhū̱tāni̱ yathā̱yama̭ra̱pā asa̭t"
  ],
