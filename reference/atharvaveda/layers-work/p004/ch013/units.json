  "lines_deva": [
   "द्वावि॒मौ वातौ॒ वात॒ आ सिन्धो॒रा प॑रावतः॑",
   "दक्षं॑ ते अ॒न्य आ॒वातु॒ व्य॑१न्यो वा॑तु॒ यद् रपः॑"
  ],
  "lines_iast": [
   "dvāvi̱mau vātau̱ vāta̱ ā sindho̱rā pa̭rāvata̭ḥ",
   "dakṣa̭ṃ te a̱nya ā̱vātu̱ vya̭1nyo vā̭tu̱ yad rapa̭ḥ"
  ],
