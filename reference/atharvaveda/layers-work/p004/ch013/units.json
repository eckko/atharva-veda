  "lines_deva": [
   "अ॒यं मे॒ हस्तो॒ भग॑वान॒यं मे॒ भग॑वत्तरः",
   "अ॒यं मे॑ वि॒श्वभे॑षजो॒ऽयं शि॒वाभि॑मर्शनः"
  ],
  "lines_iast": [
   "a̱yaṃ me̱ hasto̱ bhaga̭vāna̱yaṃ me̱ bhaga̭vattaraḥ",
   "a̱yaṃ mḙ vi̱śvabhḙṣajo̱'yaṃ śi̱vābhi̭marśanaḥ"
  ],
