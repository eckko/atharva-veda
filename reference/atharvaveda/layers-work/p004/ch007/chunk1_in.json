  "lines_deva": [
   "अना॑प्ता॒ ये वः॑ प्रथ॒मा यानि॒ कर्मा॑णि चक्रि॒रे॑",
   "वी॒रान्नो॒ अत्र॒ मा द॑भ॒न् तद् व॑ ए॒तत्पु॒रो द॑धे"
  ],
  "lines_iast": [
   "anā̭ptā̱ ye va̭ḥ pratha̱mā yāni̱ karmā̭ṇi cakri̱rḙ",
   "vī̱rānno̱ atra̱ mā da̭bha̱n tad va̭ e̱tatpu̱ro da̭dhe"
  ],
