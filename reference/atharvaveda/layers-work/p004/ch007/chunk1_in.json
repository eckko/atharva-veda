  "line_ids": [
   "004.007.1a",
   "004.007.1b"
  ],
  "lines_deva": [
   "वारि॒दं वा॑रयातै वर॒णाव॑त्या॒मधि॑",
   "तत्रा॒मृत॒स्यासि॑क्त॒ तेना॑ ते वारये वि॒षम्"
  ],
  "lines_iast": [
   "vāri̱daṃ vā̭rayātai vara̱ṇāva̭tyā̱madhi̭",
   "tatrā̱mṛta̱syāsi̭kta̱ tenā̭ te vāraye vi̱ṣam"
  ],
