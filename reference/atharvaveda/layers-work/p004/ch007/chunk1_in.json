   "004.007.5b"
  ],
  "lines_deva": [
   "परि॒ ग्राम॑मि॒वाचि॑तं॒ वच॑सा स्थापयामसि",
   "तिष्ठा॑ वृ॒क्ष इ॑व॒ स्थाम्न्यभ्रि॑खाते॒ न रू॑रुपः"
  ],
  "lines_iast": [
   "pari̱ grāma̭mi̱vāci̭ta̱ṃ vaca̭sā sthāpayāmasi",
   "tiṣṭhā̭ vṛ̱kṣa i̭va̱ sthāmnyabhri̭khāte̱ na rṷ̄rupaḥ"
  ],
