   "004.007.6b"
  ],
  "lines_deva": [
   "प॒वस्तै॑स्त्वा॒ पर्य॑क्रीणन् दू॒र्शेभि॑र॒जिनै॑रु॒त",
   "प्र॒क्रीर॑सि॒ त्वमो॑ष॒धेऽभ्रि॑खाते॒ न रू॑रुपः"
  ],
  "lines_iast": [
   "pa̱vastai̭stvā̱ parya̭krīṇan dū̱rśebhi̭ra̱jinai̭ru̱ta",
   "pra̱krīra̭si̱ tvamo̭ṣa̱dhe'bhri̭khāte̱ na rṷ̄rupaḥ"
  ],
