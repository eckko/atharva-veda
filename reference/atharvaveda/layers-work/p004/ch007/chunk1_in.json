   "004.007.2a",
   "004.007.2b"
  ],
  "lines_deva": [
   "अ॒र॒सं प्रा॒च्यंऽवि॒षम॑र॒सं यदु॑दी॒च्यऽम्",
   "अथे॒दम॑धरा॒च्यं॑ कर॒म्भेण॒ वि क॑ल्पते"
  ],
  "lines_iast": [
   "a̱ra̱saṃ prā̱cyaṃ'vi̱ṣama̭ra̱saṃ yadṷdī̱cya'm",
   "athe̱dama̭dharā̱cya̭ṃ kara̱mbheṇa̱ vi ka̭lpate"
  ],
