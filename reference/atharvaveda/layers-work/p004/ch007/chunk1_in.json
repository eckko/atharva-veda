 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "004.007.4a",
   "004.007.4b"
  ],
  "lines_deva": [
   "वि ते॒ मदं॑ मदावति श॒रमि॑व पातयामसि",
   "प्र त्वा॑ च॒रुमि॑व॒ येष॑न्तं॒ वच॑सा स्थापयामसि"
  ],
  "lines_iast": [
   "vi te̱ mada̭ṃ madāvati śa̱rami̭va pātayāmasi",
   "pra tvā̭ ca̱rumi̭va̱ yeṣa̭nta̱ṃ vaca̭sā sthāpayāmasi"
  ],
