 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "004.007.3a",
   "004.007.3b"
  ],
  "lines_deva": [
   "क॒र॒म्भं कृ॒त्वा ति॒र्यंऽपीबस्पा॒कमु॑दार॒थिम्",
   "क्षु॒धा किल॑ त्वा दुष्टनो जक्षि॒वान्त्स न रू॑रुपः"
  ],
  "lines_iast": [
   "ka̱ra̱mbhaṃ kṛ̱tvā ti̱ryaṃ'pībaspā̱kamṷdāra̱thim",
   "kṣu̱dhā kila̭ tvā duṣṭano jakṣi̱vāntsa na rṷ̄rupaḥ"
  ],
