   "004.003.3b"
  ],
  "lines_deva": [
   "अ॒क्ष्यौऽच ते॒ मुखं॑ च ते व्याघ्र जम्भयामसि",
   "आत् सर्वा॑न् विंश॒तिं न॒खान्"
  ],
  "lines_iast": [
   "a̱kṣyau'ca te̱ mukha̭ṃ ca te vyāghra jambhayāmasi",
   "āt sarvā̭n viṃśa̱tiṃ na̱khān"
  ],
