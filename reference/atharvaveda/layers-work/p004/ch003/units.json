   "004.003.5b"
  ],
  "lines_deva": [
   "यो अ॒द्य स्ते॒न आय॑ति॒ स संपि॑ष्टो॒ अपा॑यति",
   "प॒थाम॑पध्वं॒सेनै॒त्विन्द्रो॒ वज्रे॑ण हन्तु॒ तम्"
  ],
  "lines_iast": [
   "yo a̱dya ste̱na āya̭ti̱ sa saṃpi̭ṣṭo̱ apā̭yati",
   "pa̱thāma̭padhva̱ṃsenai̱tvindro̱ vajrḙṇa hantu̱ tam"
  ],
