  "lines_deva": [
   "यत् सं॒यमो॒ न वि य॑मो॒ वि य॑मो॒ यन्न सं॒यमः॑",
   "इ॒न्द्र॒जाः सो॑म॒जा आ॑थर्व॒णम॑सि व्याघ्र॒जम्भ॑नम्"
  ],
  "lines_iast": [
   "yat sa̱ṃyamo̱ na vi ya̭mo̱ vi ya̭mo̱ yanna sa̱ṃyama̭ḥ",
   "i̱ndra̱jāḥ so̭ma̱jā ā̭tharva̱ṇama̭si vyāghra̱jambha̭nam"
  ],
