   "004.003.6b"
  ],
  "lines_deva": [
   "मू॒र्णा मृ॒गस्य॒ दन्ता॒ अपि॑शीर्णा उ पृ॒ष्टयः॑",
   "नि॒म्रुक्ते॑ गो॒धा भ॑वतु नी॒चाय॑च्छश॒युर्मृ॒गः"
  ],
  "lines_iast": [
   "mū̱rṇā mṛ̱gasya̱ dantā̱ api̭śīrṇā u pṛ̱ṣṭaya̭ḥ",
   "ni̱mruktḙ go̱dhā bha̭vatu nī̱cāya̭cchaśa̱yurmṛ̱gaḥ"
  ],
