   "004.003.4a",
   "004.003.4b"
  ],
  "lines_deva": [
   "व्या॒घ्रं द॒त्वतां॑ व॒यं प्र॑थ॒मं ज॑म्भयामसि",
   "आदु॑ ष्टे॒नमथो॒ अहिं॑ यातु॒धान॒मथो॒ वृक॑म्"
  ],
  "lines_iast": [
   "vyā̱ghraṃ da̱tvatā̭ṃ va̱yaṃ pra̭tha̱maṃ ja̭mbhayāmasi",
   "ādṷ ṣṭe̱namatho̱ ahi̭ṃ yātu̱dhāna̱matho̱ vṛka̭m"
  ],
