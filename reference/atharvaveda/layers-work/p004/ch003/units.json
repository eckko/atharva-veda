   "004.003.2a",
   "004.003.2b"
  ],
  "lines_deva": [
   "परे॑णैतु प॒था वृकः॑ पर॒मेणो॒त तस्क॑रः",
   "परे॑ण द॒त्वती॒ रज्जुः॒ परे॑णाघा॒युर॑र्षतु"
  ],
  "lines_iast": [
   "parḙṇaitu pa̱thā vṛka̭ḥ para̱meṇo̱ta taska̭raḥ",
   "parḙṇa da̱tvatī̱ rajju̱ḥ parḙṇāghā̱yura̭rṣatu"
  ],
