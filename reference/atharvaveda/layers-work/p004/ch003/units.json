[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "004.003.1a",
   "004.003.1b"
  ],
  "lines_deva": [
   "उदि॒तस्त्रयो॑ अक्रमन् व्या॒घ्रः पुरु॑षो॒ वृकः॑",
   "हिरु॒ग्घि यन्ति॒ सिन्ध॑वो॒ हिरु॑ग् दे॒वो वन॒स्पति॒र्हिरु॑ङ्नमन्तु॒ शत्र॑वः"
  ],
  "lines_iast": [
   "udi̱tastrayo̭ akraman vyā̱ghraḥ purṷṣo̱ vṛka̭ḥ",
   "hiru̱gghi yanti̱ sindha̭vo̱ hirṷg de̱vo vana̱spati̱rhirṷṅnamantu̱ śatra̭vaḥ"
  ],
  "book_split": [
