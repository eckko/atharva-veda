   "006.001.3b"
  ],
  "lines_deva": [
   "स घा॑ नो दे॒वः स॑वि॒ता सा॑विषद॒मृता॑नि॒ भूरि॑",
   "उ॒भे सु॑ष्टुती सु॒गात॑वे"
  ],
  "lines_iast": [
   "sa ghā̭ no de̱vaḥ sa̭vi̱tā sā̭viṣada̱mṛtā̭ni̱ bhūri̭",
   "u̱bhe sṷṣṭutī su̱gāta̭ve"
  ],
