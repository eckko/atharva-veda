  "lines_deva": [
   "दो॒षो गा॑य बृ॒हद् गा॑य द्यु॒मद् धे॑हि",
   "आथ॑र्वण स्तु॒हि दे॒वं स॑वि॒तार॑म्"
  ],
  "lines_iast": [
   "do̱ṣo gā̭ya bṛ̱had gā̭ya dyu̱mad dhḙhi",
   "ātha̭rvaṇa stu̱hi de̱vaṃ sa̭vi̱tāra̭m"
  ],
