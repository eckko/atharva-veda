   "006.001.2b"
  ],
  "lines_deva": [
   "तमु॑ ष्टुहि॒ यो अ॒न्तः सिन्धौ॑ सू॒नुः",
   "स॒त्यस्य॒ युवा॑न॒मद्रो॑घवाचं सु॒शेव॑म्"
  ],
  "lines_iast": [
   "tamṷ ṣṭuhi̱ yo a̱ntaḥ sindhaṷ sū̱nuḥ",
   "sa̱tyasya̱ yuvā̭na̱madro̭ghavācaṃ su̱śeva̭m"
  ],
