  ],
  "lines_deva": [
   "नमो॑ देवव॒धेभ्यो॒ नमो॑ राजव॒धेभ्यः॑",
   "अथो॒ ये विश्या॑नां व॒धास्तेभ्यो॑ मृत्यो॒ नमो॑ऽस्तु ते"
  ],
  "lines_iast": [
   "namo̭ devava̱dhebhyo̱ namo̭ rājava̱dhebhya̭ḥ",
   "atho̱ ye viśyā̭nāṃ va̱dhāstebhyo̭ mṛtyo̱ namo̭'stu te"
  ],
