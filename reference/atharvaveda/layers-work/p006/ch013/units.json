 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.013.3a",
   "006.013.3b"
  ],
  "lines_deva": [
   "नम॑स्ते यातु॒धाने॑भ्यो॒ नम॑स्ते भेष॒जेभ्यः॑",
   "नम॑स्ते मृत्यो॒ मूले॑भ्यो ब्राह्म॒णेभ्य॑ इ॒दं नमः॑"
  ],
  "lines_iast": [
   "nama̭ste yātu̱dhānḙbhyo̱ nama̭ste bheṣa̱jebhya̭ḥ",
   "nama̭ste mṛtyo̱ mūlḙbhyo brāhma̱ṇebhya̭ i̱daṃ nama̭ḥ"
  ],
