 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.013.2a",
   "006.013.2b"
  ],
  "lines_deva": [
   "नम॑स्ते अधिवा॒काय॑ परावा॒काय॑ ते॒ नमः॑",
   "सु॒म॒त्यै मृ॑त्यो ते॒ नमो॑ दुर्म॒त्यै त॑ इ॒दं नमः॑"
  ],
  "lines_iast": [
   "nama̭ste adhivā̱kāya̭ parāvā̱kāya̭ te̱ nama̭ḥ",
   "su̱ma̱tyai mṛ̭tyo te̱ namo̭ durma̱tyai ta̭ i̱daṃ nama̭ḥ"
  ],
