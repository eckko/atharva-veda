   "006.078.2a",
   "006.078.2b"
  ],
  "lines_deva": [
   "अ॒भि व॑र्धतां॒ पय॑सा॒भि रा॒ष्ट्रेण॑ वर्धताम्",
   "र॒य्या स॒हस्र॑वर्चसे॒मौ स्तामनु॑पक्षितौ"
  ],
  "lines_iast": [
   "a̱bhi va̭rdhatā̱ṃ paya̭sā̱bhi rā̱ṣṭreṇa̭ vardhatām",
   "ra̱yyā sa̱hasra̭varcase̱mau stāmanṷpakṣitau"
  ],
