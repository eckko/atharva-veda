   "006.078.3b"
  ],
  "lines_deva": [
   "त्वष्टा॑ जा॒याम॑जनय॒त् त्वष्टा॑स्यै॒ त्वां पति॑म्",
   "त्वष्टा॑ स॒हस्र॒मायूं॑षि दी॒र्घमायुः॑ कृणोतु वाम्"
  ],
  "lines_iast": [
   "tvaṣṭā̭ jā̱yāma̭janaya̱t tvaṣṭā̭syai̱ tvāṃ pati̭m",
   "tvaṣṭā̭ sa̱hasra̱māyṷ̄ṃṣi dī̱rghamāyṷḥ kṛṇotu vām"
  ],
