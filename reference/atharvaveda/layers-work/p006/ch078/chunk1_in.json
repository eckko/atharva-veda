  "lines_deva": [
   "तेन॑ भू॒तेन॑ ह॒विषा॒यमा प्या॑यतां॑ पुनः॑",
   "जा॒यां याम॑स्मा॒ आवा॑क्षु॒स्तां रसे॑ना॒भि व॑र्धताम्"
  ],
  "lines_iast": [
   "tena̭ bhū̱tena̭ ha̱viṣā̱yamā pyā̭yatā̭ṃ puna̭ḥ",
   "jā̱yāṃ yāma̭smā̱ āvā̭kṣu̱stāṃ rasḙnā̱bhi va̭rdhatām"
  ],
