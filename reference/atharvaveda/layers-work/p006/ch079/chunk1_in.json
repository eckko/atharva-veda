  ],
  "lines_deva": [
   "अ॒यं नो॒ नभ॑स॒स्पतिः॑ सं॒स्फानो॑ अ॒भि र॑क्षतु",
   "अस॑मातिं गृहेषु॑ नः"
  ],
  "lines_iast": [
   "a̱yaṃ no̱ nabha̭sa̱spati̭ḥ sa̱ṃsphāno̭ a̱bhi ra̭kṣatu",
   "asa̭mātiṃ gṛheṣṷ naḥ"
  ],
