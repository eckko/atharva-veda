   "006.079.3b"
  ],
  "lines_deva": [
   "देव॑ संस्फान सहस्रापो॒षस्ये॑शिषे",
   "तस्य॑ नो रास्व॒ तस्य॑ नो धेहि॒ तस्य॑ ते भक्ति॒वांसः॑ स्याम"
  ],
  "lines_iast": [
   "deva̭ saṃsphāna sahasrāpo̱ṣasyḙśiṣe",
   "tasya̭ no rāsva̱ tasya̭ no dhehi̱ tasya̭ te bhakti̱vāṃsa̭ḥ syāma"
  ],
