 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.079.2a",
   "006.079.2b"
  ],
  "lines_deva": [
   "त्वं नो॑ नभसस्पत ऊर्जं॑ गृ॒हेषु॑ धारय",
   "आ पु॒ष्टमेत्वा वसु॑"
  ],
  "lines_iast": [
   "tvaṃ no̭ nabhasaspata ūrja̭ṃ gṛ̱heṣṷ dhāraya",
   "ā pu̱ṣṭametvā vasṷ"
  ],
