 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.142.2a",
   "006.142.2b"
  ],
  "lines_deva": [
   "आ॒शृ॒ण्वन्तं॒ यवं॑ दे॒वं यत्र॑ त्वाच्छा॒वदा॑मसि",
   "तदुच्छ्र॑यस्व॒ द्यौरि॑व समु॒द्र इ॑वै॒ध्यक्षि॑तः"
  ],
  "lines_iast": [
   "ā̱śṛ̱ṇvanta̱ṃ yava̭ṃ de̱vaṃ yatra̭ tvācchā̱vadā̭masi",
   "taducchra̭yasva̱ dyauri̭va samu̱dra i̭vai̱dhyakṣi̭taḥ"
  ],
