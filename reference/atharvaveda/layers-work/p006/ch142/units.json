 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.142.3a",
   "006.142.3b"
  ],
  "lines_deva": [
   "अक्षि॑तास्त उप॒सदोऽक्षि॑ताः सन्तु रा॒शयः॑",
   "पृ॒णन्तो॒ अक्षि॑ताः सन्त्व॒त्तारः॑ स॒न्त्वक्षि॑ताः"
  ],
  "lines_iast": [
   "akṣi̭tāsta upa̱sado'kṣi̭tāḥ santu rā̱śaya̭ḥ",
   "pṛ̱ṇanto̱ akṣi̭tāḥ santva̱ttāra̭ḥ sa̱ntvakṣi̭tāḥ"
  ],
