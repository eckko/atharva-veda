  "lines_deva": [
   "त्रिं॒शद् धामा॒ वि रा॑जति॒ वाक् प॑त॒ङ्गो अ॑शिश्रियत्",
   "प्रति॒ वस्तो॒रह॒र्द्युभिः॑"
  ],
  "lines_iast": [
   "tri̱ṃśad dhāmā̱ vi rā̭jati̱ vāk pa̭ta̱ṅgo a̭śiśriyat",
   "prati̱ vasto̱raha̱rdyubhi̭ḥ"
