   "006.031.2b"
  ],
  "lines_deva": [
   "अ॒न्तश्च॑रति रोच॒ना अ॒स्य प्रा॒णाद॑पान॒तः",
   "व्यऽख्यन्महि॒षः स्वः"
  ],
  "lines_iast": [
   "a̱ntaśca̭rati roca̱nā a̱sya prā̱ṇāda̭pāna̱taḥ",
   "vya'khyanmahi̱ṣaḥ svaḥ"
