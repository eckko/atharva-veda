  "lines_deva": [
   "आयं गौः पृश्नि॑रक्रमी॒दस॑दन्मा॒तरं॑ पु॒रः",
   "पि॒तरं॑ च प्र॒यन्त्स्वः"
  ],
  "lines_iast": [
   "āyaṃ gauḥ pṛśni̭rakramī̱dasa̭danmā̱tara̭ṃ pu̱raḥ",
   "pi̱tara̭ṃ ca pra̱yantsvaḥ"
  ],
