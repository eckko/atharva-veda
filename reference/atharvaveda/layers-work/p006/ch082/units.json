  "lines_deva": [
   "आ॒गच्छ॑त॒ आग॑तस्य॒ नाम॑ गृह्णाम्याय॒तः",
   "इन्द्र॑स्य वृत्र॒घ्नो व॑न्वे वास॒वस्य॑ श॒तक्र॑तोः"
  ],
  "lines_iast": [
   "ā̱gaccha̭ta̱ āga̭tasya̱ nāma̭ gṛhṇāmyāya̱taḥ",
   "indra̭sya vṛtra̱ghno va̭nve vāsa̱vasya̭ śa̱takra̭toḥ"
  ],
