 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.082.3a",
   "006.082.3b"
  ],
  "lines_deva": [
   "यस्ते॑ऽङ्कु॒शो व॑सु॒दानो॑ बृ॒हन्नि॑न्द्र हिर॒ण्ययः॑",
   "तेना॑ जनीय॒ते जा॒यां मह्यं॑ धेहि शचीपते"
  ],
  "lines_iast": [
   "yastḙ'ṅku̱śo va̭su̱dāno̭ bṛ̱hanni̭ndra hira̱ṇyaya̭ḥ",
   "tenā̭ janīya̱te jā̱yāṃ mahya̭ṃ dhehi śacīpate"
  ],
