   "006.082.2a",
   "006.082.2b"
  ],
  "lines_deva": [
   "येन॑ सू॒र्यां सा॑वि॒त्रीम॒श्विनो॒हतुः॑ प॒था",
   "तेन॒ माम॑ब्रवी॒द् भगो॑ जा॒यामा व॑हता॒दिति॑"
  ],
  "lines_iast": [
   "yena̭ sū̱ryāṃ sā̭vi̱trīma̱śvino̱hatṷḥ pa̱thā",
   "tena̱ māma̭bravī̱d bhago̭ jā̱yāmā va̭hatā̱diti̭"
  ],
