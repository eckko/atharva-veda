   "006.071.3a",
   "006.071.3b"
  ],
  "lines_deva": [
   "यदन्न॒मद्म्यनृ॑तेन देवा दा॒स्यन्नदा॑स्यन्नु॒त सं॑गृ॒णामि॑",
   "वै॒श्वा॒न॒रस्य॑ मह॒तो म॑हि॒म्ना शि॒वं मह्यं॒ मधु॑मद॒स्त्वन्न॑म्"
  ],
  "lines_iast": [
   "yadanna̱madmyanṛ̭tena devā dā̱syannadā̭syannu̱ta sa̭ṃgṛ̱ṇāmi̭",
   "vai̱śvā̱na̱rasya̭ maha̱to ma̭hi̱mnā śi̱vaṃ mahya̱ṃ madhṷmada̱stvanna̭m"
  ],
