 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.071.2a",
   "006.071.2b"
  ],
  "lines_deva": [
   "यन्मा॑ हु॒तमहु॑तमाज॒गाम॑ द॒त्तं पि॒तृभि॒रनु॑मतं मनु॒ष्यैः",
   "यस्मा॑न्मे॒ मन॒ उदि॑व॒ रार॑जीत्य॒ग्निष्टद्धोता॒ सुहु॑तं कृणोतु"
  ],
  "lines_iast": [
   "yanmā̭ hu̱tamahṷtamāja̱gāma̭ da̱ttaṃ pi̱tṛbhi̱ranṷmataṃ manu̱ṣyaiḥ",
   "yasmā̭nme̱ mana̱ udi̭va̱ rāra̭jītya̱gniṣṭaddhotā̱ suhṷtaṃ kṛṇotu"
  ],
