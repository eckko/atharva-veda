   "006.071.1b"
  ],
  "lines_deva": [
   "यदन्न॒मद्मि॑ बहु॒धा विरू॑पं॒ हिर॑ण्य॒मश्व॑मु॒त गाम॒जामवि॑म्",
   "यदे॒व किं च॑ प्रतिज॒ग्रहाह॑म॒ग्निष्टद्धोता॒ सुहु॑तं कृनोतु"
  ],
  "lines_iast": [
   "yadanna̱madmi̭ bahu̱dhā virṷ̄pa̱ṃ hira̭ṇya̱maśva̭mu̱ta gāma̱jāmavi̭m",
   "yade̱va kiṃ ca̭ pratija̱grahāha̭ma̱gniṣṭaddhotā̱ suhṷtaṃ kṛnotu"
  ],
