  "lines_deva": [
   "न्य॑१ग्वातो॑ वाति॒ न्यऽक् तपति॑ सूर्यः॑",
   "नी॒चीन॑म॒घ्न्या दु॑हे॒ न्यऽग् भवतु ते॒ रपः॑"
  ],
  "lines_iast": [
   "nya̭1gvāto̭ vāti̱ nya'k tapati̭ sūrya̭ḥ",
   "nī̱cīna̭ma̱ghnyā dṷhe̱ nya'g bhavatu te̱ rapa̭ḥ"
  ],
