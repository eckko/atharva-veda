   "006.091.3b"
  ],
  "lines_deva": [
   "आप॒ इद् वा उ॑ भेष॒जीरापो॑ अमीव॒चात॑नीः",
   "आपो॑ विश्व॑स्य भेष॒जीस्तास्ते॑ कृण्वन्तु भेष॒जम्"
  ],
  "lines_iast": [
   "āpa̱ id vā ṷ bheṣa̱jīrāpo̭ amīva̱cāta̭nīḥ",
   "āpo̭ viśva̭sya bheṣa̱jīstāstḙ kṛṇvantu bheṣa̱jam"
  ],
