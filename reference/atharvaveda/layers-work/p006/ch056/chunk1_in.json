   "006.056.2b"
  ],
  "lines_deva": [
   "नमो॑ऽस्त्वसि॒ताय॒ नम॒स्तिर॑श्चिराजये",
   "स्व॒जाय॑ ब॒भ्रवे॒ नमो॒ नमो॑ देवज॒नेभ्यः॑"
  ],
  "lines_iast": [
   "namo̭'stvasi̱tāya̱ nama̱stira̭ścirājaye",
   "sva̱jāya̭ ba̱bhrave̱ namo̱ namo̭ devaja̱nebhya̭ḥ"
  ],
