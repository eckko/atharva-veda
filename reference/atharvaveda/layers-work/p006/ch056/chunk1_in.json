   "006.056.3b"
  ],
  "lines_deva": [
   "सं ते॑ हन्मि द॒ता द॒तः समु॑ ते॒ हन्वा॒ हनू॑",
   "सं ते॑ जि॒ह्वया॑ जि॒ह्वां सम्वा॒स्नाह॑ आ॒स्यऽम्"
  ],
  "lines_iast": [
   "saṃ tḙ hanmi da̱tā da̱taḥ samṷ te̱ hanvā̱ hanṷ̄",
   "saṃ tḙ ji̱hvayā̭ ji̱hvāṃ samvā̱snāha̭ ā̱sya'm"
  ],
