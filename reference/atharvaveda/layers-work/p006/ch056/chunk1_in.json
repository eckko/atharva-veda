  ],
  "lines_deva": [
   "मा नो॑ देवा॒ अहि॑र्वधी॒त् सतो॑कान्त्स॒हपु॑रुषान्",
   "सम्य॑तं॒ न वि ष्प॑रद् व्यात्तं॒ न सं य॑म॒न्नमो॑ देवज॒नेभ्यः॑"
  ],
  "lines_iast": [
   "mā no̭ devā̱ ahi̭rvadhī̱t sato̭kāntsa̱hapṷruṣān",
   "samya̭ta̱ṃ na vi ṣpa̭rad vyātta̱ṃ na saṃ ya̭ma̱nnamo̭ devaja̱nebhya̭ḥ"
  ],
