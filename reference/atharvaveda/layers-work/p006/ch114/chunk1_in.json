 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.114.2a",
   "006.114.2b"
  ],
  "lines_deva": [
   "ऋ॒तस्य॒र्ते॑ना॑दित्या॒ यज॑त्रा मु॒ञ्चते॒ह नः॑",
   "य॒ज्ञं यद् य॑ज्ञवाहसः॒ शिक्ष॑न्तो॒ नोप॑शेकि॒म"
  ],
  "lines_iast": [
   "ṛ̱tasya̱rtḙnā̭dityā̱ yaja̭trā mu̱ñcate̱ha na̭ḥ",
   "ya̱jñaṃ yad ya̭jñavāhasa̱ḥ śikṣa̭nto̱ nopa̭śeki̱ma"
  ],
