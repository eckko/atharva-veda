 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.114.3a",
   "006.114.3b"
  ],
  "lines_deva": [
   "मेद॑स्वता॒ यज॑मानाः स्रु॒चाज्या॑नि॒ जुह्व॑तः",
   "अ॒का॒मा वि॑श्वे वो देवाः॒ शिक्ष॑न्तो॒ नोप॑ शेकि॒म"
  ],
  "lines_iast": [
   "meda̭svatā̱ yaja̭mānāḥ sru̱cājyā̭ni̱ juhva̭taḥ",
   "a̱kā̱mā vi̭śve vo devā̱ḥ śikṣa̭nto̱ nopa̭ śeki̱ma"
  ],
