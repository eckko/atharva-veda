   "006.114.1a",
   "006.114.1b"
  ],
  "lines_deva": [
   "यद् दे॑वा देव॒हेड॑नं॒ देवा॑सश्चकृ॒मा व॒यम्",
   "आदि॑त्या॒स्तस्मा॑न्नो यू॒यमृ॒तस्य॒र्तेन॑ मुञ्चत"
  ],
  "lines_iast": [
   "yad dḙvā deva̱heḍa̭na̱ṃ devā̭saścakṛ̱mā va̱yam",
   "ādi̭tyā̱stasmā̭nno yū̱yamṛ̱tasya̱rtena̭ muñcata"
  ],
