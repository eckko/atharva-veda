   "006.014.1b"
  ],
  "lines_deva": [
   "अ॒स्थि॒स्रं॒सं प॑रुस्रं॒समास्थि॑तं हृदयाम॒यम्",
   "ब॒लासं॒ सर्वं॑ नाशयाङ्गे॒ष्ठा यश्च॒ पर्व॑सु"
  ],
  "lines_iast": [
   "a̱sthi̱sra̱ṃsaṃ pa̭rusra̱ṃsamāsthi̭taṃ hṛdayāma̱yam",
   "ba̱lāsa̱ṃ sarva̭ṃ nāśayāṅge̱ṣṭhā yaśca̱ parva̭su"
  ],
