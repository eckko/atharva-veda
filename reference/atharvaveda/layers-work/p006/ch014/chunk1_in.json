 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.014.2a",
   "006.014.2b"
  ],
  "lines_deva": [
   "निर्ब॒लासं॑ बला॒सिनः॑ क्षि॒णोमि॑ मुष्क॒रं य॑था",
   "छि॒नद्म्य॑स्य॒ बन्ध॑नं॒ मूल॑मुर्वा॒र्वा इ॑व"
  ],
  "lines_iast": [
   "nirba̱lāsa̭ṃ balā̱sina̭ḥ kṣi̱ṇomi̭ muṣka̱raṃ ya̭thā",
   "chi̱nadmya̭sya̱ bandha̭na̱ṃ mūla̭murvā̱rvā i̭va"
  ],
