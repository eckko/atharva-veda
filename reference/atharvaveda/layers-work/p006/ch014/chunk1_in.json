 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.014.3a",
   "006.014.3b"
  ],
  "lines_deva": [
   "निर्ब॑लासे॒तः प्र प॑ताशु॒ङ्गः शि॑शु॒को य॑था",
   "अथो॒ इट॑ इव हाय॒नोप॑ द्रा॒ह्यवी॑रहा"
  ],
  "lines_iast": [
   "nirba̭lāse̱taḥ pra pa̭tāśu̱ṅgaḥ śi̭śu̱ko ya̭thā",
   "atho̱ iṭa̭ iva hāya̱nopa̭ drā̱hyavī̭rahā"
  ],
