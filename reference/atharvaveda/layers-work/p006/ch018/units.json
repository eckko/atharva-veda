   "006.018.2b"
  ],
  "lines_deva": [
   "यथा॒ भूमि॑र्मृ॒तम॑ना मृ॒तान्मृ॒तम॑नस्तरा",
   "यथो॒त म॒म्रुषो॒ मन॑ ए॒वेर्ष्योर्मृ॒तं मनः॑"
  ],
  "lines_iast": [
   "yathā̱ bhūmi̭rmṛ̱tama̭nā mṛ̱tānmṛ̱tama̭nastarā",
   "yatho̱ta ma̱mruṣo̱ mana̭ e̱verṣyormṛ̱taṃ mana̭ḥ"
  ],
