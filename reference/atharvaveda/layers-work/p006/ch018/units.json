 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.018.3a",
   "006.018.3b"
  ],
  "lines_deva": [
   "अ॒दो यत् ते हृ॒दि श्रि॒तं म॑न॒स्कं प॑तयिष्णु॒कम्",
   "तत॑स्त ई॒र्ष्यां मु॑ञ्चामि॒ निरू॒ष्माणं॒ दृते॑रिव"
  ],
  "lines_iast": [
   "a̱do yat te hṛ̱di śri̱taṃ ma̭na̱skaṃ pa̭tayiṣṇu̱kam",
   "tata̭sta ī̱rṣyāṃ mṷñcāmi̱ nirū̱ṣmāṇa̱ṃ dṛtḙriva"
  ],
