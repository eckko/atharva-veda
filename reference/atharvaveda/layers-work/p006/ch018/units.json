  ],
  "lines_deva": [
   "ई॒र्ष्याया॒ ध्राजिं॑ प्रथ॒मां प्र॑थ॒मस्या॑ उ॒ताप॑राम्",
   "अ॒ग्निं हृ॑द॒य्यं॑१ शोकं॒ तं ते॒ निर्वा॑पयामसि"
  ],
  "lines_iast": [
   "ī̱rṣyāyā̱ dhrāji̭ṃ pratha̱māṃ pra̭tha̱masyā̭ u̱tāpa̭rām",
   "a̱gniṃ hṛ̭da̱yya̭ṃ1 śoka̱ṃ taṃ te̱ nirvā̭payāmasi"
  ],
