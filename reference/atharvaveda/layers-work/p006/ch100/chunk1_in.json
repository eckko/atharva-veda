 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.100.2a",
   "006.100.2b"
  ],
  "lines_deva": [
   "यद् वो॑ दे॒वा उ॑पजीका॒ आसि॑ञ्च॒न् धन्व॑न्युद॒कम्",
   "तेन॑ दे॒वप्र॑सूतेने॒दं दू॑षयता वि॒षम्"
  ],
  "lines_iast": [
   "yad vo̭ de̱vā ṷpajīkā̱ āsi̭ñca̱n dhanva̭nyuda̱kam",
   "tena̭ de̱vapra̭sūtene̱daṃ dṷ̄ṣayatā vi̱ṣam"
  ],
