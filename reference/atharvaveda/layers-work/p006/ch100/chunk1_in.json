   "006.100.1b"
  ],
  "lines_deva": [
   "दे॒वा अ॑दुः॒ सूर्यो॑ अदाद् द्यौर॑दात् पृथि॒व्यऽदात्",
   "ति॒स्रः सर॑स्वतिरदुः॒ सचि॑त्ता विष॒दूष॑णम्"
  ],
  "lines_iast": [
   "de̱vā a̭du̱ḥ sūryo̭ adād dyaura̭dāt pṛthi̱vya'dāt",
   "ti̱sraḥ sara̭svatiradu̱ḥ saci̭ttā viṣa̱dūṣa̭ṇam"
  ],
