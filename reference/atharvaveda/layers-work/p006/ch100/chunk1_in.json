 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.100.3a",
   "006.100.3b"
  ],
  "lines_deva": [
   "असु॑राणां दुहि॒तासि॒ सा दे॒वाना॑मसि॒ स्वसा॑",
   "दि॒वस्पृ॑थि॒व्याः संभू॑ता॒ सा च॑कर्थार॒सं वि॒षम्"
  ],
  "lines_iast": [
   "asṷrāṇāṃ duhi̱tāsi̱ sā de̱vānā̭masi̱ svasā̭",
   "di̱vaspṛ̭thi̱vyāḥ saṃbhṷ̄tā̱ sā ca̭karthāra̱saṃ vi̱ṣam"
  ],
