 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.085.3a",
   "006.085.3b"
  ],
  "lines_deva": [
   "यथा॑ वृ॒त्र इ॒मा आप॑स्त॒स्तम्भ॑ वि॒श्वधा॑ य॒तीः",
   "ए॒वा ते॑ अ॒ग्निना॒ यक्ष्मं॑ वैश्वान॒रेण॑ वारये"
  ],
  "lines_iast": [
   "yathā̭ vṛ̱tra i̱mā āpa̭sta̱stambha̭ vi̱śvadhā̭ ya̱tīḥ",
   "e̱vā tḙ a̱gninā̱ yakṣma̭ṃ vaiśvāna̱reṇa̭ vāraye"
  ],
