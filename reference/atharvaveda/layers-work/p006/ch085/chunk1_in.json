   "006.085.1a",
   "006.085.1b"
  ],
  "lines_deva": [
   "व॒र॒णो वा॑रयाता अ॒यं दे॒वो वन॒स्पतिः॑",
   "यक्ष्मो॒ यो अ॒स्मिन्नावि॑ष्ट॒स्तमु॑ दे॒वा अ॑वीवरन्"
  ],
  "lines_iast": [
   "va̱ra̱ṇo vā̭rayātā a̱yaṃ de̱vo vana̱spati̭ḥ",
   "yakṣmo̱ yo a̱sminnāvi̭ṣṭa̱stamṷ de̱vā a̭vīvaran"
  ],
