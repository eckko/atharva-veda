 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.085.2a",
   "006.085.2b"
  ],
  "lines_deva": [
   "इन्द्र॑स्य॒ वच॑सा व॒यं मि॒त्रस्य॒ वरु॑णस्य च",
   "दे॒वानां॒ सर्वे॑षां वा॒चा यक्ष्मं॑ ते वारयामहे"
  ],
  "lines_iast": [
   "indra̭sya̱ vaca̭sā va̱yaṃ mi̱trasya̱ varṷṇasya ca",
   "de̱vānā̱ṃ sarvḙṣāṃ vā̱cā yakṣma̭ṃ te vārayāmahe"
  ],
