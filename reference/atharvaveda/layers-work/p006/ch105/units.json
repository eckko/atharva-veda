  "lines_deva": [
   "यथा॒ सूर्य॑स्य र॒श्मयः॑ परा॒पत॑न्त्याशु॒मत्",
   "ए॒वा त्वं कासे॒ प्र प॑त समु॒द्रस्यानु॑ विक्ष॒रम्"
  ],
  "lines_iast": [
   "yathā̱ sūrya̭sya ra̱śmaya̭ḥ parā̱pata̭ntyāśu̱mat",
   "e̱vā tvaṃ kāse̱ pra pa̭ta samu̱drasyānṷ vikṣa̱ram"
