 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.118.3a",
   "006.118.3b"
  ],
  "lines_deva": [
   "यस्मा॑ ऋ॒णं यस्य॑ जा॒यामु॒पैमि॒ यं याच॑मानो अ॒भ्यैमि॑ देवाः",
   "ते वाचं॑ वादिषु॒र्मोत्त॑रां॒ मद्देव॑पत्नी॒ अप्स॑रसा॒वधी॑तम्"
  ],
  "lines_iast": [
   "yasmā̭ ṛ̱ṇaṃ yasya̭ jā̱yāmu̱paimi̱ yaṃ yāca̭māno a̱bhyaimi̭ devāḥ",
   "te vāca̭ṃ vādiṣu̱rmotta̭rā̱ṃ maddeva̭patnī̱ apsa̭rasā̱vadhī̭tam"
  ],
