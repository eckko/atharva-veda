 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.118.2a",
   "006.118.2b"
  ],
  "lines_deva": [
   "उग्रं॑पश्ये॒ राष्ट्र॑भृ॒त् किल्बि॑षाणि॒ यद॒क्षवृ॑त्त॒मनु॑ दत्तं न ए॒तत्",
   "ऋ॒णान्नो॒ नर्णमेर्त्स॑मानो य॒मस्य॑ लो॒के अधि॑रज्जु॒रा॑यत्"
  ],
  "lines_iast": [
   "ugra̭ṃpaśye̱ rāṣṭra̭bhṛ̱t kilbi̭ṣāṇi̱ yada̱kṣavṛ̭tta̱manṷ dattaṃ na e̱tat",
   "ṛ̱ṇānno̱ narṇamertsa̭māno ya̱masya̭ lo̱ke adhi̭rajju̱rā̭yat"
  ],
