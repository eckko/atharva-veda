   "006.118.1a",
   "006.118.1b"
  ],
  "lines_deva": [
   "यद्धस्ता॑भ्यां चकृ॒म किल्बि॑षाण्य॒क्षानां॑ ग॒त्नुमु॑प॒लिप्स॑मानाः",
   "उ॒ग्रं॒प॒श्ये उ॑ग्र॒जितौ॒ तद॒द्याप्स॒रसा॒वनु॑ दत्तामृ॒णं नः॑"
  ],
  "lines_iast": [
   "yaddhastā̭bhyāṃ cakṛ̱ma kilbi̭ṣāṇya̱kṣānā̭ṃ ga̱tnumṷpa̱lipsa̭mānāḥ",
   "u̱gra̱ṃpa̱śye ṷgra̱jitau̱ tada̱dyāpsa̱rasā̱vanṷ dattāmṛ̱ṇaṃ na̭ḥ"
  ],
