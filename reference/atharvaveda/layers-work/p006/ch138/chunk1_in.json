 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.138.2a",
   "006.138.2b"
  ],
  "lines_deva": [
   "क्ली॒बं कृ॑ध्योप॒शिन॒मथो॑ कुरी॒रिणं॑ कृधि",
   "अथा॒स्येन्द्रो॒ ग्राव॑भ्यामु॒भे भि॑नत्त्वा॒ण्ड्यौऽ"
  ],
  "lines_iast": [
   "klī̱baṃ kṛ̭dhyopa̱śina̱matho̭ kurī̱riṇa̭ṃ kṛdhi",
   "athā̱syendro̱ grāva̭bhyāmu̱bhe bhi̭nattvā̱ṇḍyau'"
  ],
