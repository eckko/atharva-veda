 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "006.138.4a",
   "006.138.4b"
  ],
  "lines_deva": [
   "ये ते॑ ना॒ड्यौऽदे॒वकृ॑ते॒ ययो॒स्तिष्ठ॑ति॒ वृष्ण्य॑म्",
   "ते ते॑ भिनद्मि॒ शम्य॑या॒मुष्या॒ अधि॑ मु॒ष्कयोः॑"
  ],
  "lines_iast": [
   "ye tḙ nā̱ḍyau'de̱vakṛ̭te̱ yayo̱stiṣṭha̭ti̱ vṛṣṇya̭m",
   "te tḙ bhinadmi̱ śamya̭yā̱muṣyā̱ adhi̭ mu̱ṣkayo̭ḥ"
  ],
