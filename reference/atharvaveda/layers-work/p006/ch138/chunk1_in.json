  "line_ids": [
   "006.138.1a",
   "006.138.1b"
  ],
  "lines_deva": [
   "त्वं वी॒रुधां॒ श्रेष्ठ॑तमाभिश्रु॒तास्यो॑षधे",
   "इ॒मं मे॑ अ॒द्य पुरु॑षं क्ली॒बमो॑प॒शिनं॑ कृधि"
  ],
  "lines_iast": [
   "tvaṃ vī̱rudhā̱ṃ śreṣṭha̭tamābhiśru̱tāsyo̭ṣadhe",
   "i̱maṃ mḙ a̱dya purṷṣaṃ klī̱bamo̭pa̱śina̭ṃ kṛdhi"
  ],
