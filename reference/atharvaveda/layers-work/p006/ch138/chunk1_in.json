 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.138.3a",
   "006.138.3b"
  ],
  "lines_deva": [
   "क्लीब॑ क्ली॒बं त्वा॑करं॒ वध्रे॒ वध्रिं॑ त्वाकर॒मर॑सार॒सं त्वा॑करम्",
   "कु॒रीर॑मस्य शी॒र्षणि॒ कुम्बं॑ चाधि॒निद॑ध्मसि"
  ],
  "lines_iast": [
   "klība̭ klī̱baṃ tvā̭kara̱ṃ vadhre̱ vadhri̭ṃ tvākara̱mara̭sāra̱saṃ tvā̭karam",
   "ku̱rīra̭masya śī̱rṣaṇi̱ kumba̭ṃ cādhi̱nida̭dhmasi"
  ],
