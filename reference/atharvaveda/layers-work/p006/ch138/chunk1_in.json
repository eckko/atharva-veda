   "006.138.5a",
   "006.138.5b"
  ],
  "lines_deva": [
   "यथा॑ न॒डं क॒शिपु॑ने॒ स्त्रियो॑ भि॒न्दन्त्यश्म॑ना",
   "ए॒वा भि॑नद्मि ते॒ शेपो॒ऽमुष्या॒ अधि॑ मु॒ष्कयोः॑"
  ],
  "lines_iast": [
   "yathā̭ na̱ḍaṃ ka̱śipṷne̱ striyo̭ bhi̱ndantyaśma̭nā",
   "e̱vā bhi̭nadmi te̱ śepo̱'muṣyā̱ adhi̭ mu̱ṣkayo̭ḥ"
  ],
