  "lines_deva": [
   "भगे॑न मा शांश॒पेन॑ सा॒कमिन्द्रे॑ण मे॒दिना॑",
   "कृ॒णोमि॑ भ॒गिनं॒ माप॑ द्रा॒न्त्वरा॑तयः"
  ],
  "lines_iast": [
   "bhagḙna mā śāṃśa̱pena̭ sā̱kamindrḙṇa me̱dinā̭",
   "kṛ̱ṇomi̭ bha̱gina̱ṃ māpa̭ drā̱ntvarā̭tayaḥ"
  ],
