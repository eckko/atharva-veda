   "006.129.2a",
   "006.129.2b"
  ],
  "lines_deva": [
   "येन॑ वृ॒क्षाँ अ॒भ्यभ॑वो॒ भगे॑न॒ वर्च॑सा स॒ह",
   "तेन॑ मा भ॒गिनं॑ कृ॒ण्वप॑ द्रा॒न्त्वरा॑तयः"
  ],
  "lines_iast": [
   "yena̭ vṛ̱kṣā~ a̱bhyabha̭vo̱ bhagḙna̱ varca̭sā sa̱ha",
   "tena̭ mā bha̱gina̭ṃ kṛ̱ṇvapa̭ drā̱ntvarā̭tayaḥ"
  ],
