 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.129.3a",
   "006.129.3b"
  ],
  "lines_deva": [
   "यो अ॒न्धो यः पु॑नःस॒रो भगो॑ वृ॒क्षेष्वाहि॑तः",
   "तेन॑ मा भ॒गिनं॑ कृ॒ण्वप॑ द्रा॒न्त्वरा॑तयः"
  ],
  "lines_iast": [
   "yo a̱ndho yaḥ pṷnaḥsa̱ro bhago̭ vṛ̱kṣeṣvāhi̭taḥ",
   "tena̭ mā bha̱gina̭ṃ kṛ̱ṇvapa̭ drā̱ntvarā̭tayaḥ"
  ],
