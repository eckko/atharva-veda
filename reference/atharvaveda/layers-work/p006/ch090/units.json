 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.090.2a",
   "006.090.2b"
  ],
  "lines_deva": [
   "यास्ते॑ श॒तं ध॒मन॒योऽङ्गा॒न्यनु॒ विष्ठि॑ताः",
   "तासां॑ ते॒ सर्वा॑सां व॒यं निर्वि॒षाणि॑ ह्वयामसि"
  ],
  "lines_iast": [
   "yāstḙ śa̱taṃ dha̱mana̱yo'ṅgā̱nyanu̱ viṣṭhi̭tāḥ",
   "tāsā̭ṃ te̱ sarvā̭sāṃ va̱yaṃ nirvi̱ṣāṇi̭ hvayāmasi"
  ],
