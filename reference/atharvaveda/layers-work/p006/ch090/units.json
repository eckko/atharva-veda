   "006.090.3a",
   "006.090.3b"
  ],
  "lines_deva": [
   "नम॑स्ते रु॒द्रास्य॑ते॒ नमः॒ प्रति॑हितायै",
   "नमो॑ विसृ॒ज्यमा॑नायै॒ नमो॒ निप॑तितायै"
  ],
  "lines_iast": [
   "nama̭ste ru̱drāsya̭te̱ nama̱ḥ prati̭hitāyai",
   "namo̭ visṛ̱jyamā̭nāyai̱ namo̱ nipa̭titāyai"
  ],
