   "006.090.1a",
   "006.090.1b"
  ],
  "lines_deva": [
   "यां ते॑ रु॒द्र इषु॒मास्य॒दङ्गे॑भ्यो॒ हृद॑याय च",
   "इ॒दं ताम॒द्य त्वद् व॒यं विषू॑चीं॒ वि वृ॑हामसि"
  ],
  "lines_iast": [
   "yāṃ tḙ ru̱dra iṣu̱māsya̱daṅgḙbhyo̱ hṛda̭yāya ca",
   "i̱daṃ tāma̱dya tvad va̱yaṃ viṣṷ̄cī̱ṃ vi vṛ̭hāmasi"
  ],
