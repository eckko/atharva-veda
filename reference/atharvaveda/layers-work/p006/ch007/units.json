  "lines_deva": [
   "येन॑ सो॒मादि॑तिः प॒था मि॒त्रा वा॒ यन्त्य॒द्रुहः॑",
   "तेना॒ नोऽव॒सा ग॑हि"
  ],
  "lines_iast": [
   "yena̭ so̱mādi̭tiḥ pa̱thā mi̱trā vā̱ yantya̱druha̭ḥ",
   "tenā̱ no'va̱sā ga̭hi"
  ],
