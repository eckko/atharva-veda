   "006.123.3a",
   "006.123.3b"
  ],
  "lines_deva": [
   "देवाः॒ पित॑रः॒ पित॑रो॒ देवाः॑",
   "यो अस्मि॒ सो अ॑स्मि"
  ],
  "lines_iast": [
   "devā̱ḥ pita̭ra̱ḥ pita̭ro̱ devā̭ḥ",
   "yo asmi̱ so a̭smi"
  ],
  "book_split": [
