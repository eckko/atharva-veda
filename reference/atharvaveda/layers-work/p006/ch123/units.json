  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.123.2a",
   "006.123.2b"
  ],
  "lines_deva": [
   "जा॒नी॒त स्मै॑नं पर॒मे व्योऽम॒न् देवाः॒ सध॑स्था वि॒द लो॒कमत्र॑",
   "अ॒न्वा॒ग॒न्ता यज॑मानः स्व॒स्तीऽष्टापू॒र्तं स्म॑ कृणुता॒विर॑स्मै"
  ],
  "lines_iast": [
   "jā̱nī̱ta smai̭naṃ para̱me vyo'ma̱n devā̱ḥ sadha̭sthā vi̱da lo̱kamatra̭",
   "a̱nvā̱ga̱ntā yaja̭mānaḥ sva̱stī'ṣṭāpū̱rtaṃ sma̭ kṛṇutā̱vira̭smai"
  ],
