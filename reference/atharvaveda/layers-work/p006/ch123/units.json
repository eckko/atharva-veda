   "006.123.5a",
   "006.123.5b"
  ],
  "lines_deva": [
   "नाके॑ राज॑न् प्रति॑ तिष्ठ॒ तत्रै॒तत् प्रति॑ तिष्ठतु",
   "वि॒द्धि पू॒र्तस्य॑ नो राज॒न्त्स दे॑व सु॒मना॑ भव"
  ],
  "lines_iast": [
   "nākḙ rāja̭n prati̭ tiṣṭha̱ tatrai̱tat prati̭ tiṣṭhatu",
   "vi̱ddhi pū̱rtasya̭ no rāja̱ntsa dḙva su̱manā̭ bhava"
  ],
