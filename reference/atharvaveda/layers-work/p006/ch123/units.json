[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "006.123.1a",
   "006.123.1b"
  ],
  "lines_deva": [
   "ए॒तं स॑धस्थाः॒ परि॑ वो ददामि॒ यं शे॑व॒धिमा॒वहा॑ज्जा॒तवे॑दाः",
   "अ॒न्वा॒ग॒न्ता यज॑मानः स्व॒स्ति तं स्म॑ जानीत पर॒मे व्योऽमन्"
  ],
  "lines_iast": [
   "e̱taṃ sa̭dhasthā̱ḥ pari̭ vo dadāmi̱ yaṃ śḙva̱dhimā̱vahā̭jjā̱tavḙdāḥ",
   "a̱nvā̱ga̱ntā yaja̭mānaḥ sva̱sti taṃ sma̭ jānīta para̱me vyo'man"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
