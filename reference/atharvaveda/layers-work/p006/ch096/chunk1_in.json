   "006.096.3b"
  ],
  "lines_deva": [
   "यच्चक्षु॑षा॒ मन॑सा॒ यच्च॑ वा॒चोपा॑रि॒म जाग्र॑तो॒ यत् स्व॒पन्तः॑",
   "सोम॒स्तानि॑ स्व॒धया॑ नः पुनातु"
  ],
  "lines_iast": [
   "yaccakṣṷṣā̱ mana̭sā̱ yacca̭ vā̱copā̭ri̱ma jāgra̭to̱ yat sva̱panta̭ḥ",
   "soma̱stāni̭ sva̱dhayā̭ naḥ punātu"
  ],
