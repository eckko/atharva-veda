  ],
  "lines_deva": [
   "या ओष॑धयः॒ सोम॑राज्ञीर्ब॒ह्वीः श॒तवि॑चक्षणाः",
   "बृह॒स्पति॑प्रसूता॒स्ता नो॑ मुञ्च॒न्त्वंह॑सः"
  ],
  "lines_iast": [
   "yā oṣa̭dhaya̱ḥ soma̭rājñīrba̱hvīḥ śa̱tavi̭cakṣaṇāḥ",
   "bṛha̱spati̭prasūtā̱stā no̭ muñca̱ntvaṃha̭saḥ"
  ],
