 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.077.3a",
   "006.077.3b"
  ],
  "lines_deva": [
   "जात॑वेदो॒ नि व॑र्तय श॒तं ते॑ सन्त्वा॒वतः॑",
   "स॒हस्रं॑ त उपा॒वृत॒स्तभि॑र्नः॒ पुन॒रा कृ॑धि"
  ],
  "lines_iast": [
   "jāta̭vedo̱ ni va̭rtaya śa̱taṃ tḙ santvā̱vata̭ḥ",
   "sa̱hasra̭ṃ ta upā̱vṛta̱stabhi̭rna̱ḥ puna̱rā kṛ̭dhi"
  ],
