 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.077.2a",
   "006.077.2b"
  ],
  "lines_deva": [
   "य उ॒दान॑ट् प॒राय॑णं॒ य उ॒दान॒ण् न्याय॑नम्",
   "आ॒वर्त॑नं नि॒वर्त॑नं॒ यो गो॒पा अपि॒ तं हु॑वे"
  ],
  "lines_iast": [
   "ya u̱dāna̭ṭ pa̱rāya̭ṇa̱ṃ ya u̱dāna̱ṇ nyāya̭nam",
   "ā̱varta̭naṃ ni̱varta̭na̱ṃ yo go̱pā api̱ taṃ hṷve"
  ],
