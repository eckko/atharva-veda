   "006.077.1b"
  ],
  "lines_deva": [
   "अस्था॒द् द्यौरस्था॑त् पृथि॒व्यस्था॒द् विश्व॑मि॒दं जग॑त्",
   "आ॒स्थाने॒ पर्व॑ता अस्थु॒ स्थाम्न्यश्वां॑ अतिष्ठिपम्"
  ],
  "lines_iast": [
   "asthā̱d dyaurasthā̭t pṛthi̱vyasthā̱d viśva̭mi̱daṃ jaga̭t",
   "ā̱sthāne̱ parva̭tā asthu̱ sthāmnyaśvā̭ṃ atiṣṭhipam"
  ],
