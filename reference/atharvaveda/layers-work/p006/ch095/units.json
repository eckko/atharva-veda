   "006.095.3b"
  ],
  "lines_deva": [
   "गर्भो॑ अ॒स्योष॑धीनां॒ गर्भो॑ हि॒मव॑तामु॒त",
   "गर्भो॒ विश्व॑स्य भू॒तस्ये॒मं मे॑ अग॒दं कृ॑धि"
  ],
  "lines_iast": [
   "garbho̭ a̱syoṣa̭dhīnā̱ṃ garbho̭ hi̱mava̭tāmu̱ta",
   "garbho̱ viśva̭sya bhū̱tasye̱maṃ mḙ aga̱daṃ kṛ̭dhi"
  ],
