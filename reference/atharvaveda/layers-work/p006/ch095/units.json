  "lines_deva": [
   "अ॒श्व॒त्थो दे॑व॒सद॑नस्तृ॒तीय॑स्यामि॒तो दि॒वि",
   "तत्रा॒मृत॑स्य॒ चक्ष॑णं दे॒वाः कुष्ठ॑मवन्वत"
  ],
  "lines_iast": [
   "a̱śva̱ttho dḙva̱sada̭nastṛ̱tīya̭syāmi̱to di̱vi",
   "tatrā̱mṛta̭sya̱ cakṣa̭ṇaṃ de̱vāḥ kuṣṭha̭mavanvata"
  ],
