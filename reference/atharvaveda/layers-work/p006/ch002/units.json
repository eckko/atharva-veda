   "006.002.3a",
   "006.002.3b"
  ],
  "lines_deva": [
   "सु॒नोता॑ सोम॒पाव्ने॑ सोम॒मिन्द्रा॑य व॒ज्रिणे॑",
   "युवा॒ जेतेशा॑नः॒ स पु॑रुष्टु॒तः"
  ],
  "lines_iast": [
   "su̱notā̭ soma̱pāvnḙ soma̱mindrā̭ya va̱jriṇḙ",
   "yuvā̱ jeteśā̭na̱ḥ sa pṷruṣṭu̱taḥ"
  ],
