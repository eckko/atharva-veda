 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.002.2a",
   "006.002.2b"
  ],
  "lines_deva": [
   "आ यं वि॒शन्तीन्द॑वो॒ वयो॒ न वृ॒क्षमन्ध॑सः",
   "विर॑प्शि॒न् विमृधो॑ जहि रक्ष॒स्विनीः॑"
  ],
  "lines_iast": [
   "ā yaṃ vi̱śantīnda̭vo̱ vayo̱ na vṛ̱kṣamandha̭saḥ",
   "vira̭pśi̱n vimṛdho̭ jahi rakṣa̱svinī̭ḥ"
  ],
