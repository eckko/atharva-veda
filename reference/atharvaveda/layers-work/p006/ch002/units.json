   "006.002.1b"
  ],
  "lines_deva": [
   "इन्द्रा॑य॒ सोम॑मृत्विजः सु॒नोता च॑ धावत",
   "स्तो॒तुर्यो वचः॑ शृ॒णव॒द्धवं॑ च मे"
  ],
  "lines_iast": [
   "indrā̭ya̱ soma̭mṛtvijaḥ su̱notā ca̭ dhāvata",
   "sto̱turyo vaca̭ḥ śṛ̱ṇava̱ddhava̭ṃ ca me"
  ],
