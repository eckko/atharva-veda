   "006.044.1a",
   "006.044.1b"
  ],
  "lines_deva": [
   "अस्था॒द् द्यौरस्था॑त् पृथि॒व्यस्था॒द् विश्व॑मि॒दं जग॑त्",
   "अस्थु॑र्वृ॒क्षा ऊ॒र्ध्वस्व॑प्ना॒स्तिष्ठा॒द् रोगो॑ अ॒यं तव॑"
  ],
  "lines_iast": [
   "asthā̱d dyaurasthā̭t pṛthi̱vyasthā̱d viśva̭mi̱daṃ jaga̭t",
   "asthṷrvṛ̱kṣā ū̱rdhvasva̭pnā̱stiṣṭhā̱d rogo̭ a̱yaṃ tava̭"
  ],
