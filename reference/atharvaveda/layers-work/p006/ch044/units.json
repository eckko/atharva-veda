 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.044.3a",
   "006.044.3b"
  ],
  "lines_deva": [
   "रु॒द्रस्य॒ मूत्र॑मस्य॒मृत॑स्य॒ नाभिः॑",
   "वि॒षा॒ण॒का नाम॒ वा अ॑सि पितॄ॒णां मूला॒दुत्थि॑ता वातीकृत॒नाश॑नी"
  ],
  "lines_iast": [
   "ru̱drasya̱ mūtra̭masya̱mṛta̭sya̱ nābhi̭ḥ",
   "vi̱ṣā̱ṇa̱kā nāma̱ vā a̭si pitṝ̱ṇāṃ mūlā̱dutthi̭tā vātīkṛta̱nāśa̭nī"
  ],
