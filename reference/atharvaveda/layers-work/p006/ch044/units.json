 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.044.2a",
   "006.044.2b"
  ],
  "lines_deva": [
   "श॒तं या भे॑ष॒जानि॑ ते स॒हस्रं॒ संग॑तानि च",
   "श्रेष्ठ॑मास्रावभेष॒जं वसि॑ष्ठं रोग॒नाश॑नम्"
  ],
  "lines_iast": [
   "śa̱taṃ yā bhḙṣa̱jāni̭ te sa̱hasra̱ṃ saṃga̭tāni ca",
   "śreṣṭha̭māsrāvabheṣa̱jaṃ vasi̭ṣṭhaṃ roga̱nāśa̭nam"
  ],
