   "006.042.1b"
  ],
  "lines_deva": [
   "अव॒ ज्यामि॑व॒ धन्व॑नो म॒न्युं त॑नोमि ते हृ॒दः",
   "यथा॒ संम॑नसौ भू॒त्वा सखा॑याविव॒ सचा॑वहै"
  ],
  "lines_iast": [
   "ava̱ jyāmi̭va̱ dhanva̭no ma̱nyuṃ ta̭nomi te hṛ̱daḥ",
   "yathā̱ saṃma̭nasau bhū̱tvā sakhā̭yāviva̱ sacā̭vahai"
  ],
