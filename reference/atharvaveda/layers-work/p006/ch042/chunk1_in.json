 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.042.3a",
   "006.042.3b"
  ],
  "lines_deva": [
   "अ॒भि ति॑ष्ठामि ते म॒न्युं पार्ष्ण्या॒ प्रप॑देन च",
   "यथा॑व॒शो न वादि॑षो॒ मम॑ चि॒त्तमु॒पाय॑सि"
  ],
  "lines_iast": [
   "a̱bhi ti̭ṣṭhāmi te ma̱nyuṃ pārṣṇyā̱ prapa̭dena ca",
   "yathā̭va̱śo na vādi̭ṣo̱ mama̭ ci̱ttamu̱pāya̭si"
  ],
