 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.042.2a",
   "006.042.2b"
  ],
  "lines_deva": [
   "सखा॑याविव सचावहा॒ अव॑ म॒न्युं त॑नोमि ते",
   "अ॒धस्ते॑ अश्म॑नो म॒न्युमुपा॑स्यामसि॒ यो गु॒रुः"
  ],
  "lines_iast": [
   "sakhā̭yāviva sacāvahā̱ ava̭ ma̱nyuṃ ta̭nomi te",
   "a̱dhastḙ aśma̭no ma̱nyumupā̭syāmasi̱ yo gu̱ruḥ"
  ],
