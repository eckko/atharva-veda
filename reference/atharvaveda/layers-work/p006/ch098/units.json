 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.098.3a",
   "006.098.3b"
  ],
  "lines_deva": [
   "प्राच्या॑ दि॒शस्त्वमि॑न्द्रासि॒ राजो॒तोदी॑च्या दि॒शो वृ॑त्रहन्छत्रु॒होऽसि",
   "यत्र॒ यन्ति॑ स्रो॒त्यास्तज्जि॒तं ते॑ दक्षिण॒तो वृ॑ष॒भ ए॑षि॒ हव्यः॑"
  ],
  "lines_iast": [
   "prācyā̭ di̱śastvami̭ndrāsi̱ rājo̱todī̭cyā di̱śo vṛ̭trahanchatru̱ho'si",
   "yatra̱ yanti̭ sro̱tyāstajji̱taṃ tḙ dakṣiṇa̱to vṛ̭ṣa̱bha ḙṣi̱ havya̭ḥ"
  ],
