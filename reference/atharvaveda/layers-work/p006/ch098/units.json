   "006.098.1b"
  ],
  "lines_deva": [
   "इन्द्रो॑ जयाति॒ न परा॑ जयाता अधिरा॒जो राज॑सु राजयातै",
   "च॒र्कृत्य॒ ईड्यो॒ वन्द्य॑श्चोप॒सद्यो॑ नम॒स्योऽभवे॒ह"
  ],
  "lines_iast": [
   "indro̭ jayāti̱ na parā̭ jayātā adhirā̱jo rāja̭su rājayātai",
   "ca̱rkṛtya̱ īḍyo̱ vandya̭ścopa̱sadyo̭ nama̱syo'bhave̱ha"
  ],
