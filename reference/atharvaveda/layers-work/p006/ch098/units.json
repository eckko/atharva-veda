 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.098.2a",
   "006.098.2b"
  ],
  "lines_deva": [
   "त्वमि॑न्द्राधिरा॒जः श्र॑व॒स्युस्त्वं भू॑र॒भिभू॑ति॒र्जना॑नाम्",
   "त्वं दैवी॒र्विश॑ इ॒मा वि रा॒जायु॑ष्मत् क्ष॒त्रम॒जरं॑ ते अस्तु"
  ],
  "lines_iast": [
   "tvami̭ndrādhirā̱jaḥ śra̭va̱syustvaṃ bhṷ̄ra̱bhibhṷ̄ti̱rjanā̭nām",
   "tvaṃ daivī̱rviśa̭ i̱mā vi rā̱jāyṷṣmat kṣa̱trama̱jara̭ṃ te astu"
  ],
