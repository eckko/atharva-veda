   "006.136.3b"
  ],
  "lines_deva": [
   "यस्ते॒ केशो॑ऽव॒पद्य॑ते॒ समू॑लो॒ यश्च॑ वृ॒श्चते॑",
   "इ॒दं तं वि॒श्वभे॑षज्या॒भि षि॑ञ्चामि वी॒रुधा॑"
  ],
  "lines_iast": [
   "yaste̱ keśo̭'va̱padya̭te̱ samṷ̄lo̱ yaśca̭ vṛ̱ścatḙ",
   "i̱daṃ taṃ vi̱śvabhḙṣajyā̱bhi ṣi̭ñcāmi vī̱rudhā̭"
  ],
