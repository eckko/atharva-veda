  "lines_deva": [
   "दे॒वी दे॒व्यामधि॑ जा॒ता पृ॑थि॒व्याम॑स्योषधे",
   "तां त्वा॑ नितत्नि॒ केशे॑भ्यो॒ दृंह॑णाय खनामसि"
  ],
  "lines_iast": [
   "de̱vī de̱vyāmadhi̭ jā̱tā pṛ̭thi̱vyāma̭syoṣadhe",
   "tāṃ tvā̭ nitatni̱ keśḙbhyo̱ dṛṃha̭ṇāya khanāmasi"
  ],
