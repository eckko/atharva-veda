   "006.115.1b"
  ],
  "lines_deva": [
   "यद् वि॒द्वांसो॒ यदवि॑द्वांस॒ एनां॑सि चकृ॒मा व॒यम्",
   "यू॒यं न॒स्तस्मा॑न्मुञ्चत॒ विश्वे॑ देवाः सजोषसः"
  ],
  "lines_iast": [
   "yad vi̱dvāṃso̱ yadavi̭dvāṃsa̱ enā̭ṃsi cakṛ̱mā va̱yam",
   "yū̱yaṃ na̱stasmā̭nmuñcata̱ viśvḙ devāḥ sajoṣasaḥ"
  ],
