 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.115.3a",
   "006.115.3b"
  ],
  "lines_deva": [
   "द्रु॒प॒दादि॑व मुमुचा॒नः स्वि॒न्नः स्ना॒त्वा मला॑दिव",
   "पू॒तं प॒वित्रे॑णे॒वाज्यं॒ विश्वे॑ शुम्भन्तु॒ मैन॑सः"
  ],
  "lines_iast": [
   "dru̱pa̱dādi̭va mumucā̱naḥ svi̱nnaḥ snā̱tvā malā̭diva",
   "pū̱taṃ pa̱vitrḙṇe̱vājya̱ṃ viśvḙ śumbhantu̱ maina̭saḥ"
  ],
