   "006.115.2a",
   "006.115.2b"
  ],
  "lines_deva": [
   "यदि॒ जाग्र॒द् यदि॒ स्वप॒न्नेन॑ एन॒स्योऽक॑रम्",
   "भू॒तं मा॒ तस्मा॒द् भव्यं॑ च द्रुप॒दादि॑व मुञ्चताम्"
  ],
  "lines_iast": [
   "yadi̱ jāgra̱d yadi̱ svapa̱nnena̭ ena̱syo'ka̭ram",
   "bhū̱taṃ mā̱ tasmā̱d bhavya̭ṃ ca drupa̱dādi̭va muñcatām"
  ],
