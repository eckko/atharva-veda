  "lines_deva": [
   "यथा॒ मम॒ स्मरा॑द॒सौ नामुष्या॒हं क॒दा च॒न",
   "देवाः॒ प्र हि॑णुत स्म॒रम॒सौ मामनु॑ शोचतु"
  ],
  "lines_iast": [
   "yathā̱ mama̱ smarā̭da̱sau nāmuṣyā̱haṃ ka̱dā ca̱na",
   "devā̱ḥ pra hi̭ṇuta sma̱rama̱sau māmanṷ śocatu"
  ],
