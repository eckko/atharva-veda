  "lines_deva": [
   "र॒थ॒जितां॑ राथजिते॒यीना॑मप्स॒रसा॑म॒यं स्म॒रः",
   "देवाः॒ प्र हि॑णुत स्म॒रम॒सौ मामनु॑ शोचतु"
  ],
  "lines_iast": [
   "ra̱tha̱jitā̭ṃ rāthajite̱yīnā̭mapsa̱rasā̭ma̱yaṃ sma̱raḥ",
   "devā̱ḥ pra hi̭ṇuta sma̱rama̱sau māmanṷ śocatu"
  ],
