   "006.130.2b"
  ],
  "lines_deva": [
   "अ॒सौ मे॑ स्मरता॒दिति॑ प्रि॒यो मे॑ स्मरता॒दिति॑",
   "देवाः॒ प्र हि॑णुत स्म॒रम॒सौ मामनु॑ शोचतु"
  ],
  "lines_iast": [
   "a̱sau mḙ smaratā̱diti̭ pri̱yo mḙ smaratā̱diti̭",
   "devā̱ḥ pra hi̭ṇuta sma̱rama̱sau māmanṷ śocatu"
  ],
