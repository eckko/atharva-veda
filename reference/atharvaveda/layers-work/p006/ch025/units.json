  ],
  "lines_deva": [
   "पञ्च॑ च॒ याः प॑ञ्चा॒शच्च॑ सं॒यन्ति॒ मन्या॑ अ॒भि",
   "इ॒तस्ताः सर्वा॑ नश्यन्तु वा॒का अ॑प॒चिता॑मिव"
  ],
  "lines_iast": [
   "pañca̭ ca̱ yāḥ pa̭ñcā̱śacca̭ sa̱ṃyanti̱ manyā̭ a̱bhi",
   "i̱tastāḥ sarvā̭ naśyantu vā̱kā a̭pa̱citā̭miva"
  ],
