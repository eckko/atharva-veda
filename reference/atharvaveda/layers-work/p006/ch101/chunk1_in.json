   "006.101.2b"
  ],
  "lines_deva": [
   "येन॑ कृ॒षं वा॒जय॑न्ति॒ येन॑ हि॒न्वन्त्यातु॑रम्",
   "तेना॒स्य ब्र॑ह्मणस्पते॒ धनु॑रि॒वा ता॑नया॒ पसः॑"
  ],
  "lines_iast": [
   "yena̭ kṛ̱ṣaṃ vā̱jaya̭nti̱ yena̭ hi̱nvantyātṷram",
   "tenā̱sya bra̭hmaṇaspate̱ dhanṷri̱vā tā̭nayā̱ pasa̭ḥ"
  ],
