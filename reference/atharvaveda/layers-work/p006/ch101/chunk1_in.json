   "006.101.1b"
  ],
  "lines_deva": [
   "आ वृ॑षायस्व श्वसि॒हि वर्ध॑स्व प्र॒थय॑स्व च",
   "य॒था॒ङ्गं व॑र्धतां॒ शेप॒स्तेन॑ यो॒षित॒मिज्ज॑हि"
  ],
  "lines_iast": [
   "ā vṛ̭ṣāyasva śvasi̱hi vardha̭sva pra̱thaya̭sva ca",
   "ya̱thā̱ṅgaṃ va̭rdhatā̱ṃ śepa̱stena̭ yo̱ṣita̱mijja̭hi"
  ],
