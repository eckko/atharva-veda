   "006.045.1a",
   "006.045.1b"
  ],
  "lines_deva": [
   "प॒रोऽपे॑हि मनस्पाप॒ किमश॑स्तानि शंससि",
   "परे॑हि॒ न त्वा॑ कामये वृ॒क्षां वना॑नि॒ सं च॑र गृ॒हेषु॑ गोषु॑ मे॒ मनः॑"
  ],
  "lines_iast": [
   "pa̱ro'pḙhi manaspāpa̱ kimaśa̭stāni śaṃsasi",
   "parḙhi̱ na tvā̭ kāmaye vṛ̱kṣāṃ vanā̭ni̱ saṃ ca̭ra gṛ̱heṣṷ goṣṷ me̱ mana̭ḥ"
  ],
