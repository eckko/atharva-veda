   "006.045.2a",
   "006.045.2b"
  ],
  "lines_deva": [
   "अ॒व॒शसा॑ निः॒शसा॒ यत् प॑रा॒शसो॑पारि॒म जाग्र॑तो॒ यत् स्व॒पन्तः॑",
   "अ॒ग्निर्वि॑श्वा॒न्यप॑ दुष्कृ॒तान्यजु॑ष्टान्या॒रे अ॒स्मद् द॑धातु"
  ],
  "lines_iast": [
   "a̱va̱śasā̭ ni̱ḥśasā̱ yat pa̭rā̱śaso̭pāri̱ma jāgra̭to̱ yat sva̱panta̭ḥ",
   "a̱gnirvi̭śvā̱nyapa̭ duṣkṛ̱tānyajṷṣṭānyā̱re a̱smad da̭dhātu"
  ],
