   "006.045.3a",
   "006.045.3b"
  ],
  "lines_deva": [
   "यदि॑न्द्र ब्रह्मणस्प॒तेऽपि॒ मृषा॒ चरा॑मसि",
   "प्रचे॑ता न आङ्गिर॒सो दु॑रि॒तात् पा॒त्वंह॑सः"
  ],
  "lines_iast": [
   "yadi̭ndra brahmaṇaspa̱te'pi̱ mṛṣā̱ carā̭masi",
   "pracḙtā na āṅgira̱so dṷri̱tāt pā̱tvaṃha̭saḥ"
  ],
