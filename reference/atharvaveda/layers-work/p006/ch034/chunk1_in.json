  "lines_deva": [
   "प्राग्नये॒ वाच॑मीरय वृष॒भाय॑ क्षिती॒नाम्",
   "स नः॑ पर्ष॒दति॒ द्विषः॑"
  ],
  "lines_iast": [
   "prāgnaye̱ vāca̭mīraya vṛṣa̱bhāya̭ kṣitī̱nām",
   "sa na̭ḥ parṣa̱dati̱ dviṣa̭ḥ"
  ],
