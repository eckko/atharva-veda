  "lines_deva": [
   "यो रक्षां॑सि नि॒जूर्व॑त्य॒ग्निस्ति॒ग्मेन॑ शो॒चिषा॑",
   "स नः॑ पर्ष॒दति॒ द्विषः॑"
  ],
  "lines_iast": [
   "yo rakṣā̭ṃsi ni̱jūrva̭tya̱gnisti̱gmena̭ śo̱ciṣā̭",
   "sa na̭ḥ parṣa̱dati̱ dviṣa̭ḥ"
