  "lines_deva": [
   "यः पर॑स्याः परा॒वत॑स्ति॒रो धन्वा॑ति॒रोच॑ते",
   "स नः॑ पर्ष॒दति॒ द्विषः॑"
  ],
  "lines_iast": [
   "yaḥ para̭syāḥ parā̱vata̭sti̱ro dhanvā̭ti̱roca̭te",
   "sa na̭ḥ parṣa̱dati̱ dviṣa̭ḥ"
