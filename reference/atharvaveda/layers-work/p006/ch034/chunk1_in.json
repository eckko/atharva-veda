   "006.034.4b"
  ],
  "lines_deva": [
   "यो विश्वा॒भि वि॒पश्य॑ति॒ भुव॑ना॒ सं च॒ पश्य॑ति",
   "स नः॑ पर्ष॒दति॒ द्विषः॑"
  ],
  "lines_iast": [
   "yo viśvā̱bhi vi̱paśya̭ti̱ bhuva̭nā̱ saṃ ca̱ paśya̭ti",
   "sa na̭ḥ parṣa̱dati̱ dviṣa̭ḥ"
