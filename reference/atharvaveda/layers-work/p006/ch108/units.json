   "006.108.5b"
  ],
  "lines_deva": [
   "मे॒धां सा॒यं मे॒धां प्रा॒तर्मे॒धां म॒ध्यन्दि॑नं॒ परि॑",
   "मे॒धां सूर्य॑स्य र॒श्मिभि॒र्वच॒सा वे॑शयामहे"
  ],
  "lines_iast": [
   "me̱dhāṃ sā̱yaṃ me̱dhāṃ prā̱tarme̱dhāṃ ma̱dhyandi̭na̱ṃ pari̭",
   "me̱dhāṃ sūrya̭sya ra̱śmibhi̱rvaca̱sā vḙśayāmahe"
  ],
