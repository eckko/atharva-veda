 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.108.3a",
   "006.108.3b"
  ],
  "lines_deva": [
   "यां मे॒धामृ॒भवो॑ वि॒दुर्यां मे॒धामसु॑रा वि॒दुः",
   "ऋष॑यो भ॒द्रां मे॒धां यां वि॒दुस्तां मय्या वे॑शयामसि"
  ],
  "lines_iast": [
   "yāṃ me̱dhāmṛ̱bhavo̭ vi̱duryāṃ me̱dhāmasṷrā vi̱duḥ",
   "ṛṣa̭yo bha̱drāṃ me̱dhāṃ yāṃ vi̱dustāṃ mayyā vḙśayāmasi"
  ],
