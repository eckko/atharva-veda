   "006.108.4b"
  ],
  "lines_deva": [
   "यामृष॑यो भूत॒कृतो॑ मे॒धां मे॑धा॒विनो॑ वि॒दुः",
   "तया॒ माम॒द्य मे॒धयाग्ने॑ मेधा॒विनं॑ कृणु"
  ],
  "lines_iast": [
   "yāmṛṣa̭yo bhūta̱kṛto̭ me̱dhāṃ mḙdhā̱vino̭ vi̱duḥ",
   "tayā̱ māma̱dya me̱dhayāgnḙ medhā̱vina̭ṃ kṛṇu"
  ],
