 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "006.108.1a",
   "006.108.1b"
  ],
  "lines_deva": [
   "त्वं नो॑ मेधे प्रथ॒मा गोभि॒रश्वे॑भि॒रा ग॑हि",
   "त्वं सूर्य॑स्य र॒श्मिभि॒स्त्वं नो॑ असि य॒ज्ञिया॑"
  ],
  "lines_iast": [
   "tvaṃ no̭ medhe pratha̱mā gobhi̱raśvḙbhi̱rā ga̭hi",
   "tvaṃ sūrya̭sya ra̱śmibhi̱stvaṃ no̭ asi ya̱jñiyā̭"
  ],
