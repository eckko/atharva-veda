 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.108.2a",
   "006.108.2b"
  ],
  "lines_deva": [
   "मे॒धाम॒हं प्र॑थ॒मां ब्रह्म॑ण्वतीं॒ ब्रह्म॑जूता॒मृषि॑ष्टुताम्",
   "प्रपी॑तां ब्रह्मचा॒रिभि॑र्दे॒वाना॒मव॑से हुवे"
  ],
  "lines_iast": [
   "me̱dhāma̱haṃ pra̭tha̱māṃ brahma̭ṇvatī̱ṃ brahma̭jūtā̱mṛṣi̭ṣṭutām",
   "prapī̭tāṃ brahmacā̱ribhi̭rde̱vānā̱mava̭se huve"
  ],
