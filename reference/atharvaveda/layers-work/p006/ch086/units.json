   "006.086.1b"
  ],
  "lines_deva": [
   "वृषेन्द्र॑स्य॒ वृषा॑ दि॒वो वृषा॑ पृथि॒व्या अ॒यम्",
   "वृषा॒ विश्व॑स्य भू॒तस्य॒ त्वमे॑कवृ॒षो भ॑व"
  ],
  "lines_iast": [
   "vṛṣendra̭sya̱ vṛṣā̭ di̱vo vṛṣā̭ pṛthi̱vyā a̱yam",
   "vṛṣā̱ viśva̭sya bhū̱tasya̱ tvamḙkavṛ̱ṣo bha̭va"
  ],
