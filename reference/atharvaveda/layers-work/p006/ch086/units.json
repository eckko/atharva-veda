 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.086.3a",
   "006.086.3b"
  ],
  "lines_deva": [
   "स॒म्राड॒स्यसु॑राणां क॒कुन्म॑नु॒ष्याऽणाम्",
   "दे॒वाना॑मर्ध॒भाग॑सि॒ त्वमे॑कवृ॒षो भ॑व"
  ],
  "lines_iast": [
   "sa̱mrāḍa̱syasṷrāṇāṃ ka̱kunma̭nu̱ṣyā'ṇām",
   "de̱vānā̭mardha̱bhāga̭si̱ tvamḙkavṛ̱ṣo bha̭va"
  ],
