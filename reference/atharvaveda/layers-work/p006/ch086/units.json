  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.086.2a",
   "006.086.2b"
  ],
  "lines_deva": [
   "स॒मु॒द्र ई॑शे स्र॒वता॑म॒ग्निः पृ॑थि॒व्या व॒शी",
   "च॒न्द्रमा॒ नक्ष॑त्राणामीशे॒ त्वमे॑कवृ॒षो भ॑व"
  ],
  "lines_iast": [
   "sa̱mu̱dra ī̭śe sra̱vatā̭ma̱gniḥ pṛ̭thi̱vyā va̱śī",
   "ca̱ndramā̱ nakṣa̭trāṇāmīśe̱ tvamḙkavṛ̱ṣo bha̭va"
  ],
