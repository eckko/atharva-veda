   "006.075.2b"
  ],
  "lines_deva": [
   "प॒र॒मां तं प॑रा॒वत॒मिन्द्रो॑ नुदतु वृत्र॒हा",
   "यतो॒ न पुन॒राय॑ति शश्व॒तीभ्यः॒ समा॑भ्यः"
  ],
  "lines_iast": [
   "pa̱ra̱māṃ taṃ pa̭rā̱vata̱mindro̭ nudatu vṛtra̱hā",
   "yato̱ na puna̱rāya̭ti śaśva̱tībhya̱ḥ samā̭bhyaḥ"
  ],
