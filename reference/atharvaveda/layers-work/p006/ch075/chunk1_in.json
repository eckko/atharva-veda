  "lines_deva": [
   "निर॒मुं नु॑द॒ ओक॑सः स॒पत्नो॒ यः पृ॑त॒न्यति॑",
   "नै॒र्बा॒ध्येऽन ह॒विषेन्द्र॑ एनं॒ परा॑शरीत्"
  ],
  "lines_iast": [
   "nira̱muṃ nṷda̱ oka̭saḥ sa̱patno̱ yaḥ pṛ̭ta̱nyati̭",
   "nai̱rbā̱dhye'na ha̱viṣendra̭ ena̱ṃ parā̭śarīt"
  ],
