   "006.075.3a",
   "006.075.3b",
   "006.075.3c"
  ],
  "lines_deva": [
   "एतु॑ ति॒स्रः प॑रा॒वत॒ एतु॒ पञ्च॒ जनाँ॒ अति॑",
   "एतु॑ ति॒स्रोऽति॑ रोच॒ना यतो॒ न पुन॒राय॑ति",
   "शश्व॒तीभ्यः॒ समा॑भ्यो॒ यावत् सूर्यो॒ अस॑द् दि॒वि"
  ],
  "lines_iast": [
   "etṷ ti̱sraḥ pa̭rā̱vata̱ etu̱ pañca̱ janā̱~ ati̭",
   "etṷ ti̱sro'ti̭ roca̱nā yato̱ na puna̱rāya̭ti",
   "śaśva̱tībhya̱ḥ samā̭bhyo̱ yāvat sūryo̱ asa̭d di̱vi"
  ],
