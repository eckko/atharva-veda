 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.032.3a",
   "006.032.3b"
  ],
  "lines_deva": [
   "अभ॑यं मित्रावरुणावि॒हास्तु॑ नो॒ऽर्चिषा॒त्त्रिणो॑ नुदतं प्र॒तीचः॑",
   "मा ज्ञा॒तारं॒ मा प्र॑ति॒ष्ठां वि॑दन्त मि॒थो वि॑घ्ना॒ना उप॑ यन्तु मृ॒त्युम्"
  ],
  "lines_iast": [
   "abha̭yaṃ mitrāvaruṇāvi̱hāstṷ no̱'rciṣā̱ttriṇo̭ nudataṃ pra̱tīca̭ḥ",
   "mā jñā̱tāra̱ṃ mā pra̭ti̱ṣṭhāṃ vi̭danta mi̱tho vi̭ghnā̱nā upa̭ yantu mṛ̱tyum"
  ],
