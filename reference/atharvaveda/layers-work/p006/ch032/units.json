 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.032.2a",
   "006.032.2b"
  ],
  "lines_deva": [
   "रु॒द्रो वो॑ ग्री॒वा अश॑रैत् पिशाचाः पृ॒ष्टीर्वोऽपि॑ शृणातु यातुधानाः",
   "वी॒रुद् वो॑ वि॒श्वतो॑वीर्या य॒मेन॒ सम॑जीगमत्"
  ],
  "lines_iast": [
   "ru̱dro vo̭ grī̱vā aśa̭rait piśācāḥ pṛ̱ṣṭīrvo'pi̭ śṛṇātu yātudhānāḥ",
   "vī̱rud vo̭ vi̱śvato̭vīryā ya̱mena̱ sama̭jīgamat"
  ],
