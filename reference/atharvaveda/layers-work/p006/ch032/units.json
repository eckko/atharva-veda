   "006.032.1b"
  ],
  "lines_deva": [
   "अ॒न्त॒र्दा॒वे जु॑हुता॒ स्वे॒३तद् या॑तुधान॒क्षय॑णं घृ॒तेन॑",
   "आ॒राद् रक्षां॑सि॒ प्रति॑ दह॒ त्वम॑ग्ने॒ न नो॑ गृ॒हाणा॒मुप॑ तीतपासि"
  ],
  "lines_iast": [
   "a̱nta̱rdā̱ve jṷhutā̱ sve̱3tad yā̭tudhāna̱kṣaya̭ṇaṃ ghṛ̱tena̭",
   "ā̱rād rakṣā̭ṃsi̱ prati̭ daha̱ tvama̭gne̱ na no̭ gṛ̱hāṇā̱mupa̭ tītapāsi"
  ],
