 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.029.2a",
   "006.029.2b"
  ],
  "lines_deva": [
   "यौ ते॑ दू॒तौ नि॑रृत इ॒दमे॒तोऽप्र॑हितौ॒ प्रहि॑तौ वा गृ॒हं नः॑",
   "क॒पो॒तो॒लू॒काभ्या॒मप॑दं॒ तद॑स्तु"
  ],
  "lines_iast": [
   "yau tḙ dū̱tau ni̭rṛta i̱dame̱to'pra̭hitau̱ prahi̭tau vā gṛ̱haṃ na̭ḥ",
   "ka̱po̱to̱lū̱kābhyā̱mapa̭da̱ṃ tada̭stu"
  ],
