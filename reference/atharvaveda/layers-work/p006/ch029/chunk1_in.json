   "006.029.1b"
  ],
  "lines_deva": [
   "अ॒मून् हे॒तिः प॑त॒त्रिणी॒ न्येऽतु॒ यदुलू॑को॒ वद॑ति मो॒घमे॒तत्",
   "यद् वा॑ क॒पोत॑ प॒दम॒ग्नौ कृ॒णोति॑"
  ],
  "lines_iast": [
   "a̱mūn he̱tiḥ pa̭ta̱triṇī̱ nye'tu̱ yadulṷ̄ko̱ vada̭ti mo̱ghame̱tat",
   "yad vā̭ ka̱pota̭ pa̱dama̱gnau kṛ̱ṇoti̭"
  ],
