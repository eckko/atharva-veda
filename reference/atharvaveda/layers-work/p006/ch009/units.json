   "006.009.2b"
  ],
  "lines_deva": [
   "मम॑ त्वा दोषणि॒श्रिषं॑ कृ॒णोमि॑ हृदय॒श्रिष॑म्",
   "यथा॒ मम॒ क्रता॒वसो॒ मम॑ चि॒त्तमु॒पाय॑सि"
  ],
  "lines_iast": [
   "mama̭ tvā doṣaṇi̱śriṣa̭ṃ kṛ̱ṇomi̭ hṛdaya̱śriṣa̭m",
   "yathā̱ mama̱ kratā̱vaso̱ mama̭ ci̱ttamu̱pāya̭si"
  ],
