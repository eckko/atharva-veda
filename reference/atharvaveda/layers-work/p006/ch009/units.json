  "lines_deva": [
   "वाञ्छ॑ मे त॒न्वं॑१ पादौ॒ वाञ्छा॒क्ष्यौ॒३वाञ्छ॑ स॒क्थ्यौऽ",
   "अ॒क्ष्यौऽ वृष॒ण्यन्त्याः॒ केशा॒ मां ते॑ कामे॑न शुष्यन्तु"
  ],
  "lines_iast": [
   "vāñcha̭ me ta̱nva̭ṃ1 pādau̱ vāñchā̱kṣyau̱3vāñcha̭ sa̱kthyau'",
   "a̱kṣyau' vṛṣa̱ṇyantyā̱ḥ keśā̱ māṃ tḙ kāmḙna śuṣyantu"
  ],
