   "006.009.3b"
  ],
  "lines_deva": [
   "यासां॒ नाभि॑रा॒रेह॑णं हृ॒दि सं॒वन॑नं कृ॒तम्",
   "गावो॑ घृ॒तस्य॑ मा॒तरो॒ ऽमूं सं वा॑नयन्तु मे"
  ],
  "lines_iast": [
   "yāsā̱ṃ nābhi̭rā̱reha̭ṇaṃ hṛ̱di sa̱ṃvana̭naṃ kṛ̱tam",
   "gāvo̭ ghṛ̱tasya̭ mā̱taro̱ 'mūṃ saṃ vā̭nayantu me"
  ],
