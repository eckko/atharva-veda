 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.069.2a",
   "006.069.2b"
  ],
  "lines_deva": [
   "अश्वि॑ना सार॒घेण॑ मा॒ मधु॑नाङ्क्तं शुभस्पती",
   "यथा॒ भर्ग॑स्वतीं॒ वाच॑मा॒वदा॑नि॒ जनाँ॑ अनु॑"
  ],
  "lines_iast": [
   "aśvi̭nā sāra̱gheṇa̭ mā̱ madhṷnāṅktaṃ śubhaspatī",
   "yathā̱ bharga̭svatī̱ṃ vāca̭mā̱vadā̭ni̱ janā̭~ anṷ"
  ],
