 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.069.3a",
   "006.069.3b"
  ],
  "lines_deva": [
   "मयि॒ वर्चो॒ अथो॒ यशोऽथो॑ य॒ज्ञस्य॒ यत् पयः॑",
   "तन्मयि॑ प्र॒जाप॑तिर्दि॒वि द्यामि॑व दृंहतु"
  ],
  "lines_iast": [
   "mayi̱ varco̱ atho̱ yaśo'tho̭ ya̱jñasya̱ yat paya̭ḥ",
   "tanmayi̭ pra̱jāpa̭tirdi̱vi dyāmi̭va dṛṃhatu"
  ],
