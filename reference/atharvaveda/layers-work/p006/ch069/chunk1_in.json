   "006.069.1a",
   "006.069.1b"
  ],
  "lines_deva": [
   "गि॒राव॑र॒गरा॑टेषु॒ हिर॑ण्ये॒ गोषु॒ यद् यशः॑",
   "सुरा॑यां सि॒च्यमा॑नायां की॒लाले॒ मधु॒ तन्मयि॑"
  ],
  "lines_iast": [
   "gi̱rāva̭ra̱garā̭ṭeṣu̱ hira̭ṇye̱ goṣu̱ yad yaśa̭ḥ",
   "surā̭yāṃ si̱cyamā̭nāyāṃ kī̱lāle̱ madhu̱ tanmayi̭"
  ],
