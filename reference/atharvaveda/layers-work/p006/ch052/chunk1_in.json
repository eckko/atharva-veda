   "006.052.3b"
  ],
  "lines_deva": [
   "आ॒यु॒र्ददं॑ विप॒श्चितं॑ श्रु॒तां कण्व॑स्य वी॒रुध॑म्",
   "आभा॑रिषं वि॒श्वभे॑षजीम॒स्यादृष्टा॒न् नि श॑मयत्"
  ],
  "lines_iast": [
   "ā̱yu̱rdada̭ṃ vipa̱ścita̭ṃ śru̱tāṃ kaṇva̭sya vī̱rudha̭m",
   "ābhā̭riṣaṃ vi̱śvabhḙṣajīma̱syādṛṣṭā̱n ni śa̭mayat"
  ],
