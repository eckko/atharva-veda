  "lines_deva": [
   "उत् सूर्यो॑ दि॒व ए॑ति पु॒रो रक्षां॑सि नि॒जूर्व॑न्",
   "आ॒दि॒त्यः पर्वतेभ्यो वि॒श्वदृ॑ष्टो अदृष्ट॒हा"
  ],
  "lines_iast": [
   "ut sūryo̭ di̱va ḙti pu̱ro rakṣā̭ṃsi ni̱jūrva̭n",
   "ā̱di̱tyaḥ parvatebhyo vi̱śvadṛ̭ṣṭo adṛṣṭa̱hā"
  ],
