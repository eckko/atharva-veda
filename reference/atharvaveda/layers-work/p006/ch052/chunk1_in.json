   "006.052.2b"
  ],
  "lines_deva": [
   "नि गावो॑ गो॒ष्ठे अ॑सद॒न् नि मृ॒गासो॑ अविक्षत",
   "न्यू॒३र्मयो॑ न॒दीनं॒ न्य॑१दृष्टा॑ अलिप्सत"
  ],
  "lines_iast": [
   "ni gāvo̭ go̱ṣṭhe a̭sada̱n ni mṛ̱gāso̭ avikṣata",
   "nyū̱3rmayo̭ na̱dīna̱ṃ nya̭1dṛṣṭā̭ alipsata"
  ],
