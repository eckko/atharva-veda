 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.005.2a",
   "006.005.2b"
  ],
  "lines_deva": [
   "इन्द्रे॒मं प्र॑त॒रं कृ॑धि सजा॒ताना॑मसद् व॒शी",
   "रा॒यस्पोषे॑ण॒ सं सृ॑ज जी॒वात॑वे ज॒रसे॑ नय"
  ],
  "lines_iast": [
   "indre̱maṃ pra̭ta̱raṃ kṛ̭dhi sajā̱tānā̭masad va̱śī",
   "rā̱yaspoṣḙṇa̱ saṃ sṛ̭ja jī̱vāta̭ve ja̱rasḙ naya"
  ],
