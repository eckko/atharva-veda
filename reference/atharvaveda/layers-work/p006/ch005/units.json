 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.005.3a",
   "006.005.3b"
  ],
  "lines_deva": [
   "यस्य॑ कृ॒ण्मो ह॒विर्गृ॒हे तम॑ग्ने वर्धया॒ त्वम्",
   "तस्मै॒ सोमो॒ अधि॑ ब्रवद॒यं च॒ ब्रह्म॑ण॒स्पतिः॑"
  ],
  "lines_iast": [
   "yasya̭ kṛ̱ṇmo ha̱virgṛ̱he tama̭gne vardhayā̱ tvam",
   "tasmai̱ somo̱ adhi̭ bravada̱yaṃ ca̱ brahma̭ṇa̱spati̭ḥ"
  ],
