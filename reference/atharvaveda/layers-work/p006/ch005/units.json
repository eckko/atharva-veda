  ],
  "lines_deva": [
   "उदे॑नमुत्त॒रं न॒याग्ने॑ घृ॒तेना॑हुत",
   "समे॑नं॒ वर्च॑सा सृज प्र॒जया॑ च ब॒हुं कृ॑धि"
  ],
  "lines_iast": [
   "udḙnamutta̱raṃ na̱yāgnḙ ghṛ̱tenā̭huta",
   "samḙna̱ṃ varca̭sā sṛja pra̱jayā̭ ca ba̱huṃ kṛ̭dhi"
  ],
