  "lines_deva": [
   "हि॒मव॑तः॒ प्र स्र॑वन्ति॒ सिन्धौ॑ समह सङ्ग॒मः",
   "आपो॑ ह मह्यं॒ तद् दे॒वीर्दद॑न् हृद्द्योतभेष॒जम्"
  ],
  "lines_iast": [
   "hi̱mava̭ta̱ḥ pra sra̭vanti̱ sindhaṷ samaha saṅga̱maḥ",
   "āpo̭ ha mahya̱ṃ tad de̱vīrdada̭n hṛddyotabheṣa̱jam"
  ],
