   "006.024.3b"
  ],
  "lines_deva": [
   "सिन्धु॑पत्नीः॒ सिन्धु॑राज्ञीः॒ सर्वा॒ या न॒द्य॑१स्थन॑",
   "द॒त्त न॒स्तस्य॑ भेष॒जं तेना॑ वो भुनजामहै"
  ],
  "lines_iast": [
   "sindhṷpatnī̱ḥ sindhṷrājñī̱ḥ sarvā̱ yā na̱dya̭1sthana̭",
   "da̱tta na̱stasya̭ bheṣa̱jaṃ tenā̭ vo bhunajāmahai"
  ],
