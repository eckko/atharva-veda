   "006.024.2b"
  ],
  "lines_deva": [
   "यन्मे॑ अ॒क्ष्योरा॑दि॒द्योत॒ पार्ष्ण्योः॒ प्रप॑दोश्च॒ यत्",
   "आप॒स्तत् सर्वं॒ निष्क॑रन् भि॒षजां॒ सुभि॑षक्तमाः"
  ],
  "lines_iast": [
   "yanmḙ a̱kṣyorā̭di̱dyota̱ pārṣṇyo̱ḥ prapa̭dośca̱ yat",
   "āpa̱stat sarva̱ṃ niṣka̭ran bhi̱ṣajā̱ṃ subhi̭ṣaktamāḥ"
  ],
