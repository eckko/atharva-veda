 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.127.3a",
   "006.127.3b",
   "006.127.3c"
  ],
  "lines_deva": [
   "यो अङ्ग्यो॒ यः कर्ण्यो॒ यो अ॒क्ष्योर्वि॒सल्प॑कः",
   "वि वृ॑हामो वि॒सल्प॑कं विद्र॒धं हृ॑दयाम॒यम्",
   "परा॒ तमज्ञा॑तं॒ यक्ष्म॑मध॒राञ्चं॑ सुवामसि"
  ],
  "lines_iast": [
   "yo aṅgyo̱ yaḥ karṇyo̱ yo a̱kṣyorvi̱salpa̭kaḥ",
   "vi vṛ̭hāmo vi̱salpa̭kaṃ vidra̱dhaṃ hṛ̭dayāma̱yam",
   "parā̱ tamajñā̭ta̱ṃ yakṣma̭madha̱rāñca̭ṃ suvāmasi"
  ],
