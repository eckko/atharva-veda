 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.127.2a",
   "006.127.2b"
  ],
  "lines_deva": [
   "यौ ते॑ बलास॒ तिष्ठ॑तः॒ कक्षे॑ मु॒ष्कावप॑श्रितौ",
   "वेदा॒हं तस्य॑ भेष॒जं ची॒पुद्रु॑रभि॒चक्ष॑णम्"
  ],
  "lines_iast": [
   "yau tḙ balāsa̱ tiṣṭha̭ta̱ḥ kakṣḙ mu̱ṣkāvapa̭śritau",
   "vedā̱haṃ tasya̭ bheṣa̱jaṃ cī̱pudrṷrabhi̱cakṣa̭ṇam"
  ],
