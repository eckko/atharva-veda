   "006.127.1b"
  ],
  "lines_deva": [
   "वि॒द्र॒धस्य॑ ब॒लास॑स्य॒ लोहि॑तस्य वनस्पते",
   "वि॒सल्प॑कस्योषधे॒ मोच्छि॑षः पिशि॒तं च॒न"
  ],
  "lines_iast": [
   "vi̱dra̱dhasya̭ ba̱lāsa̭sya̱ lohi̭tasya vanaspate",
   "vi̱salpa̭kasyoṣadhe̱ mocchi̭ṣaḥ piśi̱taṃ ca̱na"
  ],
