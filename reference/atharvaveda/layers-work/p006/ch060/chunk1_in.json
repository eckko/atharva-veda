   "006.060.2a",
   "006.060.2b"
  ],
  "lines_deva": [
   "अश्र॑मदि॒यम॑र्यमन्न॒न्यासां॒ सम॑नं य॒ती",
   "अ॒ङ्गो न्वऽर्यमन्न॒स्या अ॒न्याः सम॑न॒माय॑ति"
  ],
  "lines_iast": [
   "aśra̭madi̱yama̭ryamanna̱nyāsā̱ṃ sama̭naṃ ya̱tī",
   "a̱ṅgo nva'ryamanna̱syā a̱nyāḥ sama̭na̱māya̭ti"
  ],
