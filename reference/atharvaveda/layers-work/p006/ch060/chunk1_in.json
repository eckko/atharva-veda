   "006.060.1b"
  ],
  "lines_deva": [
   "अ॒यमा या॑त्यर्य॒मा पु॒रस्ता॒द् विषि॑तस्तुपः",
   "अ॒स्या इ॒चछन्न॒ग्रुवै॒ पति॑मु॒त जा॒याम॒जान॑ये"
  ],
  "lines_iast": [
   "a̱yamā yā̭tyarya̱mā pu̱rastā̱d viṣi̭tastupaḥ",
   "a̱syā i̱cachanna̱gruvai̱ pati̭mu̱ta jā̱yāma̱jāna̭ye"
  ],
