 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.060.3a",
   "006.060.3b"
  ],
  "lines_deva": [
   "धा॒ता दा॑धार पृथि॒वीं धा॒ता द्यामु॒त सूर्य॑म्",
   "धा॒तास्या अ॒ग्रुवै॒ पतिं॒ दधा॑तु प्रतिका॒म्यऽम्"
  ],
  "lines_iast": [
   "dhā̱tā dā̭dhāra pṛthi̱vīṃ dhā̱tā dyāmu̱ta sūrya̭m",
   "dhā̱tāsyā a̱gruvai̱ pati̱ṃ dadhā̭tu pratikā̱mya'm"
  ],
