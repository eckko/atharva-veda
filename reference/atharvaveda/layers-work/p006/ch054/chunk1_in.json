   "006.054.1a",
   "006.054.1b"
  ],
  "lines_deva": [
   "इ॒दं तद् यु॒ज उत्त॑र॒मिन्द्रं॑ शुम्भा॒म्यष्ट॑ये",
   "अ॒स्य क्ष॒त्रं श्रियं॑ म॒हीं वृ॒ष्टिरि॑व वर्धया॒ तृण॑म्"
  ],
  "lines_iast": [
   "i̱daṃ tad yu̱ja utta̭ra̱mindra̭ṃ śumbhā̱myaṣṭa̭ye",
   "a̱sya kṣa̱traṃ śriya̭ṃ ma̱hīṃ vṛ̱ṣṭiri̭va vardhayā̱ tṛṇa̭m"
  ],
