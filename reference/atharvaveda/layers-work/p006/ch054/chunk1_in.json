 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.054.2a",
   "006.054.2b"
  ],
  "lines_deva": [
   "अ॒स्मै क्ष॒त्रम॑ग्नीषोमाव॒स्मै धा॑रयतं र॒यिम्",
   "इ॒मं रा॒ष्ट्रस्या॑भीव॒र्गे कृ॑णु॒तं यु॒ज उत्त॑रम्"
  ],
  "lines_iast": [
   "a̱smai kṣa̱trama̭gnīṣomāva̱smai dhā̭rayataṃ ra̱yim",
   "i̱maṃ rā̱ṣṭrasyā̭bhīva̱rge kṛ̭ṇu̱taṃ yu̱ja utta̭ram"
  ],
