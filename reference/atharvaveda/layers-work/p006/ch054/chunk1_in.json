 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.054.3a",
   "006.054.3b"
  ],
  "lines_deva": [
   "सब॑न्धु॒श्चास॑बन्धुश्च॒ यो अ॒स्मां अ॑भि॒दास॑ति",
   "सर्वं॒ तं र॑न्धयासि मे॒ यज॑मानाय सुन्व॒ते"
  ],
  "lines_iast": [
   "saba̭ndhu̱ścāsa̭bandhuśca̱ yo a̱smāṃ a̭bhi̱dāsa̭ti",
   "sarva̱ṃ taṃ ra̭ndhayāsi me̱ yaja̭mānāya sunva̱te"
  ],
