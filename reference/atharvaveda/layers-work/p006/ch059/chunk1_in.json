 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.059.3a",
   "006.059.3b"
  ],
  "lines_deva": [
   "वि॒श्वरू॑पां सु॒भगा॑म॒च्छाव॑दामि जीव॒लाम्",
   "सा नो॑ रु॒द्रस्या॒स्तां हे॒तिं दू॒रं न॑यतु॒ गोभ्यः॑"
  ],
  "lines_iast": [
   "vi̱śvarṷ̄pāṃ su̱bhagā̭ma̱cchāva̭dāmi jīva̱lām",
   "sā no̭ ru̱drasyā̱stāṃ he̱tiṃ dū̱raṃ na̭yatu̱ gobhya̭ḥ"
  ],
