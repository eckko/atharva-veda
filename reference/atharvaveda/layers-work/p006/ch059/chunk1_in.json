  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.059.2a",
   "006.059.2b"
  ],
  "lines_deva": [
   "शर्म॑ यच्छ॒त्वोष॑धिः स॒ह दे॒वीर॑रुन्ध॒ती",
   "कर॒त् पय॑स्वन्तं गो॒ष्ठम॑य॒क्ष्मां उ॒त पूरु॑षान्"
  ],
  "lines_iast": [
   "śarma̭ yaccha̱tvoṣa̭dhiḥ sa̱ha de̱vīra̭rundha̱tī",
   "kara̱t paya̭svantaṃ go̱ṣṭhama̭ya̱kṣmāṃ u̱ta pūrṷṣān"
  ],
