   "006.059.1b"
  ],
  "lines_deva": [
   "अ॒न॒डुद्भ्य॒स्त्वं प्र॑थ॒मं धे॒नुभ्य॒स्त्वम॑रुन्धति",
   "अधे॑नवे॒ वय॑से॒ शर्म॑ यच्छ॒ चतु॑ष्पदे"
  ],
  "lines_iast": [
   "a̱na̱ḍudbhya̱stvaṃ pra̭tha̱maṃ dhe̱nubhya̱stvama̭rundhati",
   "adhḙnave̱ vaya̭se̱ śarma̭ yaccha̱ catṷṣpade"
  ],
