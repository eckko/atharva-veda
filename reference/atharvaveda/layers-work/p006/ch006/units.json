   "006.006.2b"
  ],
  "lines_deva": [
   "यो नः॑ सोम सुशं॒सिनो॑ दुः॒शंस॑ आ॒दिदे॑शति",
   "वज्रे॑णास्य॒ मुखे॑ जहि॒ स संपि॑ष्टो॒ अपा॑यति"
  ],
  "lines_iast": [
   "yo na̭ḥ soma suśa̱ṃsino̭ du̱ḥśaṃsa̭ ā̱didḙśati",
   "vajrḙṇāsya̱ mukhḙ jahi̱ sa saṃpi̭ṣṭo̱ apā̭yati"
  ],
