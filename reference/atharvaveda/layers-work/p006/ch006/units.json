   "006.006.3b"
  ],
  "lines_deva": [
   "यो नः॑ सोमाभि॒दास॑ति॒ सना॑भि॒र्यश्च॒ निष्ट्यः॑",
   "अप॒ तस्य॒ बलं॑ तिर म॒हीव॒ द्यौर्व॑ध॒त्मना॑"
  ],
  "lines_iast": [
   "yo na̭ḥ somābhi̱dāsa̭ti̱ sanā̭bhi̱ryaśca̱ niṣṭya̭ḥ",
   "apa̱ tasya̱ bala̭ṃ tira ma̱hīva̱ dyaurva̭dha̱tmanā̭"
  ],
