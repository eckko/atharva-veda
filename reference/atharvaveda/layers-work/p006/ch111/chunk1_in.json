 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.111.2a",
   "006.111.2b"
  ],
  "lines_deva": [
   "अ॒ग्निष्टे॒ नि श॑मयतु॒ यदि॑ ते॒ मन॒ उद्यु॑तम्",
   "कृ॒णोमि॑ वि॒द्वान् भे॑ष॒जं यदानु॑न्मदि॒तोऽस॑सि"
  ],
  "lines_iast": [
   "a̱gniṣṭe̱ ni śa̭mayatu̱ yadi̭ te̱ mana̱ udyṷtam",
   "kṛ̱ṇomi̭ vi̱dvān bhḙṣa̱jaṃ yadānṷnmadi̱to'sa̭si"
  ],
