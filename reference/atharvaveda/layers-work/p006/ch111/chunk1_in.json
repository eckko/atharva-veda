 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "006.111.1a",
   "006.111.1b"
  ],
  "lines_deva": [
   "इ॒मं मे॑ अग्ने॒ पुरु॑षं मुमुग्ध्य॒यं यो ब॒द्धः सुय॑तो॒ लाल॑पीति",
   "अतोऽधि॑ ते कृणवद् भाग॒धेयं॑ य॒दानु॑न्मदि॒तोऽस॑ति"
  ],
  "lines_iast": [
   "i̱maṃ mḙ agne̱ purṷṣaṃ mumugdhya̱yaṃ yo ba̱ddhaḥ suya̭to̱ lāla̭pīti",
   "ato'dhi̭ te kṛṇavad bhāga̱dheya̭ṃ ya̱dānṷnmadi̱to'sa̭ti"
  ],
