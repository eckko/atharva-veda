 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.111.3a",
   "006.111.3b"
  ],
  "lines_deva": [
   "दे॒वै॒न॒सादुन्म॑दित॒मुन्म॑त्तं॒ रक्ष॑स॒स्परि॑",
   "कृ॒णोमि॑ वि॒द्वान् भे॑ष॒जं यदानु॑न्मदि॒तोऽस॑ति"
  ],
  "lines_iast": [
   "de̱vai̱na̱sādunma̭dita̱munma̭tta̱ṃ rakṣa̭sa̱spari̭",
   "kṛ̱ṇomi̭ vi̱dvān bhḙṣa̱jaṃ yadānṷnmadi̱to'sa̭ti"
  ],
