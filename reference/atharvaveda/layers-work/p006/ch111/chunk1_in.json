 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "006.111.4a",
   "006.111.4b"
  ],
  "lines_deva": [
   "पुन॑स्त्वा दुरप्स॒रसः॒ पुन॒रिन्द्रः॒ पुन॒र्भगः॑",
   "पुन॑स्त्वा दु॒र्विश्वे॑ दे॒वा यथानु॑न्मदि॒तोऽस॑सि"
  ],
  "lines_iast": [
   "puna̭stvā durapsa̱rasa̱ḥ puna̱rindra̱ḥ puna̱rbhaga̭ḥ",
   "puna̭stvā du̱rviśvḙ de̱vā yathānṷnmadi̱to'sa̭si"
  ],
