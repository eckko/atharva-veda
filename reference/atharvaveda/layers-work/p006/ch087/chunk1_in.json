   "006.087.3b"
  ],
  "lines_deva": [
   "इन्द्र॑ ए॒तम॑दीधरत् ध्रु॒वं ध्रु॒वेण॑ ह॒विषा॑",
   "तस्मै॒ सोमो॒ अधि॑ ब्रवद॒यं च॒ ब्रह्म॑ण॒स्पतिः॑"
  ],
  "lines_iast": [
   "indra̭ e̱tama̭dīdharat dhru̱vaṃ dhru̱veṇa̭ ha̱viṣā̭",
   "tasmai̱ somo̱ adhi̭ bravada̱yaṃ ca̱ brahma̭ṇa̱spati̭ḥ"
  ],
