  ],
  "lines_deva": [
   "आ त्वा॑हार्षम॒न्तर॑भूर्ध्रु॒वस्ति॒ष्ठावि॑चाचलत्",
   "विश॑स्त्वा॒ सर्वा॑ वाञ्छन्तु॒ मा त्वद् रा॒ष्ट्रमधि॑ भ्रशत्"
  ],
  "lines_iast": [
   "ā tvā̭hārṣama̱ntara̭bhūrdhru̱vasti̱ṣṭhāvi̭cācalat",
   "viśa̭stvā̱ sarvā̭ vāñchantu̱ mā tvad rā̱ṣṭramadhi̭ bhraśat"
  ],
