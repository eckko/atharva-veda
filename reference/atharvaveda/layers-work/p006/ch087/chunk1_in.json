   "006.087.2a",
   "006.087.2b"
  ],
  "lines_deva": [
   "इ॒हैवैधि॒ माप॑ च्योष्ठाः॒ पर्व॑त इ॒वावि॑चाचलत्",
   "इन्द्र॑ इवे॒ह ध्रु॒वस्ति॑ष्ठे॒ह रा॒ष्ट्रमु॑ धारय"
  ],
  "lines_iast": [
   "i̱haivaidhi̱ māpa̭ cyoṣṭhā̱ḥ parva̭ta i̱vāvi̭cācalat",
   "indra̭ ive̱ha dhru̱vasti̭ṣṭhe̱ha rā̱ṣṭramṷ dhāraya"
  ],
