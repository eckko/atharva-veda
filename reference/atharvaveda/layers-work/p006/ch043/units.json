 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.043.3a",
   "006.043.3b"
  ],
  "lines_deva": [
   "वि ते॑ हन॒व्यां श॒रणिं॒ वि ते॒ मुख्यां॑ नयामसि",
   "यथा॑व॒शो न वादि॑षो॒ मम॑ चि॒त्तमु॒पाय॑सि"
  ],
  "lines_iast": [
   "vi tḙ hana̱vyāṃ śa̱raṇi̱ṃ vi te̱ mukhyā̭ṃ nayāmasi",
   "yathā̭va̱śo na vādi̭ṣo̱ mama̭ ci̱ttamu̱pāya̭si"
  ],
