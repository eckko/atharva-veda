 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.043.2a",
   "006.043.2b"
  ],
  "lines_deva": [
   "अ॒यं यो भूरि॑मूलः समु॒द्रम॑व॒तिष्ठ॑ति",
   "द॒र्भः पृ॑थि॒व्या उत्थि॑तो मन्यु॒शम॑न उच्यते"
  ],
  "lines_iast": [
   "a̱yaṃ yo bhūri̭mūlaḥ samu̱drama̭va̱tiṣṭha̭ti",
   "da̱rbhaḥ pṛ̭thi̱vyā utthi̭to manyu̱śama̭na ucyate"
  ],
