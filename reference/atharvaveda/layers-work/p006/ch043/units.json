  ],
  "lines_deva": [
   "अ॒यं द॒र्भो विम॑न्युकः॒ स्वाय॒ चार॑णाय च",
   "म॒न्योर्विम॑न्युकस्या॒यं म॑न्यु॒शम॑न उच्यते"
  ],
  "lines_iast": [
   "a̱yaṃ da̱rbho vima̭nyuka̱ḥ svāya̱ cāra̭ṇāya ca",
   "ma̱nyorvima̭nyukasyā̱yaṃ ma̭nyu̱śama̭na ucyate"
  ],
