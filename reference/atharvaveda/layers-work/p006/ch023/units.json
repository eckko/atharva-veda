  "lines_deva": [
   "स॒स्रुषी॒स्तद॒पसो॒ दिवा॒ नक्तं॑ च स॒स्रुषीः॑",
   "वरे॑ण्यक्रतुर॒हम॒पो दे॒वीरुप॑ ह्वये"
  ],
  "lines_iast": [
   "sa̱sruṣī̱stada̱paso̱ divā̱ nakta̭ṃ ca sa̱sruṣī̭ḥ",
   "varḙṇyakratura̱hama̱po de̱vīrupa̭ hvaye"
  ],
