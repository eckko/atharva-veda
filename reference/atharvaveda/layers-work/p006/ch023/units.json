   "006.023.2b"
  ],
  "lines_deva": [
   "ओता॒ आपः॑ कर्म॒ण्याऽमु॒ञ्चन्त्वि॒तः प्रणी॑तये",
   "स॒द्यः कृ॑ण्व॒न्त्वेत॑वे"
  ],
  "lines_iast": [
   "otā̱ āpa̭ḥ karma̱ṇyā'mu̱ñcantvi̱taḥ praṇī̭taye",
   "sa̱dyaḥ kṛ̭ṇva̱ntveta̭ve"
  ],
