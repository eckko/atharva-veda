   "006.023.3a",
   "006.023.3b"
  ],
  "lines_deva": [
   "दे॒वस्य॑ सवि॒तुः स॒वे कर्म॑ कृण्वन्तु॒ मानु॑षाः",
   "शं नो॑ भवन्त्व॒प ओष॑धीः शि॒वाः"
  ],
  "lines_iast": [
   "de̱vasya̭ savi̱tuḥ sa̱ve karma̭ kṛṇvantu̱ mānṷṣāḥ",
   "śaṃ no̭ bhavantva̱pa oṣa̭dhīḥ śi̱vāḥ"
  ],
