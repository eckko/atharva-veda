  "lines_deva": [
   "उप॒ प्रागा॑त् सहस्रा॒क्षो यु॒क्त्वा श॒पथो॒ रथ॑म्",
   "श॒प्तार॑मन्वि॒छन् मम॒ वृक॑ इ॒वावि॑मतो गृ॒हम्"
  ],
  "lines_iast": [
   "upa̱ prāgā̭t sahasrā̱kṣo yu̱ktvā śa̱patho̱ ratha̭m",
   "śa̱ptāra̭manvi̱chan mama̱ vṛka̭ i̱vāvi̭mato gṛ̱ham"
  ],
