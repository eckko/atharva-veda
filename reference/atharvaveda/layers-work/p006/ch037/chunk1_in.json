 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.037.3a",
   "006.037.3b"
  ],
  "lines_deva": [
   "यो नः॒ शपा॒दश॑पतः॒ शप॑तो॒ यश्च॑ नः॒ शपा॑त्",
   "शुने॑ पेष्ट्र॑मि॒वाव॑क्षामं॒ तं प्रत्य॑स्यामि मृ॒त्यवे॑"
  ],
  "lines_iast": [
   "yo na̱ḥ śapā̱daśa̭pata̱ḥ śapa̭to̱ yaśca̭ na̱ḥ śapā̭t",
   "śunḙ peṣṭra̭mi̱vāva̭kṣāma̱ṃ taṃ pratya̭syāmi mṛ̱tyavḙ"
  ],
