   "006.037.2b"
  ],
  "lines_deva": [
   "परि॑ णो वृङ्ग्धि शपथ ह्र॒दम॒ग्निरि॑वा॒ दह॑न्",
   "श॒प्तार॒मत्र॑ नो जहि दि॒वो वृ॒क्षमि॑वा॒शनिः॑"
  ],
  "lines_iast": [
   "pari̭ ṇo vṛṅgdhi śapatha hra̱dama̱gniri̭vā̱ daha̭n",
   "śa̱ptāra̱matra̭ no jahi di̱vo vṛ̱kṣami̭vā̱śani̭ḥ"
  ],
