   "006.139.3b"
  ],
  "lines_deva": [
   "शुष्य॑तु॒ मयि॑ ते॒ हृद॑य॒मथो॑ शुष्यत्वा॒स्यऽम्",
   "अथो॒ नि शु॑ष्य॒ मां कामे॒नाथो॒ शुष्का॑स्या चर"
  ],
  "lines_iast": [
   "śuṣya̭tu̱ mayi̭ te̱ hṛda̭ya̱matho̭ śuṣyatvā̱sya'm",
   "atho̱ ni śṷṣya̱ māṃ kāme̱nātho̱ śuṣkā̭syā cara"
  ],
