   "006.139.4b"
  ],
  "lines_deva": [
   "सं॒वन॑नी समुष्प॒ला बभ्रु॒ कल्या॑णि॒ सं नु॑द",
   "अमूं च॒ मां च॒ सं नु॑द समा॒नं हृद॑यं कृधि"
  ],
  "lines_iast": [
   "sa̱ṃvana̭nī samuṣpa̱lā babhru̱ kalyā̭ṇi̱ saṃ nṷda",
   "amūṃ ca̱ māṃ ca̱ saṃ nṷda samā̱naṃ hṛda̭yaṃ kṛdhi"
  ],
