  "lines_deva": [
   "यथा॑ नकु॒लो वि॒च्छिद्य॑ सं॒दधा॒त्यहिं॒ पुनः॑",
   "ए॒वा काम॑स्य॒ विच्छि॑न्नं॒ सं धे॑हि वीर्यावति"
  ],
  "lines_iast": [
   "yathā̭ naku̱lo vi̱cchidya̭ sa̱ṃdadhā̱tyahi̱ṃ puna̭ḥ",
   "e̱vā kāma̭sya̱ vicchi̭nna̱ṃ saṃ dhḙhi vīryāvati"
  ],
