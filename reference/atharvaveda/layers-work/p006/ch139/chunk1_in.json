  "lines_deva": [
   "न्य॒स्ति॒का रु॑रोहिथ सुभगं॒कर॑णी॒ मम॑",
   "श॒तं तव॑ प्रता॒नास्त्रय॑स्त्रिंशन्निता॒नाः"
  ],
  "lines_iast": [
   "nya̱sti̱kā rṷrohitha subhaga̱ṃkara̭ṇī̱ mama̭",
   "śa̱taṃ tava̭ pratā̱nāstraya̭striṃśannitā̱nāḥ"
  ],
