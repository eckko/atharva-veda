 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.099.3a",
   "006.099.3b"
  ],
  "lines_deva": [
   "परि॑ दद्म॒ इन्द्र॑स्य बा॒हू स॑म॒न्तं त्रा॒तुस्त्राय॑तां नः",
   "देव॑ सवितः॒ सोम॑ राजन्त्सु॒मन॑सं मा कृणु स्व॒स्तये॑"
  ],
  "lines_iast": [
   "pari̭ dadma̱ indra̭sya bā̱hū sa̭ma̱ntaṃ trā̱tustrāya̭tāṃ naḥ",
   "deva̭ savita̱ḥ soma̭ rājantsu̱mana̭saṃ mā kṛṇu sva̱stayḙ"
  ],
