  ],
  "lines_deva": [
   "अ॒भि त्वे॑न्द्र॒ वरि॑मतः पु॒रा त्वां॑हूर॒णाद्धु॑वे",
   "ह्वया॑म्यु॒ग्रं चे॒त्तारं॑ पु॒रुणा॑मानमेक॒जम्"
  ],
  "lines_iast": [
   "a̱bhi tvḙndra̱ vari̭mataḥ pu̱rā tvā̭ṃhūra̱ṇāddhṷve",
   "hvayā̭myu̱graṃ ce̱ttāra̭ṃ pu̱ruṇā̭mānameka̱jam"
  ],
