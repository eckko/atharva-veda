   "006.099.2a",
   "006.099.2b"
  ],
  "lines_deva": [
   "यो अ॒द्य सेन्यो॑ व॒धो जिघां॑सन् न उ॒दीर॑ते",
   "इन्द्र॑स्य॒ तत्र॑ बा॒हू स॑म॒न्तं परि॑ दद्मः"
  ],
  "lines_iast": [
   "yo a̱dya senyo̭ va̱dho jighā̭ṃsan na u̱dīra̭te",
   "indra̭sya̱ tatra̭ bā̱hū sa̭ma̱ntaṃ pari̭ dadmaḥ"
  ],
