  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.011.2a",
   "006.011.2b"
  ],
  "lines_deva": [
   "पुं॒सि वै रेतो॑ भवति॒ तत् स्त्रि॒यामनु॑ षिच्यते",
   "तद् वै पु॒त्रस्य॒ वेद॑नं॒ तत् प्र॒जाप॑तिरब्रवीत्"
  ],
  "lines_iast": [
   "pu̱ṃsi vai reto̭ bhavati̱ tat stri̱yāmanṷ ṣicyate",
   "tad vai pu̱trasya̱ veda̭na̱ṃ tat pra̱jāpa̭tirabravīt"
  ],
