   "006.011.1a",
   "006.011.1b"
  ],
  "lines_deva": [
   "श॒मीम॑श्व॒त्थ आरू॑ढ॒स्तत्र॑ पुं॒सु॑व॑नं कृ॒तम्",
   "तद् वै पु॒त्रस्य॒ वेद॑नं॒ तत् स्त्री॒ष्वा भ॑रामसि"
  ],
  "lines_iast": [
   "śa̱mīma̭śva̱ttha ārṷ̄ḍha̱statra̭ pu̱ṃsṷva̭naṃ kṛ̱tam",
   "tad vai pu̱trasya̱ veda̭na̱ṃ tat strī̱ṣvā bha̭rāmasi"
  ],
  "book_split": [
