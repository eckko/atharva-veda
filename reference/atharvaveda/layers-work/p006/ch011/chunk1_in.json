 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.011.3a",
   "006.011.3b"
  ],
  "lines_deva": [
   "प्र॒जाप॑ति॒रनु॑मतिः सिनीवा॒ल्यऽचीक्लृपत्",
   "स्त्रषू॑यम॒न्यत्र॒ दध॒त् पुंमां॑समु दधदि॒ह"
  ],
  "lines_iast": [
   "pra̱jāpa̭ti̱ranṷmatiḥ sinīvā̱lya'cīklṛpat",
   "straṣṷ̄yama̱nyatra̱ dadha̱t puṃmā̭ṃsamu dadhadi̱ha"
  ],
