 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.102.2a",
   "006.102.2b"
  ],
  "lines_deva": [
   "आहं खि॑दामि ते॒ मनो॑ राजा॒श्वः पृ॒ष्ट्यामि॑व",
   "रे॒ष्मच्छि॑न्नं॒ यथा॒ तृणं॒ मयि॑ ते वेष्टतां॒ मनः॑"
  ],
  "lines_iast": [
   "āhaṃ khi̭dāmi te̱ mano̭ rājā̱śvaḥ pṛ̱ṣṭyāmi̭va",
   "re̱ṣmacchi̭nna̱ṃ yathā̱ tṛṇa̱ṃ mayi̭ te veṣṭatā̱ṃ mana̭ḥ"
  ],
