   "006.102.1a",
   "006.102.1b"
  ],
  "lines_deva": [
   "यथा॒यं वा॒हो अ॑श्विना स॒मैति॒ सं च॒ वर्त॑ते",
   "ए॒वा माम॒भि ते॒ मनः॑ स॒मैतु॒ सं च॑ वर्तताम्"
  ],
  "lines_iast": [
   "yathā̱yaṃ vā̱ho a̭śvinā sa̱maiti̱ saṃ ca̱ varta̭te",
   "e̱vā māma̱bhi te̱ mana̭ḥ sa̱maitu̱ saṃ ca̭ vartatām"
  ],
