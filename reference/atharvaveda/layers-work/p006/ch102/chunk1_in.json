 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.102.3a",
   "006.102.3b"
  ],
  "lines_deva": [
   "आञ्ज॑नस्य म॒दुघ॑स्य॒ कुष्ठ॑स्य॒ नल॑दस्य च",
   "तु॒रो भग॑स्य॒ हस्ता॑भ्यामनु॒रोध॑न॒मुद् भ॑रे"
  ],
  "lines_iast": [
   "āñja̭nasya ma̱dugha̭sya̱ kuṣṭha̭sya̱ nala̭dasya ca",
   "tu̱ro bhaga̭sya̱ hastā̭bhyāmanu̱rodha̭na̱mud bha̭re"
  ],
