 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "006.128.4a",
   "006.128.4b"
  ],
  "lines_deva": [
   "यो नो॑ भद्रा॒हमक॑रः सा॒यं नक्त॒मथो॒ दिवा॑",
   "तस्मै॑ ते नक्षत्रराज॒ शक॑धूम॒ सदा॒ नमः॑"
  ],
  "lines_iast": [
   "yo no̭ bhadrā̱hamaka̭raḥ sā̱yaṃ nakta̱matho̱ divā̭",
   "tasmai̭ te nakṣatrarāja̱ śaka̭dhūma̱ sadā̱ nama̭ḥ"
  ],
