   "006.128.1a",
   "006.128.1b"
  ],
  "lines_deva": [
   "श॒क॒धूमं॒ नक्ष॑त्राणि॒ यद् राजा॑न॒मकु॑र्वत",
   "भ॒द्रा॒हम॑स्मै॒ प्राय॑च्छन्नि॒दं रा॒ष्ट्रमसा॒दिति॑"
  ],
  "lines_iast": [
   "śa̱ka̱dhūma̱ṃ nakṣa̭trāṇi̱ yad rājā̭na̱makṷrvata",
   "bha̱drā̱hama̭smai̱ prāya̭cchanni̱daṃ rā̱ṣṭramasā̱diti̭"
  ],
