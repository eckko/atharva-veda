 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.128.3a",
   "006.128.3b"
  ],
  "lines_deva": [
   "अ॒हो॒रा॒त्राभ्यां॒ नक्ष॑त्रेभ्यः सूर्याचन्द्र॒मसा॑भ्याम्",
   "भ॒द्रा॒हम॒स्मभ्यं॑ राज॒न्छक॑धूम॒ त्वं कृ॑धि"
  ],
  "lines_iast": [
   "a̱ho̱rā̱trābhyā̱ṃ nakṣa̭trebhyaḥ sūryācandra̱masā̭bhyām",
   "bha̱drā̱hama̱smabhya̭ṃ rāja̱nchaka̭dhūma̱ tvaṃ kṛ̭dhi"
  ],
