 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.128.2a",
   "006.128.2b"
  ],
  "lines_deva": [
   "भ॒द्रा॒हं नो॑ म॒ध्यंदि॑ने भद्रा॒हं सा॒यम॑स्तु नः",
   "भ॒द्रा॒हं नो॒ अह्नां॑ प्रा॒ता रात्री॑ भद्रा॒हम॑स्तु नः"
  ],
  "lines_iast": [
   "bha̱drā̱haṃ no̭ ma̱dhyaṃdi̭ne bhadrā̱haṃ sā̱yama̭stu naḥ",
   "bha̱drā̱haṃ no̱ ahnā̭ṃ prā̱tā rātrī̭ bhadrā̱hama̭stu naḥ"
  ],
