  ],
  "lines_deva": [
   "वा॒युरे॑नाः स॒माक॑र॒त् त्वष्टा॒ पोषा॑य ध्रियताम्",
   "इन्द्र॑ आभ्यो॒ अधि॑ ब्रवद् रु॒द्रो भू॒म्ने चि॑कित्सतु"
  ],
  "lines_iast": [
   "vā̱yurḙnāḥ sa̱māka̭ra̱t tvaṣṭā̱ poṣā̭ya dhriyatām",
   "indra̭ ābhyo̱ adhi̭ bravad ru̱dro bhū̱mne ci̭kitsatu"
  ],
