 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.141.2a",
   "006.141.2b"
  ],
  "lines_deva": [
   "लोहि॑तेन॒ स्वधि॑तिना मिथु॒नं कर्ण॑योः कृधि",
   "अक॑र्ताम॒श्विना॒ लक्ष्म॒ तद॑स्तु प्र॒जया॑ ब॒हु"
  ],
  "lines_iast": [
   "lohi̭tena̱ svadhi̭tinā mithu̱naṃ karṇa̭yoḥ kṛdhi",
   "aka̭rtāma̱śvinā̱ lakṣma̱ tada̭stu pra̱jayā̭ ba̱hu"
  ],
