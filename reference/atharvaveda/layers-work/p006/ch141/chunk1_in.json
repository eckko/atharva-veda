 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.141.3a",
   "006.141.3b"
  ],
  "lines_deva": [
   "यथा॑ च॒क्रुर्दे॑वासु॒रा यथा॑ मनु॒ष्याऽउ॒त",
   "ए॒वा स॑हस्रपो॒षाय॑ कृणु॒तं लक्ष्मा॑श्विना"
  ],
  "lines_iast": [
   "yathā̭ ca̱krurdḙvāsu̱rā yathā̭ manu̱ṣyā'u̱ta",
   "e̱vā sa̭hasrapo̱ṣāya̭ kṛṇu̱taṃ lakṣmā̭śvinā"
  ],
