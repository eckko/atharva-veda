 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.026.2a",
   "006.026.2b"
  ],
  "lines_deva": [
   "यो नः॑ पाप्म॒न् न जहा॑सि॒ तमु॑ त्वा जहिमो व॒यम्",
   "प॒थामनु॑ व्या॒वर्त॑ने॒ऽन्यं पा॒प्मानु॑ पद्यताम्"
  ],
  "lines_iast": [
   "yo na̭ḥ pāpma̱n na jahā̭si̱ tamṷ tvā jahimo va̱yam",
   "pa̱thāmanṷ vyā̱varta̭ne̱'nyaṃ pā̱pmānṷ padyatām"
  ],
