   "006.026.1a",
   "006.026.1b"
  ],
  "lines_deva": [
   "अव॑ मा पाप्मन्त्सृज व॒शी सन् मृ॑डयासि नः",
   "आ मा॑ भ॒द्रस्य॑ लो॒के पा॑प्मन् धे॒ह्यवि॑ह्रुतम्"
  ],
  "lines_iast": [
   "ava̭ mā pāpmantsṛja va̱śī san mṛ̭ḍayāsi naḥ",
   "ā mā̭ bha̱drasya̭ lo̱ke pā̭pman dhe̱hyavi̭hrutam"
  ],
