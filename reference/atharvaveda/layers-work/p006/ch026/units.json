   "006.026.3b"
  ],
  "lines_deva": [
   "अ॒न्यत्रा॒स्मन्न्युऽच्यतु सहस्रा॒क्षो अम॑र्त्यः",
   "यं द्वेषा॑म॒ तमृ॑च्छतु॒ यमु॑ द्वि॒ष्मस्तमिज्ज॑हि"
  ],
  "lines_iast": [
   "a̱nyatrā̱smannyu'cyatu sahasrā̱kṣo ama̭rtyaḥ",
   "yaṃ dveṣā̭ma̱ tamṛ̭cchatu̱ yamṷ dvi̱ṣmastamijja̭hi"
  ],
