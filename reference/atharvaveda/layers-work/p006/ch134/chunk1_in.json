   "006.134.1b"
  ],
  "lines_deva": [
   "अ॒यं वज्र॑स्तर्पयतामृ॒तस्यावा॑स्य रा॒ष्ट्रमप॑ हन्तु जीवि॒तम्",
   "शृ॒णातु॑ ग्री॒वाः प्र शृ॑णातू॒ष्णिहा॑ वृ॒त्रस्ये॑व॒ शची॒पतिः॑"
  ],
  "lines_iast": [
   "a̱yaṃ vajra̭starpayatāmṛ̱tasyāvā̭sya rā̱ṣṭramapa̭ hantu jīvi̱tam",
   "śṛ̱ṇātṷ grī̱vāḥ pra śṛ̭ṇātū̱ṣṇihā̭ vṛ̱trasyḙva̱ śacī̱pati̭ḥ"
  ],
