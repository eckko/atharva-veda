   "006.134.2b"
  ],
  "lines_deva": [
   "अध॑रोऽधर॒ उत्त॑रेभ्यो गू॒ढः पृ॑थि॒व्या मोत् सृपत्",
   "वज्रे॒णाव॑हतः शयाम्"
  ],
  "lines_iast": [
   "adha̭ro'dhara̱ utta̭rebhyo gū̱ḍhaḥ pṛ̭thi̱vyā mot sṛpat",
   "vajre̱ṇāva̭hataḥ śayām"
  ],
