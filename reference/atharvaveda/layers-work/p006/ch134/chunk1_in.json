   "006.134.3a",
   "006.134.3b"
  ],
  "lines_deva": [
   "यो जि॒नाति॒ तमन्वि॑च्छ यो जि॒नाति॒ तमिज्ज॑हि",
   "जि॒न॒तो व॑ज्र॒ त्वं सी॒मन्त॑म॒न्वञ्च॒मनु॑ पातय"
  ],
  "lines_iast": [
   "yo ji̱nāti̱ tamanvi̭ccha yo ji̱nāti̱ tamijja̭hi",
   "ji̱na̱to va̭jra̱ tvaṃ sī̱manta̭ma̱nvañca̱manṷ pātaya"
  ],
