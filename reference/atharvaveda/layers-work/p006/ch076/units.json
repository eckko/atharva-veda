   "006.076.3b"
  ],
  "lines_deva": [
   "यो अ॑स्य स॒मिधं॒ वेद॑ क्ष॒त्रिये॑ण स॒माहि॑ताम्",
   "नाभि॑ह्वा॒रे प॒दं नि द॑धाति॒ स मृ॒त्यवे॑"
  ],
  "lines_iast": [
   "yo a̭sya sa̱midha̱ṃ veda̭ kṣa̱triyḙṇa sa̱māhi̭tām",
   "nābhi̭hvā̱re pa̱daṃ ni da̭dhāti̱ sa mṛ̱tyavḙ"
  ],
