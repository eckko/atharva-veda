  "lines_deva": [
   "य ए॑नं परि॒षीद॑न्ति समा॒दध॑ति॒ चक्ष॑से",
   "सं॒प्रेद्धो॑ अ॒ग्निर्जि॒ह्वाभि॒रुदे॑तु॒ हृद॑या॒दधि॑"
  ],
  "lines_iast": [
   "ya ḙnaṃ pari̱ṣīda̭nti samā̱dadha̭ti̱ cakṣa̭se",
   "sa̱ṃpreddho̭ a̱gnirji̱hvābhi̱rudḙtu̱ hṛda̭yā̱dadhi̭"
  ],
