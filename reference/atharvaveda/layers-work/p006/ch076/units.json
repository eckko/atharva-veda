   "006.076.4b"
  ],
  "lines_deva": [
   "नैनं घ्नन्ति पर्या॒यिणो॒ न स॒न्नाँ अव॑ गच्छति",
   "अ॒ग्नेर्यः क्ष॒त्रियो॑ वि॒द्वान् नाम॑ गृ॒ह्णात्यायु॑षे"
  ],
  "lines_iast": [
   "nainaṃ ghnanti paryā̱yiṇo̱ na sa̱nnā~ ava̭ gacchati",
   "a̱gneryaḥ kṣa̱triyo̭ vi̱dvān nāma̭ gṛ̱hṇātyāyṷṣe"
  ],
