   "006.076.2b"
  ],
  "lines_deva": [
   "अ॒ग्नेः सा॑न्तप॒नस्या॒हमायु॑षे प॒दमा र॑भे",
   "अ॒द्धा॒तिर्यस्य॒ पश्य॑ति धू॒ममु॒द्यन्त॑मास्य॒तः"
  ],
  "lines_iast": [
   "a̱gneḥ sā̭ntapa̱nasyā̱hamāyṷṣe pa̱damā ra̭bhe",
   "a̱ddhā̱tiryasya̱ paśya̭ti dhū̱mamu̱dyanta̭māsya̱taḥ"
  ],
