   "006.083.2b"
  ],
  "lines_deva": [
   "एन्येका॒ श्येन्येका॑ कृ॒ष्णैका॒ रोहि॑णी॒ द्वे",
   "सर्वा॑सामग्रभं॒ नामावी॑रघ्नी॒रपे॑तन"
  ],
  "lines_iast": [
   "enyekā̱ śyenyekā̭ kṛ̱ṣṇaikā̱ rohi̭ṇī̱ dve",
   "sarvā̭sāmagrabha̱ṃ nāmāvī̭raghnī̱rapḙtana"
  ],
