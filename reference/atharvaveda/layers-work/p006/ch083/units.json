  "lines_deva": [
   "अप॑चितः॒ प्र प॑तत सुप॒र्णो व॑स॒तेरि॑व",
   "सूर्यः॑ कृ॒णोतु॑ भेष॒जं च॒न्द्रमा॒ वोऽपो॑च्छतु"
  ],
  "lines_iast": [
   "apa̭cita̱ḥ pra pa̭tata supa̱rṇo va̭sa̱teri̭va",
   "sūrya̭ḥ kṛ̱ṇotṷ bheṣa̱jaṃ ca̱ndramā̱ vo'po̭cchatu"
  ],
