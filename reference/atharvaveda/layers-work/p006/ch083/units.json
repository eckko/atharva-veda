  "lines_deva": [
   "अ॒सूति॑का रामाय॒ण्यऽप॒चित् प्र प॑तिष्यति",
   "ग्लरि॒तः प्र प॑तिष्यति॒ स ग॑लु॒न्तो न॑शिष्यति"
  ],
  "lines_iast": [
   "a̱sūti̭kā rāmāya̱ṇya'pa̱cit pra pa̭tiṣyati",
   "glari̱taḥ pra pa̭tiṣyati̱ sa ga̭lu̱nto na̭śiṣyati"
  ],
