  "lines_deva": [
   "श्ये॒नोऽसि गाय॒त्रच्छन्दा॒ अनु॒ त्वा र॑भे",
   "स्व॒स्ति मा॒ सं व॑हा॒स्य य॒ज्ञस्यो॒दृचि॒ स्वाहा॑"
  ],
  "lines_iast": [
   "śye̱no'si gāya̱tracchandā̱ anu̱ tvā ra̭bhe",
   "sva̱sti mā̱ saṃ va̭hā̱sya ya̱jñasyo̱dṛci̱ svāhā̭"
  ],
