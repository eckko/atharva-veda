   "006.065.3a",
   "006.065.3b"
  ],
  "lines_deva": [
   "इन्द्र॑श्चकार प्रथ॒मं नै॑र्ह॒स्तमसु॑रेभ्यः",
   "जय॑न्तु सत्वा॑नो॒ मम॑ स्थि॒रेणेन्द्रे॑ण मे॒दिना॑"
  ],
  "lines_iast": [
   "indra̭ścakāra pratha̱maṃ nai̭rha̱stamasṷrebhyaḥ",
   "jaya̭ntu satvā̭no̱ mama̭ sthi̱reṇendrḙṇa me̱dinā̭"
  ],
