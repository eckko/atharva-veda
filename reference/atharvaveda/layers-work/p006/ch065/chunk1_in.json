  ],
  "lines_deva": [
   "अव॑ म॒न्युरवाय॒ताव॑ बा॒हू म॑नो॒युजा॑",
   "परा॑शर॒ त्वं तेषां॒ परा॑ञ्चं॒ शुष्म॑मर्द॒याधा॑ नो र॒यिमा कृधि"
  ],
  "lines_iast": [
   "ava̭ ma̱nyuravāya̱tāva̭ bā̱hū ma̭no̱yujā̭",
   "parā̭śara̱ tvaṃ teṣā̱ṃ parā̭ñca̱ṃ śuṣma̭marda̱yādhā̭ no ra̱yimā kṛdhi"
  ],
