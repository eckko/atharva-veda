   "006.065.2a",
   "006.065.2b"
  ],
  "lines_deva": [
   "निर्ह॑स्तेभ्यो नैर्ह॒स्तं यं दे॑वाः॒ शरु॒मस्य॑थ",
   "वृ॒श्चामि॒ शत्रू॑णां बा॒हून॒नेन॑ ह॒विषा॒हम्"
  ],
  "lines_iast": [
   "nirha̭stebhyo nairha̱staṃ yaṃ dḙvā̱ḥ śaru̱masya̭tha",
   "vṛ̱ścāmi̱ śatrṷ̄ṇāṃ bā̱hūna̱nena̭ ha̱viṣā̱ham"
  ],
