   "006.021.1b"
  ],
  "lines_deva": [
   "इ॒मा यास्ति॒स्रः पृ॑थि॒वीस्तासां॑ ह॒ भूमि॑रुत्त॒मा",
   "तासा॒मधि॑ त्व॒चो अ॒हं भे॑ष॒जं समु॑ जग्रभम्"
  ],
  "lines_iast": [
   "i̱mā yāsti̱sraḥ pṛ̭thi̱vīstāsā̭ṃ ha̱ bhūmi̭rutta̱mā",
   "tāsā̱madhi̭ tva̱co a̱haṃ bhḙṣa̱jaṃ samṷ jagrabham"
  ],
