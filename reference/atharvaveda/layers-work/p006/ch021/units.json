 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.021.3a",
   "006.021.3b"
  ],
  "lines_deva": [
   "रेव॑ती॒रना॑धृषः सिषा॒सवः॑ सिषासथ",
   "उ॒त स्थ के॑श॒दृंह॑णी॒रथो॑ ह केश॒वर्ध॑नीः"
  ],
  "lines_iast": [
   "reva̭tī̱ranā̭dhṛṣaḥ siṣā̱sava̭ḥ siṣāsatha",
   "u̱ta stha kḙśa̱dṛṃha̭ṇī̱ratho̭ ha keśa̱vardha̭nīḥ"
  ],
