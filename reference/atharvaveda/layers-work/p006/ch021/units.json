 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.021.2a",
   "006.021.2b"
  ],
  "lines_deva": [
   "श्रेष्ठ॑मसि भेष॒जानां॒ वसि॑ष्ठं॒ वीरु॑धानाम्",
   "सोमो॒ भग॑ इव॒ यामे॑षु॒ दे॒वेषु॒ वरु॑णो॒ यथा॑"
  ],
  "lines_iast": [
   "śreṣṭha̭masi bheṣa̱jānā̱ṃ vasi̭ṣṭha̱ṃ vīrṷdhānām",
   "somo̱ bhaga̭ iva̱ yāmḙṣu̱ de̱veṣu̱ varṷṇo̱ yathā̭"
  ],
