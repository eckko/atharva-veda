 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.068.3a",
   "006.068.3b"
  ],
  "lines_deva": [
   "येनाव॑पत् सवि॒ता क्षु॒रेण॒ सोम॑स्य॒ राज्ञो॒ वरु॑णस्य वि॒द्वान्",
   "तेन॑ ब्रह्माणो वपते॒दम॒स्य गोमा॒नश्व॑वान॒यम॑स्तु प्र॒जावा॑न्"
  ],
  "lines_iast": [
   "yenāva̭pat savi̱tā kṣu̱reṇa̱ soma̭sya̱ rājño̱ varṷṇasya vi̱dvān",
   "tena̭ brahmāṇo vapate̱dama̱sya gomā̱naśva̭vāna̱yama̭stu pra̱jāvā̭n"
  ],
