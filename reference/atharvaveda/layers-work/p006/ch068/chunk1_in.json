 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.068.2a",
   "006.068.2b"
  ],
  "lines_deva": [
   "अदि॑तिः॒ श्मश्रु॑ वप॒त्वाप॑ उन्दन्तु॒ वर्च॑सा",
   "चिकि॑त्सतु प्र॒जाप॑तिर्दीर्घायु॒त्वाय॒ चक्ष॑से"
  ],
  "lines_iast": [
   "adi̭ti̱ḥ śmaśrṷ vapa̱tvāpa̭ undantu̱ varca̭sā",
   "ciki̭tsatu pra̱jāpa̭tirdīrghāyu̱tvāya̱ cakṣa̭se"
  ],
