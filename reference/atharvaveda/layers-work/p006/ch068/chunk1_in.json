   "006.068.1b"
  ],
  "lines_deva": [
   "आयम॑गन्त्सवि॒ता क्षु॒रेणो॒ष्णेन॑ वाय उद॒केनेहि॑",
   "आ॒दि॒त्या रु॒द्रा वस॑व उन्दन्तु॒ सचे॑तसः॒ सोम॑स्य॒ राज्ञो॑ वपत॒ प्रचे॑तसः"
  ],
  "lines_iast": [
   "āyama̭gantsavi̱tā kṣu̱reṇo̱ṣṇena̭ vāya uda̱kenehi̭",
   "ā̱di̱tyā ru̱drā vasa̭va undantu̱ sacḙtasa̱ḥ soma̭sya̱ rājño̭ vapata̱ pracḙtasaḥ"
  ],
