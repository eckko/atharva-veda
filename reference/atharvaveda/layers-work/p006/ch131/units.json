  ],
  "lines_deva": [
   "अनु॑म॒तेऽन्वि॒दं म॑न्य॒स्वाकू॑ते॒ समि॒दं नमः॑",
   "देवाः॒ प्र हि॑णुत स्म॒रम॒सौ मामनु॑ शोचतु"
  ],
  "lines_iast": [
   "anṷma̱te'nvi̱daṃ ma̭nya̱svākṷ̄te̱ sami̱daṃ nama̭ḥ",
   "devā̱ḥ pra hi̭ṇuta sma̱rama̱sau māmanṷ śocatu"
  ],
