 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.104.2a",
   "006.104.2b"
  ],
  "lines_deva": [
   "इ॒दमा॒दान॑मकरं॒ तप॒सेन्द्रे॑ण॒ संशि॑तम्",
   "अ॒मित्रा॒ येऽत्र॑ नः॒ सन्ति॒ तान॑ग्न॒ आ द्या॒ त्वम्"
  ],
  "lines_iast": [
   "i̱damā̱dāna̭makara̱ṃ tapa̱sendrḙṇa̱ saṃśi̭tam",
   "a̱mitrā̱ ye'tra̭ na̱ḥ santi̱ tāna̭gna̱ ā dyā̱ tvam"
  ],
