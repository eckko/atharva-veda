 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.104.3a",
   "006.104.3b"
  ],
  "lines_deva": [
   "ऐना॑न् द्यतामिन्द्रा॒ग्नी सोमो॑ राजा॑ च मे॒दिनौ॑",
   "इन्द्रो॑ म॒रुत्वा॑ना॒दान॑म॒मित्रे॑भ्यः कृणोतु नः"
  ],
  "lines_iast": [
   "ainā̭n dyatāmindrā̱gnī somo̭ rājā̭ ca me̱dinaṷ",
   "indro̭ ma̱rutvā̭nā̱dāna̭ma̱mitrḙbhyaḥ kṛṇotu naḥ"
  ],
