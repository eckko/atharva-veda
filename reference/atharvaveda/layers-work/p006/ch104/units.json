   "006.104.1a",
   "006.104.1b"
  ],
  "lines_deva": [
   "आ॒दाने॑न सं॒दाने॑ना॒मित्रा॒ना द्या॑मसि",
   "अ॒पा॒ना ये चै॑षां प्रा॒णा असु॒नासू॒न्त्सम॑च्छिदन्"
  ],
  "lines_iast": [
   "ā̱dānḙna sa̱ṃdānḙnā̱mitrā̱nā dyā̭masi",
   "a̱pā̱nā ye cai̭ṣāṃ prā̱ṇā asu̱nāsū̱ntsama̭cchidan"
  ],
