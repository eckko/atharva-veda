  ],
  "lines_deva": [
   "यं दे॒वाः स्म॒रमसि॑ञ्चन्न॒प्स्व१न्तः शोशु॑चानं स॒हाध्या",
   "तं ते॑ तपामि॒ वरु॑णस्य॒ धर्म॑णा"
  ],
  "lines_iast": [
   "yaṃ de̱vāḥ sma̱ramasi̭ñcanna̱psva1ntaḥ śośṷcānaṃ sa̱hādhyā",
   "taṃ tḙ tapāmi̱ varṷṇasya̱ dharma̭ṇā"
  ],
