 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.067.2a",
   "006.067.2b"
  ],
  "lines_deva": [
   "मू॒ढा अ॒मित्रा॑श्चरताशी॒र्षाण॑ इ॒वाहयः॑",
   "तेषां॑ वो अ॒ग्निमू॑ढाना॒मिन्द्रो॑ हन्तु॒ वरं॑वरम्"
  ],
  "lines_iast": [
   "mū̱ḍhā a̱mitrā̭ścaratāśī̱rṣāṇa̭ i̱vāhaya̭ḥ",
   "teṣā̭ṃ vo a̱gnimṷ̄ḍhānā̱mindro̭ hantu̱ vara̭ṃvaram"
  ],
