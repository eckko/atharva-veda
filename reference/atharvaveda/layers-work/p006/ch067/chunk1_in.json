   "006.067.1b"
  ],
  "lines_deva": [
   "परि॒ व॑र्त्मा॑नि स॒र्वत॒ इन्द्रः॑ पू॒षा च॑ सस्रतुः",
   "मुह्य॑न्त्व॒द्यामूः सेना॑ अ॒मित्रा॑णां परस्त॒राम्"
  ],
  "lines_iast": [
   "pari̱ va̭rtmā̭ni sa̱rvata̱ indra̭ḥ pū̱ṣā ca̭ sasratuḥ",
   "muhya̭ntva̱dyāmūḥ senā̭ a̱mitrā̭ṇāṃ parasta̱rām"
  ],
