   "006.067.3a",
   "006.067.3b"
  ],
  "lines_deva": [
   "ऐषु॑ नह्य॒ वृषा॒जिनं॑ हरि॒णस्या॒ भियं॑ कृधि",
   "परा॑ङ॒मित्र॒ एष॑त्व॒र्वाची॒ गौरुपे॑षतु"
  ],
  "lines_iast": [
   "aiṣṷ nahya̱ vṛṣā̱jina̭ṃ hari̱ṇasyā̱ bhiya̭ṃ kṛdhi",
   "parā̭ṅa̱mitra̱ eṣa̭tva̱rvācī̱ gaurupḙṣatu"
  ],
