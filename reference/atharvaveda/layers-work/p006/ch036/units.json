   "006.036.3b"
  ],
  "lines_deva": [
   "अ॒ग्निः परे॑षु॒ धाम॑सु॒ कामो॑ भू॒तस्य॒ भव्य॑स्य",
   "स॒म्राडेको॒ वि रा॑जति"
  ],
  "lines_iast": [
   "a̱gniḥ parḙṣu̱ dhāma̭su̱ kāmo̭ bhū̱tasya̱ bhavya̭sya",
   "sa̱mrāḍeko̱ vi rā̭jati"
  ],
