 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.036.2a",
   "006.036.2b"
  ],
  "lines_deva": [
   "स विश्वा॑ प्रति॑ चाक्लृप ऋ॒तूंरुत् सृ॑जते व॒शी",
   "य॒ज्ञस्य॒ वय॑ उत्ति॒रन्"
  ],
  "lines_iast": [
   "sa viśvā̭ prati̭ cāklṛpa ṛ̱tūṃrut sṛ̭jate va̱śī",
   "ya̱jñasya̱ vaya̭ utti̱ran"
  ],
