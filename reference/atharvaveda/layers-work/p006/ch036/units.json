  ],
  "lines_deva": [
   "वऋ॒तावा॑नं वैश्वान॒रमृ॒तस्य॒ ज्योति॑ष॒स्पति॑म्",
   "अज॑स्रं घ॒र्ममी॑महे"
  ],
  "lines_iast": [
   "vaṛ̱tāvā̭naṃ vaiśvāna̱ramṛ̱tasya̱ jyoti̭ṣa̱spati̭m",
   "aja̭sraṃ gha̱rmamī̭mahe"
  ],
