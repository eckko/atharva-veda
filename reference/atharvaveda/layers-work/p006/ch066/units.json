 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.066.2a",
   "006.066.2b"
  ],
  "lines_deva": [
   "आ॒त॒न्वा॒ना आ॒यच्छ॒न्तोऽस्य॑न्तो॒ ये च॒ धाव॑थ",
   "निर्ह॑स्ताः शत्रवः स्थ॒नेन्द्रो॑ वोऽद्य परा॑शरीत्"
  ],
  "lines_iast": [
   "ā̱ta̱nvā̱nā ā̱yaccha̱nto'sya̭nto̱ ye ca̱ dhāva̭tha",
   "nirha̭stāḥ śatravaḥ stha̱nendro̭ vo'dya parā̭śarīt"
  ],
