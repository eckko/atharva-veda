 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.066.3a",
   "006.066.3b"
  ],
  "lines_deva": [
   "निर्ह॑स्ताः सन्तु॒ शत्र॒वोऽङ्गै॑षां म्लापयामसि",
   "अथै॑षामिन्द्र॒ वेदां॑सि शत॒शो वि भ॑जामहै"
  ],
  "lines_iast": [
   "nirha̭stāḥ santu̱ śatra̱vo'ṅgai̭ṣāṃ mlāpayāmasi",
   "athai̭ṣāmindra̱ vedā̭ṃsi śata̱śo vi bha̭jāmahai"
  ],
