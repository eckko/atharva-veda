  "line_ids": [
   "006.066.1a",
   "006.066.1b"
  ],
  "lines_deva": [
   "निर्ह॑स्तः शत्रु॑रभि॒दास॑न्नस्तु॒ ये सेना॑भि॒र्युध॑मा॒यन्त्य॒स्मान्",
   "सम॑र्पयेन्द्र मह॒ता व॒धेन॒ द्रात्वे॑षामघहा॒रो विवि॑द्धः"
  ],
  "lines_iast": [
   "nirha̭staḥ śatrṷrabhi̱dāsa̭nnastu̱ ye senā̭bhi̱ryudha̭mā̱yantya̱smān",
   "sama̭rpayendra maha̱tā va̱dhena̱ drātvḙṣāmaghahā̱ro vivi̭ddhaḥ"
  ],
