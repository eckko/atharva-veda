  "lines_deva": [
   "विश्व॑जित् त्रायमा॒णायै॑ मा॒ परि॑ देहि",
   "त्राय॑माणे द्वि॒पाच्च॒ सर्वं॑ नो॒ रक्ष॒ चतु॑ष्पा॒द् यच्च॑ नः॒ स्वम्"
  ],
  "lines_iast": [
   "viśva̭jit trāyamā̱ṇāyai̭ mā̱ pari̭ dehi",
   "trāya̭māṇe dvi̱pācca̱ sarva̭ṃ no̱ rakṣa̱ catṷṣpā̱d yacca̭ na̱ḥ svam"
  ],
