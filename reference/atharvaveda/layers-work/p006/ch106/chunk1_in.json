   "006.106.1b"
  ],
  "lines_deva": [
   "आय॑ने ते प॒राय॑णे दूर्वा॑ रोहतु पु॒ष्पिणीः॑",
   "उत्सो॑ वा॒ तत्र॒ जाय॑तां ह्रदो वा॑ पु॒ण्डरी॑कवान्"
  ],
  "lines_iast": [
   "āya̭ne te pa̱rāya̭ṇe dūrvā̭ rohatu pu̱ṣpiṇī̭ḥ",
   "utso̭ vā̱ tatra̱ jāya̭tāṃ hrado vā̭ pu̱ṇḍarī̭kavān"
  ],
