 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "006.106.2a",
   "006.106.2b"
  ],
  "lines_deva": [
   "अ॒पामि॒दं न्यय॑नं समु॒द्रस्य॑ नि॒वेश॑नम्",
   "मध्ये॑ ह्र॒दस्य॑ नो गृ॒हाः प॑रा॒चीना॒ मुखा॑ कृधि"
  ],
  "lines_iast": [
   "a̱pāmi̱daṃ nyaya̭naṃ samu̱drasya̭ ni̱veśa̭nam",
   "madhyḙ hra̱dasya̭ no gṛ̱hāḥ pa̭rā̱cīnā̱ mukhā̭ kṛdhi"
  ],
