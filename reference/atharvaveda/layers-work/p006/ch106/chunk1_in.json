 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.106.3a",
   "006.106.3b"
  ],
  "lines_deva": [
   "हि॒मस्य॑ त्वा ज॒रायु॑णा॒ शाले॒ परि॑ व्ययामसि",
   "शी॒तह्र॑दा॒ हि नो॒ भुवो॒ऽग्निष्कृ॑णोतु भेष॒जम्"
  ],
  "lines_iast": [
   "hi̱masya̭ tvā ja̱rāyṷṇā̱ śāle̱ pari̭ vyayāmasi",
   "śī̱tahra̭dā̱ hi no̱ bhuvo̱'gniṣkṛ̭ṇotu bheṣa̱jam"
  ],
