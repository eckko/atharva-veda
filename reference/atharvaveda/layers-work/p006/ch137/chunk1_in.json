   "006.137.3b"
  ],
  "lines_deva": [
   "दृंह॑ मूल॒माग्रं॑ यच्छ॒ वि मध्यं॑ यामयौषधे",
   "केशा॑ न॒डा इ॑व वर्धन्तां शी॒र्ष्णस्ते॑ असि॒ताः परि॑"
  ],
  "lines_iast": [
   "dṛṃha̭ mūla̱māgra̭ṃ yaccha̱ vi madhya̭ṃ yāmayauṣadhe",
   "keśā̭ na̱ḍā i̭va vardhantāṃ śī̱rṣṇastḙ asi̱tāḥ pari̭"
  ],
