  ],
  "lines_deva": [
   "यां ज॒मद॑ग्नि॒रख॑नद् दुहि॒त्रे के॑श॒वर्ध॑नीम्",
   "तां वी॒तह॑व्य॒ आभ॑र॒दसि॑तस्य गृ॒हेभ्यः॑"
  ],
  "lines_iast": [
   "yāṃ ja̱mada̭gni̱rakha̭nad duhi̱tre kḙśa̱vardha̭nīm",
   "tāṃ vī̱taha̭vya̱ ābha̭ra̱dasi̭tasya gṛ̱hebhya̭ḥ"
  ],
