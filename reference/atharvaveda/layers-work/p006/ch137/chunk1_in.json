   "006.137.2b"
  ],
  "lines_deva": [
   "अ॒भीशु॑ना॒ मेया॑ आसन् व्या॒मेना॑नु॒मेयाः॑",
   "केशा॑ न॒डा इ॑व वर्धन्तां शी॒र्ष्णस्ते॑ असि॒ताः परि॑"
  ],
  "lines_iast": [
   "a̱bhīśṷnā̱ meyā̭ āsan vyā̱menā̭nu̱meyā̭ḥ",
   "keśā̭ na̱ḍā i̭va vardhantāṃ śī̱rṣṇastḙ asi̱tāḥ pari̭"
  ],
