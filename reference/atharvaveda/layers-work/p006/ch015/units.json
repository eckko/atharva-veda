   "006.015.2b"
  ],
  "lines_deva": [
   "सब॑न्धु॒श्चास॑बन्धुश्च॒ यो अ॒स्मां अ॑भि॒दास॑ति",
   "तेषां॒ सा वृ॒क्षाणा॑मिवा॒हं भू॑यासमुत्त॒मः"
  ],
  "lines_iast": [
   "saba̭ndhu̱ścāsa̭bandhuśca̱ yo a̱smāṃ a̭bhi̱dāsa̭ti",
   "teṣā̱ṃ sā vṛ̱kṣāṇā̭mivā̱haṃ bhṷ̄yāsamutta̱maḥ"
  ],
