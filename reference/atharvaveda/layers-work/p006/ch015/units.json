  "lines_deva": [
   "उ॒त्त॒मो अ॒स्योष॑धीनां॒ तव॑ वृ॒क्षा उ॑प॒स्तयः॑",
   "उ॒प॒स्तिर॑स्तु सो॒३स्माकं॒ यो अ॒स्मां अ॑भि॒दास॑ति"
  ],
  "lines_iast": [
   "u̱tta̱mo a̱syoṣa̭dhīnā̱ṃ tava̭ vṛ̱kṣā ṷpa̱staya̭ḥ",
   "u̱pa̱stira̭stu so̱3smāka̱ṃ yo a̱smāṃ a̭bhi̱dāsa̭ti"
  ],
