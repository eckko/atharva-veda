   "006.015.3b"
  ],
  "lines_deva": [
   "यथा॒ सोम॒ ओष॑धीनामुत्त॒मो ह॒विषां॑ कृ॒तः",
   "त॒लाशा॑ वृ॒क्षाणा॑मिवा॒हं भू॑यासमुत्त॒मः"
  ],
  "lines_iast": [
   "yathā̱ soma̱ oṣa̭dhīnāmutta̱mo ha̱viṣā̭ṃ kṛ̱taḥ",
   "ta̱lāśā̭ vṛ̱kṣāṇā̭mivā̱haṃ bhṷ̄yāsamutta̱maḥ"
  ],
