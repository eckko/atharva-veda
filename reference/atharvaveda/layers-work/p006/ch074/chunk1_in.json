 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "006.074.3a",
   "006.074.3b"
  ],
  "lines_deva": [
   "यथा॑दि॒त्या वसु॑भिः संबभू॒वुर्म॒रुद्भि॑रु॒ग्रा अहृ॑णीयमानाः",
   "एवा त्रि॑णाम॒न्नहृ॑णीयमान इ॒मान् जना॒न्त्संम॑नसस्कृधी॒ह"
  ],
  "lines_iast": [
   "yathā̭di̱tyā vasṷbhiḥ saṃbabhū̱vurma̱rudbhi̭ru̱grā ahṛ̭ṇīyamānāḥ",
   "evā tri̭ṇāma̱nnahṛ̭ṇīyamāna i̱mān janā̱ntsaṃma̭nasaskṛdhī̱ha"
  ],
