   "006.074.1b"
  ],
  "lines_deva": [
   "सं वः॑ पृच्यन्तां त॒न्वः॑१ सं मनां॑सि॒ समु॑ व्र॒ता",
   "सं वोऽयं ब्रह्म॑ण॒स्पति॒र्भगः॑ सं वो॑ अजीगमत्"
  ],
  "lines_iast": [
   "saṃ va̭ḥ pṛcyantāṃ ta̱nva̭ḥ1 saṃ manā̭ṃsi̱ samṷ vra̱tā",
   "saṃ vo'yaṃ brahma̭ṇa̱spati̱rbhaga̭ḥ saṃ vo̭ ajīgamat"
  ],
