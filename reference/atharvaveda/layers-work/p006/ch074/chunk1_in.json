   "006.074.2a",
   "006.074.2b"
  ],
  "lines_deva": [
   "सं॒ज्ञप॑नं वो॒ मन॒सोऽथो॑ सं॒ज्ञप॑नं हृ॒दः",
   "अथो॒ भग॑स्य॒ यच्छ्रा॒न्तं तेन॒ संज्ञ॑पयामि वः"
  ],
  "lines_iast": [
   "sa̱ṃjñapa̭naṃ vo̱ mana̱so'tho̭ sa̱ṃjñapa̭naṃ hṛ̱daḥ",
   "atho̱ bhaga̭sya̱ yacchrā̱ntaṃ tena̱ saṃjña̭payāmi vaḥ"
  ],
