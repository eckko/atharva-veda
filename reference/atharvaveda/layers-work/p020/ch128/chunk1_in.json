   "ज्येष्ठो॒ यद॑प्रचेता॒स्तदा॑हु॒रध॑रा॒गिति॑"
  ],
  "lines_iast": [
   "yo jā̱myā apra̭thaya̱stad yat sakhā̭ya̱ṃ dudhṷ̄rṣati",
   "jyeṣṭho̱ yada̭pracetā̱stadā̭hu̱radha̭rā̱giti̭"
  ],
