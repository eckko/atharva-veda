  "lines_deva": [
   "यः स॒भेयो॑ विद॒थ्यः सु॒त्वा य॒ज्वाथ॒ पूरु॑षः",
   "सूर्यं॒ चामू॑ रि॒शादस॒स्तद् दे॒वाः प्राग॑कल्पयन्"
  ],
  "lines_iast": [
   "yaḥ sa̱bheyo̭ vida̱thyaḥ su̱tvā ya̱jvātha̱ pūrṷṣaḥ",
   "sūrya̱ṃ cāmṷ̄ ri̱śādasa̱stad de̱vāḥ prāga̭kalpayan"
  ],
