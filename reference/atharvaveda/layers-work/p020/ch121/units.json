  "lines_deva": [
   "अ॒भि त्वा॑ शूर नोनु॒मोऽदु॑ग्धा इव धे॒नवः॑",
   "ईशा॑नम॒स्य जग॑तः स्व॒र्दृश॒मीशा॑नमिन्द्र त॒स्थुषः॑"
  ],
  "lines_iast": [
   "a̱bhi tvā̭ śūra nonu̱mo'dṷgdhā iva dhe̱nava̭ḥ",
   "īśā̭nama̱sya jaga̭taḥ sva̱rdṛśa̱mīśā̭namindra ta̱sthuṣa̭ḥ"
  ],
