 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.121.2a",
   "020.121.2b"
  ],
  "lines_deva": [
   "न त्वावां॑ अ॒न्यो दि॒व्यो न पार्थि॑वो॒ न जा॒तो न ज॑निष्यते",
   "अ॒श्वा॒यन्तो॑ मघवन्निन्द्र वा॒जिनो॑ ग॒व्यन्त॑स्त्वा हवामहे"
  ],
  "lines_iast": [
   "na tvāvā̭ṃ a̱nyo di̱vyo na pārthi̭vo̱ na jā̱to na ja̭niṣyate",
   "a̱śvā̱yanto̭ maghavannindra vā̱jino̭ ga̱vyanta̭stvā havāmahe"
  ],
