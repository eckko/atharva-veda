 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.083.2a",
   "020.083.2b"
  ],
  "lines_deva": [
   "ये ग॑व्य॒ता मन॑सा॒ शत्रु॑माद॒भुर॑भिप्र॒घ्नन्ति॑ धृष्णु॒या",
   "अघ॑ स्मा नो मघवन्निन्द्र गिर्वणस्तनू॒पा अन्त॑मो भव"
  ],
  "lines_iast": [
   "ye ga̭vya̱tā mana̭sā̱ śatrṷmāda̱bhura̭bhipra̱ghnanti̭ dhṛṣṇu̱yā",
   "agha̭ smā no maghavannindra girvaṇastanū̱pā anta̭mo bhava"
  ],
