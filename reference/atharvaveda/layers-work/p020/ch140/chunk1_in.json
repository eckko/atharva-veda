 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "020.140.5a",
   "020.140.5b"
  ],
  "lines_deva": [
   "यद्वां॑ क॒क्षीवां॑ उ॒त यद्व्य॑श्व॒ ऋषि॒र्यद्वां॑ दी॒र्घत॑मा जु॒हाव॑",
   "पृथी॒ यद्वां॑ वै॒न्यः साद॑नेष्वे॒वेदतो॑ अश्विना चेतयेथाम्"
  ],
  "lines_iast": [
   "yadvā̭ṃ ka̱kṣīvā̭ṃ u̱ta yadvya̭śva̱ ṛṣi̱ryadvā̭ṃ dī̱rghata̭mā ju̱hāva̭",
   "pṛthī̱ yadvā̭ṃ vai̱nyaḥ sāda̭neṣve̱vedato̭ aśvinā cetayethām"
  ],
