 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.140.2a",
   "020.140.2b"
  ],
  "lines_deva": [
   "आ नू॒नम॒श्विनो॒र्ऋषि॒ स्तोमं॑ चिकेत वा॒मया॑",
   "आ सोमं॒ मधु॑मत्तमं घ॒र्मं सि॑ञ्चा॒दथ॑र्वणि"
  ],
  "lines_iast": [
   "ā nū̱nama̱śvino̱rṛṣi̱ stoma̭ṃ ciketa vā̱mayā̭",
   "ā soma̱ṃ madhṷmattamaṃ gha̱rmaṃ si̭ñcā̱datha̭rvaṇi"
  ],
  "book_split": [
