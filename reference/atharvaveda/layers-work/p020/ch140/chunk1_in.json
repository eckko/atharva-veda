[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "020.140.1a",
   "020.140.1b"
  ],
  "lines_deva": [
   "यन्ना॑सत्या भुर॒ण्यथो॒ यद्वा॑ देव भिष॒ज्यथः॑",
   "अ॒यं वां॑ व॒त्सो म॒तिभि॒र्न वि॑न्धते ह॒विष्म॑न्तं॒ हि गच्छ॑थः"
  ],
  "lines_iast": [
   "yannā̭satyā bhura̱ṇyatho̱ yadvā̭ deva bhiṣa̱jyatha̭ḥ",
   "a̱yaṃ vā̭ṃ va̱tso ma̱tibhi̱rna vi̭ndhate ha̱viṣma̭nta̱ṃ hi gaccha̭thaḥ"
  ],
