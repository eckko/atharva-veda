 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "020.140.3a",
   "020.140.3b"
  ],
  "lines_deva": [
   "आ नू॒नं र॒घुव॑र्तनिं॒ रथं॑ तिष्ठाथो अश्विना",
   "आ वां॒ स्तोमा॑ इ॒मे मम॒ नभो॒ न चु॑च्यवीरत"
  ],
  "lines_iast": [
   "ā nū̱naṃ ra̱ghuva̭rtani̱ṃ ratha̭ṃ tiṣṭhātho aśvinā",
   "ā vā̱ṃ stomā̭ i̱me mama̱ nabho̱ na cṷcyavīrata"
  ],
