 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "020.140.4a",
   "020.140.4b"
  ],
  "lines_deva": [
   "यद॒द्य वां॑ नासत्यो॒क्थैरा॑चुच्युवी॒महि॑",
   "यद्वा॒ वाणी॑भिरश्विने॒वेत्क॒ण्वस्य॑ बोधतम्"
  ],
  "lines_iast": [
   "yada̱dya vā̭ṃ nāsatyo̱kthairā̭cucyuvī̱mahi̭",
   "yadvā̱ vāṇī̭bhiraśvine̱vetka̱ṇvasya̭ bodhatam"
  ],
