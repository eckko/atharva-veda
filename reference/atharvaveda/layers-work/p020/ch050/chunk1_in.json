  "lines_deva": [
   "कन्नव्यो॑ अत॒सीनां॑ तु॒रो गृ॑णीत॒ मर्त्यः॑",
   "न॒ही न्व॑स्य महि॒मान॑मिन्द्रि॒यं स्वर्गृ॒णन्त॑ आन॒शुः"
  ],
  "lines_iast": [
   "kannavyo̭ ata̱sīnā̭ṃ tu̱ro gṛ̭ṇīta̱ martya̭ḥ",
   "na̱hī nva̭sya mahi̱māna̭mindri̱yaṃ svargṛ̱ṇanta̭ āna̱śuḥ"
  ],
