   "020.050.2a",
   "020.050.2b"
  ],
  "lines_deva": [
   "कदु॑ स्तु॒वन्त॑ ऋतयन्त दे॒वत॒ ऋषिः॒ को विप्र॑ ओहते",
   "क॒दा हवं॑ मघवन्निन्द्र सुन्व॒तः कदु॑ स्तुव॒त आ ग॑मः"
  ],
  "lines_iast": [
   "kadṷ stu̱vanta̭ ṛtayanta de̱vata̱ ṛṣi̱ḥ ko vipra̭ ohate",
   "ka̱dā hava̭ṃ maghavannindra sunva̱taḥ kadṷ stuva̱ta ā ga̭maḥ"
  ],
