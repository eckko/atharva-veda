 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.119.2a",
   "020.119.2b"
  ],
  "lines_deva": [
   "तु॒र॒ण्यवो॒ मधु॑मन्तं घृत॒श्चुतं॒ विप्रा॑सो अ॒र्कमा॑नृचुः",
   "अ॒स्मे र॒यिः प॑प्रथे॒ वृष्ण्यं॒ शवो॒ऽस्मे सु॑वा॒नास॒ इन्द॑वः"
  ],
  "lines_iast": [
   "tu̱ra̱ṇyavo̱ madhṷmantaṃ ghṛta̱ścuta̱ṃ viprā̭so a̱rkamā̭nṛcuḥ",
   "a̱sme ra̱yiḥ pa̭prathe̱ vṛṣṇya̱ṃ śavo̱'sme sṷvā̱nāsa̱ inda̭vaḥ"
  ],
