  "lines_deva": [
   "अस्ता॑वि॒ मन्म॑ पू॒र्व्यं ब्रह्मेन्द्रा॑य वोचत",
   "पू॒र्वीरृ॒तस्य॑ बृह॒तीर॑नूषत स्तो॒तुर्मे॒घा अ॑सृक्षत"
  ],
  "lines_iast": [
   "astā̭vi̱ manma̭ pū̱rvyaṃ brahmendrā̭ya vocata",
   "pū̱rvīrṛ̱tasya̭ bṛha̱tīra̭nūṣata sto̱turme̱ghā a̭sṛkṣata"
  ],
