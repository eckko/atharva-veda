   "020.082.2b"
  ],
  "lines_deva": [
   "शिक्षे॑य॒मिन्म॑हय॒ते दि॒वेदि॑वे रा॒य आ कु॑हचि॒द्विदे॑",
   "न॒हि त्वद॒न्यन्म॑घवन् न॒ आप्यं॒ वस्यो॒ अस्ति॑ पि॒ता च॒न"
  ],
  "lines_iast": [
   "śikṣḙya̱minma̭haya̱te di̱vedi̭ve rā̱ya ā kṷhaci̱dvidḙ",
   "na̱hi tvada̱nyanma̭ghavan na̱ āpya̱ṃ vasyo̱ asti̭ pi̱tā ca̱na"
  ],
