  "lines_deva": [
   "यदि॑न्द्र॒ याव॑त॒स्त्वमे॒ताव॑द॒हमीशी॑य",
   "स्तो॒तार॒मिद् दि॑धिषेय रदावसो॒ न पा॑प॒त्वाय॑ रासीय"
  ],
  "lines_iast": [
   "yadi̭ndra̱ yāva̭ta̱stvame̱tāva̭da̱hamīśī̭ya",
   "sto̱tāra̱mid di̭dhiṣeya radāvaso̱ na pā̭pa̱tvāya̭ rāsīya"
  ],
