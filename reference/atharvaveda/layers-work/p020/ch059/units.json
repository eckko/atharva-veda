 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "020.059.3a",
   "020.059.3b"
  ],
  "lines_deva": [
   "उदिन्न्व॑स्य रिच्य॒तेंऽशो धनं॒ न जि॒ग्युषः॑",
   "य इन्द्रो॒ हरि॑वा॒न्न द॑भन्ति॒ तं रिपो॒ दक्षं॑ दधाति सो॒मिनि॑"
  ],
  "lines_iast": [
   "udinnva̭sya ricya̱teṃ'śo dhana̱ṃ na ji̱gyuṣa̭ḥ",
   "ya indro̱ hari̭vā̱nna da̭bhanti̱ taṃ ripo̱ dakṣa̭ṃ dadhāti so̱mini̭"
  ],
