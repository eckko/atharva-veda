   "020.059.1a",
   "020.059.1b"
  ],
  "lines_deva": [
   "उदु॒ त्ये मधु॑मत्तमा॒ गिर॒ स्तोमा॑स ईरते",
   "स॒त्रा॒जितो॑ धन॒सा अक्षि॑तोतयो वाज॒यन्तो॒ रथा॑ इव"
  ],
  "lines_iast": [
   "udu̱ tye madhṷmattamā̱ gira̱ stomā̭sa īrate",
   "sa̱trā̱jito̭ dhana̱sā akṣi̭totayo vāja̱yanto̱ rathā̭ iva"
  ],
  "book_split": [
