 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.059.2a",
   "020.059.2b"
  ],
  "lines_deva": [
   "कण्वा॑ इव॒ भृग॑वः॒ सूर्या॑ इव॒ विश्व॒मिद्धी॒तमा॑नशुः",
   "इन्द्रं॒ स्तोमे॑भिर्म॒हय॑न्त आ॒यवः॑ प्रि॒यमे॑धासो अस्वरन्"
  ],
  "lines_iast": [
   "kaṇvā̭ iva̱ bhṛga̭va̱ḥ sūryā̭ iva̱ viśva̱middhī̱tamā̭naśuḥ",
   "indra̱ṃ stomḙbhirma̱haya̭nta ā̱yava̭ḥ pri̱yamḙdhāso asvaran"
  ],
