 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "020.059.4a",
   "020.059.4b"
  ],
  "lines_deva": [
   "मन्त्र॒मख॑र्वं॒ सुधि॑तं सु॒पेश॑सं॒ दधा॑त य॒ज्ञिये॒ष्वा",
   "पू॒र्वीश्च॒न प्रसि॑तयस्तरन्ति तं य इन्द्रे॒ कर्म॑णा॒ भुव॑त्"
  ],
  "lines_iast": [
   "mantra̱makha̭rva̱ṃ sudhi̭taṃ su̱peśa̭sa̱ṃ dadhā̭ta ya̱jñiye̱ṣvā",
   "pū̱rvīśca̱na prasi̭tayastaranti taṃ ya indre̱ karma̭ṇā̱ bhuva̭t"
  ],
