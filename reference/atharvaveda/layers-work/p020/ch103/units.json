   "020.103.1b"
  ],
  "lines_deva": [
   "अ॒ग्निमी॑लि॒ष्वाव॑से॒ गाथा॑भिः शी॒रशो॑चिषम्",
   "अ॒ग्निं रा॒ये पु॑रुमील्ह श्रु॒तं नरो॒ऽग्निं सु॑दी॒तये॑ छ॒र्दिः"
  ],
  "lines_iast": [
   "a̱gnimī̭li̱ṣvāva̭se̱ gāthā̭bhiḥ śī̱raśo̭ciṣam",
   "a̱gniṃ rā̱ye pṷrumīlha śru̱taṃ naro̱'gniṃ sṷdī̱tayḙ cha̱rdiḥ"
  ],
