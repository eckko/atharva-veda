   "020.103.3a",
   "020.103.3b"
  ],
  "lines_deva": [
   "अच्छा॒ हि त्वा॑ सहसः सूनो अङ्गिरः॒ स्रुच॒श्चर॑न्त्यध्व॒रे",
   "ऊ॒र्जो नपा॑तं घृ॒तके॑शमीमहे॒ऽग्निं य॒ज्ञेषु॑ पू॒र्व्यम्"
  ],
  "lines_iast": [
   "acchā̱ hi tvā̭ sahasaḥ sūno aṅgira̱ḥ sruca̱ścara̭ntyadhva̱re",
   "ū̱rjo napā̭taṃ ghṛ̱takḙśamīmahe̱'gniṃ ya̱jñeṣṷ pū̱rvyam"
  ],
