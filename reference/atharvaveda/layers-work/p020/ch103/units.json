   "020.103.2b"
  ],
  "lines_deva": [
   "अग्न॒ आ या॑ह्य॒ग्निभि॒र्होता॑रं त्वा वृणीमहे",
   "आ त्वाम॑नक्तु॒ प्रय॑ता ह॒विष्म॑ती॒ यजि॑ष्ठं ब॒र्हिरा॒सदे॑"
  ],
  "lines_iast": [
   "agna̱ ā yā̭hya̱gnibhi̱rhotā̭raṃ tvā vṛṇīmahe",
   "ā tvāma̭naktu̱ praya̭tā ha̱viṣma̭tī̱ yaji̭ṣṭhaṃ ba̱rhirā̱sadḙ"
  ],
