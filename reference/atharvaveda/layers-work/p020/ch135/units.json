  "lines_deva": [
   "वीमे दे॒वा अ॑क्रंस॒ताध्व॒र्यो क्षि॒प्रं प्र॒चर॑",
   "सु॒स॒त्यमिद्गवा॑म॒स्यसि॑ प्रखु॒दसि॑"
  ],
  "lines_iast": [
   "vīme de̱vā a̭kraṃsa̱tādhva̱ryo kṣi̱praṃ pra̱cara̭",
   "su̱sa̱tyamidgavā̭ma̱syasi̭ prakhu̱dasi̭"
  ],
