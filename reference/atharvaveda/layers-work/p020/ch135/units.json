   "020.135.3b"
  ],
  "lines_deva": [
   "अला॑बूनि पृ॒षात॑का॒न्यश्व॑त्थ॒पला॑शम्",
   "पिपी॑लिका॒वट॒श्वसो॑ वि॒द्युत्स्वाप॑र्णश॒फो गोश॒फो जरित॒रोऽथामो॑ दै॒व"
  ],
  "lines_iast": [
   "alā̭būni pṛ̱ṣāta̭kā̱nyaśva̭ttha̱palā̭śam",
   "pipī̭likā̱vaṭa̱śvaso̭ vi̱dyutsvāpa̭rṇaśa̱pho gośa̱pho jarita̱ro'thāmo̭ dai̱va"
  ],
