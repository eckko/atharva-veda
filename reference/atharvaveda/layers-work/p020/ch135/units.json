   "020.135.2b"
  ],
  "lines_deva": [
   "को॒श॒बिले॑ रजनि॒ ग्रन्थे॑र्धा॒नमु॒पानहि॑ पा॒दम्",
   "उत्त॑मां॒ जनि॑मां ज॒न्यानुत्त॑मां जनी॒न्वर्त्म॑न्यात्"
  ],
  "lines_iast": [
   "ko̱śa̱bilḙ rajani̱ granthḙrdhā̱namu̱pānahi̭ pā̱dam",
   "utta̭mā̱ṃ jani̭māṃ ja̱nyānutta̭māṃ janī̱nvartma̭nyāt"
  ],
