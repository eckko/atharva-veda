   "020.135.1a",
   "020.135.1b"
  ],
  "lines_deva": [
   "भुगि॑त्य॒भिग॑तः॒ शलि॑त्य॒पक्रा॑न्तः॒ फलि॑त्य॒भिष्ठि॑तः",
   "दु॒न्दुभि॑माहनना॒भ्यां जरितरोथा॑मो दै॒व"
  ],
  "lines_iast": [
   "bhugi̭tya̱bhiga̭ta̱ḥ śali̭tya̱pakrā̭nta̱ḥ phali̭tya̱bhiṣṭhi̭taḥ",
   "du̱ndubhi̭māhananā̱bhyāṃ jaritarothā̭mo dai̱va"
  ],
