  "lines_deva": [
   "आदि॑त्या ह जरितरङ्गि॑रोभ्यो॒ दक्षि॑णाम॒नय॑न्",
   "तां ह॑ जरितः॒ प्रत्या॑यं॒स्तामु ह॑ जरितः॒ प्रत्या॑यन्"
  ],
  "lines_iast": [
   "ādi̭tyā ha jaritaraṅgi̭robhyo̱ dakṣi̭ṇāma̱naya̭n",
   "tāṃ ha̭ jarita̱ḥ pratyā̭ya̱ṃstāmu ha̭ jarita̱ḥ pratyā̭yan"
  ],
