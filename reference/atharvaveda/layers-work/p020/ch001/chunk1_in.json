  ],
  "lines_deva": [
   "मरु॑तो॒ यस्य॒ हि क्षये॑ पा॒था दि॒वो वि॑महसः । स सु॑गो॒पात॑मो॒ जनः॑"
  ],
  "lines_iast": [
   "marṷto̱ yasya̱ hi kṣayḙ pā̱thā di̱vo vi̭mahasaḥ | sa sṷgo̱pāta̭mo̱ jana̭ḥ"
  ],
