  "lines_deva": [
   "इन्द्र॑ त्वा वृष॒भं व॒यं सु॒ते सोमे॑ हवामहे । स पा॑हि॒ मध्वो॒ अन्ध॑सः"
  ],
  "lines_iast": [
   "indra̭ tvā vṛṣa̱bhaṃ va̱yaṃ su̱te somḙ havāmahe | sa pā̭hi̱ madhvo̱ andha̭saḥ"
  ],
