   "020.133.1b"
  ],
  "lines_deva": [
   "वित॑तौ किरणौ॒ द्वौ तावा॑ पिनष्टि॒ पूरु॑षः",
   "न वै॑ कुमारि॒ तत्तथा॒ यथा॑ कुमारि॒ मन्य॑से"
  ],
  "lines_iast": [
   "vita̭tau kiraṇau̱ dvau tāvā̭ pinaṣṭi̱ pūrṷṣaḥ",
   "na vai̭ kumāri̱ tattathā̱ yathā̭ kumāri̱ manya̭se"
  ],
