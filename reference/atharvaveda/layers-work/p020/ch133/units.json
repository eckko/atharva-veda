  "lines_deva": [
   "निगृ॑ह्य॒ कर्ण॑कौ॒ द्वौ निरा॑यच्छसि॒ मध्य॑मे",
   "न वै॑ कुमारि॒ तत्तथा॒ यथा॑ कुमारि॒ मन्य॑से"
  ],
  "lines_iast": [
   "nigṛ̭hya̱ karṇa̭kau̱ dvau nirā̭yacchasi̱ madhya̭me",
   "na vai̭ kumāri̱ tattathā̱ yathā̭ kumāri̱ manya̭se"
  ],
