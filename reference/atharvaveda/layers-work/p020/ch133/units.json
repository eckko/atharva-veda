  "lines_deva": [
   "मा॒तुष्टे कि॑रणौ॒ द्वौ निवृ॑त्तः॒ पुरु॑षानृते",
   "न वै॑ कुमारि॒ तत्तथा॒ यथा॑ कुमारि॒ मन्य॑से"
  ],
  "lines_iast": [
   "mā̱tuṣṭe ki̭raṇau̱ dvau nivṛ̭tta̱ḥ purṷṣānṛte",
   "na vai̭ kumāri̱ tattathā̱ yathā̭ kumāri̱ manya̭se"
  ],
