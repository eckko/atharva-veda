   "020.133.4b"
  ],
  "lines_deva": [
   "उ॒त्ता॒नायै॒ शया॒नायै॒ तिष्ठ॑न्ती॒ वाव॑ गूहसि",
   "न वै॑ कमारि॒ तत्तथा॒ यथा॑ कुमारि॒ मन्य॑से"
  ],
  "lines_iast": [
   "u̱ttā̱nāyai̱ śayā̱nāyai̱ tiṣṭha̭ntī̱ vāva̭ gūhasi",
   "na vai̭ kamāri̱ tattathā̱ yathā̭ kumāri̱ manya̭se"
  ],
