  ],
  "lines_deva": [
   "अम॑न्म॒हीद॑ना॒शवो॑ऽनु॒ग्रास॑श्च वृत्रहन्",
   "सु॒कृत्सु ते॑ मह॒ता शू॑र॒ राध॒सानु॒ स्तोमं॑ मुदीमहि"
  ],
  "lines_iast": [
   "ama̭nma̱hīda̭nā̱śavo̭'nu̱grāsa̭śca vṛtrahan",
   "su̱kṛtsu tḙ maha̱tā śṷ̄ra̱ rādha̱sānu̱ stoma̭ṃ mudīmahi"
  ],
