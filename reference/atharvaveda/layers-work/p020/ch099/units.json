  ],
  "lines_deva": [
   "अ॒भि त्वा॑ पू॒र्वपी॑तय॒ इन्द्र॒ स्तोमे॑भिरा॒यवः॑",
   "स॒मी॒ची॒नास॑ ऋ॒भवः॒ सम॑स्वरन् रु॒द्रा गृ॑णन्त॒ पूर्व्य॑म्"
  ],
  "lines_iast": [
   "a̱bhi tvā̭ pū̱rvapī̭taya̱ indra̱ stomḙbhirā̱yava̭ḥ",
   "sa̱mī̱cī̱nāsa̭ ṛ̱bhava̱ḥ sama̭svaran ru̱drā gṛ̭ṇanta̱ pūrvya̭m"
  ],
