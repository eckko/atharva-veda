 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.099.2a",
   "020.099.2b"
  ],
  "lines_deva": [
   "अ॒स्येदिन्द्रो॑ वावृधे॒ वृष्ण्यं॒ शवो॒ मदे॑ सु॒तस्य॒ विष्ण॑वि",
   "अ॒द्या तम॑स्य महि॒मान॑मा॒यवोऽनु॑ ष्टुवन्ति पू॒र्वथा॑"
  ],
  "lines_iast": [
   "a̱syedindro̭ vāvṛdhe̱ vṛṣṇya̱ṃ śavo̱ madḙ su̱tasya̱ viṣṇa̭vi",
   "a̱dyā tama̭sya mahi̱māna̭mā̱yavo'nṷ ṣṭuvanti pū̱rvathā̭"
  ],
