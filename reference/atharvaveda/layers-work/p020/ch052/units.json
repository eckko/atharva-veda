 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "020.052.2a",
   "020.052.2b"
  ],
  "lines_deva": [
   "स्वर॑न्ति त्वा सु॒ते नरो॒ वसो॑ निरे॒क उ॒क्थिनः॑",
   "क॒दा सु॒तं तृ॑षा॒ण ओक॒ आ ग॑म॒ इन्द्र॑ स्व॒ब्दीव॒ वंस॑गः"
  ],
  "lines_iast": [
   "svara̭nti tvā su̱te naro̱ vaso̭ nire̱ka u̱kthina̭ḥ",
   "ka̱dā su̱taṃ tṛ̭ṣā̱ṇa oka̱ ā ga̭ma̱ indra̭ sva̱bdīva̱ vaṃsa̭gaḥ"
  ],
