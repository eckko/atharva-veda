   "020.052.3b"
  ],
  "lines_deva": [
   "कण्वे॑भिर्धृष्ण॒वा धृ॒षद् वाजं॑ दर्षि सह॒स्रिण॑म्",
   "पि॒शङ्ग॑रूपं मघवन् विचर्षणे म॒क्षू गोम॑न्तमीमहे"
  ],
  "lines_iast": [
   "kaṇvḙbhirdhṛṣṇa̱vā dhṛ̱ṣad vāja̭ṃ darṣi saha̱sriṇa̭m",
   "pi̱śaṅga̭rūpaṃ maghavan vicarṣaṇe ma̱kṣū goma̭ntamīmahe"
  ],
