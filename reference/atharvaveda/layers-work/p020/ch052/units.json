  ],
  "lines_deva": [
   "व॒यं घ॑ त्वा सु॒ताव॑न्त॒ आपो॒ न वृ॒क्तब॑र्हिषः",
   "प॒वित्र॑स्य प्र॒स्रव॑णेषु वृत्रह॒न् परि॑ स्तो॒तार॑ आसते"
  ],
  "lines_iast": [
   "va̱yaṃ gha̭ tvā su̱tāva̭nta̱ āpo̱ na vṛ̱ktaba̭rhiṣaḥ",
   "pa̱vitra̭sya pra̱srava̭ṇeṣu vṛtraha̱n pari̭ sto̱tāra̭ āsate"
  ],
