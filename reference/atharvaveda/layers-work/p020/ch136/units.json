  "lines_deva": [
   "म॒हा॒न॒ग्नी कृ॑कवाकं॒ शम्य॑या॒ परि॑ धावति",
   "अ॒यं न वि॒द्म यो॑ मृ॒गः शी॒र्ष्णा ह॑रति॒ धाणि॑काम्"
  ],
  "lines_iast": [
   "ma̱hā̱na̱gnī kṛ̭kavāka̱ṃ śamya̭yā̱ pari̭ dhāvati",
   "a̱yaṃ na vi̱dma yo̭ mṛ̱gaḥ śī̱rṣṇā ha̭rati̱ dhāṇi̭kām"
  ],
