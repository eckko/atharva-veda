   "020.136.2b"
  ],
  "lines_deva": [
   "यदा॑ स्थू॒लेन॒ पस॑साणौ मु॒ष्का उपा॑वधीत्",
   "विष्व॑ञ्चा व॒स्या वर्ध॑तः॒ सिक॑तास्वेव॒ गर्द॑भौ"
  ],
  "lines_iast": [
   "yadā̭ sthū̱lena̱ pasa̭sāṇau mu̱ṣkā upā̭vadhīt",
   "viṣva̭ñcā va̱syā vardha̭ta̱ḥ sika̭tāsveva̱ garda̭bhau"
  ],
