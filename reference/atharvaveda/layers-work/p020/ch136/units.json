   "020.136.1b"
  ],
  "lines_deva": [
   "यद॑स्या अंहु॒भेद्याः॑ कृ॒धु स्थू॒लमु॒पात॑सत्",
   "मु॒ष्काविद॑स्या एज॒तो गो॑श॒फे श॑कु॒लावि॑व"
  ],
  "lines_iast": [
   "yada̭syā aṃhu̱bhedyā̭ḥ kṛ̱dhu sthū̱lamu̱pāta̭sat",
   "mu̱ṣkāvida̭syā eja̱to go̭śa̱phe śa̭ku̱lāvi̭va"
  ],
