   "इन्दु॒रिन्द्रा॑य पवत॒ इति॑ दे॒वासो॑ अब्रुवन्",
   "वा॒चस्पति॑र्मखस्यते॒ विश्व॒स्येशा॑न॒ ओज॑सा"
  ],
  "lines_iast": [
   "indu̱rindrā̭ya pavata̱ iti̭ de̱vāso̭ abruvan",
   "vā̱caspati̭rmakhasyate̱ viśva̱syeśā̭na̱ oja̭sā"
  ],
