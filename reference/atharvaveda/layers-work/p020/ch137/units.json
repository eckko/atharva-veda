   "020.137.1b"
  ],
  "lines_deva": [
   "यद्ध॒ प्राची॒रज॑ग॒न्तोरो॑ मण्डूरधाणिकीः",
   "ह॒ता इन्द्र॑स्य॒ शत्र॑वः॒ सर्वे॑ बुद्बु॒दया॑शवः"
  ],
  "lines_iast": [
   "yaddha̱ prācī̱raja̭ga̱ntoro̭ maṇḍūradhāṇikīḥ",
   "ha̱tā indra̭sya̱ śatra̭va̱ḥ sarvḙ budbu̱dayā̭śavaḥ"
  ],
