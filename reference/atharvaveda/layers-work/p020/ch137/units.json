  "lines_deva": [
   "सु॒तासो॒ मधु॑मत्तमाः॒ सोमा॒ इन्द्रा॑य म॒न्दिनः॑",
   "प॒वित्र॑वन्तो अक्षरन्दे॒वान्ग॑च्छ॑न्तु वो॒ मदाः॑"
  ],
  "lines_iast": [
   "su̱tāso̱ madhṷmattamā̱ḥ somā̱ indrā̭ya ma̱ndina̭ḥ",
   "pa̱vitra̭vanto akṣarande̱vānga̭ccha̭ntu vo̱ madā̭ḥ"
  ],
