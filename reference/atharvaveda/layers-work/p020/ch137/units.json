  "lines_deva": [
   "त्वं ह॒ त्यत्स॒प्तभ्यो॒ जाय॑मानोऽश॒त्रुभ्यो॑ अभवः॒ शत्रु॑रिन्द्र",
   "गू॒ल्हे द्यावा॑पृथि॒वी अन्व॑विन्दो विभु॒मद्भ्यो॒ भुव॑नेभ्यो॒ रणं॑ धाः"
  ],
  "lines_iast": [
   "tvaṃ ha̱ tyatsa̱ptabhyo̱ jāya̭māno'śa̱trubhyo̭ abhava̱ḥ śatrṷrindra",
   "gū̱lhe dyāvā̭pṛthi̱vī anva̭vindo vibhu̱madbhyo̱ bhuva̭nebhyo̱ raṇa̭ṃ dhāḥ"
  ],
