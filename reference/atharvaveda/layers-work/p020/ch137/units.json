   "020.137.6b"
  ],
  "lines_deva": [
   "स॒हस्र॑धारः पवते समु॒द्रो वा॑चमीङ्ख॒यः",
   "सोमः॒ पती॑ रयी॒णां सखेन्द्र॑स्य दि॒वेदि॑वे"
  ],
  "lines_iast": [
   "sa̱hasra̭dhāraḥ pavate samu̱dro vā̭camīṅkha̱yaḥ",
   "soma̱ḥ patī̭ rayī̱ṇāṃ sakhendra̭sya di̱vedi̭ve"
  ],
