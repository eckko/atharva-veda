   "020.137.7b"
  ],
  "lines_deva": [
   "अव॑ द्र॒प्सो अं॑शु॒मती॑मतिष्ठदिया॒नः कृ॒ष्णो द॒शभिः॑ स॒हस्रैः॑",
   "आव॒त्तमिन्द्रः॒ शच्या॒ धम॑न्त॒मप॒स्नेहि॑तीर्नृ॒मणा॑ अधत्त"
  ],
  "lines_iast": [
   "ava̭ dra̱pso a̭ṃśu̱matī̭matiṣṭhadiyā̱naḥ kṛ̱ṣṇo da̱śabhi̭ḥ sa̱hasrai̭ḥ",
   "āva̱ttamindra̱ḥ śacyā̱ dhama̭nta̱mapa̱snehi̭tīrnṛ̱maṇā̭ adhatta"
  ],
