  "lines_deva": [
   "कपृ॑न्नरः कपृ॒थमुद्द॑धातन चो॒दय॑त खु॒दत॒ वाज॑सातये",
   "नि॒ष्टि॒ग्र्यः पु॒त्रमा च्या॑वयो॒तय॒ इन्द्रं॑ स॒बाध॑ इ॒ह सोम॑पीतये"
  ],
  "lines_iast": [
   "kapṛ̭nnaraḥ kapṛ̱thamudda̭dhātana co̱daya̭ta khu̱data̱ vāja̭sātaye",
   "ni̱ṣṭi̱gryaḥ pu̱tramā cyā̭vayo̱taya̱ indra̭ṃ sa̱bādha̭ i̱ha soma̭pītaye"
  ],
