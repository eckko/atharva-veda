  "lines_deva": [
   "द॒धि॒क्राव्णो॑ अकारिषं जि॒ष्णोरश्व॑स्य वा॒जिनः॑",
   "सु॒र॒भि नो॒ मुखा॑ कर॒त्प्र ण॒ आयूं॑षि तारिषत्"
  ],
  "lines_iast": [
   "da̱dhi̱krāvṇo̭ akāriṣaṃ ji̱ṣṇoraśva̭sya vā̱jina̭ḥ",
   "su̱ra̱bhi no̱ mukhā̭ kara̱tpra ṇa̱ āyṷ̄ṃṣi tāriṣat"
  ],
