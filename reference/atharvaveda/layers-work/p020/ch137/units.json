  "lines_deva": [
   "द्र॒प्सम॑पश्यं॒ विषु॑णे॒ चर॑न्तमुपह्व॒रे न॒द्यो अंशु॒मत्याः॑",
   "नभो॒ न कृ॒ष्णम॑वतस्थि॒वांस॒मिष्या॑मि वो वृषणो॒ युध्य॑ता॒जौ"
  ],
  "lines_iast": [
   "dra̱psama̭paśya̱ṃ viṣṷṇe̱ cara̭ntamupahva̱re na̱dyo aṃśu̱matyā̭ḥ",
   "nabho̱ na kṛ̱ṣṇama̭vatasthi̱vāṃsa̱miṣyā̭mi vo vṛṣaṇo̱ yudhya̭tā̱jau"
  ],
