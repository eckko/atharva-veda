  ],
  "lines_deva": [
   "व॒यमे॑नमि॒दा ह्योपी॑पेमे॒ह व॒ज्रिण॑म्",
   "तस्मा॑ उ अ॒द्य स॑म॒ना सु॒तं भ॒रा नू॒नं भू॑षत श्रु॒ते"
  ],
  "lines_iast": [
   "va̱yamḙnami̱dā hyopī̭peme̱ha va̱jriṇa̭m",
   "tasmā̭ u a̱dya sa̭ma̱nā su̱taṃ bha̱rā nū̱naṃ bhṷ̄ṣata śru̱te"
  ],
