   "020.098.2b"
  ],
  "lines_deva": [
   "वृक॑श्चिदस्य वार॒ण उ॑रा॒मथि॒रा व॒युने॑षु भूषति",
   "सेमं नः॒ स्तोमं॑ जुजुषा॒ण आ ग॒हीन्द्र॒ प्र चि॒त्रया॑ धि॒या"
  ],
  "lines_iast": [
   "vṛka̭ścidasya vāra̱ṇa ṷrā̱mathi̱rā va̱yunḙṣu bhūṣati",
   "semaṃ na̱ḥ stoma̭ṃ jujuṣā̱ṇa ā ga̱hīndra̱ pra ci̱trayā̭ dhi̱yā"
  ],
