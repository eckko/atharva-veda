  "lines_deva": [
   "कदू॒ न्व॑१स्याकृ॑त॒मिन्द्र॑स्यास्ति॒ पौंस्य॑म्",
   "केनो॒ नु कं॒ श्रोम॑तेन॒ न शु॑श्रुवे ज॒नुषः॒ परि॑ वृत्र॒हा"
  ],
  "lines_iast": [
   "kadū̱ nva̭1syākṛ̭ta̱mindra̭syāsti̱ pauṃsya̭m",
   "keno̱ nu ka̱ṃ śroma̭tena̱ na śṷśruve ja̱nuṣa̱ḥ pari̭ vṛtra̱hā"
  ],
