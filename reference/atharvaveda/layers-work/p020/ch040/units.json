  "lines_deva": [
   "इन्द्रे॑ण॒ सं हि दृक्ष॑से संजग्मा॒नो अबि॑भ्युषा। म॒न्दू स॑मा॒नव॑र्चसा"
  ],
  "lines_iast": [
   "indrḙṇa̱ saṃ hi dṛkṣa̭se saṃjagmā̱no abi̭bhyuṣā| ma̱ndū sa̭mā̱nava̭rcasā"
  ],
