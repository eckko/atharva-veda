 {
  "n": "30",
  "type": "verse",
  "line_ids": [
   "019.023.30a",
   "019.023.30b"
  ],
  "lines_deva": [
   "ब्रह्म॑ज्येष्ठा॒ संभृ॑ता वी॒र्याऽणि॒ ब्रह्माग्रे॒ ज्येष्ठं॒ दिव॒मा त॑तान",
   "भू॒तानां॑ ब्र॒ह्मा प्र॑थ॒मोत जज्ञे॒ तेना॑र्हति॒ ब्रह्म॑णा॒ स्पर्धि॑तुं॒ कः"
  ],
  "lines_iast": [
   "brahma̭jyeṣṭhā̱ saṃbhṛ̭tā vī̱ryā'ṇi̱ brahmāgre̱ jyeṣṭha̱ṃ diva̱mā ta̭tāna",
   "bhū̱tānā̭ṃ bra̱hmā pra̭tha̱mota jajñe̱ tenā̭rhati̱ brahma̭ṇā̱ spardhi̭tu̱ṃ kaḥ"
  ],
