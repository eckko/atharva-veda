   "019.035.2a",
   "019.035.2b"
  ],
  "lines_deva": [
   "स नो॑ रक्षतु जङ्गि॒डो ध॑नपा॒लो धने॑व",
   "दे॒वा यं च॒क्रुर्ब्रा॑ह्म॒णाः प॑रि॒पाण॑मराति॒हम्"
  ],
  "lines_iast": [
   "sa no̭ rakṣatu jaṅgi̱ḍo dha̭napā̱lo dhanḙva",
   "de̱vā yaṃ ca̱krurbrā̭hma̱ṇāḥ pa̭ri̱pāṇa̭marāti̱ham"
  ],
