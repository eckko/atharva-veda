   "019.035.3b"
  ],
  "lines_deva": [
   "दु॒र्हार्दः॒ संघो॑रं॒ चक्षुः॑ पाप॒कृत्वा॑न॒माग॑मम्",
   "तांस्त्वं स॑हस्रचक्षो प्रतीबो॒धेन॑ नाशय परि॒पाणो॑ऽसि जङ्गि॒डः"
  ],
  "lines_iast": [
   "du̱rhārda̱ḥ saṃgho̭ra̱ṃ cakṣṷḥ pāpa̱kṛtvā̭na̱māga̭mam",
   "tāṃstvaṃ sa̭hasracakṣo pratībo̱dhena̭ nāśaya pari̱pāṇo̭'si jaṅgi̱ḍaḥ"
  ],
