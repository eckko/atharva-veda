   "019.035.5b"
  ],
  "lines_deva": [
   "य ऋ॒ष्णवो॑ दे॒वकृ॑ता॒ य उ॒तो व॑वृ॒तेऽन्यः",
   "सर्वां॒स्तान् वि॒श्वभे॑षजोऽर॒सां ज॑ङ्गि॒डस्क॑रत्"
  ],
  "lines_iast": [
   "ya ṛ̱ṣṇavo̭ de̱vakṛ̭tā̱ ya u̱to va̭vṛ̱te'nyaḥ",
   "sarvā̱ṃstān vi̱śvabhḙṣajo'ra̱sāṃ ja̭ṅgi̱ḍaska̭rat"
  ],
