   "019.035.1b"
  ],
  "lines_deva": [
   "इन्द्र॑स्य॒ नाम॑ गृ॒ह्णन्त॒ ऋस॑यो जङ्गि॒डं द॑दुः",
   "दे॒वा यं च॒क्रुर्भे॑ष॒जमग्रे॑ विष्कन्ध॒दूष॑णम्"
  ],
  "lines_iast": [
   "indra̭sya̱ nāma̭ gṛ̱hṇanta̱ ṛsa̭yo jaṅgi̱ḍaṃ da̭duḥ",
   "de̱vā yaṃ ca̱krurbhḙṣa̱jamagrḙ viṣkandha̱dūṣa̭ṇam"
  ],
