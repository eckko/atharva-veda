 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "019.035.4a",
   "019.035.4b"
  ],
  "lines_deva": [
   "परि॑ मा दि॒वः परि॑ मा पृथि॒व्याः पर्य॒न्तरि॑क्षा॒त् परि॑ मा वी॒रुद्भ्यः॑",
   "परि॑ मा भू॒तात् परि॑ मो॒त भव्या॑द् दि॒शोदि॑शो जङ्गि॒डः पा॑त्व॒स्मान्"
  ],
  "lines_iast": [
   "pari̭ mā di̱vaḥ pari̭ mā pṛthi̱vyāḥ parya̱ntari̭kṣā̱t pari̭ mā vī̱rudbhya̭ḥ",
   "pari̭ mā bhū̱tāt pari̭ mo̱ta bhavyā̭d di̱śodi̭śo jaṅgi̱ḍaḥ pā̭tva̱smān"
  ],
