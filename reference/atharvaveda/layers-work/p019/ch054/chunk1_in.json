   "019.054.2b"
  ],
  "lines_deva": [
   "का॒लेन॒ वातः॑ पवते का॒लेन॑ पृथि॒वी म॒ही",
   "द्यौर्म॒ही का॒ल आहि॑ता"
  ],
  "lines_iast": [
   "kā̱lena̱ vāta̭ḥ pavate kā̱lena̭ pṛthi̱vī ma̱hī",
   "dyaurma̱hī kā̱la āhi̭tā"
  ],
