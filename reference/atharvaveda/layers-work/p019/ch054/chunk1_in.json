 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "019.054.4a",
   "019.054.4b"
  ],
  "lines_deva": [
   "का॒लो य॒ज्ञं समै॑रयद् दे॒वेभ्यो॑ भा॒गमक्षि॑तम्",
   "का॒ले ग॑न्धर्वाप्स॒रसः॑ का॒ले लो॒काः प्रति॑ष्ठिताः"
  ],
  "lines_iast": [
   "kā̱lo ya̱jñaṃ samai̭rayad de̱vebhyo̭ bhā̱gamakṣi̭tam",
   "kā̱le ga̭ndharvāpsa̱rasa̭ḥ kā̱le lo̱kāḥ prati̭ṣṭhitāḥ"
  ],
