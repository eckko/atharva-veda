   "019.054.1b"
  ],
  "lines_deva": [
   "का॒लादापः॒ सम॑भवन् का॒लाद् ब्रह्म॒ तपो॒ दिशः॑",
   "का॒लेनोदे॑ति॒ सूर्यः॑ का॒ले नि वि॑शते॒ पुनः॑"
  ],
  "lines_iast": [
   "kā̱lādāpa̱ḥ sama̭bhavan kā̱lād brahma̱ tapo̱ diśa̭ḥ",
   "kā̱lenodḙti̱ sūrya̭ḥ kā̱le ni vi̭śate̱ puna̭ḥ"
  ],
