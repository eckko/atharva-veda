   "019.054.3a",
   "019.054.3b"
  ],
  "lines_deva": [
   "का॒लो ह॑ भू॒तं भव्यं॑ च पु॒त्रो अ॑जनयत् पु॒रा",
   "का॒लादृचः॒ सम॑भव॒न् यजुः॑ का॒लाद॑जायत"
  ],
  "lines_iast": [
   "kā̱lo ha̭ bhū̱taṃ bhavya̭ṃ ca pu̱tro a̭janayat pu̱rā",
   "kā̱lādṛca̱ḥ sama̭bhava̱n yajṷḥ kā̱lāda̭jāyata"
  ],
