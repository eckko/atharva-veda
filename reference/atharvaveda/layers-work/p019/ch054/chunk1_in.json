 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "019.054.5a",
   "019.054.5b",
   "019.054.5c"
  ],
  "lines_deva": [
   "का॒लेऽयमङ्गि॑रा दे॒वोऽथ॑र्वा॒ चाधि॑ तिष्ठतः",
   "इ॒मं च॑ लो॒कं प॑र॒मं च॑ लो॒कं पुण्यां॑श्च लो॒कान् विधृ॑तीश्च॒ पुण्याः॑",
   "सर्वां॑ल्लो॒कान॑भि॒जित्य॒ ब्रह्म॑णा का॒लः स ई॑यते पर॒मो नु दे॒वः"
  ],
  "lines_iast": [
   "kā̱le'yamaṅgi̭rā de̱vo'tha̭rvā̱ cādhi̭ tiṣṭhataḥ",
   "i̱maṃ ca̭ lo̱kaṃ pa̭ra̱maṃ ca̭ lo̱kaṃ puṇyā̭ṃśca lo̱kān vidhṛ̭tīśca̱ puṇyā̭ḥ",
   "sarvā̭ṃllo̱kāna̭bhi̱jitya̱ brahma̭ṇā kā̱laḥ sa ī̭yate para̱mo nu de̱vaḥ"
  ],
