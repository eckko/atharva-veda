 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "019.040.1a",
   "019.040.1b"
  ],
  "lines_deva": [
   "यन्मे॑ छि॒द्रं मन॑सो॒ यच्च॑ वा॒चः सर॑स्वती मन्यु॒मन्तं॑ ज॒गाम॑",
   "विश्वै॒स्तद् दे॒वैः स॒ह सं॑विदा॒नः सं द॑धातु॒ बृह॒स्पतिः॑"
  ],
  "lines_iast": [
   "yanmḙ chi̱draṃ mana̭so̱ yacca̭ vā̱caḥ sara̭svatī manyu̱manta̭ṃ ja̱gāma̭",
   "viśvai̱stad de̱vaiḥ sa̱ha sa̭ṃvidā̱naḥ saṃ da̭dhātu̱ bṛha̱spati̭ḥ"
  ],
  "book_split": [
