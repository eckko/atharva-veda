 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.040.2a",
   "019.040.2b"
  ],
  "lines_deva": [
   "मा न॒ आपो॑ मे॒धां मा ब्रह्म॒ प्र म॑थिष्टन",
   "सु॒ष्य॒दा यू॒यं स्य॑न्दध्व॒मुप॑हूतो॒ऽहं सु॒मेधा॑ वर्च॒स्वी"
  ],
  "lines_iast": [
   "mā na̱ āpo̭ me̱dhāṃ mā brahma̱ pra ma̭thiṣṭana",
   "su̱ṣya̱dā yū̱yaṃ sya̭ndadhva̱mupa̭hūto̱'haṃ su̱medhā̭ varca̱svī"
  ],
  "book_split": [
