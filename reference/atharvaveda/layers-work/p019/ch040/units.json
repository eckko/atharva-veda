   "019.040.4b"
  ],
  "lines_deva": [
   "या नः॒ पीप॑रद॒श्विना॒ ज्योति॑ष्मती॒ तम॑स्ति॒रः",
   "ताम॒स्मे रा॑सता॒मिष॑म्"
  ],
  "lines_iast": [
   "yā na̱ḥ pīpa̭rada̱śvinā̱ jyoti̭ṣmatī̱ tama̭sti̱raḥ",
   "tāma̱sme rā̭satā̱miṣa̭m"
  ],
