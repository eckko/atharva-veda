   "019.033.5b"
  ],
  "lines_deva": [
   "द॒र्भेण॒ त्वं कृ॑णवद् वी॒र्याऽणि द॒र्भं बिभ्र॑दा॒त्मना॒ मा व्य॑थिष्ठाः",
   "अति॑ष्ठाया॒ वर्च॒साधा॒न्यान्त्सूर्य॑ इ॒वा भा॑हि प्र॒दिश॒श्चत॑स्रः"
  ],
  "lines_iast": [
   "da̱rbheṇa̱ tvaṃ kṛ̭ṇavad vī̱ryā'ṇi da̱rbhaṃ bibhra̭dā̱tmanā̱ mā vya̭thiṣṭhāḥ",
   "ati̭ṣṭhāyā̱ varca̱sādhā̱nyāntsūrya̭ i̱vā bhā̭hi pra̱diśa̱ścata̭sraḥ"
  ],
