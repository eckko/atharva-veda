 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "019.033.4a",
   "019.033.4b"
  ],
  "lines_deva": [
   "ती॒क्ष्णो राजा॑ विषास॒ही र॑क्षो॒हा वि॒श्वच॑र्षणिः",
   "ओजो॑ दे॒वानां॒ बल॑मु॒ग्रमे॒तत् तं ते॑ बध्नामि ज॒रसे॑ स्व॒स्तये॑"
  ],
  "lines_iast": [
   "tī̱kṣṇo rājā̭ viṣāsa̱hī ra̭kṣo̱hā vi̱śvaca̭rṣaṇiḥ",
   "ojo̭ de̱vānā̱ṃ bala̭mu̱grame̱tat taṃ tḙ badhnāmi ja̱rasḙ sva̱stayḙ"
  ],
