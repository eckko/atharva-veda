 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "019.033.3a",
   "019.033.3b"
  ],
  "lines_deva": [
   "त्वं भूमि॒मत्ये॒ष्योज॑सा॒ त्वं वेद्यां॑ सीदसि॒ चारु॑रध्व॒रे",
   "त्वां प॒वित्र॒मृष॑योऽभरन्त॒ त्वं पुनीहि दुरि॒तान्य॒स्मत्"
  ],
  "lines_iast": [
   "tvaṃ bhūmi̱matye̱ṣyoja̭sā̱ tvaṃ vedyā̭ṃ sīdasi̱ cārṷradhva̱re",
   "tvāṃ pa̱vitra̱mṛṣa̭yo'bharanta̱ tvaṃ punīhi duri̱tānya̱smat"
  ],
