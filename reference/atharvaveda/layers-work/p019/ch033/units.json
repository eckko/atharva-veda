 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "019.033.1a",
   "019.033.1b"
  ],
  "lines_deva": [
   "स॒ह॒स्रा॒र्घः श॒तका॑ण्डः॒ पय॑स्वान॒पाम॒ग्निर्वी॒रुधां॑ राज॒सूय॑म्",
   "स नो॒ऽयं द॒र्भः परि॑ पातु वि॒श्वतो॑ दे॒वो म॒णिरायु॑षा॒ सं सृ॑जाति नः"
  ],
  "lines_iast": [
   "sa̱ha̱srā̱rghaḥ śa̱takā̭ṇḍa̱ḥ paya̭svāna̱pāma̱gnirvī̱rudhā̭ṃ rāja̱sūya̭m",
   "sa no̱'yaṃ da̱rbhaḥ pari̭ pātu vi̱śvato̭ de̱vo ma̱ṇirāyṷṣā̱ saṃ sṛ̭jāti naḥ"
  ],
