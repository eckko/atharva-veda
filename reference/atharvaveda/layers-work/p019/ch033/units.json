 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.033.2a",
   "019.033.2b"
  ],
  "lines_deva": [
   "घृ॒तादुल्लु॑प्तो॒ मधु॑मा॒न् पय॑स्वान् भूमिदृं॒होऽच्यु॑तश्च्यावयि॒ष्णुः",
   "नु॒दन्त्स॒पत्ना॒नध॑रांश्च कृ॒ण्वन् दर्भा रो॑ह मह॒तामि॑न्द्रि॒येण॑"
  ],
  "lines_iast": [
   "ghṛ̱tādullṷpto̱ madhṷmā̱n paya̭svān bhūmidṛ̱ṃho'cyṷtaścyāvayi̱ṣṇuḥ",
   "nu̱dantsa̱patnā̱nadha̭rāṃśca kṛ̱ṇvan darbhā ro̭ha maha̱tāmi̭ndri̱yeṇa̭"
  ],
