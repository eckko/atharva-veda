  "lines_deva": [
   "चन्द्र॑मा म॑नसो जात॑श्च॑क्षोः सू॑र्यो अजायत",
   "मुखा॒दिन्द्र॑श्चा॒ग्निश्च॑ प्रा॒णाद् वा॒युर॑जायत"
  ],
  "lines_iast": [
   "candra̭mā ma̭naso jāta̭śca̭kṣoḥ sṷ̄ryo ajāyata",
   "mukhā̱dindra̭ścā̱gniśca̭ prā̱ṇād vā̱yura̭jāyata"
  ],
