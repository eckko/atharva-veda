  "lines_deva": [
   "मू॒र्ध्नो दे॒वस्य॑ बृह॒तो अं॒शवः॑ स॒प्त स॑प्त॒तीः",
   "राज्ञः॒ सोम॑स्याजायन्त जा॒तस्य॒ पुरु॑षा॒दधि॑"
  ],
  "lines_iast": [
   "mū̱rdhno de̱vasya̭ bṛha̱to a̱ṃśava̭ḥ sa̱pta sa̭pta̱tīḥ",
   "rājña̱ḥ soma̭syājāyanta jā̱tasya̱ purṷṣā̱dadhi̭"
