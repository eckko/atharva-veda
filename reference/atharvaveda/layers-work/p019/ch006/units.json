 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "019.006.3a",
   "019.006.3b"
  ],
  "lines_deva": [
   "ताव॑न्तो अस्य महि॒मान॒स्ततो॒ ज्यायां॑श्च॒ पूरु॑षः",
   "पादो॑ऽस्य॒ विश्वा॑ भू॒तानि॑ त्रि॒पाद॑स्यृ॒तं॑ दि॒वि"
  ],
  "lines_iast": [
   "tāva̭nto asya mahi̱māna̱stato̱ jyāyā̭ṃśca̱ pūrṷṣaḥ",
   "pādo̭'sya̱ viśvā̭ bhū̱tāni̭ tri̱pāda̭syṛ̱ta̭ṃ di̱vi"
  ],
