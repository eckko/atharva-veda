  "lines_deva": [
   "ब्रा॒ह्म॒णोऽस्य॒ मुख॑मासीद् बा॒हू रा॑ज॒न्योऽभवत्",
   "मध्यं॒ तद॑स्य॒ यद् वैश्यः॑ प॒द्भ्यां शू॒द्रो अ॑जायत"
  ],
  "lines_iast": [
   "brā̱hma̱ṇo'sya̱ mukha̭māsīd bā̱hū rā̭ja̱nyo'bhavat",
   "madhya̱ṃ tada̭sya̱ yad vaiśya̭ḥ pa̱dbhyāṃ śū̱dro a̭jāyata"
  ],
