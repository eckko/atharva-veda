  "lines_deva": [
   "यत् पुरु॑षेण ह॒विषा॑ दे॒वा य॒ज्ञमत॑न्वत",
   "व॒स॒न्तो अ॑स्यासी॒दाज्यं॑ ग्री॒ष्म इ॒ध्मः श॒रद्ध॒विः"
  ],
  "lines_iast": [
   "yat purṷṣeṇa ha̱viṣā̭ de̱vā ya̱jñamata̭nvata",
   "va̱sa̱nto a̭syāsī̱dājya̭ṃ grī̱ṣma i̱dhmaḥ śa̱raddha̱viḥ"
  ],
