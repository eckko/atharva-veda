  "lines_deva": [
   "यत् पुरु॑षं॒ व्यद॑धुः कति॒धा व्यऽकल्पयन्",
   "मुखं॒ किम॑स्य॒ किं बा॒हू किमू॒रू पादा॑ उच्येते"
  ],
  "lines_iast": [
   "yat purṷṣa̱ṃ vyada̭dhuḥ kati̱dhā vya'kalpayan",
   "mukha̱ṃ kima̭sya̱ kiṃ bā̱hū kimū̱rū pādā̭ ucyete"
  ],
