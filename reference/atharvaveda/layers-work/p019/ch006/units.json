  "lines_deva": [
   "तं य॒ज्ञं प्रा॒वृषा॒ प्रौक्ष॒न् पुरु॑षं जा॒तम॑ग्र॒शः",
   "तेन॑ दे॒वा अ॑यजन्त सा॒ध्या वस॑वश्च॒ ये"
  ],
  "lines_iast": [
   "taṃ ya̱jñaṃ prā̱vṛṣā̱ praukṣa̱n purṷṣaṃ jā̱tama̭gra̱śaḥ",
   "tena̭ de̱vā a̭yajanta sā̱dhyā vasa̭vaśca̱ ye"
  ],
