  "lines_deva": [
   "नाभ्या॑ आसीद॒न्तरि॑क्षं शी॒र्ष्णो द्यौः सम॑वर्तत",
   "प॒द्भ्यां भूमि॒र्दिशः॒ श्रोत्रा॒त् तथा॑ लो॒कां अ॑कल्पयन्"
  ],
  "lines_iast": [
   "nābhyā̭ āsīda̱ntari̭kṣaṃ śī̱rṣṇo dyauḥ sama̭vartata",
   "pa̱dbhyāṃ bhūmi̱rdiśa̱ḥ śrotrā̱t tathā̭ lo̱kāṃ a̭kalpayan"
  ],
