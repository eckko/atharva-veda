 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.006.2a",
   "019.006.2b"
  ],
  "lines_deva": [
   "त्रि॒भिः प॒द्भिर्द्याम॑रोह॒त् पाद॑स्ये॒हाभ॑व॒त् पुनः॑",
   "तथा॒ व्यऽक्राम॒द् विष्व॑ङशनानश॒ने अनु॑"
  ],
  "lines_iast": [
   "tri̱bhiḥ pa̱dbhirdyāma̭roha̱t pāda̭sye̱hābha̭va̱t puna̭ḥ",
   "tathā̱ vya'krāma̱d viṣva̭ṅaśanānaśa̱ne anṷ"
  ],
  "book_split": [
