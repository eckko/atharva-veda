[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "019.006.1a",
   "019.006.1b"
  ],
  "lines_deva": [
   "स॒हस्र॑बाहुः॒ पुरु॑षः सहस्रा॒क्षः स॒हस्र॑पात्",
   "स भूमिं॑ वि॒श्वतो॑ वृ॒त्वात्य॑तिष्ठद् दशाङ्गु॒लम्"
  ],
  "lines_iast": [
   "sa̱hasra̭bāhu̱ḥ purṷṣaḥ sahasrā̱kṣaḥ sa̱hasra̭pāt",
   "sa bhūmi̭ṃ vi̱śvato̭ vṛ̱tvātya̭tiṣṭhad daśāṅgu̱lam"
  ],
  "book_split": [
