  "lines_deva": [
   "तस्मा॒दश्वा॑ अजायन्त॒ ये च॒ के चो॑भ॒याद॑तः",
   "गावो॑ ह जज्ञिरे॒ तस्मा॒त् तस्मा॑ज्जा॒ता अ॑जा॒वयः॑"
  ],
  "lines_iast": [
   "tasmā̱daśvā̭ ajāyanta̱ ye ca̱ ke co̭bha̱yāda̭taḥ",
   "gāvo̭ ha jajñire̱ tasmā̱t tasmā̭jjā̱tā a̭jā̱vaya̭ḥ"
  ],
