 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "019.006.4a",
   "019.006.4b"
  ],
  "lines_deva": [
   "पुरु॑ष ए॒वेदं सर्वं॒ यद् भू॒तं यच्च॑ भा॒व्यम्",
   "उ॒तामृ॑त॒त्वस्ये॑श्व॒रो यद॒न्येनाभ॑वत् स॒ह"
  ],
  "lines_iast": [
   "purṷṣa e̱vedaṃ sarva̱ṃ yad bhū̱taṃ yacca̭ bhā̱vyam",
   "u̱tāmṛ̭ta̱tvasyḙśva̱ro yada̱nyenābha̭vat sa̱ha"
  ],
