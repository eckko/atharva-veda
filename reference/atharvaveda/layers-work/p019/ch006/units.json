  "lines_deva": [
   "तस्मा॑द् य॒ज्ञात् स॑र्व॒हुत॒ ऋचः॒ सामा॑नि जज्ञिरे",
   "छन्दो॑ ह जज्ञिरे॒ तस्मा॒द् यजु॒स्तस्मा॑दजायत"
  ],
  "lines_iast": [
   "tasmā̭d ya̱jñāt sa̭rva̱huta̱ ṛca̱ḥ sāmā̭ni jajñire",
   "chando̭ ha jajñire̱ tasmā̱d yaju̱stasmā̭dajāyata"
  ],
