  "lines_deva": [
   "स॒प्तास्या॑सन् परि॒धय॒स्त्रिः स॒प्त स॒मिधः॑ कृ॒ताः",
   "दे॒वा यद् य॒ज्ञं त॑न्वा॒ना अब॑ध्न॒न् पुरु॑षं प॒शुम्"
  ],
  "lines_iast": [
   "sa̱ptāsyā̭san pari̱dhaya̱striḥ sa̱pta sa̱midha̭ḥ kṛ̱tāḥ",
   "de̱vā yad ya̱jñaṃ ta̭nvā̱nā aba̭dhna̱n purṷṣaṃ pa̱śum"
  ],
