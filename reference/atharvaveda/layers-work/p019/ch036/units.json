  "lines_deva": [
   "श॒तम॒हं दु॒र्णाम्नी॑नां गन्धर्वाप्स॒रसां॑ श॒तम्",
   "श॒तं श॑श्व॒न्वती॑नां श॒तवा॑रेण वारये"
  ],
  "lines_iast": [
   "śa̱tama̱haṃ du̱rṇāmnī̭nāṃ gandharvāpsa̱rasā̭ṃ śa̱tam",
   "śa̱taṃ śa̭śva̱nvatī̭nāṃ śa̱tavā̭reṇa vāraye"
  ],
