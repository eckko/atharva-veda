 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "019.036.3a",
   "019.036.3b"
  ],
  "lines_deva": [
   "ये यक्ष्मा॑सो अर्भ॒का म॒हान्तो॒ ये च॑ श॒ब्दिनः॑",
   "सर्वा॑न् दुर्णाम॒हा म॒णिः श॒तवा॑रो अनीनशत्"
  ],
  "lines_iast": [
   "ye yakṣmā̭so arbha̱kā ma̱hānto̱ ye ca̭ śa̱bdina̭ḥ",
   "sarvā̭n durṇāma̱hā ma̱ṇiḥ śa̱tavā̭ro anīnaśat"
  ],
  "book_split": [
