[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "019.036.1a",
   "019.036.1b"
  ],
  "lines_deva": [
   "श॒तवा॑रो अनीनश॒द् यक्ष्मा॒न् रक्षां॑सि॒ तेज॑सा",
   "आ॒रोह॒न् वर्च॑सा स॒ह म॒णिर्दु॑र्णाम॒चात॑नः"
  ],
  "lines_iast": [
   "śa̱tavā̭ro anīnaśa̱d yakṣmā̱n rakṣā̭ṃsi̱ teja̭sā",
   "ā̱roha̱n varca̭sā sa̱ha ma̱ṇirdṷrṇāma̱cāta̭naḥ"
  ],
  "book_split": [
