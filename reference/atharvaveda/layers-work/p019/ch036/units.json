 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "019.036.4a",
   "019.036.4b"
  ],
  "lines_deva": [
   "श॒तं वी॒रान॑जनयच्छ॒तं यक्ष्मा॒नपा॑वपत्",
   "दु॒र्णाम्नः॒ सर्वा॑न् ह॒त्वाव॒ रक्षां॑सि धूनुते"
  ],
  "lines_iast": [
   "śa̱taṃ vī̱rāna̭janayaccha̱taṃ yakṣmā̱napā̭vapat",
   "du̱rṇāmna̱ḥ sarvā̭n ha̱tvāva̱ rakṣā̭ṃsi dhūnute"
  ],
