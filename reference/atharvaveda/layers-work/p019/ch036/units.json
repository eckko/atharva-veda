 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.036.2a",
   "019.036.2b"
  ],
  "lines_deva": [
   "शॄङ्गा॑भ्यां॒ रक्षो॑ नुदते॒ मूले॑न यातुधा॒न्यः",
   "मध्ये॑न॒ यक्ष्मं॑ बाधते॒ नैनं॑ पा॒प्माति॑ तत्रति"
  ],
  "lines_iast": [
   "śṝṅgā̭bhyā̱ṃ rakṣo̭ nudate̱ mūlḙna yātudhā̱nyaḥ",
   "madhyḙna̱ yakṣma̭ṃ bādhate̱ naina̭ṃ pā̱pmāti̭ tatrati"
  ],
  "book_split": [
