   "019.036.5b"
  ],
  "lines_deva": [
   "हिर॑ण्यशृङ्ग ऋष॒भः शा॑तवा॒रो अ॒यं म॒णिः",
   "दु॒र्णाम्नः॒ सर्वां॑स्तृ॒ड्ढ्वाव॒ रक्षां॑स्यक्रमीत्"
  ],
  "lines_iast": [
   "hira̭ṇyaśṛṅga ṛṣa̱bhaḥ śā̭tavā̱ro a̱yaṃ ma̱ṇiḥ",
   "du̱rṇāmna̱ḥ sarvā̭ṃstṛ̱ḍḍhvāva̱ rakṣā̭ṃsyakramīt"
  ],
