  "lines_deva": [
   "प्राण॑ प्रा॒णं त्रा॑य॒स्वासो॒ अस॑वे मृड",
   "निरृ॑ते॒ निरृ॑त्या नः॒ पाशे॑भ्यो मुञ्च"
  ],
  "lines_iast": [
   "prāṇa̭ prā̱ṇaṃ trā̭ya̱svāso̱ asa̭ve mṛḍa",
   "nirṛ̭te̱ nirṛ̭tyā na̱ḥ pāśḙbhyo muñca"
  ],
