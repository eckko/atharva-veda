   "019.044.1b"
  ],
  "lines_deva": [
   "आयु॑षोऽसि प्र॒तर॑णं॒ विप्रं॑ भेष॒जमु॑च्यसे",
   "तदा॑ञ्जन॒ त्वं शं॑ताते॒ शमापो॒ अभ॑यं कृतम्"
  ],
  "lines_iast": [
   "āyṷṣo'si pra̱tara̭ṇa̱ṃ vipra̭ṃ bheṣa̱jamṷcyase",
   "tadā̭ñjana̱ tvaṃ śa̭ṃtāte̱ śamāpo̱ abha̭yaṃ kṛtam"
  ],
