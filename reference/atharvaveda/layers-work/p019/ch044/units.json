   "019.044.2b"
  ],
  "lines_deva": [
   "यो ह॑रि॒मा जा॒यान्यो॑ऽङ्गभे॒दो वि॒सल्प॑कः",
   "सर्वं॑ ते॒ यक्ष्म॒मङ्गे॑भ्यो ब॒हिर्नि॑र्ह॒न्त्वाञ्ज॑नम्"
  ],
  "lines_iast": [
   "yo ha̭ri̱mā jā̱yānyo̭'ṅgabhe̱do vi̱salpa̭kaḥ",
   "sarva̭ṃ te̱ yakṣma̱maṅgḙbhyo ba̱hirni̭rha̱ntvāñja̭nam"
  ],
