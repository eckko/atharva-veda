 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.030.2a",
   "019.030.2b"
  ],
  "lines_deva": [
   "श॒तं ते॑ दर्भ॒ वर्मा॑णि स॒हस्रं॑ वी॒र्या॑णि ते",
   "तम॒स्मै विश्वे॒ त्वां दे॒वा ज॒रसे॒ भर्त॒वा अ॑दुः"
  ],
  "lines_iast": [
   "śa̱taṃ tḙ darbha̱ varmā̭ṇi sa̱hasra̭ṃ vī̱ryā̭ṇi te",
   "tama̱smai viśve̱ tvāṃ de̱vā ja̱rase̱ bharta̱vā a̭duḥ"
  ],
