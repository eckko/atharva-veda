   "019.030.4a",
   "019.030.4b"
  ],
  "lines_deva": [
   "स॒प॒त्न॒क्षय॑णं दर्भ द्विष॒तस्तप॑नं हृ॒दः",
   "म॒णिं क्ष॒त्रस्य॒ वर्ध॑नं तनू॒पानं॑ कृणोमि ते"
  ],
  "lines_iast": [
   "sa̱pa̱tna̱kṣaya̭ṇaṃ darbha dviṣa̱tastapa̭naṃ hṛ̱daḥ",
   "ma̱ṇiṃ kṣa̱trasya̱ vardha̭naṃ tanū̱pāna̭ṃ kṛṇomi te"
  ],
