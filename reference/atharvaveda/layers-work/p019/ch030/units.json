   "019.030.1a",
   "019.030.1b"
  ],
  "lines_deva": [
   "यत् ते॑ दर्भ ज॒रामृ॑त्युः श॒तं वर्म॑सु॒ वर्म॑ ते",
   "तेने॒मं व॒र्मिणं॑ कृ॒त्वा स॒पत्नां॑ जहि वी॒र्यैः"
  ],
  "lines_iast": [
   "yat tḙ darbha ja̱rāmṛ̭tyuḥ śa̱taṃ varma̭su̱ varma̭ te",
   "tene̱maṃ va̱rmiṇa̭ṃ kṛ̱tvā sa̱patnā̭ṃ jahi vī̱ryaiḥ"
  ],
