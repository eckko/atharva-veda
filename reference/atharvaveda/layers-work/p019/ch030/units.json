   "019.030.3b"
  ],
  "lines_deva": [
   "त्वामा॑हुर्देव॒वर्म॒ त्वां द॑र्भ॒ ब्रह्म॑ण॒स्पति॑म्",
   "त्वामिन्द्र॑स्याहु॒र्वर्म॒ त्वं रा॒ष्ट्राणि॑ रक्षसि"
  ],
  "lines_iast": [
   "tvāmā̭hurdeva̱varma̱ tvāṃ da̭rbha̱ brahma̭ṇa̱spati̭m",
   "tvāmindra̭syāhu̱rvarma̱ tvaṃ rā̱ṣṭrāṇi̭ rakṣasi"
  ],
