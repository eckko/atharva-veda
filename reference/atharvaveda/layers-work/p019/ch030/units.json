  "lines_deva": [
   "यत् स॑मु॒द्रो अ॒भ्यक्र॑न्दत् प॒र्जन्यो॑ वि॒द्युता॑ स॒ह",
   "ततो॑ हिर॒ण्ययो॑ बि॒न्दुस्ततो॑ द॒र्भो अ॑जायत"
  ],
  "lines_iast": [
   "yat sa̭mu̱dro a̱bhyakra̭ndat pa̱rjanyo̭ vi̱dyutā̭ sa̱ha",
   "tato̭ hira̱ṇyayo̭ bi̱ndustato̭ da̱rbho a̭jāyata"
  ],
