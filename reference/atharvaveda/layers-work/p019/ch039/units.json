   "019.039.2c"
  ],
  "lines_deva": [
   "त्रीणि॑ ते कुष्ठ॒ नामा॑नि नद्यमा॒रो न॒द्यारि॑षः",
   "नद्या॒यं पुरु॑षो रिषत्",
   "यस्मै॑ परि॒ब्रवी॑मि त्वा सा॒यंप्रा॑त॒रथो॒ दिवा॑"
  ],
  "lines_iast": [
   "trīṇi̭ te kuṣṭha̱ nāmā̭ni nadyamā̱ro na̱dyāri̭ṣaḥ",
   "nadyā̱yaṃ purṷṣo riṣat",
   "yasmai̭ pari̱bravī̭mi tvā sā̱yaṃprā̭ta̱ratho̱ divā̭"
  ],
