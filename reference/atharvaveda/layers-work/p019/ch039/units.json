   "019.039.5d"
  ],
  "lines_deva": [
   "त्रिः शाम्बु॑भ्यो॒ अङ्गि॑रेभ्य॒स्त्रिरा॑दि॒त्येभ्य॒स्परि॑",
   "त्रिर्जा॒तो वि॒श्वदे॑वेभ्यः",
   "स कुष्ठो॑ वि॒श्वभे॑षजः सा॒कं सोमे॑न तिष्ठति",
   "त॒क्मानं॒ सर्वं॑ नाशय॒ सर्वा॑श्च यातुधा॒न्यः"
  ],
  "lines_iast": [
   "triḥ śāmbṷbhyo̱ aṅgi̭rebhya̱strirā̭di̱tyebhya̱spari̭",
   "trirjā̱to vi̱śvadḙvebhyaḥ",
   "sa kuṣṭho̭ vi̱śvabhḙṣajaḥ sā̱kaṃ somḙna tiṣṭhati",
   "ta̱kmāna̱ṃ sarva̭ṃ nāśaya̱ sarvā̭śca yātudhā̱nyaḥ"
  ],
