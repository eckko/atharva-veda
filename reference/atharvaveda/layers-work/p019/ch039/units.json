   "019.039.9b"
  ],
  "lines_deva": [
   "यं त्वा॒ वेद॒ पूर्व॒ इक्ष्वा॑को॒ यं वा॑ त्वा कुष्ठ का॒म्यः",
   "यं वा॒ वसो॑ यमात्स्य॒स्तेनासि॑ वि॒श्वभे॑षजः"
  ],
  "lines_iast": [
   "yaṃ tvā̱ veda̱ pūrva̱ ikṣvā̭ko̱ yaṃ vā̭ tvā kuṣṭha kā̱myaḥ",
   "yaṃ vā̱ vaso̭ yamātsya̱stenāsi̭ vi̱śvabhḙṣajaḥ"
  ],
