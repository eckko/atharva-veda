  "lines_deva": [
   "ऐतु॑ दे॒वस्त्राय॑माणः॒ कुष्ठो॑ हि॒मव॑त॒स्परि॑",
   "त॒क्मानं॒ सर्वं॑ नाशय॒ सर्वा॑श्च यातुधा॒न्यः"
  ],
  "lines_iast": [
   "aitṷ de̱vastrāya̭māṇa̱ḥ kuṣṭho̭ hi̱mava̭ta̱spari̭",
   "ta̱kmāna̱ṃ sarva̭ṃ nāśaya̱ sarvā̭śca yātudhā̱nyaḥ"
  ],
