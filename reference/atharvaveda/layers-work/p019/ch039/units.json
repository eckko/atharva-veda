  "lines_deva": [
   "अ॒श्व॒त्थो दे॑व॒सद॑नस्तृ॒तीय॑स्यामि॒तो दि॒वि",
   "तत्रा॒मृत॑स्य॒ चक्ष॑णं॒ ततः॒ कुष्ठो॑ अजायत",
   "स कुष्ठो॑ वि॒श्वभे॑षजः सा॒कं सोमे॑न तिष्ठति",
   "त॒क्मानं॒ सर्वं॑ नाशय॒ सर्वा॑श्च यातुधा॒न्यः"
  ],
  "lines_iast": [
   "a̱śva̱ttho dḙva̱sada̭nastṛ̱tīya̭syāmi̱to di̱vi",
   "tatrā̱mṛta̭sya̱ cakṣa̭ṇa̱ṃ tata̱ḥ kuṣṭho̭ ajāyata",
   "sa kuṣṭho̭ vi̱śvabhḙṣajaḥ sā̱kaṃ somḙna tiṣṭhati",
   "ta̱kmāna̱ṃ sarva̭ṃ nāśaya̱ sarvā̭śca yātudhā̱nyaḥ"
  ],
