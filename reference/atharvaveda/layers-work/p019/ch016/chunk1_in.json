  "lines_deva": [
   "अ॒स॒प॒त्नं पु॒रस्ता॑त् प॒श्चान्नो॒ अभ॑यं कृतम्",
   "स॒वि॒ता मा॑ दक्षिण॒त उ॑त्त॒रान्मा॒ शची॒पतिः॑"
  ],
  "lines_iast": [
   "a̱sa̱pa̱tnaṃ pu̱rastā̭t pa̱ścānno̱ abha̭yaṃ kṛtam",
   "sa̱vi̱tā mā̭ dakṣiṇa̱ta ṷtta̱rānmā̱ śacī̱pati̭ḥ"
  ],
