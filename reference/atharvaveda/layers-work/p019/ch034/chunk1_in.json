   "019.034.3b"
  ],
  "lines_deva": [
   "अ॒र॒सं कृ॒त्रिमं॑ ना॒दम॑र॒साः स॒प्त विस्र॑सः",
   "अपे॒तो ज॑ङ्गि॒डाम॑ति॒मिषु॒मस्ते॑व शातय"
  ],
  "lines_iast": [
   "a̱ra̱saṃ kṛ̱trima̭ṃ nā̱dama̭ra̱sāḥ sa̱pta visra̭saḥ",
   "ape̱to ja̭ṅgi̱ḍāma̭ti̱miṣu̱mastḙva śātaya"
  ],
