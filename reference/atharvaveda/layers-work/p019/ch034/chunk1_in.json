   "019.034.5b"
  ],
  "lines_deva": [
   "स ज॑ङ्गि॒डस्य॑ महि॒मा परि॑ णः पातु वि॒श्वतः॑",
   "विष्क॑न्धं॒ येन॑ सा॒सह॒ संस्क॑न्ध॒मोज॒ ओज॑सा"
  ],
  "lines_iast": [
   "sa ja̭ṅgi̱ḍasya̭ mahi̱mā pari̭ ṇaḥ pātu vi̱śvata̭ḥ",
   "viṣka̭ndha̱ṃ yena̭ sā̱saha̱ saṃska̭ndha̱moja̱ oja̭sā"
  ],
