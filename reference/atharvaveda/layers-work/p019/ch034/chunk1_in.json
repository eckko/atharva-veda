  "lines_deva": [
   "अथो॑पदान भगवो॒ जाङ्गि॒डामि॑तवीर्य",
   "पु॒रा त॑ उ॒ग्रा ग्र॑सत॒ उपेन्द्रो॑ वी॒र्यं ददौ"
  ],
  "lines_iast": [
   "atho̭padāna bhagavo̱ jāṅgi̱ḍāmi̭tavīrya",
   "pu̱rā ta̭ u̱grā gra̭sata̱ upendro̭ vī̱ryaṃ dadau"
  ],
