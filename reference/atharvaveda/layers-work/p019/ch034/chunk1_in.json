  "lines_deva": [
   "कृ॒त्या॒दूष॑ण ए॒वायमथो॑ अराति॒दूष॑णः",
   "अथो॒ सह॑स्वां जङ्गि॒डः प्र ण आयूं॑षि तारिषत्"
  ],
  "lines_iast": [
   "kṛ̱tyā̱dūṣa̭ṇa e̱vāyamatho̭ arāti̱dūṣa̭ṇaḥ",
   "atho̱ saha̭svāṃ jaṅgi̱ḍaḥ pra ṇa āyṷ̄ṃṣi tāriṣat"
  ],
