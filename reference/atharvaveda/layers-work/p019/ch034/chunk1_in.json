   "019.034.1b"
  ],
  "lines_deva": [
   "जा॒ङ्गि॒डोऽसि जङ्गि॒डो रक्षि॑तासि जङ्गि॒डः",
   "द्वि॒पाच्चतु॑ष्पाद॒स्माकं॒ सर्वं॑ रक्षतु जङ्गि॒डः"
  ],
  "lines_iast": [
   "jā̱ṅgi̱ḍo'si jaṅgi̱ḍo rakṣi̭tāsi jaṅgi̱ḍaḥ",
   "dvi̱pāccatṷṣpāda̱smāka̱ṃ sarva̭ṃ rakṣatu jaṅgi̱ḍaḥ"
  ],
