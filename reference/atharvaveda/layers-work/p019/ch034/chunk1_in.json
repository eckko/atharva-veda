  "lines_deva": [
   "त्रिष्ट्वा॑ दे॒वा अ॑जनय॒न् निष्ठि॑तं॒ भूम्या॒मधि॑",
   "तमु॒ त्वाङ्गि॑रा॒ इति॑ ब्राह्म॒णाः पू॒र्व्या वि॑दुः"
  ],
  "lines_iast": [
   "triṣṭvā̭ de̱vā a̭janaya̱n niṣṭhi̭ta̱ṃ bhūmyā̱madhi̭",
   "tamu̱ tvāṅgi̭rā̱ iti̭ brāhma̱ṇāḥ pū̱rvyā vi̭duḥ"
  ],
