  "lines_deva": [
   "न त्वा॒ पूर्वा॒ ओष॑धयो॒ न त्वा॑ तरन्ति॒ या नवाः॑",
   "विबा॑ध उ॒ग्रो ज॑ङ्गि॒डः प॑रि॒पाणः॑ सुम॒ङ्गलः॑"
  ],
  "lines_iast": [
   "na tvā̱ pūrvā̱ oṣa̭dhayo̱ na tvā̭ taranti̱ yā navā̭ḥ",
   "vibā̭dha u̱gro ja̭ṅgi̱ḍaḥ pa̭ri̱pāṇa̭ḥ suma̱ṅgala̭ḥ"
  ],
