   "019.022.21a",
   "019.022.21b"
  ],
  "lines_deva": [
   "ब्रह्म॑ज्येष्ठा॒ संभृ॑ता वि॒र्याऽणि॒ ब्रह्माग्रे॒ ज्येष्ठं॒ दिव॒मा त॑तान",
   "भूतानां॑ ब्र॒ह्मा प्र॑थ॒मोत॑ जज्ञे॒ तेना॑र्हति॒ ब्रह्म॑णा॒ स्पर्धि॑तुं॒ कः"
  ],
  "lines_iast": [
   "brahma̭jyeṣṭhā̱ saṃbhṛ̭tā vi̱ryā'ṇi̱ brahmāgre̱ jyeṣṭha̱ṃ diva̱mā ta̭tāna",
   "bhūtānā̭ṃ bra̱hmā pra̭tha̱mota̭ jajñe̱ tenā̭rhati̱ brahma̭ṇā̱ spardhi̭tu̱ṃ kaḥ"
  ],
