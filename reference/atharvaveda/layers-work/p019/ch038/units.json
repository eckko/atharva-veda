 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.038.2a",
   "019.038.2b"
  ],
  "lines_deva": [
   "विष्व॑ञ्च॒स्तस्मा॒द् यक्ष्मा॑ मृ॒गा अश्वा॑ इवेरते",
   "यद् गु॑ल्गु॒लु सै॑न्ध॒वं यद् वाप्यासि॑ समु॒द्रिय॑म्"
  ],
  "lines_iast": [
   "viṣva̭ñca̱stasmā̱d yakṣmā̭ mṛ̱gā aśvā̭ iverate",
   "yad gṷlgu̱lu sai̭ndha̱vaṃ yad vāpyāsi̭ samu̱driya̭m"
  ],
