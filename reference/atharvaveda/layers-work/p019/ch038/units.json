   "019.038.1a",
   "019.038.1b"
  ],
  "lines_deva": [
   "न तं यक्ष्मा॒ अरु॑न्धते॒ नैनं॑ श॒पथो॑ अश्नुते",
   "यं भे॑ष॒जस्य॑ गुल्गु॒लोः सु॑र॒भिर्ग॒न्धो अ॑श्नु॒ते"
  ],
  "lines_iast": [
   "na taṃ yakṣmā̱ arṷndhate̱ naina̭ṃ śa̱patho̭ aśnute",
   "yaṃ bhḙṣa̱jasya̭ gulgu̱loḥ sṷra̱bhirga̱ndho a̭śnu̱te"
  ],
