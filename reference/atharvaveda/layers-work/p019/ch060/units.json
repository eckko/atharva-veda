   "019.060.2b"
  ],
  "lines_deva": [
   "ऊ॒र्वोरोजो॒ जङ्घ॑योर्ज॒वः पाद॑योः",
   "प्र॒ति॒ष्ठा अरि॑ष्टानि मे॒ सर्वा॒त्मानि॑भृष्टः"
  ],
  "lines_iast": [
   "ū̱rvorojo̱ jaṅgha̭yorja̱vaḥ pāda̭yoḥ",
   "pra̱ti̱ṣṭhā ari̭ṣṭāni me̱ sarvā̱tmāni̭bhṛṣṭaḥ"
  ],
