  "lines_deva": [
   "वाङ् म॑ आ॒सन् न॒सोः प्रा॒णश्चक्षु॑र॒क्ष्णोः श्रोत्रं॒ कर्ण॑योः",
   "अप॑लिताः॒ केशा॒ अशो॑णा॒ दन्ता॑ ब॒हु बा॒ह्वोर्बल॑म्"
  ],
  "lines_iast": [
   "vāṅ ma̭ ā̱san na̱soḥ prā̱ṇaścakṣṷra̱kṣṇoḥ śrotra̱ṃ karṇa̭yoḥ",
   "apa̭litā̱ḥ keśā̱ aśo̭ṇā̱ dantā̭ ba̱hu bā̱hvorbala̭m"
  ],
