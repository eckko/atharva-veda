   "019.064.1a",
   "019.064.1b"
  ],
  "lines_deva": [
   "अग्ने॑ स॒मिध॒माहा॑र्षं बृह॒ते जा॒तवे॑दसे",
   "स मे॑ श्र॒द्धां च॑ मे॒धां च॑ जा॒तवे॑दाः॒ प्र य॑च्छतु"
  ],
  "lines_iast": [
   "agnḙ sa̱midha̱māhā̭rṣaṃ bṛha̱te jā̱tavḙdase",
   "sa mḙ śra̱ddhāṃ ca̭ me̱dhāṃ ca̭ jā̱tavḙdā̱ḥ pra ya̭cchatu"
  ],
