 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "019.064.3a",
   "019.064.3b"
  ],
  "lines_deva": [
   "यद॑ग्ने॒ यानि॒ कानि॑ चि॒दा ते॒ दारू॑णि द॒ध्मसि॑",
   "सर्वं॒ तद॑स्तु मे शि॒वं तज्जु॑षस्व यविष्ठ्य"
  ],
  "lines_iast": [
   "yada̭gne̱ yāni̱ kāni̭ ci̱dā te̱ dārṷ̄ṇi da̱dhmasi̭",
   "sarva̱ṃ tada̭stu me śi̱vaṃ tajjṷṣasva yaviṣṭhya"
  ],
