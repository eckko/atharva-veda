 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.064.2a",
   "019.064.2b"
  ],
  "lines_deva": [
   "इ॒ध्मेन॑ त्वा जातवेदः स॒मिधा॑ वर्धयामसि",
   "तथा॒ त्वम॒स्मान् व॑र्धय प्र॒जया॑ च॒ धने॑न च"
  ],
  "lines_iast": [
   "i̱dhmena̭ tvā jātavedaḥ sa̱midhā̭ vardhayāmasi",
   "tathā̱ tvama̱smān va̭rdhaya pra̱jayā̭ ca̱ dhanḙna ca"
  ],
