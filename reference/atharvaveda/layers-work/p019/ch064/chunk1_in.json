   "019.064.4b"
  ],
  "lines_deva": [
   "ए॒तास्ते॑ अग्ने स॒मिध॒स्त्वमि॒द्धः स॒मिद् भव",
   "आयु॑र॒स्मासु॑ धेह्यमृत॒त्वमा॑चा॒र्याय"
  ],
  "lines_iast": [
   "e̱tāstḙ agne sa̱midha̱stvami̱ddhaḥ sa̱mid bhava",
   "āyṷra̱smāsṷ dhehyamṛta̱tvamā̭cā̱ryāya"
  ],
