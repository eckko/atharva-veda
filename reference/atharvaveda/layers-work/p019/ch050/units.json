  "lines_deva": [
   "उ॒षसे॑ नः॒ परि॑ देहि॒ सर्वा॒न् रात्र्य॑ना॒गसः॑",
   "उ॒षा नो॒ अह्ने॒ आ भ॑जा॒दह॒स्तुभ्यं॑ विभावरि"
  ],
  "lines_iast": [
   "u̱ṣasḙ na̱ḥ pari̭ dehi̱ sarvā̱n rātrya̭nā̱gasa̭ḥ",
   "u̱ṣā no̱ ahne̱ ā bha̭jā̱daha̱stubhya̭ṃ vibhāvari"
  ],
