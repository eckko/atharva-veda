  "lines_deva": [
   "यथा॑ शा॒म्याकः॑ प्र॒पत॑न्नप॒वान् नानु॑वि॒द्यते॑",
   "ए॒वा रा॑त्रि॒ प्र पा॑तय॒ यो अ॒स्मां अ॑भ्यघा॒यति"
  ],
  "lines_iast": [
   "yathā̭ śā̱myāka̭ḥ pra̱pata̭nnapa̱vān nānṷvi̱dyatḙ",
   "e̱vā rā̭tri̱ pra pā̭taya̱ yo a̱smāṃ a̭bhyaghā̱yati"
  ],
