  "lines_deva": [
   "रात्रिं॑रात्रि॒मरि॑ष्यन्त॒स्तरे॑म त॒न्वा व॒यम्",
   "ग॒म्भी॒रमप्ल॑वा इव॒ न त॑रेयु॒ररा॑तयः"
  ],
  "lines_iast": [
   "rātri̭ṃrātri̱mari̭ṣyanta̱starḙma ta̱nvā va̱yam",
   "ga̱mbhī̱ramapla̭vā iva̱ na ta̭reyu̱rarā̭tayaḥ"
  ],
