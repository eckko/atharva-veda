   "019.050.1b"
  ],
  "lines_deva": [
   "अध॑ रात्रि तृ॒ष्टधू॑ममशी॒र्षाण॒महिं॑ कृणु",
   "अ॒क्षौ वृक॑स्य॒ निर्ज॑ह्या॒स्तेन॒ तं द्रु॑प॒दे ज॑हि"
  ],
  "lines_iast": [
   "adha̭ rātri tṛ̱ṣṭadhṷ̄mamaśī̱rṣāṇa̱mahi̭ṃ kṛṇu",
   "a̱kṣau vṛka̭sya̱ nirja̭hyā̱stena̱ taṃ drṷpa̱de ja̭hi"
  ],
