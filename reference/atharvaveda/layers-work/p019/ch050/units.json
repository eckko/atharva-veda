   "019.050.2b"
  ],
  "lines_deva": [
   "ये ते॑ रात्र्यन॒ड्वाह॒स्तीक्ष्ण॑शृङ्गाः स्वा॒शवः॑",
   "तेभि॑र्नो अ॒द्य पा॑र॒याति॑ दु॒र्गाणि॑ वि॒श्वहा॑"
  ],
  "lines_iast": [
   "ye tḙ rātryana̱ḍvāha̱stīkṣṇa̭śṛṅgāḥ svā̱śava̭ḥ",
   "tebhi̭rno a̱dya pā̭ra̱yāti̭ du̱rgāṇi̭ vi̱śvahā̭"
  ],
