  "lines_deva": [
   "अप॑ स्ते॒नं वासो॑ गोअ॒जमु॒त तस्क॑रम्",
   "अथो॒ यो अर्व॑तः॒ शिरो॑ऽभि॒धाय॒ निनी॑षति"
  ],
  "lines_iast": [
   "apa̭ ste̱naṃ vāso̭ goa̱jamu̱ta taska̭ram",
   "atho̱ yo arva̭ta̱ḥ śiro̭'bhi̱dhāya̱ ninī̭ṣati"
  ],
