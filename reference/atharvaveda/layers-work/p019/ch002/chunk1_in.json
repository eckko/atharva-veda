   "019.002.4b"
  ],
  "lines_deva": [
   "अ॒पामह॑ दि॒व्याऽनाम॒पां स्रो॑त॒स्याऽनाम्",
   "अ॒पामह॑ प्र॒णेज॒नेऽश्वा॑ भवथ वा॒जिनः॑"
  ],
  "lines_iast": [
   "a̱pāmaha̭ di̱vyā'nāma̱pāṃ sro̭ta̱syā'nām",
   "a̱pāmaha̭ pra̱ṇeja̱ne'śvā̭ bhavatha vā̱jina̭ḥ"
  ],
