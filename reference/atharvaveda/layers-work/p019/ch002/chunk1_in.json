   "019.002.1a",
   "019.002.1b"
  ],
  "lines_deva": [
   "शं त॒ आपो॑ हैमव॒तीः शमु॑ ते सन्तू॒त्स्याः",
   "शं ते॑ सनि॒ष्यदा॒ आपः॒ शमु॑ ते सन्तु व॒र्ष्याः"
  ],
  "lines_iast": [
   "śaṃ ta̱ āpo̭ haimava̱tīḥ śamṷ te santū̱tsyāḥ",
   "śaṃ tḙ sani̱ṣyadā̱ āpa̱ḥ śamṷ te santu va̱rṣyāḥ"
  ],
