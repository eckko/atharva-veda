  "lines_deva": [
   "शं त॒ आपो॑ धन्व॒न्याः॒३ शं ते॑ सन्त्वनू॒प्याः",
   "शं ते॑ खनि॒त्रिमा॒ आपः॒ शं याः कु॒म्भेभि॒राभृ॑ताः"
  ],
  "lines_iast": [
   "śaṃ ta̱ āpo̭ dhanva̱nyā̱ḥ3 śaṃ tḙ santvanū̱pyāḥ",
   "śaṃ tḙ khani̱trimā̱ āpa̱ḥ śaṃ yāḥ ku̱mbhebhi̱rābhṛ̭tāḥ"
  ],
