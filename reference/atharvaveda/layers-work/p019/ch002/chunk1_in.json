   "019.002.5b"
  ],
  "lines_deva": [
   "ता अ॒पः शि॒वा अ॒पोऽय॑क्ष्मं॒कर॑णीर॒पः",
   "यथै॒व तृ॑प्यते॒ मय॒स्तास्त॒ आ द॑त्त भेष॒जीः"
  ],
  "lines_iast": [
   "tā a̱paḥ śi̱vā a̱po'ya̭kṣma̱ṃkara̭ṇīra̱paḥ",
   "yathai̱va tṛ̭pyate̱ maya̱stāsta̱ ā da̭tta bheṣa̱jīḥ"
  ],
