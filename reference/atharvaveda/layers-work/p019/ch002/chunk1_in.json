   "019.002.3b"
  ],
  "lines_deva": [
   "अ॒न॒भ्रयः॒ खन॑माना॒ विप्रा॑ गम्भी॒रे अ॒पसः॑",
   "भि॒षग्भ्यो॑ भि॒षक्त॑रा॒ आपो॒ अच्छा॑ वदामसि"
  ],
  "lines_iast": [
   "a̱na̱bhraya̱ḥ khana̭mānā̱ viprā̭ gambhī̱re a̱pasa̭ḥ",
   "bhi̱ṣagbhyo̭ bhi̱ṣakta̭rā̱ āpo̱ acchā̭ vadāmasi"
  ],
