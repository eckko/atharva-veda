  "lines_deva": [
   "त्वामि॑न्द्रा पुरुहूत॒ विश्व॒मायु॒र्व्यश्नवन्",
   "अह॑रहर्ब॒लिमित् ते॒ हर॒न्तोऽश्वा॑येव॒ तिष्ठ॑ते घा॒सम॑ग्ने"
  ],
  "lines_iast": [
   "tvāmi̭ndrā puruhūta̱ viśva̱māyu̱rvyaśnavan",
   "aha̭raharba̱limit te̱ hara̱nto'śvā̭yeva̱ tiṣṭha̭te ghā̱sama̭gne"
  ],
