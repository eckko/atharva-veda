   "019.055.3b"
  ],
  "lines_deva": [
   "सा॒यंसा॑यं गृ॒हप॑तिर्नो अ॒ग्निः प्रा॒तःप्रा॑तः सौमन॒सस्य॑ दा॒ता",
   "वसो॑र्वसोर्वसु॒दान॑ एधि व॒यं त्वेन्धा॑नास्त॒न्वं पुषेम"
  ],
  "lines_iast": [
   "sā̱yaṃsā̭yaṃ gṛ̱hapa̭tirno a̱gniḥ prā̱taḥprā̭taḥ saumana̱sasya̭ dā̱tā",
   "vaso̭rvasorvasu̱dāna̭ edhi va̱yaṃ tvendhā̭nāsta̱nvaṃ puṣema"
  ],
