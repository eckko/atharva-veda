   "019.055.1a",
   "019.055.1b"
  ],
  "lines_deva": [
   "रात्रिं॑रात्रि॒मप्र॑यातं॒ भर॒न्तोऽश्वा॑येव॒ तिष्ठ॑ते घा॒सम॒स्मै",
   "रा॒यस्पोषे॑ण॒ समि॒षा मद॑न्तो॒ मा ते॑ अग्ने॒ प्रति॑वेशा रिषाम"
  ],
  "lines_iast": [
   "rātri̭ṃrātri̱mapra̭yāta̱ṃ bhara̱nto'śvā̭yeva̱ tiṣṭha̭te ghā̱sama̱smai",
   "rā̱yaspoṣḙṇa̱ sami̱ṣā mada̭nto̱ mā tḙ agne̱ prati̭veśā riṣāma"
  ],
