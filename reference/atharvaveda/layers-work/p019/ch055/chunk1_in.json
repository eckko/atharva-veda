   "019.055.5b",
   "019.055.5c"
  ],
  "lines_deva": [
   "अप॑श्चा द॒ग्धान्न॑स्य भूयासम्",
   "अ॒न्ना॒दायान्न॑पतये रु॒द्राय॒ नमो॑ अ॒ग्नये॑",
   "स॒भ्यः स॒भां मे॑ पाहि॒ ये च॑ स॒भ्याः स॑भा॒सदः॑"
  ],
  "lines_iast": [
   "apa̭ścā da̱gdhānna̭sya bhūyāsam",
   "a̱nnā̱dāyānna̭pataye ru̱drāya̱ namo̭ a̱gnayḙ",
   "sa̱bhyaḥ sa̱bhāṃ mḙ pāhi̱ ye ca̭ sa̱bhyāḥ sa̭bhā̱sada̭ḥ"
  ],
