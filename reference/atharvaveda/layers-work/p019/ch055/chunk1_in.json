 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "019.055.2a",
   "019.055.2b"
  ],
  "lines_deva": [
   "या ते॒ वसो॒र्वात॒ इषुः॒ सा त॑ ए॒षा तया॑ नो मृड",
   "रा॒यस्पोषे॑ण॒ समि॒षा मद॑न्तो॒ मा ते॑ अग्ने॒ प्रति॑वेशा रिषाम"
  ],
  "lines_iast": [
   "yā te̱ vaso̱rvāta̱ iṣu̱ḥ sā ta̭ e̱ṣā tayā̭ no mṛḍa",
   "rā̱yaspoṣḙṇa̱ sami̱ṣā mada̭nto̱ mā tḙ agne̱ prati̭veśā riṣāma"
  ],
