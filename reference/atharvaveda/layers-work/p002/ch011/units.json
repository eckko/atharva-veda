   "002.011.4b"
  ],
  "lines_deva": [
   "सू॒रिर॑सि वर्चो॒धा अ॑सि तनू॒पानोऽसि",
   "आ॒प्नु॒हि श्रेयां॑स॒मति॑ स॒मं क्रा॑म"
  ],
  "lines_iast": [
   "sū̱rira̭si varco̱dhā a̭si tanū̱pāno'si",
   "ā̱pnu̱hi śreyā̭ṃsa̱mati̭ sa̱maṃ krā̭ma"
  ],
