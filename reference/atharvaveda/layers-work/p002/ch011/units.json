   "002.011.1a",
   "002.011.1b"
  ],
  "lines_deva": [
   "दूष्या॒ दूषि॑रसि हे॒त्या हे॒तिर॑सि मे॒न्या मे॒निर॑सि",
   "आ॒प्नु॒हि श्रेयां॑स॒मति॑ स॒मं क्रा॑म"
  ],
  "lines_iast": [
   "dūṣyā̱ dūṣi̭rasi he̱tyā he̱tira̭si me̱nyā me̱nira̭si",
   "ā̱pnu̱hi śreyā̭ṃsa̱mati̭ sa̱maṃ krā̭ma"
  ],
  "book_split": [
