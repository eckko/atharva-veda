   "002.011.3b"
  ],
  "lines_deva": [
   "प्रति॒ तम॒भि च॑र॒ यो॒ऽस्मान् द्वेष्टि॒ यं व॒यं द्वि॒ष्मः",
   "आ॒प्नु॒हि श्रेयां॑स॒मति॑ स॒मं क्रा॑म"
  ],
  "lines_iast": [
   "prati̱ tama̱bhi ca̭ra̱ yo̱'smān dveṣṭi̱ yaṃ va̱yaṃ dvi̱ṣmaḥ",
   "ā̱pnu̱hi śreyā̭ṃsa̱mati̭ sa̱maṃ krā̭ma"
  ],
