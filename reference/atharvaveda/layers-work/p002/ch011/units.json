   "002.011.2b"
  ],
  "lines_deva": [
   "स्र॒क्त्योऽसि प्रतिस॒रोऽसि प्रत्यभि॒चर॑णोऽसि",
   "आ॒प्नु॒हि श्रेयां॑स॒मति॑ स॒मं क्रा॑म"
  ],
  "lines_iast": [
   "sra̱ktyo'si pratisa̱ro'si pratyabhi̱cara̭ṇo'si",
   "ā̱pnu̱hi śreyā̭ṃsa̱mati̭ sa̱maṃ krā̭ma"
  ],
