   "002.031.2a",
   "002.031.2b"
  ],
  "lines_deva": [
   "दृ॒ष्टम॒दृष्ट॑मतृह॒मथो॑ कु॒रूरु॑मतृहम्",
   "अ॒ल्गण्डू॒न्त्सर्वा॑न् छ॒लुना॒न् क्रिमी॒न् वच॑सा जम्भयामसि"
  ],
  "lines_iast": [
   "dṛ̱ṣṭama̱dṛṣṭa̭matṛha̱matho̭ ku̱rūrṷmatṛham",
   "a̱lgaṇḍū̱ntsarvā̭n cha̱lunā̱n krimī̱n vaca̭sā jambhayāmasi"
  ],
