 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.031.3a",
   "002.031.3b"
  ],
  "lines_deva": [
   "अ॒ल्गण्डू॑न् हन्मि मह॒ता व॒धेन॑ दू॒ना अदू॑ना अर॒सा अ॑भूवन्",
   "शि॒ष्टानशि॑ष्टा॒न् नि ति॑रामि वा॒चा यथा॒ क्रिमी॑णां॒ नकि॑रु॒च्छिषा॑तै"
  ],
  "lines_iast": [
   "a̱lgaṇḍṷ̄n hanmi maha̱tā va̱dhena̭ dū̱nā adṷ̄nā ara̱sā a̭bhūvan",
   "śi̱ṣṭānaśi̭ṣṭā̱n ni ti̭rāmi vā̱cā yathā̱ krimī̭ṇā̱ṃ naki̭ru̱cchiṣā̭tai"
  ],
