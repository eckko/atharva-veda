  "lines_deva": [
   "इन्द्र॑स्य॒ या म॒ही दृ॒षत् क्रिमे॒र्विश्व॑स्य॒ तर्ह॑णी",
   "तया॑ पिनष्मि॒ सं क्रिमी॑न् दृ॒षदा॒ खल्वाँ॑ इव"
  ],
  "lines_iast": [
   "indra̭sya̱ yā ma̱hī dṛ̱ṣat krime̱rviśva̭sya̱ tarha̭ṇī",
   "tayā̭ pinaṣmi̱ saṃ krimī̭n dṛ̱ṣadā̱ khalvā̭~ iva"
  ],
