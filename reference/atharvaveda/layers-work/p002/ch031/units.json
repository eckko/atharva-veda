   "002.031.5b"
  ],
  "lines_deva": [
   "ये क्रिम॑यः॒ पर्व॑तेशु॒ वने॒ष्वोष॑धीषु प॒शुष्व॒प्स्व॑१न्तः",
   "ये अ॒स्माकं॑ त॒न्वऽमाविवि॒शुः सर्वं॒ तद्ध॑न्मि॒ जनि॑म॒ क्रिमी॑णाम्"
  ],
  "lines_iast": [
   "ye krima̭ya̱ḥ parva̭teśu̱ vane̱ṣvoṣa̭dhīṣu pa̱śuṣva̱psva̭1ntaḥ",
   "ye a̱smāka̭ṃ ta̱nva'māvivi̱śuḥ sarva̱ṃ taddha̭nmi̱ jani̭ma̱ krimī̭ṇām"
  ],
