 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.025.2a",
   "002.025.2b"
  ],
  "lines_deva": [
   "सह॑माने॒यं प्र॑थ॒मा पृ॑श्निप॒र्ण्यऽजायत",
   "तया॒हं दु॒र्णाम्नां॒ शिरो॑ वृ॒श्चामि॑ श॒कुने॑रिव"
  ],
  "lines_iast": [
   "saha̭māne̱yaṃ pra̭tha̱mā pṛ̭śnipa̱rṇya'jāyata",
   "tayā̱haṃ du̱rṇāmnā̱ṃ śiro̭ vṛ̱ścāmi̭ śa̱kunḙriva"
  ],
