   "002.025.5b"
  ],
  "lines_deva": [
   "परा॑च एना॒न् प्र णु॑द॒ कण्वा॑न् जीवित॒योप॑नान्",
   "तमां॑सि॒ यत्र॒ गच्छ॑न्ति॒ तत् क्र॒व्यादो॑ अजीगमम्"
  ],
  "lines_iast": [
   "parā̭ca enā̱n pra ṇṷda̱ kaṇvā̭n jīvita̱yopa̭nān",
   "tamā̭ṃsi̱ yatra̱ gaccha̭nti̱ tat kra̱vyādo̭ ajīgamam"
  ],
