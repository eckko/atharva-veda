   "002.025.1a",
   "002.025.1b"
  ],
  "lines_deva": [
   "शं नो॑ दे॒वी पृ॑श्निप॒र्ण्यशं॒ निरृ॑त्या अकः",
   "उ॒ग्रा हि क॑ण्व॒जम्भ॑नी॒ ताम॑भक्षि॒ सह॑स्वतीम्"
  ],
  "lines_iast": [
   "śaṃ no̭ de̱vī pṛ̭śnipa̱rṇyaśa̱ṃ nirṛ̭tyā akaḥ",
   "u̱grā hi ka̭ṇva̱jambha̭nī̱ tāma̭bhakṣi̱ saha̭svatīm"
  ],
