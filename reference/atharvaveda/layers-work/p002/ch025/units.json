   "002.025.3a",
   "002.025.3b"
  ],
  "lines_deva": [
   "अ॒राय॑मसृ॒क्पावा॑नं॒ यश्च॑ स्फा॒तिं जिही॑र्षति",
   "ग॒र्भा॒दं कण्वं॑ नाशय॒ पृश्नि॑पर्णि॒ सह॑स्व च"
  ],
  "lines_iast": [
   "a̱rāya̭masṛ̱kpāvā̭na̱ṃ yaśca̭ sphā̱tiṃ jihī̭rṣati",
   "ga̱rbhā̱daṃ kaṇva̭ṃ nāśaya̱ pṛśni̭parṇi̱ saha̭sva ca"
  ],
