   "002.025.4b"
  ],
  "lines_deva": [
   "गि॒रिमे॑नाँ॒ आ वे॑शय॒ कण्वा॑न् जीवित॒योप॑नान्",
   "तांस्त्वं दे॑वि पृश्निपर्ण्य॒ग्निरि॑वानु॒दह॑न्निहि"
  ],
  "lines_iast": [
   "gi̱rimḙnā̱~ ā vḙśaya̱ kaṇvā̭n jīvita̱yopa̭nān",
   "tāṃstvaṃ dḙvi pṛśniparṇya̱gniri̭vānu̱daha̭nnihi"
  ],
