  "lines_deva": [
   "नेच्छत्रुः॒ प्राशं॑ जयाति॒ सह॑मानाभि॒भूर॑सि",
   "प्राशं॒ प्रति॑प्राशो जह्यर॒सान् कृ॑न्वोषधे"
  ],
  "lines_iast": [
   "necchatru̱ḥ prāśa̭ṃ jayāti̱ saha̭mānābhi̱bhūra̭si",
   "prāśa̱ṃ prati̭prāśo jahyara̱sān kṛ̭nvoṣadhe"
  ],
