  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.009.2a",
   "002.009.2b"
  ],
  "lines_deva": [
   "आगा॒दुद॑गाद॒यं जी॒वानां॒ व्रात॒मप्य॑गात्",
   "अभू॑दु पु॒त्राणां॑ पि॒ता नृ॒णां च॒ भग॑वत्तमः"
  ],
  "lines_iast": [
   "āgā̱duda̭gāda̱yaṃ jī̱vānā̱ṃ vrāta̱mapya̭gāt",
   "abhṷ̄du pu̱trāṇā̭ṃ pi̱tā nṛ̱ṇāṃ ca̱ bhaga̭vattamaḥ"
  ],
