 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.009.3a",
   "002.009.3b"
  ],
  "lines_deva": [
   "अधी॑ती॒रध्य॑गाद॒यमधि॑ जीवपु॒रा अ॑गान्",
   "श॒तं ह्य॑स्य भि॒षजः॑ स॒हस्र॑मु॒त वी॒रुधः॑"
  ],
  "lines_iast": [
   "adhī̭tī̱radhya̭gāda̱yamadhi̭ jīvapu̱rā a̭gān",
   "śa̱taṃ hya̭sya bhi̱ṣaja̭ḥ sa̱hasra̭mu̱ta vī̱rudha̭ḥ"
  ],
