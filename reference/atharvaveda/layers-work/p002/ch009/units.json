   "002.009.4b"
  ],
  "lines_deva": [
   "दे॒वास्ते॑ ची॒तिम॑विदन् ब्र॒ह्माण॑ उ॒त वी॒रुधः॑",
   "ची॒तिं ते॒ विश्वे॑ दे॒वा अवि॑द॒न् भूम्या॒मधि॑"
  ],
  "lines_iast": [
   "de̱vāstḙ cī̱tima̭vidan bra̱hmāṇa̭ u̱ta vī̱rudha̭ḥ",
   "cī̱tiṃ te̱ viśvḙ de̱vā avi̭da̱n bhūmyā̱madhi̭"
  ],
