[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "002.009.1a",
   "002.009.1b"
  ],
  "lines_deva": [
   "दश॑वृक्ष मु॒ञ्चेमं रक्ष॑सो॒ ग्राह्या॒ अधि॒ यैनं॑ ज॒ग्राह॒ पर्व॑सु",
   "अथो॑ एनं वनस्पते जी॒वानां॒ लो॒क॑मु॑न्नय"
  ],
  "lines_iast": [
   "daśa̭vṛkṣa mu̱ñcemaṃ rakṣa̭so̱ grāhyā̱ adhi̱ yaina̭ṃ ja̱grāha̱ parva̭su",
   "atho̭ enaṃ vanaspate jī̱vānā̱ṃ lo̱ka̭mṷnnaya"
  ],
  "book_split": [
   "",
