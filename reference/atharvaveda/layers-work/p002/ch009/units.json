   "002.009.5b"
  ],
  "lines_deva": [
   "यश्च॒कार॒ स निष्क॑र॒त् स ए॒व सुभि॑षक्तमः",
   "स ए॒व तुभ्यं॑ भेष॒जानि॑ कृ॒णव॑द् भि॒षजा॒ शुचिः॑"
  ],
  "lines_iast": [
   "yaśca̱kāra̱ sa niṣka̭ra̱t sa e̱va subhi̭ṣaktamaḥ",
   "sa e̱va tubhya̭ṃ bheṣa̱jāni̭ kṛ̱ṇava̭d bhi̱ṣajā̱ śuci̭ḥ"
  ],
