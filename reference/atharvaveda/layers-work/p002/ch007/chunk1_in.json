  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.007.2a",
   "002.007.2b"
  ],
  "lines_deva": [
   "यश्च॑ साप॒त्नः श॒पथो॑ जा॒म्याः श॒पथ॑श्च॒ यः",
   "ब्र॒ह्मा यन्म॑न्यु॒तः शपा॒त् सर्वं॒ तन्नो॑ अधस्प॒दम्"
  ],
  "lines_iast": [
   "yaśca̭ sāpa̱tnaḥ śa̱patho̭ jā̱myāḥ śa̱patha̭śca̱ yaḥ",
   "bra̱hmā yanma̭nyu̱taḥ śapā̱t sarva̱ṃ tanno̭ adhaspa̱dam"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
