 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "002.007.5a",
   "002.007.5b"
  ],
  "lines_deva": [
   "श॒प्तार॑मेतु श॒पथो॒ यः सु॒हार्त् तेन॑ नः स॒ह",
   "चक्षु॑र्मन्त्रस्य दु॒र्हार्दः॑ पृ॒ष्टीरपि॑ शृणीमसि"
  ],
  "lines_iast": [
   "śa̱ptāra̭metu śa̱patho̱ yaḥ su̱hārt tena̭ naḥ sa̱ha",
   "cakṣṷrmantrasya du̱rhārda̭ḥ pṛ̱ṣṭīrapi̭ śṛṇīmasi"
  ],
