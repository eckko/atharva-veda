  ]
 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.007.3a",
   "002.007.3b"
  ],
  "lines_deva": [
   "दि॒वो मूल॒मव॑ततं पृथि॒व्या अध्युत्त॑तम्",
   "तेन॑ स॒हस्र॑काण्डेन॒ परि॑ णः पाहि वि॒श्वतः॑"
  ],
  "lines_iast": [
   "di̱vo mūla̱mava̭tataṃ pṛthi̱vyā adhyutta̭tam",
   "tena̭ sa̱hasra̭kāṇḍena̱ pari̭ ṇaḥ pāhi vi̱śvata̭ḥ"
  ],
  "book_split": [
