[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "002.007.1a",
   "002.007.1b"
  ],
  "lines_deva": [
   "अ॒घद्वि॑ष्टा दे॒वजा॑ता वी॒रुच्छ॑पथ॒योप॑नी",
   "आपो॒ मल॑मिव॒ प्राणै॑क्षी॒त् सर्वा॒न् मच्छ॒पथाँ॒ अधि॑"
  ],
  "lines_iast": [
   "a̱ghadvi̭ṣṭā de̱vajā̭tā vī̱ruccha̭patha̱yopa̭nī",
   "āpo̱ mala̭miva̱ prāṇai̭kṣī̱t sarvā̱n maccha̱pathā̱~ adhi̭"
  ],
  "book_split": [
   "",
