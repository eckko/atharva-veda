 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "002.007.4a",
   "002.007.4b"
  ],
  "lines_deva": [
   "परि॒ मां परि॑ मे प्र॒जां परि॑ णः पाहि॒ यद्धन॑म्",
   "अरा॑तिर्नो॒ मा ता॑री॒न्मा न॑स्तारि॒षुर॒भिमा॑तयः"
  ],
  "lines_iast": [
   "pari̱ māṃ pari̭ me pra̱jāṃ pari̭ ṇaḥ pāhi̱ yaddhana̭m",
   "arā̭tirno̱ mā tā̭rī̱nmā na̭stāri̱ṣura̱bhimā̭tayaḥ"
  ],
  "book_split": [
