   "002.003.2b"
  ],
  "lines_deva": [
   "आद॒ङ्गा कु॒विद॒ङ्गा श॒तं या भे॑ष॒जानि॑ ते",
   "तेषा॑मसि॒ त्वमु॑त्त॒मम॑नास्रा॒वमरो॑गणम्"
  ],
  "lines_iast": [
   "āda̱ṅgā ku̱vida̱ṅgā śa̱taṃ yā bhḙṣa̱jāni̭ te",
   "teṣā̭masi̱ tvamṷtta̱mama̭nāsrā̱vamaro̭gaṇam"
  ],
