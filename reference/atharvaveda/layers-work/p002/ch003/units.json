   "002.003.1b"
  ],
  "lines_deva": [
   "अ॒दो यद॑व॒धाव॑त्यव॒त्कमधि॒ पर्व॑तात्",
   "तत् ते॑ कृणोमि भेष॒जं सुभे॑षजं॒ यथास॑सि"
  ],
  "lines_iast": [
   "a̱do yada̭va̱dhāva̭tyava̱tkamadhi̱ parva̭tāt",
   "tat tḙ kṛṇomi bheṣa̱jaṃ subhḙṣaja̱ṃ yathāsa̭si"
  ],
