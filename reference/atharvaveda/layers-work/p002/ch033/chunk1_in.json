  "lines_deva": [
   "ग्री॒वाभ्य॑स्त उ॒ष्णिहा॑भ्यः॒ कीक॑साभ्यो अनू॒क्याऽत्",
   "यक्ष्मं॑ दोष॒ण्य॑१मंसा॑भ्यां बा॒हुभ्यां॒ वि वृ॑हामि ते"
  ],
  "lines_iast": [
   "grī̱vābhya̭sta u̱ṣṇihā̭bhya̱ḥ kīka̭sābhyo anū̱kyā't",
   "yakṣma̭ṃ doṣa̱ṇya̭1maṃsā̭bhyāṃ bā̱hubhyā̱ṃ vi vṛ̭hāmi te"
  ],
