  "lines_deva": [
   "हृद॑यात् ते॒ परि॑ क्लो॒म्नो हली॑क्ष्णात् पा॒र्श्वाभ्या॑म्",
   "यक्ष्मं॒ मत॑स्नाभ्यां प्ली॒ह्नो य॒क्नस्ते॒ वि वृ॑हामसि"
  ],
  "lines_iast": [
   "hṛda̭yāt te̱ pari̭ klo̱mno halī̭kṣṇāt pā̱rśvābhyā̭m",
   "yakṣma̱ṃ mata̭snābhyāṃ plī̱hno ya̱knaste̱ vi vṛ̭hāmasi"
  ],
