   "002.033.1b"
  ],
  "lines_deva": [
   "अ॒क्षीभ्यां॑ ते॒ नासि॑काभ्यां॒ कर्णा॑भ्यां छुबु॑का॒दधि॑",
   "यक्ष्मं॑ शीर्ष॒ण्यं ऽ म॒स्तिष्का॑ज्जि॒ह्वाया॒ वि वृ॑हामि ते"
  ],
  "lines_iast": [
   "a̱kṣībhyā̭ṃ te̱ nāsi̭kābhyā̱ṃ karṇā̭bhyāṃ chubṷkā̱dadhi̭",
   "yakṣma̭ṃ śīrṣa̱ṇyaṃ ' ma̱stiṣkā̭jji̱hvāyā̱ vi vṛ̭hāmi te"
  ],
