  "lines_deva": [
   "यदि॒ स्थ क्षे॑त्रि॒याणां॒ यदि॑ वा॒ पुरु॑षेषिताः",
   "यदि॒ स्थ दस्यु॑भ्यो जा॒ता नश्य॑ते॒तः स॒दान्वाः॑"
  ],
  "lines_iast": [
   "yadi̱ stha kṣḙtri̱yāṇā̱ṃ yadi̭ vā̱ purṷṣeṣitāḥ",
   "yadi̱ stha dasyṷbhyo jā̱tā naśya̭te̱taḥ sa̱dānvā̭ḥ"
  ],
