   "002.014.3a",
   "002.014.3b"
  ],
  "lines_deva": [
   "अ॒सौ यो अ॑ध॒राद् गृ॒हस्तत्र॑ सन्त्वरा॒य्यः",
   "तत्र॑ से॒दिर्न्युऽच्यतु॒ सर्वा॑श्च यातुधा॒न्यः"
  ],
  "lines_iast": [
   "a̱sau yo a̭dha̱rād gṛ̱hastatra̭ santvarā̱yyaḥ",
   "tatra̭ se̱dirnyu'cyatu̱ sarvā̭śca yātudhā̱nyaḥ"
  ],
