  "lines_deva": [
   "परि॒ धामा॑न्यासामा॒शुर्गाष्ठा॑मिवासरन्",
   "अजै॑षं॒ सर्वा॑ना॒जीन्वो॒ नश्य॑ते॒तः स॒दान्वाः॑"
  ],
  "lines_iast": [
   "pari̱ dhāmā̭nyāsāmā̱śurgāṣṭhā̭mivāsaran",
   "ajai̭ṣa̱ṃ sarvā̭nā̱jīnvo̱ naśya̭te̱taḥ sa̱dānvā̭ḥ"
  ],
