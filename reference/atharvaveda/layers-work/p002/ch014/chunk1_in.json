   "002.014.2b"
  ],
  "lines_deva": [
   "निर्वो॑ गो॒ष्ठाद॑जामसि॒ निरक्षा॒न्निरु॑पान॒सात्",
   "निर्वो॑ मगुन्द्या दुहितरो गृ॒हेभ्य॑श्चातयामहे"
  ],
  "lines_iast": [
   "nirvo̭ go̱ṣṭhāda̭jāmasi̱ nirakṣā̱nnirṷpāna̱sāt",
   "nirvo̭ magundyā duhitaro gṛ̱hebhya̭ścātayāmahe"
  ],
