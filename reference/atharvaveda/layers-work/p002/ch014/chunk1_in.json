   "002.014.1a",
   "002.014.1b"
  ],
  "lines_deva": [
   "निः॒सालां धृ॒ष्णुं धि॒षण॑मेकवा॒द्यां जि॑घ॒त्स्वऽम्",
   "सर्वा॒श्चण्ड॑स्य न॒प्त्योऽ ना॒शया॑मः स॒दान्वाः॑"
  ],
  "lines_iast": [
   "ni̱ḥsālāṃ dhṛ̱ṣṇuṃ dhi̱ṣaṇa̭mekavā̱dyāṃ ji̭gha̱tsva'm",
   "sarvā̱ścaṇḍa̭sya na̱ptyo' nā̱śayā̭maḥ sa̱dānvā̭ḥ"
  ],
