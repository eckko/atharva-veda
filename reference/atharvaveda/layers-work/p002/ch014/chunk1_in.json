   "002.014.4b"
  ],
  "lines_deva": [
   "भू॒त॒प॒तिर्निर॑ज॒त्विन्द्र॑श्चे॒तः स॒दान्वाः॑",
   "गृ॒हस्य॑ बु॒ध्न आसी॑ना॒स्ता इन्द्रो॒ वज्रे॒णाधि॑ तिष्ठतु"
  ],
  "lines_iast": [
   "bhū̱ta̱pa̱tirnira̭ja̱tvindra̭śce̱taḥ sa̱dānvā̭ḥ",
   "gṛ̱hasya̭ bu̱dhna āsī̭nā̱stā indro̱ vajre̱ṇādhi̭ tiṣṭhatu"
  ],
