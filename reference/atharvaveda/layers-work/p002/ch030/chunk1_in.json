   "002.030.4a",
   "002.030.4b"
  ],
  "lines_deva": [
   "यदन्त॑रं॒ तद् बाह्यं॒ यद् बाह्यं॒ तदन्त॑रम्",
   "क॒न्याऽनां वि॒श्वरू॑पाणां॒ मनो॑ गृभायौषधे"
  ],
  "lines_iast": [
   "yadanta̭ra̱ṃ tad bāhya̱ṃ yad bāhya̱ṃ tadanta̭ram",
   "ka̱nyā'nāṃ vi̱śvarṷ̄pāṇā̱ṃ mano̭ gṛbhāyauṣadhe"
  ],
