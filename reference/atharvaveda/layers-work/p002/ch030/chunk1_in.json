  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.030.2a",
   "002.030.2b"
  ],
  "lines_deva": [
   "सं चेन्नया॑थो अश्विना का॒मिना॒ सं च॒ वक्ष॑थः",
   "सं वां॒ भगा॑सो अग्मत॒ सं चि॒त्तानि॒ समु॑ व्र॒ता"
  ],
  "lines_iast": [
   "saṃ cennayā̭tho aśvinā kā̱minā̱ saṃ ca̱ vakṣa̭thaḥ",
   "saṃ vā̱ṃ bhagā̭so agmata̱ saṃ ci̱ttāni̱ samṷ vra̱tā"
  ],
