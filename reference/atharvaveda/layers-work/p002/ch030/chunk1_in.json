[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "002.030.1a",
   "002.030.1b"
  ],
  "lines_deva": [
   "यथे॒दं भूम्या॒ अधि॒ तृणं॒ वातो॑ मथा॒य॑ति",
   "ए॒वा म॑थ्नामि ते मनो॒ यथा॒ मां का॒मिन्यसो॒ यथा॒ मन्नाप॑गा॒ असः॑"
  ],
  "lines_iast": [
   "yathe̱daṃ bhūmyā̱ adhi̱ tṛṇa̱ṃ vāto̭ mathā̱ya̭ti",
   "e̱vā ma̭thnāmi te mano̱ yathā̱ māṃ kā̱minyaso̱ yathā̱ mannāpa̭gā̱ asa̭ḥ"
  ],
  "book_split": [
