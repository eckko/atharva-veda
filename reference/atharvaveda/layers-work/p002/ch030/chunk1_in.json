  "lines_deva": [
   "एयम॑ग॒न् पति॑कामा॒ जनि॑कामो॒ऽहमाग॑मम्",
   "अश्वः॒ कनि॑क्रद॒द् यथा॒ भगे॑ना॒हं स॒हाग॑मम्"
  ],
  "lines_iast": [
   "eyama̭ga̱n pati̭kāmā̱ jani̭kāmo̱'hamāga̭mam",
   "aśva̱ḥ kani̭krada̱d yathā̱ bhagḙnā̱haṃ sa̱hāga̭mam"
  ],
