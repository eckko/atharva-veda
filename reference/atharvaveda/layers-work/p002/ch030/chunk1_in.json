 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.030.3a",
   "002.030.3b"
  ],
  "lines_deva": [
   "यत् सु॑प॒र्णा वि॑व॒क्षवो॑ अनमी॒वा वि॑व॒क्षवः॑",
   "तत्र॑ मे गछता॒द्धवं॑ श॒ल्य इ॑व॒ कुल्म॑लं॒ यथा॑"
  ],
  "lines_iast": [
   "yat sṷpa̱rṇā vi̭va̱kṣavo̭ anamī̱vā vi̭va̱kṣava̭ḥ",
   "tatra̭ me gachatā̱ddhava̭ṃ śa̱lya i̭va̱ kulma̭la̱ṃ yathā̭"
  ],
