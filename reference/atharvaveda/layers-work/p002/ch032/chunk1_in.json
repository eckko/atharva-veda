 },
 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "002.032.4a",
   "002.032.4b"
  ],
  "lines_deva": [
   "ह॒तो राजा॒ क्रिमी॑णामु॒तैषां॑ स्थ॒पति॑र्ह॒तः",
   "ह॒तो ह॒तमा॑ता॒ क्रिमि॑र्ह॒तभ्रा॑ता ह॒तस्व॑सा"
  ],
  "lines_iast": [
   "ha̱to rājā̱ krimī̭ṇāmu̱taiṣā̭ṃ stha̱pati̭rha̱taḥ",
   "ha̱to ha̱tamā̭tā̱ krimi̭rha̱tabhrā̭tā ha̱tasva̭sā"
  ],
