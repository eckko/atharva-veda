 {
  "n": "5",
  "type": "verse",
  "line_ids": [
   "002.032.5a",
   "002.032.5b"
  ],
  "lines_deva": [
   "ह॒तासो॑ अस्य वे॒शसो॑ ह॒तासः॒ परि॑वेशसः",
   "अथो॒ ये क्षु॑ल्ल॒का इ॑व॒ सर्वे॒ ते क्रिम॑यो ह॒ताः"
  ],
  "lines_iast": [
   "ha̱tāso̭ asya ve̱śaso̭ ha̱tāsa̱ḥ pari̭veśasaḥ",
   "atho̱ ye kṣṷlla̱kā i̭va̱ sarve̱ te krima̭yo ha̱tāḥ"
  ],
