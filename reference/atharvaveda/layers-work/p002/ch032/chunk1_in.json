 {
  "n": "6",
  "type": "verse",
  "line_ids": [
   "002.032.6a",
   "002.032.6b"
  ],
  "lines_deva": [
   "प्र ते॑ शृणामि॒ शृङ्गे॒ याभ्यां॑ वितुदा॒यसि॑",
   "भि॒नाद्मि॑ ते कु॒षुम्भं॒ यस्ते॑ विष॒धानः॑"
  ],
  "lines_iast": [
   "pra tḙ śṛṇāmi̱ śṛṅge̱ yābhyā̭ṃ vitudā̱yasi̭",
   "bhi̱nādmi̭ te ku̱ṣumbha̱ṃ yastḙ viṣa̱dhāna̭ḥ"
  ],
