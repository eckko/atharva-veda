   " ।",
   " ॥"
  ]
 },
 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.032.2a",
   "002.032.2b"
  ],
  "lines_deva": [
   "वि॒श्वरू॑पं चतुर॒क्षं क्रिमिं॑ सा॒रङ्ग॒मर्जु॑नम्",
   "शृ॒णाम्य॑स्य पृ॒ष्टीरपि॑ वृश्चामि॒ यच्छिरः॑"
  ],
  "lines_iast": [
   "vi̱śvarṷ̄paṃ catura̱kṣaṃ krimi̭ṃ sā̱raṅga̱marjṷnam",
   "śṛ̱ṇāmya̭sya pṛ̱ṣṭīrapi̭ vṛścāmi̱ yacchira̭ḥ"
  ],
  "book_split": [
   "",
