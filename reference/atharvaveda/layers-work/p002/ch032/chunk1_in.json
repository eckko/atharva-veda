[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "002.032.1a",
   "002.032.1b"
  ],
  "lines_deva": [
   "उ॒द्यन्ना॑दि॒त्यः क्रिमी॑न् हन्तु नि॒म्रोच॑न् हन्तु र॒श्मिभिः॑",
   "ये अ॒न्तः क्रिम॑यो॒ गवि॑"
  ],
  "lines_iast": [
   "u̱dyannā̭di̱tyaḥ krimī̭n hantu ni̱mroca̭n hantu ra̱śmibhi̭ḥ",
   "ye a̱ntaḥ krima̭yo̱ gavi̭"
  ],
  "book_split": [
   "",
   ""
  ],
  "book_hindi": [
   "",
