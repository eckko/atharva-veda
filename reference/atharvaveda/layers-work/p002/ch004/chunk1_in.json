   "002.004.4b"
  ],
  "lines_deva": [
   "दे॒वैर्द॒त्तेन॑ म॒णिना॑ जङ्गि॒डेन॑ मयो॒भुवा॑",
   "विष्क॑न्धं॒ सर्वा॒ रक्षां॑सि व्याया॒मे स॑हामहे"
  ],
  "lines_iast": [
   "de̱vairda̱ttena̭ ma̱ṇinā̭ jaṅgi̱ḍena̭ mayo̱bhuvā̭",
   "viṣka̭ndha̱ṃ sarvā̱ rakṣā̭ṃsi vyāyā̱me sa̭hāmahe"
  ],
