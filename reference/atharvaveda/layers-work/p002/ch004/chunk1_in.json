   "002.004.1a",
   "002.004.1b"
  ],
  "lines_deva": [
   "दी॒र्घा॒यु॒त्वाय॑ बृह॒ते रणा॒यारि॑ष्यन्तो॒ दक्ष॑माणाः॒ सदै॒व",
   "म॒णिं वि॑ष्कन्ध॒दूष॑णं जङ्गि॒डं बि॑भृमो व॒यम्"
  ],
  "lines_iast": [
   "dī̱rghā̱yu̱tvāya̭ bṛha̱te raṇā̱yāri̭ṣyanto̱ dakṣa̭māṇā̱ḥ sadai̱va",
   "ma̱ṇiṃ vi̭ṣkandha̱dūṣa̭ṇaṃ jaṅgi̱ḍaṃ bi̭bhṛmo va̱yam"
  ],
  "book_split": [
