  ],
  "lines_deva": [
   "कृ॒त्या॒दूषि॑र॒यं म॒णिरथो॑ अराति॒दूषिः॑",
   "अथो॒ सह॑स्वान् जङ्गि॒डः प्र ण॒ आयुं॑षि तारिषत्"
  ],
  "lines_iast": [
   "kṛ̱tyā̱dūṣi̭ra̱yaṃ ma̱ṇiratho̭ arāti̱dūṣi̭ḥ",
   "atho̱ saha̭svān jaṅgi̱ḍaḥ pra ṇa̱ āyṷṃṣi tāriṣat"
  ],
