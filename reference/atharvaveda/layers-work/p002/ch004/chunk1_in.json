 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.004.2a",
   "002.004.2b"
  ],
  "lines_deva": [
   "जङ्गि॒डो ज॒म्भाद् वि॑श॒राद् विष्क॑न्धादभि॒शोच॑नात्",
   "म॒णिः स॒हस्र॑वीर्यः॒ परि॑ णः पातु वि॒श्वतः॑"
  ],
  "lines_iast": [
   "jaṅgi̱ḍo ja̱mbhād vi̭śa̱rād viṣka̭ndhādabhi̱śoca̭nāt",
   "ma̱ṇiḥ sa̱hasra̭vīrya̱ḥ pari̭ ṇaḥ pātu vi̱śvata̭ḥ"
  ],
  "book_split": [
