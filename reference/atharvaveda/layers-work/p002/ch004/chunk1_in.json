   "002.004.5b"
  ],
  "lines_deva": [
   "श॒णश्च॑ मा जङ्गि॒डश्च॒ विष्क॑न्धाद॒भि र॑क्षताम्",
   "अर॑ण्याद॒न्य आभृ॑तः कृ॒ष्या अ॒न्यो रसे॑भ्यः"
  ],
  "lines_iast": [
   "śa̱ṇaśca̭ mā jaṅgi̱ḍaśca̱ viṣka̭ndhāda̱bhi ra̭kṣatām",
   "ara̭ṇyāda̱nya ābhṛ̭taḥ kṛ̱ṣyā a̱nyo rasḙbhyaḥ"
  ],
