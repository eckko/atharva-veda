 },
 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.004.3a",
   "002.004.3b"
  ],
  "lines_deva": [
   "अ॒यं विष्क॑न्धं सहते॒ऽयं बा॑धते अ॒त्त्रिणः॑",
   "अ॒यं नो॑ वि॒श्वभे॑षजो जङ्गि॒डः पा॒त्वंह॑सः"
  ],
  "lines_iast": [
   "a̱yaṃ viṣka̭ndhaṃ sahate̱'yaṃ bā̭dhate a̱ttriṇa̭ḥ",
   "a̱yaṃ no̭ vi̱śvabhḙṣajo jaṅgi̱ḍaḥ pā̱tvaṃha̭saḥ"
  ],
