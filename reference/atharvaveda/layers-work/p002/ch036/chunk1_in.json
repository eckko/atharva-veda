   "002.036.7b"
  ],
  "lines_deva": [
   "इ॒दं हिर॑ण्यं॒ गुल्गु॑ल्व॒यमौ॒क्षो अथो॒ भगः॑",
   "ए॒ते पति॑भ्य॒स्त्वाम॑दुः प्रतिका॒माय॒ वेत्त॑वे"
  ],
  "lines_iast": [
   "i̱daṃ hira̭ṇya̱ṃ gulgṷlva̱yamau̱kṣo atho̱ bhaga̭ḥ",
   "e̱te pati̭bhya̱stvāma̭duḥ pratikā̱māya̱ vetta̭ve"
  ],
