 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.036.2a",
   "002.036.2b"
  ],
  "lines_deva": [
   "सोम॑जुष्टं॒ ब्रह्म॑जुष्टमर्य॒म्णा संभृ॑तं॒ भग॑म्",
   "धा॒तुर्दे॒वस्य॑ स॒त्येन॑ कृ॒णोमि॑ पति॒वेद॑नम्"
  ],
  "lines_iast": [
   "soma̭juṣṭa̱ṃ brahma̭juṣṭamarya̱mṇā saṃbhṛ̭ta̱ṃ bhaga̭m",
   "dhā̱turde̱vasya̭ sa̱tyena̭ kṛ̱ṇomi̭ pati̱veda̭nam"
  ],
  "book_split": [
