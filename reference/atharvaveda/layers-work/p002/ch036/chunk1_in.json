 {
  "n": "4",
  "type": "verse",
  "line_ids": [
   "002.036.4a",
   "002.036.4b"
  ],
  "lines_deva": [
   "यथा॑ख॒रो म॑घवं॒श्चारु॑रे॒ष प्रि॒यो मृ॒गाणां॑ सु॒षदा॑ ब॒भूव॑",
   "ए॒वा भग॑स्य जु॒ष्टेयम॑स्तु॒ नारी॒ संप्रि॑या॒ पत्यावि॑राधयन्ती"
  ],
  "lines_iast": [
   "yathā̭kha̱ro ma̭ghava̱ṃścārṷre̱ṣa pri̱yo mṛ̱gāṇā̭ṃ su̱ṣadā̭ ba̱bhūva̭",
   "e̱vā bhaga̭sya ju̱ṣṭeyama̭stu̱ nārī̱ saṃpri̭yā̱ patyāvi̭rādhayantī"
  ],
  "book_split": [
