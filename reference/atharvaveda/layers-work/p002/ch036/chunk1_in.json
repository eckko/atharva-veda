   "002.036.5b"
  ],
  "lines_deva": [
   "भग॑स्य॒ नाव॒मा रो॑ह पू॒र्णामनु॑पदस्वतीम्",
   "तयो॑पप्रता॑रय॒ यो वरः प्र॑तिका॒म्यः"
  ],
  "lines_iast": [
   "bhaga̭sya̱ nāva̱mā ro̭ha pū̱rṇāmanṷpadasvatīm",
   "tayo̭papratā̭raya̱ yo varaḥ pra̭tikā̱myaḥ"
  ],
