[
 {
  "n": "1",
  "type": "verse",
  "line_ids": [
   "002.036.1a",
   "002.036.1b"
  ],
  "lines_deva": [
   "आ नो॑ अग्ने सुम॒तिं सं॑भ॒लो ग॑मेदि॒मां कु॑मा॒रीं स॒ह नो॒ भगे॑न",
   "जु॒ष्टा व॒रेषु॒ सम॑नेषु व॒ल्गुरो॒षं पत्या॒ सौभ॑गमस्त्व॒स्यै"
  ],
  "lines_iast": [
   "ā no̭ agne suma̱tiṃ sa̭ṃbha̱lo ga̭medi̱māṃ kṷmā̱rīṃ sa̱ha no̱ bhagḙna",
   "ju̱ṣṭā va̱reṣu̱ sama̭neṣu va̱lguro̱ṣaṃ patyā̱ saubha̭gamastva̱syai"
  ],
