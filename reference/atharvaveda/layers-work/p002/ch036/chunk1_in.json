   "002.036.6b"
  ],
  "lines_deva": [
   "आ क्र॑न्दय धनपते व॒रमाम॑नसं कृणु",
   "सर्वं॑ प्रदक्षि॒णं कृ॑णु॒ यो व॒रः प्र॑तिका॒म्यः"
  ],
  "lines_iast": [
   "ā kra̭ndaya dhanapate va̱ramāma̭nasaṃ kṛṇu",
   "sarva̭ṃ pradakṣi̱ṇaṃ kṛ̭ṇu̱ yo va̱raḥ pra̭tikā̱myaḥ"
  ],
