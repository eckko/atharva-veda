 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.036.3a",
   "002.036.3b"
  ],
  "lines_deva": [
   "इ॒यम॑ग्ने॒ नारी॒ पतिं॑ विदेष्ट॒ सोमो॒ हि राजा॑ सु॒भगां॑ कृ॒णोति॑",
   "सुवा॑ना पु॒त्रान् महि॑षी भवाति ग॒त्वा पतिं॑ सु॒भगा॒ वि रा॑जतु"
  ],
  "lines_iast": [
   "i̱yama̭gne̱ nārī̱ pati̭ṃ videṣṭa̱ somo̱ hi rājā̭ su̱bhagā̭ṃ kṛ̱ṇoti̭",
   "suvā̭nā pu̱trān mahi̭ṣī bhavāti ga̱tvā pati̭ṃ su̱bhagā̱ vi rā̭jatu"
  ],
  "book_split": [
