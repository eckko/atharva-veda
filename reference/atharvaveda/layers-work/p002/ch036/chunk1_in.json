   "002.036.8b"
  ],
  "lines_deva": [
   "आ ते॑ नयतु सवि॒ता न॑यतु॒ पति॒र्यः प्र॑तिका॒म्यः",
   "त्वम॑स्यै धेह्योषधे"
  ],
  "lines_iast": [
   "ā tḙ nayatu savi̱tā na̭yatu̱ pati̱ryaḥ pra̭tikā̱myaḥ",
   "tvama̭syai dhehyoṣadhe"
  ],
