 {
  "n": "2",
  "type": "verse",
  "line_ids": [
   "002.008.2a",
   "002.008.2b"
  ],
  "lines_deva": [
   "अपे॒यं रात्र्यु॑च्छ॒त्वपो॑च्छन्त्वभि॒कृत्व॑रीः",
   "वी॒रुत् क्षे॑त्रिय॒नाश॒न्यप॑ क्षेत्रि॒यमु॑च्छतु"
  ],
  "lines_iast": [
   "ape̱yaṃ rātryṷccha̱tvapo̭cchantvabhi̱kṛtva̭rīḥ",
   "vī̱rut kṣḙtriya̱nāśa̱nyapa̭ kṣetri̱yamṷcchatu"
  ],
