   "002.008.1a",
   "002.008.1b"
  ],
  "lines_deva": [
   "उद॑गातां॒ भग॑वती वि॒चृतौ॒ नाम॒ तार॑के",
   "वि क्षे॑त्रि॒यस्य॑ मुञ्चतामध॒मं पाश॑मुत्त॒मम्"
  ],
  "lines_iast": [
   "uda̭gātā̱ṃ bhaga̭vatī vi̱cṛtau̱ nāma̱ tāra̭ke",
   "vi kṣḙtri̱yasya̭ muñcatāmadha̱maṃ pāśa̭mutta̱mam"
  ],
