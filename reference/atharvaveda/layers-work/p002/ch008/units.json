 {
  "n": "3",
  "type": "verse",
  "line_ids": [
   "002.008.3a",
   "002.008.3b"
  ],
  "lines_deva": [
   "ब॒भ्रोरर्जु॑नकाण्डस्य॒ यव॑स्य ते पला॒ल्या तिल॑स्य तिलपि॒ञ्ज्या",
   "वीरुत् क्षे॑त्रिय॒नाश॒न्यप॑ क्षेत्रि॒यमु॑च्छतु"
  ],
  "lines_iast": [
   "ba̱bhrorarjṷnakāṇḍasya̱ yava̭sya te palā̱lyā tila̭sya tilapi̱ñjyā",
   "vīrut kṣḙtriya̱nāśa̱nyapa̭ kṣetri̱yamṷcchatu"
  ],
