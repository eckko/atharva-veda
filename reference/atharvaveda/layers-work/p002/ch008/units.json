   "002.008.5b"
  ],
  "lines_deva": [
   "नमः॑ सनिस्रसा॒क्षेभ्यो॒ नमः॑ संदे॒श्येऽभ्यः",
   "नमः॒ क्षेत्र॑स्य॒ पत॑ये वी॒रुत् क्षे॑त्रिय॒नाश॒न्यप॑ क्षेत्रि॒यमु॑छतु"
  ],
  "lines_iast": [
   "nama̭ḥ sanisrasā̱kṣebhyo̱ nama̭ḥ saṃde̱śye'bhyaḥ",
   "nama̱ḥ kṣetra̭sya̱ pata̭ye vī̱rut kṣḙtriya̱nāśa̱nyapa̭ kṣetri̱yamṷchatu"
  ],
