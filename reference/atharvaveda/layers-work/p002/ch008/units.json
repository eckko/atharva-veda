   "002.008.4b"
  ],
  "lines_deva": [
   "नम॑स्ते॒ लाङ्ग॑लेभ्यो॒ नम॑ ईषायु॒गेभ्यः॑",
   "वी॒रुत् क्षे॑त्रिय॒नाश॒न्यप॑ क्षेत्रि॒यमु॑च्छतु"
  ],
  "lines_iast": [
   "nama̭ste̱ lāṅga̭lebhyo̱ nama̭ īṣāyu̱gebhya̭ḥ",
   "vī̱rut kṣḙtriya̱nāśa̱nyapa̭ kṣetri̱yamṷcchatu"
  ],
